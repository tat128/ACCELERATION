oss_revenue']:,.0f}</div>\n1180:   <div class=\"lbl\">Gross Revenue</div>\n1181:   <div class=\"sub\">Shipped Output</div>\n1182: </div>\n1183: \"\"\", unsafe_allow_html=True)\n1184:                 with fb2:\n1185:                     st.markdown(f\"\"\"\n1186: <div class=\"stat-card red\">\n1187:   <div class=\"val\" style=\"color:#fb7185;\">${baseline['scrap_loss']:,.0f}</div>\n1188:   <div class=\"lbl\">Scrap Loss</div>\n1189:   <div class=\"sub\">Defect Cost</div>\n1190: </div>\n1191: \"\"\", unsafe_allow_html=True)\n1192:                 with fb3:\n1193:                     st.markdown(f\"\"\"\n1194: <div class=\"stat-card orange\">\n1195:   <div class=\"val\" style=\"color:#fbbf24;\">${baseline['bottleneck_idle_loss']:,.0f}</div>\n1196:   <div class=\"lbl\">Idle Cost</div>\n1197:   <div class=\"sub\">Starvation Loss</div>\n1198: </div>\n1199: \"\"\", unsafe_allow_html=True)\n1200:                 with fb4:\n1201:                     st.markdown(f\"\"\"\n1202: <div class=\"stat-card purple\">\n1203:   <div class=\"val\" style=\"color:#c084fc;\">${baseline['opportunity_loss']:,.0f}</div>\n1204:   <div class=\"lbl\">Opportunity Loss</div>\n1205:   <div class=\"sub\">Unmet Demand</div>\n1206: </div>\n1207: \"\"\", unsafe_allow_html=True)\n1208:                 with fb5:\n1209:                     is_pos = baseline['net_margin'] > 0\n1210:                     st.markdown(f\"\"\"\n1211: <div class=\"stat-card {'green' if is_pos else 'red'}\">\n1212:   <div class=\"val\" style=\"color:{'#34d399' if is_pos else '#fb7185'};\">${baseline['net_margin']:,.0f}</div>\n1213:   <div class=\"lbl\">Operating Margin</div>\n1214:   <div class=\"sub\">{baseline['margin_pct']:.1f}% Margin Ratio</div>\n1215: </div>\n1216: \"\"\", unsafe_allow_html=True)\n1217: \n1218:                 st.markdown(\"<div class='section-divider'></div>\", unsafe_allow_html=True)\n1219: \n1220:                 # 2-Column: Waterfall Chart on left, What-If Simulator on right\n1221:                 col_w1