{"step_index":1247,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T21:09:45Z","content":"Created At: 2026-09-20T02:39:45+05:30\nCompleted At: 2026-09-20T02:39:46+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/app.py`\nTotal Lines: 1594\nTotal Bytes: 84844\nShowing lines 820 to 960\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n820: tab1, tab2, tab3, tab4, tab5 = st.tabs([\n821:     \"Quality Inspection\",\n822:     \"Production Flow Health\",\n823:     \"Root Cause Analysis\",\n824:     \"Profitability & What-If Simulator\",\n825:     \"Digital Twin (ANN Surrogate)\",\n826: ])\n827: \n828: # ═════════════════════════════════════════════════════════════════════════════\n829: # TAB 1 — QUALITY INSPECTION\n830: # ═════════════════════════════════════════════════════════════════════════════\n831: with tab1:\n832:     with st.container(border=True):\n833:         st.markdown(\"#### Batch Inspection Ingestion\")\n834:         st.caption(\"Upload product surface images for automated YOLOv8 classification and neural Grad-CAM localization.\")\n835: \n836:         up_col1, up_col2 = st.columns([3, 1])\n837:         with up_col1:\n838:             uploaded_files = st.file_uploader(\n839:                 \"Select images\",\n840:                 type=['jpg', 'jpeg', 'png', 'bmp', 'tiff'],\n841:                 accept_multiple_files=True,\n842:                 key=\"img_upload\",\n843:                 label_visibility=\"collapsed\",\n844:             )\n845:         with up_col2:\n846:             run_btn = st.button(\"Run Inspection Batch\", type=\"primary\", use_container_width=True, disabled=not uploaded_files)\n847: \n848:         if uploaded_files and run_btn:\n849:             if not st.session_state.yolo_model:\n850:                 st.error(\"YOLOv8 model weights not loaded. Please verify the model file in the sidebar.\")\n851:             else:\n852:                 progress_bar = st.progress(0)\n853:                 for i, f in enumerate(uploaded_files):\n854:                     img = Image.open(io.BytesIO(f.read())).convert('RGB')\n855:                     result = run_inference(img, st.session_state.yolo_model, conf_threshold)\n856:                     st.session_state.registry.add(f.name, result)\n857:                     st.session_state.annotated_images[f.name] = result\n858:                     progress_bar.progress((i + 1) / len(uploaded_files))\n859:                 st.success(f\"Batch completed: {len(uploaded_files)} unit(s) evaluated.\")\n860:                 st.rerun()\n861: \n862:     reg_df  = registry.to_dataframe()\n863:     summary = registry.summary()\n864: \n865:     if not reg_df.empty and st.session_state.annotated_images:\n866:         with st.container(border=True):\n867:             st.markdown(\"#### Inspection Results Gallery\")\n868:             st.caption(\"Unit-by-unit classification telemetry, bounding boxes, and Grad-CAM neural evidence overlays.\")\n869: \n870:             ctrl1, ctrl2 = st.columns([1, 2])\n871:             with ctrl1:\n872:                 gal_filter = st.selectbox(\n873:                     \"Filter Results\",\n874:                     [\"All Units\", \"Defects Only\", \"Passed Units\", \"Uncertain / Novel\"],\n875:                     key=\"gal_filter_sel\",\n876:                 )\n877:             with ctrl2:\n878:                 vis_mode = st.radio(\n879:                     \"Display Mode\",\n880:                     [\"Bounding Box\", \"Grad-CAM Heatmap\", \"Clean Industrial View\", \"Raw Image\"],\n881:                     index=0,\n882:                     horizontal=True,\n883:                     key=\"vis_mode_sel\",\n884:                 )\n885: \n886:             items = list(st.session_state.annotated_images.items())\n887:             if gal_filter == \"Defects Only\":\n888:                 items = [it for it in items if it[1]['status'] == 'DEFECT']\n889:             elif gal_filter == \"Passed Units\":\n890:                 items = [it for it in items if it[1]['status'] == 'PASS']\n891:             elif gal_filter == \"Uncertain / Novel\":\n892:                 items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n893: \n894:             if not items:\n895:                 st.info(f\"No inspected units match the selected filter: '{gal_filter}'\")\n896:             else:\n897:                 num_cols = 3\n898:                 for row_idx in range(0, len(items), num_cols):\n899:                     row_items = items[row_idx:row_idx + num_cols]\n900:                     cols = st.columns(num_cols)\n901:                     for col_idx, (fname, res) in enumerate(row_items):\n902:                         with cols[col_idx]:\n903:                             with st.container(border=True):\n904:                                 stat = res['status']\n905:                                 dtype = res['defect_type'].upper()\n906:                                 conf = res['confidence'] * 100\n907:                                 bbox = res.get('bbox')\n908: \n909:                                 # Header row: Filename & status pill\n910:                                 top_l, top_r = st.columns([2, 1])\n911:                                 with top_l:\n912:                                     st.markdown(f\"**{fname}**\")\n913:                                 with top_r:\n914:                                     st.markdown(f\"<div style='text-align:right;'><span class='badge badge-{stat}'>{stat}</span></div>\", unsafe_allow_html=True)\n915: \n916:                                 # Main visual viewport\n917:                                 if vis_mode == \"Bounding Box\" and res.get('boxed_image'):\n918:                                     st.image(res['boxed_image'], use_container_width=True)\n919:                                 elif vis_mode == \"Grad-CAM Heatmap\" and res.get('heatmap_image'):\n920:                                     st.image(res['heatmap_image'], use_container_width=True)\n921:                                 elif vis_mode == \"Clean Industrial View\" and res.get('annotated_image'):\n922:                                     st.image(res['annotated_image'], use_container_width=True)\n923:                                 elif vis_mode == \"Raw Image\" and res.get('raw_image'):\n924:                                     st.image(res['raw_image'], use_container_width=True)\n925:                                 elif res.get('annotated_image'):\n926:                                     st.image(res['annotated_image'], use_container_width=True)\n927: \n928:                                 # Custom Confidence Bar\n929:                                 bar_cls = \"danger\" if stat == \"DEFECT\" else \"safe\" if stat == \"PASS\" else \"warn\"\n930:                                 st.markdown(f\"\"\"\n931: <div style=\"margin-top:8px;\">\n932:   <div style=\"display:flex; justify-content:space-between; font-size:11px; font-family:'JetBrains Mono'; color:#94a3b8;\">\n933:     <span>CLASS: <b style=\"color:#f8fafc;\">{dtype}</b></span>\n934:     <span>CONF: <b style=\"color:#38bdf8;\">{conf:.1f}%</b></span>\n935:   </div>\n936:   <div class=\"util-bar-wrap\">\n937:     <div class=\"util-bar-fill {bar_cls}\" style=\"width:{min(100, max(5, conf))}%;\"></div>\n938:   </div>\n939: </div>\n940: \"\"\", unsafe_allow_html=True)\n941: \n942:                                 if bbox:\n943:                                     x1, y1, x2, y2 = [int(v) for v in bbox]\n944:                                     st.caption(f\"Coordinates: `[{x1},{y1},{x2},{y2}]` ({x2-x1}x{y2-y1}px)\")\n945:                                 else:\n946:                                     st.caption(f\"Neural evaluation: `{stat}`\")\n947: \n948:     