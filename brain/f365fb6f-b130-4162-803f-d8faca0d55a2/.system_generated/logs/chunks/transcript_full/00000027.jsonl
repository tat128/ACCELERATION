           # Interactive Dynamic Margin Delta Bar Chart\n1254:                         st.plotly_chart(\n1255:                             margin_comparison_bar({fin_model: {'baseline': baseline, 'whatif': wi_result}}),\n1256:                             use_container_width=True,\n1257:                             key=f\"wi_bar_{fin_model}\"\n1258:                         )\n1259: \n1260:         # Recommendations & Export Block\n1261:         with st.container(border=True):\n1262:             st.markdown(\"#### Actionable Engineering Recommendations\")\n1263:             recs = []\n1264:             evidence = correlate(fin_analysis, fin_defect_sum)\n1265:             for card in evidence[:3]:\n1266:                 recs.append({\n1267:                     'priority': card['confidence'],\n1268:                     'title':    card['cause'],\n1269:                     'action':   card['action'],\n1270:                     'impact':   \"Direct scrap reduction and buffer stabilization\",\n1271:                 })\n1272: \n1273:             if fin_analysis.get('throughput_gap', 0) > 10:\n1274:                 recs.insert(0, {\n1275:                     'priority': 'HIGH',\n1276:                     'title':    f\"Elevate {fin_analysis['bottleneck_station']} station capacity\",\n1277:                     'action':   (\n1278:                         f\"{fin_analysis['bottleneck_station']} is operating at \"\n1279:                         f\"{fin_analysis['bottleneck_util']*100:.0f}% capacity utilisation — the primary constraint. \"\n1280:                         \"Add parallel tooling or schedule shift balancing.\"\n1281:                     ),\n1282:                     'impact': f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} revenue recovery\",\n1283:                 })\n1284: \n1285:             priority_labels = {'HIGH': '[HIGH PRIORITY]', 'MEDIUM': '[MEDIUM PRIORITY]', 'LOW': '[LOW PRIORITY]'}\n1286:             for i, rec in enumerate(recs[: