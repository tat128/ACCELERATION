{"step_index":905,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T18:44:57Z","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Comprehensive UI CSS overhaul — premium dark cyber-industrial design system","EndLine":367,"Instruction":"Replace all CSS with an upgraded premium version adding scan-line effect, animated grid, custom stat cards, progress bars, and better sidebar","ReplacementContent":"# ── Futuristic Cyber Industrial UI Styling ────────────────────────────────────\nst.markdown(\"\"\"\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n\n    /* ══════════════════════════════════════════════\n       GLOBAL CANVAS — Deep Space Industrial Theme\n    ══════════════════════════════════════════════ */\n    .stApp {\n        background-color: #020817;\n        background-image:\n            radial-gradient(ellipse at 0% 0%, rgba(0,240,255,0.10) 0px, transparent 55%),\n            radial-gradient(ellipse at 100% 0%, rgba(139,92,246,0.10) 0px, transparent 55%),\n            radial-gradient(ellipse at 50% 100%, rgba(5,223,157,0.07) 0px, transparent 55%),\n            linear-gradient(rgba(0,240,255,0.025) 1px, transparent 1px),\n            linear-gradient(90deg, rgba(0,240,255,0.025) 1px, transparent 1px);\n        background-size: 100% 100%, 100% 100%, 100% 100%, 40px 40px, 40px 40px;\n        font-family: 'Rajdhani', -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n        letter-spacing: 0.3px;\n        color: #e2e8f0;\n    }\n\n    /* ══════════════════════════════════════════════\n       CUSTOM SCROLLBARS\n    ══════════════════════════════════════════════ */\n    ::-webkit-scrollbar { width: 5px; height: 5px; }\n    ::-webkit-scrollbar-track { background: #020817; }\n    ::-webkit-scrollbar-thumb { background: rgba(0,240,255,0.3); border-radius: 10px; }\n    ::-webkit-scrollbar-thumb:hover { background: #00f0ff; box-shadow: 0 0 8px #00f0ff; }\n\n    /* ══════════════════════════════════════════════\n       TYPOGRAPHY SYSTEM\n    ══════════════════════════════════════════════ */\n    h1, h2, h3 {\n        font-family: 'Orbitron', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 1px !important;\n        color: #f8fafc !important;\n        text-shadow: 0 0 30px rgba(0,240,255,0.2);\n    }\n    h4, h5, h6 {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.5px !important;\n        color: #e2e8f0 !important;\n    }\n    p, span, label {\n        color: #cbd5e1 !important;\n    }\n    [data-testid=\"stCaptionContainer\"], [data-testid=\"stCaptionContainer\"] p {\n        color: #64748b !important;\n        font-size: 12.5px !important;\n    }\n    strong, b { color: #f8fafc !important; }\n\n    /* ══════════════════════════════════════════════\n       SIDEBAR — Dark Frosted Glass Panel\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stSidebar\"] {\n        background: linear-gradient(180deg, #050d1f 0%, #020817 100%) !important;\n        border-right: 1px solid rgba(0,240,255,0.12) !important;\n        box-shadow: 4px 0 24px rgba(0,0,0,0.5) !important;\n    }\n    [data-testid=\"stSidebar\"] * { color: #cbd5e1; }\n    [data-testid=\"stSidebar\"] h3 {\n        font-family: 'Orbitron', sans-serif !important;\n        font-size: 13px !important;\n        letter-spacing: 2px !important;\n        color: #00f0ff !important;\n        border-bottom: 1px solid rgba(0,240,255,0.2);\n        padding-bottom: 8px !important;\n        text-shadow: 0 0 12px rgba(0,240,255,0.5) !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       HEADER BAR\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stHeader\"] {\n        background: rgba(2,8,23,0.85) !important;\n        backdrop-filter: blur(16px) !important;\n        border-bottom: 1px solid rgba(0,240,255,0.1) !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       FROSTED GLASS CARDS\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stVerticalBlockBorderWrapper\"] {\n        background: rgba(8,14,30,0.75) !important;\n        border: 1px solid rgba(0,240,255,0.14) !important;\n        border-radius: 14px !important;\n        backdrop-filter: blur(24px) !important;\n        -webkit-backdrop-filter: blur(24px) !important;\n        box-shadow:\n            0 8px 32px rgba(0,0,0,0.6),\n            inset 0 1px 0 rgba(0,240,255,0.12),\n            inset 0 -1px 0 rgba(0,0,0,0.3) !important;\n        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    [data-testid=\"stVerticalBlockBorderWrapper\"]:hover {\n        border-color: rgba(0,240,255,0.32) !important;\n        box-shadow:\n            0 16px 48px rgba(0,0,0,0.7),\n            0 0 0 1px rgba(0,240,255,0.08),\n            inset 0 1px 0 rgba(0,240,255,0.25) !important;\n        transform: translateY(-1px);\n    }\n\n    /* ══════════════════════════════════════════════\n       NAVIGATION TABS\n    ══════════════════════════════════════════════ */\n    .stTabs [data-baseweb=\"tab-list\"] {\n        gap: 6px;\n        margin-bottom: 20px;\n        background: rgba(8,14,30,0.8);\n        padding: 5px 6px;\n        border-radius: 12px;\n        border: 1px solid rgba(0,240,255,0.15);\n        box-shadow: inset 0 1px 0 rgba(0,240,255,0.08);\n    }\n    .stTabs [data-baseweb=\"tab\"] {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-size: 14px;\n        font-weight: 700;\n        letter-spacing: 0.8px;\n        padding: 9px 22px;\n        border-radius: 8px;\n        color: #64748b;\n        border: 1px solid transparent;\n        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n        text-transform: uppercase;\n    }\n    .stTabs [data-baseweb=\"tab\"]:hover {\n        color: #00f0ff;\n        background: rgba(0,240,255,0.07);\n        border-color: rgba(0,240,255,0.18);\n    }\n    .stTabs [aria-selected=\"true\"] {\n        background: linear-gradient(135deg, rgba(0,240,255,0.18) 0%, rgba(59,130,246,0.15) 100%) !important;\n        color: #00f0ff !important;\n        border-color: rgba(0,240,255,0.42) !important;\n        box-shadow: 0 0 20px rgba(0,240,255,0.18), inset 0 1px 0 rgba(0,240,255,0.3);\n    }\n\n    /* ══════════════════════════════════════════════\n       METRICS\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stMetricValue\"] {\n        font-family: 'JetBrains Mono', monospace !important;\n        font-weight: 700 !important;\n        font-size: 1.6rem !important;\n        color: #f8fafc !important;\n    }\n    [data-testid=\"stMetricLabel\"] {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-size: 11px !important;\n        font-weight: 700 !important;\n        letter-spacing: 1.2px !important;\n        text-transform: uppercase !important;\n        color: #475569 !important;\n    }\n    [data-testid=\"stMetricDelta\"] {\n        font-family: 'JetBrains Mono', monospace !important;\n        font-size: 12px !important;\n    }\n    [data-testid=\"stMetric\"] {\n        background: rgba(8,14,30,0.6) !important;\n        border: 1px solid rgba(0,240,255,0.1) !important;\n        border-radius: 10px !important;\n        padding: 12px 16px !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       BUTTONS\n    ══════════════════════════════════════════════ */\n    .stButton > button {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 1px !important;\n        text-transform: uppercase !important;\n        border-radius: 8px !important;\n        border: 1px solid rgba(0,240,255,0.28) !important;\n        background: linear-gradient(135deg, rgba(15,23,42,0.9) 0%, rgba(30,41,59,0.9) 100%) !important;\n        color: #e2e8f0 !important;\n        transition: all 0.2s cubic-bezier(0.16,1,0.3,1) !important;\n        height: 40px !important;\n    }\n    .stButton > button:hover {\n        border-color: #00f0ff !important;\n        color: #00f0ff !important;\n        box-shadow: 0 0 20px rgba(0,240,255,0.3), 0 4px 12px rgba(0,0,0,0.4) !important;\n        transform: translateY(-2px) !important;\n    }\n    .stButton > button[kind=\"primary\"] {\n        background: linear-gradient(135deg, #0369a1 0%, #0ea5e9 100%) !important;\n        border-color: rgba(14,165,233,0.6) !important;\n        color: #ffffff !important;\n        box-shadow: 0 0 16px rgba(14,165,233,0.3) !important;\n    }\n    .stButton > button[kind=\"primary\"]:hover {\n        box-shadow: 0 0 28px rgba(0,240,255,0.5), 0 6px 16px rgba(0,0,0,0.4) !important;\n        transform: translateY(-2px) !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       FORM ELEMENTS — INPUTS, SELECTS, SLIDERS\n    ══════════════════════════════════════════════ */\n    input, textarea {\n        background-color: #0a1628 !important;\n        color: #f8fafc !important;\n        border: 1px solid rgba(0,240,255,0.2) !important;\n        border-radius: 8px !important;\n        font-family: 'JetBrains Mono', monospace !important;\n    }\n    input:focus, textarea:focus {\n        border-color: rgba(0,240,255,0.5) !important;\n        box-shadow: 0 0 0 3px rgba(0,240,255,0.1) !important;\n    }\n    [data-baseweb=\"base-input\"], [data-baseweb=\"input\"] {\n        background-color: #0a1628 !important;\n        border-color: rgba(0,240,255,0.2) !important;\n    }\n    [data-baseweb=\"select\"] > div {\n        background-color: #0a1628 !important;\n        color: #f8fafc !important;\n        border: 1px solid rgba(0,240,255,0.2) !important;\n        border-radius: 8px !important;\n    }\n    [data-baseweb=\"popover\"], [data-baseweb=\"menu\"], [role=\"listbox\"] {\n        background-color: #0a1628 !important;\n        border: 1px solid rgba(0,240,255,0.25) !important;\n        border-radius: 10px !important;\n        box-shadow: 0 20px 40px rgba(0,0,0,0.7) !important;\n    }\n    [data-baseweb=\"menu\"] li, [role=\"option\"] {\n        color: #cbd5e1 !important;\n        background-color: transparent !important;\n        border-radius: 6px !important;\n        margin: 2px 4px !important;\n    }\n    [data-baseweb=\"menu\"] li:hover, [role=\"option\"]:hover {\n        background-color: rgba(0,240,255,0.12) !important;\n        color: #00f0ff !important;\n    }\n    [role=\"option\"][aria-selected=\"true\"] {\n        background-color: rgba(0,240,255,0.18) !important;\n        color: #00f0ff !important;\n    }\n    .stSlider > div > div > div {\n        background: rgba(0,240,255,0.15) !important;\n    }\n    .stSlider > div > div > div > div {\n        background: #00f0ff !important;\n        box-shadow: 0 0 10px rgba(0,240,255,0.5) !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       FILE UPLOADER\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stFileUploader\"] {\n        background: rgba(8,14,30,0.6) !important;\n    }\n    [data-testid=\"stFileUploaderDropzone\"] {\n        background: rgba(8,14,30,0.5) !important;\n        border: 2px dashed rgba(0,240,255,0.22) !important;\n        border-radius: 12px !important;\n        transition: all 0.2s ease !important;\n    }\n    [data-testid=\"stFileUploaderDropzone\"]:hover {\n        border-color: rgba(0,240,255,0.5) !important;\n        background: rgba(0,240,255,0.05) !important;\n    }\n    [data-testid=\"stFileUploaderDropzone\"] * { color: #64748b !important; }\n\n    /* ══════════════════════════════════════════════\n       DATAFRAMES & TABLES\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stDataFrame\"] {\n        border: 1px solid rgba(0,240,255,0.12) !important;\n        border-radius: 10px !important;\n        overflow: hidden !important;\n    }\n    .stDataFrame thead tr th {\n        background: rgba(0,240,255,0.08) !important;\n        color: #00f0ff !important;\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.8px !important;\n        text-transform: uppercase !important;\n        font-size: 12px !important;\n    }\n    .stDataFrame tbody tr:hover td {\n        background: rgba(0,240,255,0.06) !important;\n    }\n\n    /* ══════════════════════════════════════════════\n       EXPANDERS\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stExpander\"] {\n        background: rgba(8,14,30,0.5) !important;\n        border: 1px solid rgba(0,240,255,0.12) !important;\n        border-radius: 10px !important;\n        overflow: hidden !important;\n    }\n    details summary {\n        color: #94a3b8 !important;\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 600 !important;\n        padding: 10px 0 !important;\n    }\n    details summary:hover { color: #00f0ff !important; }\n\n    /* ══════════════════════════════════════════════\n       RADIO & CHECKBOX\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stRadio\"] label span { color: #94a3b8 !important; }\n    [data-testid=\"stRadio\"] label:hover span { color: #00f0ff !important; }\n\n    /* ══════════════════════════════════════════════\n       PULSE DOTS — Live Indicators\n    ══════════════════════════════════════════════ */\n    .pulse-dot {\n        display: inline-block; width: 8px; height: 8px;\n        border-radius: 50%;\n        background: #00f0ff; box-shadow: 0 0 10px #00f0ff;\n        animation: pulse_glow 2s infinite ease-in-out;\n        margin-right: 6px; vertical-align: middle;\n    }\n    .pulse-dot.green  { background: #05df9d; box-shadow: 0 0 10px #05df9d; }\n    .pulse-dot.red    { background: #ff3366; box-shadow: 0 0 10px #ff3366; }\n    .pulse-dot.orange { background: #ffaa00; box-shadow: 0 0 10px #ffaa00; }\n    @keyframes pulse_glow {\n        0%  { transform: scale(0.90); opacity: 0.7; }\n        50% { transform: scale(1.30); opacity: 1.0; }\n        100%{ transform: scale(0.90); opacity: 0.7; }\n    }\n\n    /* ══════════════════════════════════════════════\n       HUD SYSTEM BANNER\n    ══════════════════════════════════════════════ */\n    .hud-banner {\n        display: flex; flex-wrap: wrap; gap: 20px;\n        align-items: center; justify-content: space-between;\n        background: linear-gradient(90deg,\n            rgba(0,240,255,0.06) 0%,\n            rgba(139,92,246,0.04) 50%,\n            rgba(5,223,157,0.04) 100%);\n        border: 1px solid rgba(0,240,255,0.18);\n        border-radius: 10px;\n        padding: 10px 18px; margin: 12px 0;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 10.5px; color: #475569;\n        letter-spacing: 0.9px;\n    }\n    .hud-banner .status-val { color: #00f0ff; font-weight: 700; }\n\n    /* ══════════════════════════════════════════════\n       STATUS BADGES\n    ══════════════════════════════════════════════ */\n    .badge {\n        display: inline-flex; align-items: center; gap: 4px;\n        padding: 3px 10px; border-radius: 5px;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 10px; font-weight: 700;\n        letter-spacing: 1px; text-transform: uppercase;\n        border: 1px solid transparent;\n    }\n    .badge-DEFECT  { background: rgba(255,51,102,0.12);  color: #ff3366; border-color: rgba(255,51,102,0.35); }\n    .badge-PASS    { background: rgba(5,223,157,0.12);   color: #05df9d; border-color: rgba(5,223,157,0.35); }\n    .badge-UNCERTAIN{background: rgba(255,170,0,0.12);   color: #ffaa00; border-color: rgba(255,170,0,0.35); }\n    .badge-NOVEL   { background: rgba(191,90,242,0.12);  color: #bf5af2; border-color: rgba(191,90,242,0.35); }\n    .badge-CRITICAL{ background: rgba(255,51,102,0.12);  color: #ff3366; border-color: rgba(255,51,102,0.35); box-shadow:0 0 8px rgba(255,51,102,0.2); }\n    .badge-WARNING { background: rgba(255,170,0,0.12);   color: #ffaa00; border-color: rgba(255,170,0,0.35); box-shadow:0 0 8px rgba(255,170,0,0.2); }\n    .badge-OPTIMAL { background: rgba(5,223,157,0.12);   color: #05df9d; border-color: rgba(5,223,157,0.35); box-shadow:0 0 8px rgba(5,223,157,0.2); }\n    .badge-HIGH    { background: rgba(255,51,102,0.12);  color: #ff3366; border-color: rgba(255,51,102,0.35); }\n    .badge-MEDIUM  { background: rgba(255,170,0,0.12);   color: #ffaa00; border-color: rgba(255,170,0,0.35); }\n    .badge-LOW     { background: rgba(100,116,139,0.12); color: #94a3b8; border-color: rgba(100,116,139,0.35); }\n\n    /* ══════════════════════════════════════════════\n       EVIDENCE / ALERT CARDS\n    ══════════════════════════════════════════════ */\n    .evidence-box {\n        background: rgba(8,14,30,0.85);\n        border: 1px solid rgba(0,240,255,0.15);\n        border-left: 3px solid #00f0ff;\n        border-radius: 0 10px 10px 0;\n        padding: 14px 18px; margin-bottom: 10px;\n        box-shadow: 0 4px 20px rgba(0,0,0,0.4);\n        transition: all 0.2s ease;\n    }\n    .evidence-box:hover { transform: translateX(2px); }\n    .evidence-box.HIGH     { border-left-color: #ff3366; box-shadow: 0 4px 20px rgba(255,51,102,0.1); }\n    .evidence-box.CRITICAL { border-left-color: #ff3366; box-shadow: 0 4px 20px rgba(255,51,102,0.15); }\n    .evidence-box.MEDIUM   { border-left-color: #ffaa00; box-shadow: 0 4px 20px rgba(255,170,0,0.1); }\n    .evidence-box.WARNING  { border-left-color: #ffaa00; }\n    .evidence-box.LOW      { border-left-color: #334155; }\n    .evidence-box.OPTIMAL  { border-left-color: #05df9d; box-shadow: 0 4px 20px rgba(5,223,157,0.1); }\n\n    /* ══════════════════════════════════════════════\n       STAT CARD — Custom metric display component\n    ══════════════════════════════════════════════ */\n    .stat-card {\n        background: rgba(8,14,30,0.75);\n        border: 1px solid rgba(0,240,255,0.12);\n        border-top: 2px solid rgba(0,240,255,0.4);\n        border-radius: 12px;\n        padding: 16px 18px;\n        text-align: center;\n        transition: all 0.25s ease;\n    }\n    .stat-card:hover {\n        border-top-color: #00f0ff;\n        box-shadow: 0 0 20px rgba(0,240,255,0.12);\n    }\n    .stat-card .val {\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 1.8rem; font-weight: 700;\n        color: #f8fafc; line-height: 1.1;\n    }\n    .stat-card .lbl {\n        font-family: 'Rajdhani', sans-serif;\n        font-size: 11px; font-weight: 700;\n        letter-spacing: 1.5px; text-transform: uppercase;\n        color: #475569; margin-top: 4px;\n    }\n    .stat-card .sub {\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 10px; color: #334155; margin-top: 2px;\n    }\n\n    /* ══════════════════════════════════════════════\n       SECTION DIVIDER — Glowing line separator\n    ══════════════════════════════════════════════ */\n    .section-divider {\n        height: 1px;\n        background: linear-gradient(90deg,\n            transparent 0%,\n            rgba(0,240,255,0.3) 30%,\n            rgba(0,240,255,0.5) 50%,\n            rgba(0,240,255,0.3) 70%,\n            transparent 100%);\n        margin: 20px 0;\n        box-shadow: 0 0 8px rgba(0,240,255,0.2);\n    }\n\n    /* ══════════════════════════════════════════════\n       PROGRESS BAR — Custom utilisation bar\n    ══════════════════════════════════════════════ */\n    .util-bar-wrap {\n        background: rgba(0,240,255,0.06);\n        border: 1px solid rgba(0,240,255,0.1);\n        border-radius: 6px; height: 8px;\n        overflow: hidden; margin: 6px 0;\n    }\n    .util-bar-fill {\n        height: 100%; border-radius: 6px;\n        background: linear-gradient(90deg, #00f0ff, #0ea5e9);\n        box-shadow: 0 0 8px rgba(0,240,255,0.5);\n        transition: width 0.6s ease;\n    }\n    .util-bar-fill.danger {\n        background: linear-gradient(90deg, #ff3366, #ef4444);\n        box-shadow: 0 0 8px rgba(255,51,102,0.5);\n    }\n    .util-bar-fill.warn {\n        background: linear-gradient(90deg, #ffaa00, #f59e0b);\n        box-shadow: 0 0 8px rgba(255,170,0,0.5);\n    }\n\n    /* ══════════════════════════════════════════════\n       SPINNER\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stSpinner\"] { color: #00f0ff !important; }\n\n    /* ══════════════════════════════════════════════\n       ALERTS / INFO BOXES\n    ══════════════════════════════════════════════ */\n    [data-testid=\"stAlert\"] {\n        border-radius: 10px !important;\n        border: 1px solid rgba(0,240,255,0.2) !important;\n        background: rgba(8,14,30,0.8) !important;\n    }\n    [data-testid=\"stInfo\"] {\n        border-left: 3px solid #0ea5e9 !important;\n        background: rgba(14,165,233,0.08) !important;\n    }\n    [data-testid=\"stSuccess\"] {\n        border-left: 3px solid #05df9d !important;\n        background: rgba(5,223,157,0.08) !important;\n    }\n    [data-testid=\"stError\"] {\n        border-left: 3px solid #ff3366 !important;\n        background: rgba(255,51,102,0.08) !important;\n    }\n    [data-testid=\"stWarning\"] {\n        border-left: 3px solid #ffaa00 !important;\n        background: rgba(255,170,0,0.08) !important;\n    }\n</style>","StartLine":42,"TargetContent":"# ── Futuristic Cyber Industrial UI Styling ────────────────────────────────────\nst.markdown(\"\"\"\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');","TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\app.py","toolAction":"Replacing all CSS with premium design system","toolSummary":"Replace all CSS"}}]}
{"step_index":906,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T18:46:17Z","content":"Created At: 2026-09-20T00:16:17+05:30\nCompleted At: 2026-09-20T00:16:18+05:30\nThe following changes were made by the replace_file_content tool to: C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\app.py. If relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission.\n[diff_block_start]\n@@ -44,6 +44,500 @@\n <style>\n     @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n \n+    /* ══════════════════════════════════════════════\n+       GLOBAL CANVAS — Deep Space Industrial Theme\n+    ══════════════════════════════════════════════ */\n+    .stApp {\n+        background-color: #020817;\n+        background-image:\n+            radial-gradient(ellipse at 0% 0%, rgba(0,240,255,0.10) 0px, transparent 55%),\n+            radial-gradient(ellipse at 100% 0%, rgba(139,92,246,0.10) 0px, transparent 55%),\n+            radial-gradient(ellipse at 50% 100%, rgba(5,223,157,0.07) 0px, transparent 55%),\n+            linear-gradient(rgba(0,240,255,0.025) 1px, transparent 1px),\n+            linear-gradient(90deg, rgba(0,240,255,0.025) 1px, transparent 1px);\n+        background-size: 100% 100%, 100% 100%, 100% 100%, 40px 40px, 40px 40px;\n+        font-family: 'Rajdhani', -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n+        letter-spacing: 0.3px;\n+        color: #e2e8f0;\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       CUSTOM SCROLLBARS\n+    ══════════════════════════════════════════════ */\n+    ::-webkit-scrollbar { width: 5px; height: 5px; }\n+    ::-webkit-scrollbar-track { background: #020817; }\n+    ::-webkit-scrollbar-thumb { background: rgba(0,240,255,0.3); border-radius: 10px; }\n+    ::-webkit-scrollbar-thumb:hover { background: #00f0ff; box-shadow: 0 0 8px #00f0ff; }\n+\n+    /* ══════════════════════════════════════════════\n+       TYPOGRAPHY SYSTEM\n+    ══════════════════════════════════════════════ */\n+    h1, h2, h3 {\n+        font-family: 'Orbitron', sans-serif !important;\n+        font-weight: 700 !important;\n+        letter-spacing: 1px !important;\n+        color: #f8fafc !important;\n+        text-shadow: 0 0 30px rgba(0,240,255,0.2);\n+    }\n+    h4, h5, h6 {\n+        font-family: 'Rajdhani', sans-serif !important;\n+        font-weight: 700 !important;\n+        letter-spacing: 0.5px !important;\n+        color: #e2e8f0 !important;\n+    }\n+    p, span, label {\n+        color: #cbd5e1 !important;\n+    }\n+    [data-testid=\"stCaptionContainer\"], [data-testid=\"stCaptionContainer\"] p {\n+        color: #64748b !important;\n+        font-size: 12.5px !important;\n+    }\n+    strong, b { color: #f8fafc !important; }\n+\n+    /* ══════════════════════════════════════════════\n+       SIDEBAR — Dark Frosted Glass Panel\n+    ══════════════════════════════════════════════ */\n+    [data-testid=\"stSidebar\"] {\n+        background: linear-gradient(180deg, #050d1f 0%, #020817 100%) !important;\n+        border-right: 1px solid rgba(0,240,255,0.12) !important;\n+        box-shadow: 4px 0 24px rgba(0,0,0,0.5) !important;\n+    }\n+    [data-testid=\"stSidebar\"] * { color: #cbd5e1; }\n+    [data-testid=\"stSidebar\"] h3 {\n+        font-family: 'Orbitron', sans-serif !important;\n+        font-size: 13px !important;\n+        letter-spacing: 2px !important;\n+        color: #00f0ff !important;\n+        border-bottom: 1px solid rgba(0,240,255,0.2);\n+        padding-bottom: 8px !important;\n+        text-shadow: 0 0 12px rgba(0,240,255,0.5) !important;\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       HEADER BAR\n+    ══════════════════════════════════════════════ */\n+    [data-testid=\"stHeader\"] {\n+        background: rgba(2,8,23,0.85) !important;\n+        backdrop-filter: blur(16px) !important;\n+        border-bottom: 1px solid rgba(0,240,255,0.1) !important;\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       FROSTED GLASS CARDS\n+    ══════════════════════════════════════════════ */\n+    [data-testid=\"stVerticalBlockBorderWrapper\"] {\n+        background: rgba(8,14,30,0.75) !important;\n+        border: 1px solid rgba(0,240,255,0.14) !important;\n+        border-radius: 14px !important;\n+        backdrop-filter: blur(24px) !important;\n+        -webkit-backdrop-filter: blur(24px) !important;\n+        box-shadow:\n+            0 8px 32px rgba(0,0,0,0.6),\n+            inset 0 1px 0 rgba(0,240,255,0.12),\n+            inset 0 -1px 0 rgba(0,0,0,0.3) !important;\n+        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n+    }\n+    [data-testid=\"stVerticalBlockBorderWrapper\"]:hover {\n+        border-color: rgba(0,240,255,0.32) !important;\n+        box-shadow:\n+            0 16px 48px rgba(0,0,0,0.7),\n+            0 0 0 1px rgba(0,240,255,0.08),\n+            inset 0 1px 0 rgba(0,240,255,0.25) !important;\n+        transform: translateY(-1px);\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       NAVIGATION TABS\n+    ══════════════════════════════════════════════ */\n+    .stTabs [data-baseweb=\"tab-list\"] {\n+        gap: 6px;\n+        margin-bottom: 20px;\n+        background: rgba(8,14,30,0.8);\n+        padding: 5px 6px;\n+        border-radius: 12px;\n+        border: 1px solid rgba(0,240,255,0.15);\n+        box-shadow: inset 0 1px 0 rgba(0,240,255,0.08);\n+    }\n+    .stTabs [data-baseweb=\"tab\"] {\n+        font-family: 'Rajdhani', sans-serif !important;\n+        font-size: 14px;\n+        font-weight: 700;\n+        letter-spacing: 0.8px;\n+        padding: 9px 22px;\n+        border-radius: 8px;\n+        color: #64748b;\n+        border: 1px solid transparent;\n+        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n+        text-transform: uppercase;\n+    }\n+    .stTabs [data-baseweb=\"tab\"]:hover {\n+        color: #00f0ff;\n+        background: rgba(0,240,255,0.07);\n+        border-color: rgba(0,240,255,0.18);\n+    }\n+    .stTabs [aria-selected=\"true\"] {\n+        background: linear-gradient(135deg, rgba(0,240,255,0.18) 0%, rgba(59,130,246,0.15) 100%) !important;\n+        color: #00f0ff !important;\n+        border-color: rgba(0,240,255,0.42) !important;\n+        box-shadow: 0 0 20px rgba(0,240,255,0.18), inset 0 1px 0 rgba(0,240,255,0.3);\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       METRICS\n+    ══════════════════════════════════════════════ */\n+    [data-testid=\"stMetricValue\"] {\n+        font-family: 'JetBrains Mono', monospace !important;\n+        font-weight: 700 !important;\n+        font-size: 1.6rem !important;\n+        color: #f8fafc !important;\n+    }\n+    [data-testid=\"stMetricLabel\"] {\n+        font-family: 'Rajdhani', sans-serif !important;\n+        font-size: 11px !important;\n+        font-weight: 700 !important;\n+        letter-spacing: 1.2px !important;\n+        text-transform: uppercase !important;\n+        color: #475569 !important;\n+    }\n+    [data-testid=\"stMetricDelta\"] {\n+        font-family: 'JetBrains Mono', monospace !important;\n+        font-size: 12px !important;\n+    }\n+    [data-testid=\"stMetric\"] {\n+        background: rgba(8,14,30,0.6) !important;\n+        border: 1px solid rgba(0,240,255,0.1) !important;\n+        border-radius: 10px !important;\n+        padding: 12px 16px !important;\n+    }\n+\n+    /* ══════════════════════════════════════════════\n+       BUTTONS\n+    ══════════════════════════════════════════════ */\n+    .stButton > button {\n+        font-family: 'Rajdhani', sans-serif !important;\n+        font-weight: 700 !important;\n+        letter-spacing: 1px !important;\n+        text-transform: uppercase !important;\n+        border-radius: 8px !important;\n+     