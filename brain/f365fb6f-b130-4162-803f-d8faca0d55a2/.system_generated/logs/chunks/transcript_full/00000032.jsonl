501:     from modules.profitability import what_if\n502: \n503:     scrap_vals = np.linspace(0, 60, 20)\n504:     util_vals = np.linspace(0, 50, 20)\n505:     \n506:     Z = np.zeros((len(util_vals), len(scrap_vals)))\n507:     for i, u in enumerate(util_vals):\n508:         for j, s in enumerate(scrap_vals):\n509:             res = what_if(analysis, defect_sum, scrap_cost, downtime_cost, u, s, revenue_mult)\n510:             Z[i, j] = res.get('net_margin', 0)\n511: \n512:     # Calculate active point\n513:     cur_res = what_if(analysis, defect_sum, scrap_cost, downtime_cost, current_util_impr, current_scrap_redn, revenue_mult)\n514:     cur_z = cur_res.get('net_margin', 0)\n515: \n516:     # Executive Classy Colorscale: Deep Obsidian -> Cobalt -> Emerald -> Ice Cyan\n517:     colorscale = [\n518:         [0.0, \"#0b132b\"],\n519:         [0.25, \"#1c2541\"],\n520:         [0.5, \"#0284c7\"],\n521:         [0.75, \"#10b981\"],\n522:         [1.0, \"#38bdf8\"],\n523:     ]\n524: \n525:     fig = go.Figure()\n526: \n527:     # 3D Surface\n528:     fig.add_trace(go.Surface(\n529:         x=scrap_vals,\n530:         y=util_vals,\n531:         z=Z,\n532:         colorscale=colorscale,\n533:         showscale=True,\n534:         colorbar=dict(\n535:             title=dict(text=\"Net Margin ($)\", font=dict(color=\"#cbd5e1\", size=11, family=\"Plus Jakarta Sans\")),\n536:             tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n537:             len=0.7,\n538:             thickness=14,\n539:             outlinewidth=0,\n540:         ),\n541:         hovertemplate=\"Scrap Redn: %{x:.1f}%<br>Idle Redn: %{y:.1f}%<br>Margin: $%{z:,.0f}<extra></extra>\",\n542:         contours=dict(\n543:             z=dict(show=True, usecolormap=True, highlightcolor=\"#ffffff\", project_z=True)\n544:         ),\n545:         opacity=0.92,\n546:     ))\n547: \n548:     # Active Operating Point Marker\n549:     fig.add_trace(go.Scatter3d(\n550:         x=[current_scrap_redn],\n551:         y=[current_util_impr],\n552:         z=[cur_z],\n553:         mode=\"markers+text\",\n554:         marker=dict(\n555:             size=8,\n556:             color=\"#f43f5e\",\n557:             symbol=\"diamond\",\n558:             line=dict(color=\"#ffffff\", width=2)\n559:         ),\n560:         text=[f\"  Active Target: ${cur_z:,.0f}\"],\n561:         textposition=\"top center\",\n562:         textfont=dict(color=\"#f8fafc\", size=11, family=\"JetBrains Mono\"),\n563:         name=\"Operating Point\",\n564:         hovertemplate=\"<b>ACTIVE SELECTION</b><br>Scrap Redn: %{x:.1f}%<br>Idle Redn: %{y:.1f}%<br>Margin: $%{z:,.0f}<extra></extra>\"\n565:     ))\n566: \n567:     camera = dict(\n568:         eye=dict(x=1.55, y=-1.55, z=0.95),\n569:         center=dict(x=0, y=0, z=-0.1)\n570:     )\n571: \n572:     fig.update_layout(\n573:         title=dict(\n574:             text=\"3D Profitability Optimization Frontier (What-If Response Surface)\",\n575:             font=dict(size=14, color=\"#f8fafc\", family=\"Plus Jakarta Sans, sans-serif\"),\n576:         ),\n577:         scene=dict(\n578:             xaxis=dict(\n579:                 title=dict(text=\"Scrap Reduction (%)\", font=dict(color=\"#cbd5e1\", size=11)),\n580:                 tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n581:                 backgroundcolor=\"rgba(15, 23, 42, 0.4)\",\n582:                 gridcolor=\"rgba(148, 163, 184, 0.15)\",\n583:                 showbackground=True,\n584:             ),\n585:             yaxis=dict(\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
