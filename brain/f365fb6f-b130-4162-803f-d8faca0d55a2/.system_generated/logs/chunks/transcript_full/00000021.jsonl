gba(8,14,30,0.75) !important;\n        border: 1px solid rgba(0,240,255,0.14) !important;\n        border-radius: 14px !important;\n        backdrop-filter: blur(24px) !important;\n        -webkit-backdrop-filter: blur(24px) !important;\n        box-shadow:\n            0 8px 32px rgba(0,0,0,0.6),\n            inset 0 1px 0 rgba(0,240,255,0.12),\n            inset 0 -1px 0 rgba(0,0,0,0.3) !important;\n        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n    }\n    [data-testid=\"stVerticalBlockBorderWrapper\"]:hover {\n        border-color: rgba(0,240,255,0.32) !important;\n        box-shadow:\n            0 16px 48px rgba(0,0,0,0.7),\n            0 0 0 1px rgba(0,240,255,0.08),\n            inset 0 1px 0 rgba(0,240,255,0.25) !important;\n        transform: translateY(-1px);\n    }\n\n    /* ══════════════════════════════════════════════\n       NAVIGATION TABS\n    ══════════════════════════════════════════════ */\n    .stTabs [data-baseweb=\"tab-list\"] {\n        gap: 6px;\n        margin-bottom: 20px;\n        background: rgba(8,14,30,0.8);\n        padding: 5px 6px;\n        border-radius: 12px;\n        border: 1px solid rgba(0,240,255,0.15);\n        box-shadow: inset 0 1px 0 rgba(0,240,255,0.08);\n    }\n    .stTabs [data-baseweb=\"tab\"] {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-size: 14px;\n        font-weight: 700;\n        letter-spacing: 0.8px;\n        padding: 9px 22px;\n        border-radius: 8px;\n        color: #64748b;\n        border: 1px solid transparent;\n        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n        text-transform: uppercase;\n    }\n    .stTabs [data-baseweb=\"tab\"]:hover {\n        color: #00f0ff;\n        background: rgba(0,240,255,0.07);\n        border-color: rgba(0,240,255,0.18);\n    }\n    .stTabs [aria-selected=\"true\"] {\n        background: linear-gradient(135deg, rgba(0,240,255,0.18) 0%, rgba(59,130,246,0.15) 100%) !important;\n        color: #00f0ff !important;\n  