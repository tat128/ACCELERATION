('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n\n    /* Global Canvas */\n    .stApp {\n        background-color: #050711;\n        background-image: \n            radial-gradient(at 0% 0%, rgba(0, 240, 255, 0.08) 0px, transparent 50%),\n            radial-gradient(at 100% 0%, rgba(139, 92, 246, 0.08) 0px, transparent 50%),\n            radial-gradient(at 50% 100%, rgba(16, 185, 129, 0.05) 0px, transparent 50%);\n        font-family: 'Rajdhani', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n        letter-spacing: 0.2px;\n    }\n    \n    /* Typography */\n    h1, h2, h3 {\n        font-family: 'Orbitron', -apple-system, sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.8px !important;\n        color: #f8fafc !important;\n        text-shadow: 0 0 20px rgba(0, 240, 255, 0.15);\n    }\n    h4, h5, h6 {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.5px !important;\n        color: #e2e8f0 !important;\n    }\n\n    /* Sleek Container Cards */\n    [data-testid=\"stVerticalBlockBorderWrapper\"] {\n        background: rgba(11, 17, 33, 0.75) !important;\n        border: 1px solid rgba(0, 240, 255, 0.16) !important;\n        border-radius: 12px !important;\n        backdrop-filter: blur(16px) !important;\n        -webkit-backdrop-filter: blur(16px) !important;\n        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(0, 240, 255, 0.15) !important;\n        transition: border-color 0.3s ease, box-shadow 0.3s ease;\n    }\n    [data-testid=\"stVerticalBlockBorderWrapper\"]:hover {\n        border-color: rgba(0, 240, 255, 0.32) !important;\n        box-shadow: 0 10px 40px 0 rgba(0, 240, 255, 0.1), inset 0 1px 0 0 rgba(0, 240, 255, 0.25) !important;\n    }\n\n    /* Live Telemetry Pulse Dot */\n    .pulse-dot {\n        display: inline-block;\n        width: 8px;\n        height: 8px;\n        border-radius: 50%;\n        background-color: #00f0ff;\n        box-shadow: 0 0 10px #00f0ff;\n        animation: pulse_glow 2s infinite ease-in-out;\n        margin-right: 6px;\n        vertical-align: middle;\n    }\n    .pulse-dot.green {\n        background-color: #10b981;\n        box-shadow: 0 0 10px #10b981;\n    }\n    @keyframes pulse_glow {\n        0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 4px currentColor; }\n        50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 14px currentColor; }\n        100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 4px currentColor; }\n    }\n\n    /* HUD Banner */\n    .hud-banner {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 16px;\n        align-items: center;\n        justify-content: space-between;\n        background: linear-gradient(90deg, rgba(0, 240, 255, 0.08) 0%, rgba(139, 92, 246, 0.04) 100%);\n        border: 1px solid rgba(0, 240, 255, 0.22);\n        border-radius: 8px;\n        padding: 8px 16px;\n        margin: 10px 0;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 11px;\n        color: #94a3b8;\n        letter-spacing: 0.8px;\n    }\n    .hud-banner .status-val {\n        color: #00f0ff;\n        font-weight: 700;\n    }\n\n    /* Badges */\n    .badge {\n        display: inline-block;\n        padding: 3px 10px;\n        border-radius: 4px;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 11px;\n        font-weight: 700;\n        letter-spacing: 0.8px;\n        text-transform: uppercase;\n        border: 1px solid transparent;\n    }\n    .badge-DEFECT    { background: rgba(239, 68, 68, 0.15); color: #ff3366; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 0 10px rgba(239, 68, 68, 0.2); }\n    .badge-PASS      { background: rgba(16, 185, 129, 0.15); color: #05df9d; border-color: rgba(16, 185, 129, 0.4); box-shadow: 0 0 10px