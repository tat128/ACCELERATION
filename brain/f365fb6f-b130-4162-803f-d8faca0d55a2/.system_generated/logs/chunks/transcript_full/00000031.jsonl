mportant;\n        overflow: hidden !important;\n    }\n    details summary {\n        color: #94a3b8 !important;\n        font-family: 'Plus Jakarta Sans', sans-serif !important;\n        font-weight: 600 !important;\n        padding: 10px 0 !important;\n    }\n    details summary:hover { color: #38bdf8 !important; }\n\n    /* ══════════════════════════════════════════════\n       STATUS INDICATOR DOTS\n    ══════════════════════════════════════════════ */\n    .pulse-dot {\n        display: inline-block; width: 7px; height: 7px;\n        border-radius: 50%;\n        background: #38bdf8; box-shadow: 0 0 6px rgba(56, 189, 248, 0.6);\n        animation: pulse_glow 2.5s infinite ease-in-out;\n        margin-right: 6px; vertical-align: middle;\n    }\n    .pulse-dot.green  { background: #10b981; box-shadow: 0 0 6px rgba(16, 185, 129, 0.6); }\n    .pulse-dot.red    { background: #f43f5e; box-shadow: 0 0 6px rgba(244, 63, 94, 0.6); }\n    .pulse-dot.orange { background: #f59e0b; box-shadow: 0 0 6px rgba(245, 158, 11, 0.6); }\n    .pulse-dot.purple { background: #a855f7; box-shadow: 0 0 6px rgba(168, 85, 247, 0.6); }\n    @keyframes pulse_glow {\n        0%  { transform: scale(0.92); opacity: 0.8; }\n        50% { transform: scale(1.20); opacity: 1.0; }\n        100%{ transform: scale(0.92); opacity: 0.8; }\n    }\n\n    /* ══════════════════════════════════════════════\n       HUD TELEMETRY BANNER\n    ══════════════════════════════════════════════ */\n    .hud-banner {\n        display: flex; flex-wrap: wrap; gap: 16px;\n        align-items: center; justify-content: space-between;\n        background: linear-gradient(90deg,\n            rgba(56, 189, 248, 0.05) 0%,\n            rgba(99, 102, 241, 0.04) 50%,\n            rgba(16, 185, 129, 0.03) 100%);\n        border: 1px solid rgba(148, 163, 184, 0.12);\n        border-radius: 10px;\n        padding: 9px 16px; margin: 12px 0;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 11px; color: #64748b;\n