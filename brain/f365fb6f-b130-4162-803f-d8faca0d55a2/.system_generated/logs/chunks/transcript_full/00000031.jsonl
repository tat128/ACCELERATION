x; flex-wrap: wrap; gap: 16px;\n405:         align-items: center; justify-content: space-between;\n406:         background: linear-gradient(90deg,\n407:             rgba(56, 189, 248, 0.07) 0%,\n408:             rgba(99, 102, 241, 0.05) 50%,\n409:             rgba(16, 185, 129, 0.04) 100%);\n410:         border: 1px solid rgba(148, 163, 184, 0.14);\n411:         border-radius: 10px;\n412:         padding: 9px 16px; margin: 12px 0;\n413:         font-family: 'JetBrains Mono', monospace;\n414:         font-size: 11px; color: #64748b;\n415:         letter-spacing: 0.3px;\n416:         box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);\n417:     }\n418:     .hud-banner .status-val { color: #38bdf8; font-weight: 600; }\n419: \n420:     /* ══════════════════════════════════════════════\n421:        STATUS BADGES — Soft Classy Tones\n422:     ══════════════════════════════════════════════ */\n423:     .badge {\n424:         display: inline-flex; align-items: center; gap: 4px;\n425:         padding: 3px 9px; border-radius: 6px;\n426:         font-family: 'JetBrains Mono', monospace;\n427:         font-size: 10px; font-weight: 600;\n428:         letter-spacing: 0.5px; text-transform: uppercase;\n429:         border: 1px solid transparent;\n430:     }\n431:     .badge-DEFECT  { background: rgba(244, 63, 94, 0.14);  color: #fb7185; border-color: rgba(244, 63, 94, 0.3); }\n432:     .badge-PASS    { background: rgba(16, 185, 129, 0.14); color: #34d399; border-color: rgba(16, 185, 129, 0.3); }\n433:     .badge-UNCERTAIN{background: rgba(245, 158, 11, 0.14); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3); }\n434:     .badge-NOVEL   { background: rgba(168, 85, 247, 0.14); color: #c084fc; border-color: rgba(168, 85, 247, 0.3); }\n435:     .badge-CRITICAL{ background: rgba(244, 63, 94, 0.14);  color: #fb7185; border-color: rgba(244, 63, 94, 0.35); }\n436:     .badge-WARNING { background: rgba(245, 158, 11, 0.14); color: #fbbf24; border-color: rgba(245, 158, 11, 0.35); }\n437:     .badge-OPTIMAL { background: rgba(16, 185, 129, 0.14); color: #34d399; border-color: rgba(16, 185, 129, 0.35); }\n438:     .badge-HIGH    { background: rgba(244, 63, 94, 0.14);  color: #fb7185; border-color: rgba(244, 63, 94, 0.3); }\n439:     .badge-MEDIUM  { background: rgba(245, 158, 11, 0.14); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3); }\n440:     .badge-LOW     { background: rgba(100, 116, 139, 0.14);color: #94a3b8; border-color: rgba(100, 116, 139, 0.3); }\n441: \n442:     /* ══════════════════════════════════════════════\n443:        EVIDENCE & ALERT CARDS\n444:     ══════════════════════════════════════════════ */\n445:     .evidence-box {\n446:         background: linear-gradient(145deg, rgba(18, 27, 46, 0.8) 0%, rgba(10, 16, 30, 0.85) 100%);\n447:         border: 1px solid rgba(148, 163, 184, 0.14);\n448:         border-left: 3.5px solid #38bdf8;\n449:         border-radius: 0 10px 10px 0;\n450:         padding: 14px 18px; margin-bottom: 12px;\n451:         box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);\n452:         transition: all 0.2s ease;\n453:     }\n454:     .evidence-box:hover { transform: translateX(3px); }\n455:     .evidence-box.HIGH     { border-left-color: #f43f5e; }\n456:     .evidence-box.CRITICAL { border-left-color: #f43f5e; }\n457:     .evidence-box.MEDIUM   { border-left-color: #f59e0b; }\n458:     .evidence-box.WARNING  { border-left-color: #f59e0b; }\n459:     .evidence-box.LOW      { border-left-color: #475569; }\n460:     .evidence-box.OPTIMAL  { border-left-color: #10b981; }\n461: \n462:     /* ══════════════════════════════════════════════\n463:        EXECUTIVE STAT CARDS\n464:     ══════════════════════════════════════════════ */\n465:     .stat-card {\n466:         background: linear-gradient(180deg, rgba(22, 33, 54, 0.65) 0%, rgba(10, 15, 28, 0.85) 100%);\n467:         border: 1px solid rgba(148, 163, 184, 0.14);\n468:         border-top: 3px solid #38bdf8;\n469:         border-radius: 12px;\n470:         padding: