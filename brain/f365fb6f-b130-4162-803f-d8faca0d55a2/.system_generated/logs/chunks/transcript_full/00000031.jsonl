    overflow: hidden; margin: 6px 0;\n520:     }\n521:     .util-bar-fill {\n522:         height: 100%; border-radius: 6px;\n523:         background: linear-gradient(90deg, #38bdf8, #0284c7);\n524:         transition: width 0.5s ease;\n525:     }\n526:     .util-bar-fill.danger { background: linear-gradient(90deg, #f43f5e, #e11d48); }\n527:     .util-bar-fill.warn   { background: linear-gradient(90deg, #f59e0b, #d97706); }\n528:     .util-bar-fill.safe   { background: linear-gradient(90deg, #10b981, #059669); }\n529: \n530:     /* ══════════════════════════════════════════════\n531:        ALERTS & TOASTS\n532:     ══════════════════════════════════════════════ */\n533:     [data-testid=\"stSpinner\"] { color: #38bdf8 !important; }\n534:     [data-testid=\"stAlert\"] {\n535:         border-radius: 10px !important;\n536:         border: 1px solid rgba(148, 163, 184, 0.15) !important;\n537:         background: rgba(13, 19, 33, 0.8) !important;\n538:     }\n539:     [data-testid=\"stInfo\"] {\n540:         border-left: 3px solid #38bdf8 !important;\n541:         background: rgba(56, 189, 248, 0.05) !important;\n542:     }\n543:     [data-testid=\"stSuccess\"] {\n544:         border-left: 3px solid #10b981 !important;\n545:         background: rgba(16, 185, 129, 0.05) !important;\n546:     }\n547:     [data-testid=\"stError\"] {\n548:         border-left: 3px solid #f43f5e !important;\n549:         background: rgba(244, 63, 94, 0.05) !important;\n550:     }\n551:     [data-testid=\"stWarning\"] {\n552:         border-left: 3px solid #f59e0b !important;\n553:         background: rgba(245, 158, 11, 0.05) !important;\n554:     }\n555: </style>\n556: \"\"\", unsafe_allow_html=True)\n557: \n558: # ─────────────────────────────────────────────────────────────────────────────\n559: # Session State Initialization\n560: # ─────────────────────────────────────────────────────────────────────────────\n561: if 'registry' not in st.session_state:\n562:     st.session_state.registry 