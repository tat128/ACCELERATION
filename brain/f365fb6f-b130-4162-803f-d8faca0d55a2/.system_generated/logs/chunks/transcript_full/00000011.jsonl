{"step_index":588,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T16:23:34Z","content":"Created At: 2026-09-19T21:53:34+05:30\nCompleted At: 2026-09-19T21:53:34+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/production_analyzer.py`\nTotal Lines: 168\nTotal Bytes: 6808\nShowing lines 1 to 168\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Production-flow analyser.\n3: \n4: Reads Rockwell Arena simulation CSVs (Models 1–3) and applies\n5: Theory of Constraints (TOC) to identify bottleneck stations,\n6: quantify throughput gaps, and compare models.\n7: \"\"\"\n8: from __future__ import annotations\n9: \n10: import io\n11: from typing import Optional\n12: \n13: import numpy as np\n14: import pandas as pd\n15: \n16: from utils.constants import STATION_COLS, DEMAND_COLS, PARTS_COLS, PPH_COLS\n17: \n18: \n19: # ── Helpers ───────────────────────────────────────────────────────────────────\n20: \n21: def _find_col(df: pd.DataFrame, candidates: list[str]) -> Optional[str]:\n22:     \"\"\"Return the first candidate column name that exists in df.\"\"\"\n23:     for c in candidates:\n24:         if c in df.columns:\n25:             return c\n26:     return None\n27: \n28: \n29: def _safe_mean(series) -> float:\n30:     try:\n31:         return float(series.mean())\n32:     except Exception:\n33:         return 0.0\n34: \n35: \n36: # ── Loading ───────────────────────────────────────────────────────────────────\n37: \n38: def load_csv(file_or_path) -> tuple[pd.DataFrame | None, str | None]:\n39:     \"\"\"Load a model CSV and return (DataFrame, error).\"\"\"\n40:     try:\n41:         if hasattr(file_or_path, 'read'):\n42:             # Streamlit UploadedFile — read bytes then wrap\n43:             raw = file_or_path.read()\n44:             df = pd.read_csv(io.BytesIO(raw))\n45:         else:\n46:             df = pd.read_csv(file_or_path)\n47:         df.columns = df.columns.str.strip()\n48:         return df, None\n49:     except Exception as exc:\n50:         return None, str(exc)\n51: \n52: \n53: # ── Core Analysis ─────────────────────────────────────────────────────────────\n54: \n55: def analyze(df: pd.DataFrame) -> dict | None:\n56:     \"\"\"\n57:     Analyse a single model's simulation DataFrame.\n58: \n59:     Returns a dict with:\n60:         stations          dict  station → {utilization, waiting_time}\n61:         bottleneck_station str\n62:         bottleneck_util   float  (0–1)\n63:         bottleneck_wait   float  (minutes)\n64:         demand            float\n65:         total_parts       float\n66:         parts_per_hour    float\n67:         throughput_efficiency float  (%)\n68:         throughput_gap    float\n69:         raw_means         dict  column → mean value\n70:     \"\"\"\n71:     row = df.mean(numeric_only=True).to_dict()\n72: \n73:     # ── Resolve demand / throughput columns ───────────────────────────────────\n74:     demand_col = _find_col(df, DEMAND_COLS)\n75:     parts_col  = _find_col(df, PARTS_COLS)\n76:     pph_col    = _find_col(df, PPH_COLS)\n77: \n78:     demand       = row.get(demand_col,   0.0) if demand_col else 0.0\n79:     total_parts  = row.get(parts_col,    0.0) if parts_col  else 0.0\n80:     parts_per_hr = row.get(pph_col,      0.0) if pph_col    else 0.0\n81: \n82:     # ── Resolve station utilisation / waiting columns ─────────────────────────\n83:     station_metrics: dict[str, dict] = {}\n84: \n85:     for station, col_groups in STATION_COLS.items():\n86:         util_col = _find_col(df, col_groups['util'])\n87:         wait_col = _find_col(df, col_groups['wait'])\n88: \n89:         if util_col is None:\n90:             continue  # station not in this model's CSV\n91: \n92:         raw_util = row.get(util_col, 0.0)\n93:         # Normalise: some CSVs store 0-1, others 0-100\n94:         util = raw_util / 100.0 if raw_util > 1.5 else raw_util\n95:         wait = row.get(wait_col, 0.0) if wait_col else 0.0\n96: \n97:         station_metrics[station] = {\n98:             'utilization':  round(float(util), 4),\n99:             'waiting_time': round(float(wait), 2),\n100:         }\n101: \n102:     if not station_metrics:\n103:         return None\n104: \n105:     # ── Identify bottleneck (highest utilisation) ─────────────────────────────\n106:     bottleneck = max(station_metrics.items(), key=lambda x: x[1]['utilization'])\n107: \n108:     # ── Throughput KPIs ───────────────────────────────────────────────────────\n109:     throughput_eff = (total_parts / demand * 100) if demand > 0 else 0.0\n110:     throughput_gap = max(demand - total_parts, 0.0)\n111: \n112:     return {\n113:         'stations':            station_metrics,\n114:         'bottleneck_station':  bottleneck[0],\n115:         'bottleneck_util':     bottleneck[1]['utilization'],\n116:         'bottleneck_wait':     bottleneck[1]['waiting_time'],\n117:         'demand':              round(demand, 1),\n118:         'total_parts':         round(total_parts, 1),\n119:         'parts_per_hour':      round(parts_per_hr, 1),\n120:         'throughput_efficiency': round(throughput_eff, 2),\n121:         'throughput_gap':      round(throughput_gap, 1),\n122:         'raw_means':           {k: round(v, 4) for k, v in row.items()},\n123:     }\n124: \n125: \n126: # ── Multi-model comparison ────────────────────────────────────────────────────\n127: \n128: def compare_models(analyses: dict[str, dict | None]) -> pd.DataFrame:\n129:     \"\"\"\n130:     Return a summary DataFrame comparing all loaded models.\n131: \n132:     Columns: Model, Demand, Parts Produced, Parts/Hour, Throughput %,\n133:              Throughput Gap, Bottleneck, Bottleneck Util (%)\n134:     \"\"\"\n135:     rows = []\n136:     for name, a in analyses.items():\n137:         if a is None:\n138:             continue\n139:         bn_station = a['bottleneck_station']\n140:         rows.append({\n141:             'Model':              name,\n142:             'Demand':             a['demand'],\n143:             'Parts Produced':     a['total_parts'],\n144:             'Parts/Hour':         a['parts_per_hour'],\n145:             'Throughput %':       a['throughput_efficiency'],\n146:             'Throughput Gap':     a['throughput_gap'],\n147:             'Bottleneck Station': bn_station,\n148:             'Bottleneck Util %':  round(a['bottleneck_util'] * 100, 1),\n149:             'Bottleneck Wait (min)': a['bottleneck_wait'],\n150:         })\n151:     return pd.DataFrame(rows) if rows else pd.DataFrame()\n152: \n153: \n154: # ── WIP Estimate ──────────────────────────────────────────────────────────────\n155: \n156: def estimate_wip(analysis: dict) -> dict[str, float]:\n157:     \"\"\"\n158:     Rough WIP estimate per station using Little's Law:\n159:         WIP ≈ arrival_rate × waiting_time\n160:     arrival_rate = parts_per_hour / 60  (parts/min)\n161:     \"\"\"\n162:     pph  = analysis.get('parts_per_hour', 0)\n163:     rate = pph / 60.0\n164:     wip  = {}\n165:     for station, data in analysis['stations'].items():\n166:         wip[station] = round(rate * data['waiting_time'], 1)\n167:     return wip\n168: \nThe above content shows the entire, complete file contents of the requested file.\n"}
