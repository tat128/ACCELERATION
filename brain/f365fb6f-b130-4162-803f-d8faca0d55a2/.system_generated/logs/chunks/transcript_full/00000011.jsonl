{"step_index":564,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T16:22:24Z","content":"Created At: 2026-09-19T21:52:24+05:30\nCompleted At: 2026-09-19T21:52:25+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/defect_detector.py`\nTotal Lines: 437\nTotal Bytes: 16674\nShowing lines 380 to 437\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n380: \n381: # ── Bounding Box HUD Annotator ────────────────────────────────────────────────\n382: \n383: def annotate_boxes_hud(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n384:     \"\"\"Draws bounding boxes around localized defect regions.\"\"\"\n385:     w, h = img.size\n386:     overlay = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n387:     draw_overlay = ImageDraw.Draw(overlay)\n388:     draw = ImageDraw.Draw(img)\n389: \n390:     for det in detections:\n391:         bbox = det.get('bbox')\n392:         dtype = det['defect_type'].lower()\n393:         if bbox is None or dtype in ('normal', 'acceptable', 'pass'):\n394:             continue\n395: \n396:         x1, y1, x2, y2 = [int(v) for v in bbox]\n397:         color_hex = DEFECT_COLORS.get(dtype, '#e74c3c')\n398:         c_rgb = tuple(int(color_hex.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))\n399:         \n400:         draw_overlay.rectangle([x1, y1, x2, y2], fill=c_rgb + (40,))\n401:         box_thickness = max(2, int(min(w, h) / 200))\n402:         draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n403: \n404:         # Tag\n405:         label = f\" {dtype.upper()} {det['confidence']*100:.0f}% \"\n406:         try:\n407:             font = ImageFont.truetype(\"arialbd.ttf\", max(10, int(min(w, h) / 50)))\n408:         except Exception:\n409:             font = ImageFont.load_default()\n410: \n411:         lbl_y1 = max(0, y1 - 18)\n412:         draw.rectangle([x1, lbl_y1, x1 + len(label)*7, y1], fill=color_hex)\n413:         draw.text((x1 + 2, lbl_y1 + 1), label, fill='white', font=font)\n414: \n415:     return Image.alpha_composite(img.convert('RGBA'), overlay).convert('RGB')\n416: \n417: \n418: # ── Heatmap Overlay ───────────────────────────────────────────────────────────\n419: \n420: def generate_heatmap_overlay(\n421:     img: Image.Image,\n422:     cam: np.ndarray | None,\n423:     status: str,\n424:     defect_type: str,\n425: ) -> Image.Image:\n426:     \"\"\"Creates a smooth thermal activation heatmap overlay on the original image.\"\"\"\n427:     if cam is None or status == 'PASS':\n428:         return img\n429: \n430:     img_rgb = np.array(img.convert('RGB'))\n431:     cam_uint = np.uint8(np.clip(cam * 255, 0, 255))\n432:     heatmap_color = cv2.applyColorMap(cam_uint, cv2.COLORMAP_JET)\n433:     heatmap_color = cv2.cvtColor(heatmap_color, cv2.COLOR_BGR2RGB)\n434: \n435:     blended = cv2.addWeighted(img_rgb, 0.65, heatmap_color, 0.35, 0)\n436:     return Image.fromarray(blended)\n437: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
