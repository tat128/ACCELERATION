{"step_index":993,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T19:09:01Z","content":"Created At: 2026-09-20T00:39:01+05:30\nCompleted At: 2026-09-20T00:39:02+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/utils/chart_helpers.py`\nTotal Lines: 436\nTotal Bytes: 17787\nShowing lines 300 to 436\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n300:             barmode='group',\n301:             title=dict(text='Net Margin Delta — Baseline vs What-If Optimization', font=dict(size=14, color='#f8fafc')),\n302:             yaxis=dict(title='Net Operating Margin ($)'),\n303:             height=320,\n304:         )\n305:     )\n306:     return fig\n307: \n308: \n309: # ── ANN Surrogate & Digital Twin Charts ───────────────────────────────────────\n310: \n311: def ann_prediction_gauge(val: float, title: str, threshold: float = 0.85) -> go.Figure:\n312:     \"\"\"Renders a high-tech cyberpunk gauge for ANN predicted station load.\"\"\"\n313:     pct = val * 100.0 if val <= 1.0 else val\n314:     thresh_pct = threshold * 100.0 if threshold <= 1.0 else threshold\n315:     bar_color = _CYBER['red'] if pct >= thresh_pct else (_CYBER['orange'] if pct >= thresh_pct * 0.85 else _CYBER['cyan'])\n316: \n317:     fig = go.Figure(go.Indicator(\n318:         mode=\"gauge+number+delta\",\n319:         value=pct,\n320:         number=dict(suffix=\"%\", font=dict(color='#f8fafc', size=24)),\n321:         delta=dict(reference=thresh_pct, increasing=dict(color=_CYBER['red']), decreasing=dict(color=_CYBER['green'])),\n322:         title=dict(text=title, font=dict(color='#cbd5e1', size=13)),\n323:         gauge=dict(\n324:             axis=dict(range=[0, 100], tickwidth=1, tickcolor=\"#64748b\", tickfont=dict(color=\"#94a3b8\", size=10)),\n325:             bar=dict(color=bar_color, thickness=0.35),\n326:             bgcolor=\"rgba(15, 23, 42, 0.6)\",\n327:             borderwidth=1,\n328:             bordercolor=\"rgba(0, 240, 255, 0.2)\",\n329:             steps=[\n330:                 dict(range=[0, thresh_pct * 0.75], color=\"rgba(5, 223, 157, 0.15)\"),\n331:                 dict(range=[thresh_pct * 0.75, thresh_pct], color=\"rgba(255, 170, 0, 0.15)\"),\n332:                 dict(range=[thresh_pct, 100], color=\"rgba(255, 51, 102, 0.25)\"),\n333:             ],\n334:             threshold=dict(\n335:                 line=dict(color=_CYBER['red'], width=3),\n336:                 thickness=0.8,\n337:                 value=thresh_pct\n338:             )\n339:         )\n340:     ))\n341:     fig.update_layout(\n342:         paper_bgcolor=_BG,\n343:         plot_bgcolor=_BG,\n344:         font=dict(color='#e2e8f0', family='-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace'),\n345:         margin=dict(t=30, b=10, l=20, r=20),\n346:         height=190\n347:     )\n348:     return fig\n349: \n350: \n351: def ann_sweep_curve(sweep_x: list, sweep_y: list, output_names: list, current_input: float = None, title: str = \"Neural Metamodel Response Curve\") -> go.Figure:\n352:     \"\"\"Plots multi-output surrogate response curves across parameter sweep.\"\"\"\n353:     fig = go.Figure()\n354:     colors = [_CYBER['cyan'], _CYBER['green'], _CYBER['purple'], _CYBER['orange'], _CYBER['yellow']]\n355: \n356:     import numpy as np\n357:     y_arr = np.array(sweep_y)\n358:     if y_arr.ndim == 1:\n359:         y_arr = y_arr.reshape(-1, 1)\n360: \n361:     for i, name in enumerate(output_names):\n362:         col_color = colors[i % len(colors)]\n363:         series_y = y_arr[:, i] * 100.0 if np.max(y_arr[:, i]) <= 1.0 else y_arr[:, i]\n364:         fig.add_trace(go.Scatter(\n365:             x=sweep_x,\n366:             y=series_y,\n367:             mode='lines',\n368:             name=name,\n369:             line=dict(color=col_color, width=2.5),\n370:             hovertemplate=f\"Input: %{{x:.1f}}<br>{name}: %{{y:.2f}}%<extra></extra>\"\n371:         ))\n372: \n373:     # Threshold line\n374:     fig.add_hline(\n375:         y=85.0, line_dash=\"dash\", line_color=_CYBER['red'],\n376:         annotation_text=\"85% Bottleneck Limit\", annotation_font=dict(color=_CYBER['red'], size=11),\n377:         annotation_position=\"top right\"\n378:     )\n379: \n380:     if current_input is not None:\n381:         fig.add_vline(\n382:             x=current_input, line_dash=\"dot\", line_color=\"#ffffff\",\n383:             annotation_text=f\"Current: {current_input:.1f}\", annotation_font=dict(color=\"#ffffff\", size=10),\n384:             annotation_position=\"bottom right\"\n385:         )\n386: \n387:     fig.update_layout(\n388:         **_base_layout(\n389:             title=dict(text=title, font=dict(size=14, color='#f8fafc')),\n390:             xaxis=dict(title='Input Parameter Value'),\n391:             yaxis=dict(title='Predicted Output / Utilization (%)'),\n392:             height=340,\n393:             legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n394:         )\n395:     )\n396:     return fig\n397: \n398: \n399: def ann_validation_scatter(y_true: list, y_pred: list, title: str = \"Arena Simulation vs ANN Surrogate\", r2: float = 0.0) -> go.Figure:\n400:     \"\"\"Plots actual Rockwell Arena simulation observations vs ANN surrogate predictions.\"\"\"\n401:     import numpy as np\n402:     fig = go.Figure()\n403: \n404:     # Scatter points\n405:     fig.add_trace(go.Scatter(\n406:         x=y_true,\n407:         y=y_pred,\n408:         mode='markers',\n409:         name='Observations',\n410:         marker=dict(color=_CYBER['cyan'], size=6, opacity=0.75, line=dict(color='#ffffff', width=0.5)),\n411:         hovertemplate=\"Actual: %{x:.4f}<br>Predicted: %{y:.4f}<extra></extra>\"\n412:     ))\n413: \n414:     # Ideal 1:1 diagonal line\n415:     min_val = min(min(y_true), min(y_pred))\n416:     max_val = max(max(y_true), max(y_pred))\n417:     fig.add_trace(go.Scatter(\n418:         x=[min_val, max_val],\n419:         y=[min_val, max_val],\n420:         mode='lines',\n421:         name='Ideal Parity (y=x)',\n422:         line=dict(color=_CYBER['green'], dash='dash', width=2)\n423:     ))\n424: \n425:     fig.update_layout(\n426:         **_base_layout(\n427:             title=dict(text=f\"{title} (R² = {r2:.4f})\", font=dict(size=14, color='#f8fafc')),\n428:             xaxis=dict(title='Rockwell Arena Actual Metric'),\n429:             yaxis=dict(title='ANN Surrogate Metamodel Prediction'),\n430:             height=330,\n431:             legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n432:         )\n433:     )\n434:     return fig\n435: \n436: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
