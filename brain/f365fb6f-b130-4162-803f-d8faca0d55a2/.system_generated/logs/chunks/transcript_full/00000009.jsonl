= file_or_path.read()\n44:             df = pd.read_csv(io.BytesIO(raw))\n45:         else:\n46:             df = pd.read_csv(file_or_path)\n47:         df.columns = df.columns.str.strip()\n48:         return df, None\n49:     except Exception as exc:\n50:         return None, str(exc)\n51: \n52: \n53: # ── Core Analysis ─────────────────────────────────────────────────────────────\n54: \n55: def analyze(df: pd.DataFrame) -> dict | None:\n56:     \"\"\"\n57:     Analyse a single model's simulation DataFrame.\n58: \n59:     Returns a dict with:\n60:         stations          dict  station → {utilization, waiting_time}\n61:         bottleneck_station str\n62:         bottleneck_util   float  (0–1)\n63:         bottleneck_wait   float  (minutes)\n64:         demand            float\n65:         total_parts       float\n66:         parts_per_hour    float\n67:         throughput_efficiency float  (%)\n68:         throughput_gap    float\n69:         raw_means         dict  column → mean value\n70:     \"\"\"\n71:     row = df.mean(numeric_only=True).to_dict()\n72: \n73:     # ── Resolve demand / throughput columns ───────────────────────────────────\n74:     demand_col = _find_col(df, DEMAND_COLS)\n75:     parts_col  = _find_col(df, PARTS_COLS)\n76:     pph_col    = _find_col(df, PPH_COLS)\n77: \n78:     demand       = row.get(demand_col,   0.0) if demand_col else 0.0\n79:     total_parts  = row.get(parts_col,    0.0) if parts_col  else 0.0\n80:     parts_per_hr = row.get(pph_col,      0.0) if pph_col    else 0.0\n81: \n82:     # ── Resolve station utilisation / waiting columns ─────────────────────────\n83:     station_metrics: dict[str, dict] = {}\n84: \n85:     for station, col_groups in STATION_COLS.items():\n86:         util_col = _find_col(df, col_groups['util'])\n87:         wait_col = _find_col(df, col_groups['wait'])\n88: \n89:         if util_col is None:\n90:             continue  # station not in this model's CSV\n91: \n92:         raw_util = row.get(util_col, 0.0)\n93:         # Normalise: some CSVs store 0-1, others 0-100\n94:         util = raw_util / 100.0 if raw_util > 1.5 else raw_util\n95:         wait = row.get(wait_col, 0.0) if wait_col else 0.0\n96: \n97:         station_metrics[station] = {\n98:             'utilization':  round(float(util), 4),\n99:             'waiting_time': round(float(wait), 2),\n100:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
