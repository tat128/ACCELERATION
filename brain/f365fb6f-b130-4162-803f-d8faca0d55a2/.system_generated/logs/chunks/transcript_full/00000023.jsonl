['crack', 'scratch'],\n79:         'cause': 'Drilling station overloaded — tool vibration / wear',\n80:         'evidence': 'Drilling Utilisation > 85%',\n81:         'action': 'Inspect drill bits; reduce feed rate by 10%; schedule preventive maintenance.',\n82:         'confidence': 'HIGH',\n83:     },\n84:     {\n85:         'id': 'MILLING_HIGH_UTIL',\n86:         'condition': lambda r: r.get('Milling Util', 0) > 0.85,\n87:         'defects': ['crack', 'scratch'],\n88:         'cause': 'Milling station overloaded — thermal stress / coolant insufficiency',\n89:         'evidence': 'Milling Utilisation > 85%',\n90:         'action': 'Increase coolant flow rate; add milling capacity buffer; inspect spindle bearings.',\n91:         'confidence': 'HIGH',\n92:     },\n93:     {\n94:         'id': 'ASSEMBLY_HIGH_UTIL',\n95:         'condition': lambda r: r.get('Assembly Util', 0) > 0.85,\n96:         'defects': ['scratch', 'hole'],\n97:         'cause': 'Assembly station overloaded — rushed handling causes surface damage',\n98:         'evidence': 'Assembly Utilisation > 85%',\n99:         'action': 'Reduce WIP upstream; cross-train additional assembly operator; add buffer stock.',\n100:         'confidence': 'HIGH',\n101:     },\n102:     {\n103:         'id': 'DRILL_LONG_WAIT',\n104:         'condition': lambda r: r.get('Drilling Waiting Time', 0) > 15,\n105:         'defects': ['crack'],\n106:         'cause': 'Parts waiting long at drilling — thermal cycling causes micro-cracks',\n107:         'evidence': 'Drilling Waiting Time > 15 min',\n108:         'action': 'Balance batch size entering drilling; investigate tool changeover frequency.',\n109:         'confidence': 'MEDIUM',\n110:     },\n111:     {\n112:         'id': 'MILLING_LONG_WAIT',\n113:         'condition': lambda r: r.get('Milling Waiting Time', 0) > 12,\n114:         'defects': ['rust', 'scratch'],\n115:         'cause': 'WIP piling upstream of milling — surface oxidation during extended idle time',\n11