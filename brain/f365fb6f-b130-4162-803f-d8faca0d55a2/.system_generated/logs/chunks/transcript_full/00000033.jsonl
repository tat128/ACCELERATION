ng process line overloads with physical defect manifestations.\")\n977:             with rc_top2:\n978:                 rc_model = st.selectbox(\n979:                     \"Baseline Model\",\n980:                     list(analyses.keys()) if analyses else ['No model loaded'],\n981:                     key='rc_model_sel',\n982:                 )\n983:             \n984:             rc_analysis   = analyses.get(rc_model) if analyses else None\n985:             rc_defect_sum = registry.summary() if not no_quality else None\n986:             evidence      = correlate(rc_analysis, rc_defect_sum)\n987: \n988:             if not evidence:\n989:                 st.success(\"No critical process-quality correlations detected under current operating conditions.\")\n990:             else:\n991:                 for card in evidence:\n992:                     conf  = card['confidence']\n993:                     obs   = card['defect_observed']\n994:                     cls   = conf\n995:                     html = f\"\"\"\n996: <div class=\"evidence-box {cls}\">\n997:   <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;\">\n998:     <b>PROBABLE CAUSE: {card['cause']}</b>\n999:     <span class=\"badge badge-{conf}\">{conf} CONFIDENCE</span>\n1000:   </div>\n1001:   <small><b>Telemetry Evidence:</b> {card['evidence']} &nbsp;|&nbsp; <b>Defects:</b> {', '.join(card['related_defects']) if card['related_defects'] else 'General bottleneck'}\n1002:   {'&nbsp; <span class=\"badge badge-DEFECT\">OBSERVED IN BATCH</span>' if obs else ''}</small><br>\n1003:   <small style=\"color:#cbd5e1;\"><b>Corrective Action:</b> {card['action']}</small>\n1004: </div>\n1005: \"\"\"\n1006:                     st.markdown(html, unsafe_allow_html=True)\n1007: \n1008:         # Drift & OOD Review Blocks in 2 clean columns\n1009:         col_dr1, col_dr2 = st.columns(2)\n1010:         with col_dr1:\n1011:             with st.container(border=True):\n1012:                 st.markdown(\"#### Batch-to-Batch Defect Drift\")\n1013:                 if no_quality or len(registry) < 2:\n1014:                     st.info(\"Inspect at least 2 units in Tab 1 to track process drift.\")\n1015:                 else:\n1016:                     drift_df_raw = registry.drift_dataframe()\n1017:                     drift        = drift_analysis(drift_df_raw)\n1018:                     if drift:\n1019:                         d1, d2 = st.columns(2)\n1020:                         d1.metric(\"Drift Trajectory\", drift['trend'])\n1021:                         d2.metric(\"Drift Rate\", f\"{drift['slope']:+.2f} pp/unit\")\n1022:                         st.plotly_chart(defect_trend(drift['df']), use_container_width=True, key=\"rootcause_defect_trend_chart\")\n1023: \n1024:         with col_dr2:\n1025:             with st.container(border=True):\n1026:                 st.markdown(\"#### Out-of-Distribution (OOD) Review\")\n1027:                 if not no_quality:\n1028:                     flagged = flag_novel(registry.to_dataframe())\n1029:                     if not flagged.empty:\n1030:                         st.warning(f\"**{len(flagged)} Novel / Uncertain Unit(s)** — Flagged for review.\")\n1031:                         st.dataframe(flagged[['unit_id', 'image_name', 'defect_type', 'confidence', 'status']], use_container_width=True, height=220)\n1032:                     else:\n1033:                         st.success(\"All inspected units within high-confidence neural boundary.\")\n1034:                 else:\n1035:                     st.info(\"No inspection telemetry available yet.\")\n1036: \n1037: # ═════════════════════════════════════════════════════════════════════════════\n1038: # TAB 4 — PROFITABILITY & RECOMMENDATIONS\n1039: # ═════════════════════════════════════════════════════════════════════════════\n1040: with tab4:\n1041:     if not analyses:\n1042:         st.info(\"Upload production CSV or Excel datasets in the sidebar to activate the financial engine.\")\n1043:     else:\n1044:         with st.container(border=True):\n1045:             fin_top1, fin_top2 = st.columns([2, 1])\n1046:             with fin_top1:\n1047:                 st.markdown(\"#### Economic Impact & Loss Waterfall\")\n1048:                 st.caption(\"Financial translation of scrap losses, bottleneck idle time, and opportunity costs.\")\n1049:             with fin_top2:\n1050:                 fin_model = st.selectbox(\"Financial Target Model\", list(analyses.keys()), key='fin_model_sel')\n1051: \n1052:             fin_analysis   = analyses.get(fin_model)\n1053:             fin_defect_sum = registry.summary() if not registry.to_dataframe().empty else None\n1054: \n1055:             if fin_analysis is None:\n1056:                 st.error(\"Unable to load financial model data.\")\n1057:             else:\n1058:                 baseline = compute_financials(fin_analysis, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult)\n1059: \n1060:                 # High-Impact 5-Tile KPI Row\n1061:                 fb1, fb2, fb3, fb4, fb5 = st.columns(5)\n1062:                 with fb1:\n1063:                     st.markdown(f\"\"\"\n1064: <div class=\"stat-card green\">\n1065:   <div class=\"val\" style=\"color:#34d399;\">${baseline['gross_revenue']:,.0f}</div>\n1066:   <div class=\"lbl\">Gross Revenue</div>\n1067:   <div class=\"sub\">Shipped Output</div>\n1068: </div>\n1069: \"\"\", unsafe_allow_html=True)\n1070:                 with fb2:\n1071:                     st.markdown(f\"\"\"\n1072: <div class=\"stat-card red\">\n1073:   <div class=\"val\" style=\"color:#fb7185;\">${baseline['scrap_loss']:,.0f}</div>\n1074:   <div class=\"lbl\">Scrap Loss</div>\n1075:   <div class=\"sub\">Defect Cost</div>\n1076: </div>\n1077: \"\"\", unsafe_allow_html=True)\n1078:                 with fb3:\n1079:                     st.markdown(f\"\"\"\n1080: <div class=\"stat-card orange\">\n1081:   <div class=\"val\" style=\"color:#fbbf24;\">${baseline['bottleneck_idle_loss']:,.0f}</div>\n1082:   <div class=\"lbl\">Idle Cost</div>\n1083:   <div class=\"sub\">Starvation Loss</div>\n1084: </div>\n1085: \"\"\", unsafe_allow_html=True)\n1086:                 with fb4:\n1087:                     st.markdown(f\"\"\"\n1088: <div class=\"stat-card purple\">\n1089:   <div class=\"val\" style=\"color:#c084fc;\">${baseline['opportunity_loss']:,.0f}</div>\n1090:   <div class=\"lbl\">Opportunity Loss</div>\n1091:   <div class=\"sub\">Unmet Demand</div>\n1092: </div>\n1093: \"\"\", unsafe_allow_html=True)\n1094:                 with fb5:\n1095:                     is_pos = baseline['net_margin'] > 0\n1096:                     st.markdown(f\"\"\"\n1097: <div class=\"stat-card {'green' if is_pos else 'red'}\">\n1098:   <div class=\"val\" style=\"color:{'#34d399' if is_pos else '#fb7185'};\">${baseline['net_margin']:,.0f}</div>\n1099:   <div class=\"lbl\">Operating Margin</div>\n1100:   <div class=\"sub\">{baseline['margin_pct']:.1f}% Margin Ratio</div>\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
