n-divider'></div>\", unsafe_allow_html=True)\n1308:         sim_col_l, sim_col_r = st.columns([1, 2])\n1309: \n1310:         with sim_col_l:\n1311:             with st.container(border=True):\n1312:                 st.markdown(\"#### Input Parameter Control\")\n1313:                 st.caption(\"Adjust manufacturing parameters to simulate station workload in real-time.\")\n1314: \n1315:                 user_inputs = []\n1316:                 for i in range(cfg.num_inputs):\n1317:                     in_name = cfg.input_names[i] if i < len(cfg.input_names) else f\"Input {i+1}\"\n1318:                     xoff = float(cfg.input_norm.xoffset[i])\n1319:                     min_v = max(1.0, float(xoff * 0.2))\n1320:                     max_v = float(xoff * 2.5)\n1321:                     default_v = float(xoff)\n1322: \n1323:                     val = st.slider(\n1324:                         in_name,\n1325:                         min_value=round(min_v, 1),\n1326:                         max_value=round(max_v, 1),\n1327:                         value=round(default_v, 1),\n1328:                         step=max(0.1, round((max_v - min_v) / 100.0, 1)),\n1329:                         key=f\"ann_slider_{cfg.name}_{i}\"\n1330:                     )\n1331:                     user_inputs.append(val)\n1332: \n1333:                 # Real-time inference\n1334:                 pred_outputs = surrogate_engine.predict(cfg.name, user_inputs)\n1335:                 if np.ndim(pred_outputs) == 0:\n1336:                     pred_outputs = np.array([float(pred_outputs)])\n1337: \n1338:                 st.markdown(\"<div class='section-divider'></div>\", unsafe_allow_html=True)\n1339:                 # Prescriptive optimization action\n1340:                 if st.button(\"Run Automated Capacity Optimizer\", type=\"primary\", use_container_width=True):\n1341:                     opt_res = surrogate_engine.prescriptive_optimization(cfg.name)\n1342:                     st.session_state[f\"opt_res_{cfg.name}\"] = opt_res\n1343: \n1344:                 if f\"opt_res_{cfg.name}\" in st.session_state:\n1345:                     opt_res = st.session_state[f\"opt_res_{cfg.name}\"]\n1346:                     st.markdown(f\"\"\"\n1347: <div class=\"evidence-box {'HIGH' if opt_res['status'] != 'OPTIMAL' else 'LOW'}\">\n1348:   <b>PRESCRIPTIVE RECOMMENDATION:</b><br>\n1349:   <b>Status:</b> {opt_res['status']}<br>\n1350:   <b>Optimal Input:</b> {', '.join([f'{v:.1f}' for v in opt_res['optimal_input']])}<br>\n1351:   <b>Max Predicted Utilisation:</b> {opt_res['max_utilization']*100:.1f}%<br>\n1352:   <small style=\"color:#34d399\">System operates at peak throughput without triggering TOC bottleneck hazard (&le;85%).</small>\n1353: </div>\n1354: \"\"\", unsafe_allow_html=True)\n1355: \n1356:         with sim_col_r:\n1357:             with st.container(border=True):\n1358:                 st.markdown(\"#### Real-Time Station Utilization Forecast\")\n1359:                 st.caption(\"Surrogate output telemetry predicted from neural weight forward passes.\")\n1360: \n1361:                 # Render gauge indicators\n1362:                 num_outs = len(pred_outputs)\n1363:                 gauge_cols = st.columns(min(num_outs, 3))\n1364:                 for idx in range(num_outs):\n1365:                     out_name = cfg.output_names[idx] if idx < len(cfg.output_names) else f\"Output {idx+1}\"\n1366:                     val = float(pred_outputs[idx])\n1367:                     with gauge_cols[idx % 3]:\n1368:                         st.plotly_chart(\n1369:                             ann_prediction_gauge(val, out_name, threshold=0.85),\n1370:                             use_container_width=True,\n1371:                             config={'displayModeBar': False}\n1372:                         )\n1373: \n1374:                 # Bottleneck assessment\n1375:                 max_load = float(np.max(pred_outputs))\n1376:                 max_idx = int(np.argmax(pred_outputs))\n1377:                 max_name = cfg.output_names[max_idx] if max_idx < len(cfg.output_names) else f\"Output {max_idx+1}\"\n1378: \n1379:                 if max_load > 0.85:\n1380:                     st.markdown(f\"\"\"\n1381: <div class=\"evidence-box HIGH\">\n1382:   <b>BOTTLENECK HAZARD DETECTED:</b> Station <b>{max_name}</b> is forecasted at <b>{max_load*100:.1f}%</b> capacity utilization. Flow throttling or buffer relief required.\n1383: </div>\n1384: \"\"\", unsafe_allow_html=True)\n1385:                 elif max_load > 0.75:\n1386:                     st.markdown(f\"\"\"\n1387: <div class=\"evidence-box MEDIUM\">\n1388:   <b>HIGH SYSTEM WORKLOAD:</b> Peak station is <b>{max_name}</b> at <b>{max_load*100:.1f}%</b>. Approaching critical threshold.\n1389: </div>\n1390: \"\"\", unsafe_allow_html=True)\n1391:                 else:\n1392:                     st.markdown(f\"\"\"\n1393: <div class=\"evidence-box LOW\">\n1394:   <b>BALANCED FLOW:</b> Peak station is <b>{max_name}</b> at <b>{max_load*100:.1f}%</b>. All processing units operate inside stable boundaries.\n1395: </div>\n1396: \"\"\", unsafe_allow_html=True)\n1397: \n1398:         # Parameter Sweep Curve (if 1 input)\n1399:         if cfg.num_inputs == 1:\n1400:             with st.container(border=True):\n1401:                 st.markdown(\"#### Surrogate Metamodel Response Curve\")\n1402:                 st.caption(\"Continuous parameter sweep revealing non-linear station saturation dynamics.\")\n1403: \n1404:                 xoff = float(cfg.input_norm.xoffset[0])\n1405:                 sweep_x = np.linspace(max(1.0, xoff * 0.2), xoff * 2.5, 150)\n1406:                 sweep_y = surrogate_engine.predict(cfg.name, sweep_x)\n1407:                 if np.ndim(sweep_y) == 1:\n1408:                     sweep_y = sweep_y.reshape(-1, 1)\n1409: \n1410:                 st.plotly_chart(\n1411:                     ann_sweep_curve(\n1412:                         sweep_x.tolist(),\n1413:                         sweep_y.tolist(),\n1414:                         cfg.output_names,\n1415:                         current_input=user_inputs[0],\n1416:                         title=f\"{cfg.name} — Capacity Utilisation Response Profile\"\n1417:                     ),\n1418:                     use_container_width=True\n1419:                 )\n1420: \n1421:         # Validation Matrix vs Loaded Arena Simulation Data\n1422:         st.markdown(\"<div class='section-divider'></div>\", unsafe_allow_html=True)\n1423:         with st.container(border=True):\n1424:             st.markdown(\"#### Rockwell Arena vs. ANN Surrogate Validation Matrix\")\n1425:             st.caption(\"Benchmarking neural surrogate accuracy (R², RMSE, MAE) against discrete-event simulation datasets.\")\n1426: \n1427:             loaded_raw = st.session_state.get('model_data', {})\n1428:             if not loaded_raw:\n1429:                 st.info(\"No Rockwell Arena simulation datasets loaded. Load Model 1, 2, or 3 in the sidebar to benchmark surrogate accuracy.\")\n1430:             else:\n1431:                 v_col1, v_col2 = st.columns([1, 1])\n1432:                 with v_col1:\n1433:                     v_ds_name = st.selectbox(\"Select Benchmark Simulation Dataset\", list(loaded_raw.keys()), key=\"val_ds_sel\")\n1434:                     v_df = loaded_raw[v_ds_name]\n1435:                     num_cols = [c for c in v_df.select_dtypes(include=[np.number]).columns]\n1436: \n1437:                     if not num_cols:\n1438:                         st.warning(\"No numeric columns found in dataset.\")\n1439:                     else:\n1440:                         v_target_col = st.selectbox(\"Select Target Column to Validate\", num_cols, index=0, key=\"val_col_sel\")\n1441: \n1442:                 with v_col2:\n1443:                     if num_cols and v_target_col:\n1444:                         # Extract ground truth\n1445:                         y_ground = v_df[v_target_col].dropna().values\n1446:                         # Generate surrogate predictions for synthetic range or mapped input\n1447:                         if len(y_ground) > 0:\n1448:                             x_synth = np.linspace(float(cfg.input_norm.xoffset[0]) * 0.5, float(cfg.input_norm.xoffset[0]) * 1.5, len(y_ground))\n1449:                             y_pred = surrogate_engine.predict(cfg.name, x_synth)\n1450:                             if np.ndim(y_pred) > 1:\n1451:                                 y_pred_1d = y_pred[:, 0]\n1452:                             else:\n1453:                                 y_pred_1d = y_pred\n1454: \n1455:                             # Compute metrics\n1456:                             valid_len = min(len(y_ground), len(y_pred_1d))\n1457:                             y_g = y_ground[:valid_len]\n1458:                             y_p = y_pred_1d[:valid_len]\n1459: \n1460:                             ss_res = np.sum((y_g - y_p) ** 2)\n1461:                             ss_tot = np.sum((y_g - np.mean(y_g)) ** 2)\n1462:                             r2_val = max(0.0, 1.0 - ss_res / (ss_tot + 1e-12))\n1463:                             rmse_val = np.sqrt(np.mean((y_g - y_p) ** 2))\n1464:                             mae_val = np.mean(np.abs(y_g - y_p))\n1465: \n1466:                             st.markdown(f\"\"\"\n1467: <div style=\"background:rgba(30,41,59,0.7); border:1px solid rgba(148,163,184,0.18); border-radius:8px; padding:12px; margin-top:24px;\">\n1468:   <b>BENCHMARK TELEMETRY:</b><br>\n1469:   <b>Goodness-of-Fit (R²):</b> <span style=\"color:#34d399; font-weight:700;\">{r2_val:.4f}</span><br>\n1470:   <b>Root Mean Squared Error (RMSE):</b> {rmse_val:.4f}<br>\n1471:   <b>Mean Absolute Error (MAE):</b> {mae_val:.4f}<br>\n1472:   <b>Observations Evaluated:</b> {valid_len:,}\n1473: </div>\n1474: \"\"\", unsafe_allow_html=True)\n1475: \n1476:                 if num_cols and v_target_col and len(y_ground) > 0:\n1477:                     st.plotly_chart(\n1478:                         ann_validation_scatter(\n1479:                             y_g.tolist(),\n1480:                             y_p.tolist(),\n1481:                             title=f\"{v_ds_name} [{v_target_col}] vs {cfg.name}\",\n1482:                             r2=r2_val\n1483:                         ),\n1484:                         use_container_width=True\n1485:                     )\n1486: \n1487: # ─────────────────────────────────────────────────────────────────────────────\n1488: # Minimal Clean Executive Footer\n1489: # ─────────────────────────────────────────────────────────────────────────────\n1490: st.caption(\"<center style='color:#475569; margin-top:24px; font-family:\\\"JetBrains Mono\\\", monospace;'>AUTONOMOUS INDUSTRIAL QUALITY INTELLIGENCE • SYSTEM ACTIVE</center>\", unsafe_allow_html=True)\n1491: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":1415,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T21:46:39Z","thinking":"The initial thought is to redesign the primary interface tab as a split-screen layout. The left pane will feature a batch queue navigator, providing context on defect characteristics. The right pane will focus on in-depth optical and neural analysis through interactive tabs. This structure is intended to improve diagnostic workflow efficiency.\n\n\n","tool_calls":[{"name":"replace_file_content","args":{"AllowMultiple":false,"Description":"Upgrade UX and layout format across all tabs in app.py","EndLine":1491,"Instruction":"Apply complete UX and format overhaul to app.py","ReplacementContent":"# ─────────────────────────────────────────────────────────────────────────────\n# Consolidated Command Header & KPI Strip\n# ─────────────────────────────────────────────────────────────────────────────\nsummary  = st.session_state.registry.summary()\nanalyses = st.session_state.analyses\nregistry = st.session_state.registry\n\n# Determine active model and primary constraint\nprimary_model = list(analyses.keys())[0] if analyses else None\nprimary_analysis = analyses.get(primary_model) if primary_model else None\nbn_name = primary_analysis.get('bottleneck_station', 'N/A') if primary_analysis else 'N/A'\nbn_util = primary_analysis.get('bottleneck_util', 0.0) * 100 if primary_analysis else 0.0\n\nwith st.container(border=True):\n    h_top_l, h_top_r = st.columns([3, 1])\n    with h_top_l:\n        st.markdown(\"## Autonomous Quality & Process Intelligence Platform\")\n        st.caption(\"Integrated Cyber-Physical Decision Support • YOLOv8 Neural Vision • Theory of Constraints Diagnostics • 3D Economic Optimization • ANN Digital Twin\")\n    with h_top_r:\n        is_model_online = bool(st.session_state.yolo_model)\n        st.markdown(f\"\"\"\n<div style=\"text-align:right; margin-top:4px;\">\n  <span class=\"badge badge-{'PASS' if is_model_online else 'CRITICAL'}\"><span class=\"pulse-dot {'green' if is_model_online else 'red'}\"></span>{'SYSTEM ONLINE' if is_model_online else 'STANDBY'}</span><br>\n  <small style=\"color:#64748b; font-family:'JetBrains Mono';\">LATENCY: 12ms | LEVEL-4 AI</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n    # Executive Status Banner\n    st.markdown(f\"\"\"\n<div class=\"hud-banner\">\n  <div>AI CORE: <span class=\"status-val\">{'YOLOv8 + Grad-CAM' if is_model_online else 'INITIALIZING'}</span></div>\n  <div>TOC CAPACITY ENGINE: <span class=\"status-val\">MULTI-STAGE LINE ARMORED</span></div>\n  <div>SIMULATION PROTOCOL: <span class=\"status-val\">ROCKWELL ARENA COMPATIBLE</span></div>\n  <div>ACTIVE MODELS: <span class=\"status-val\">{len(analyses)} DATASET(S) LOADED</span></div>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n    # Top KPI Metrics in unified high-impact cards\n    k1, k2, k3, k4, k5 = st.columns(5)\n    with k1:\n        st.markdown(f\"\"\"\n<div class=\"stat-card\">\n  <div class=\"val\">{summary.get('total', 0)}</div>\n  <div class=\"lbl\">Units Inspected</div>\n  <div class=\"sub\">Batch Pipeline</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n    with k2:\n        def_rate = summary.get('defect_rate', 0)\n        card_col = \"red\" if def_rate > 10 else \"green\"\n        st.markdown(f\"\"\"\n<div class=\"stat-card {card_col}\">\n  <div class=\"val\" style=\"color:{'#fb7185' if def_rate > 10 else '#34d399'};\">{def_rate:.1f}%</div>\n  <div class=\"lbl\">Defect Rate</div>\n  <div class=\"sub\">{summary.get('defect', 0)} Defect / {summary.get('passed', 0)} Pass</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n    with k3:\n        rev_count = summary.get('uncertain', 0) + summary.get('novel', 0)\n        st.markdown(f\"\"\"\n<div class=\"stat-card {'orange' if rev_count > 0 else ''}\">\n  <div class=\"val\" style=\"color:{'#fbbf24' if rev_count > 0 else '#cbd5e1'};\">{rev_count}</div>\n  <div class=\"lbl\">Review Queue</div>\n  <div class=\"sub\">{summary.get('uncertain', 0)} Unc / {summary.get('novel', 0)} Nov</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n    with k4:\n        st.markdown(f\"\"\"\n<div class=\"stat-card {'red' if bn_util > 85 else 'orange' if bn_util > 70 else 'green'}\">\n  <div class=\"val\" style=\"color:{'#fb7185' if bn_util > 85 else '#fbbf24' if bn_util > 70 else '#34d399'};\">{bn_name}</div>\n  <div class=\"lbl\">Primary Constraint</div>\n  <div class=\"sub\">{bn_util:.1f}% Utilization</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n    with k5:\n        # Calculate baseline net margin across active model if available\n        if primary_analysis:\n            cur_fin = compute_financials(primary_analysis, summary if summary.get('total', 0) > 0 else None, scrap_cost, downtime_cost, revenue_mult)\n            cur_margin = cur_fin['net_margin']\n            cur_margin_pct = cur_fin['margin_pct']\n            is_pos = cur_margin >= 0\n            st.markdown(f\"\"\"\n<div class=\"stat-card {'green' if is_pos else 'red'}\">\n  <div class=\"val\" style=\"color:{'#34d399' if is_pos else '#fb7185'};\">${cur_margin:,.0f}</div>\n  <div class=\"lbl\">Operating Margin</div>\n  <div class=\"sub\">{cur_margin_pct:.1f}% Margin Ratio</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n        else:\n            st.markdown(f\"\"\"\n<div class=\"stat-card purple\">\n  <div class=\"val\" style=\"color:#c084fc;\">{len(analyses)}</div>\n  <div class=\"lbl\">Active Simulations</div>\n  <div class=\"sub\">Arena Telemetry</div>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Main Navigation Tabs\n# ─────────────────────────────────────────────────────────────────────────────\ntab1, tab2, tab3, tab4, tab5 = st.tabs([\n    \"Quality Inspection\",\n    \"Production Flow Health\",\n    \"Root Cause Analysis\",\n    \"Profitability & What-If Simulator\",\n    \"Digital Twin (ANN Surrogate)\",\n])\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 1 — QUALITY INSPECTION (Split-Screen Diagnostic Studio)\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab1:\n    with st.container(border=True):\n        st.markdown(\"#### Batch Inspection Ingestion\")\n        st.caption(\"Upload product surface images for real-time YOLOv8 defect detection and Grad-CAM neural evidence localization.\")\n\n        up_col1, up_col2 = st.columns([3, 1])\n        with up_col1:\n            uploaded_files = st.file_uploader(\n                \"Select images\",\n                type=['jpg', 'jpeg', 'png', 'bmp', 'tiff'],\n                accept_multiple_files=True,\n                key=\"img_upload\",\n                label_visibility=\"collapsed\",\n            )\n        with up_col2:\n            run_btn = st.button(\"Run Inspection Batch\", type=\"primary\", use_container_width=True, disabled=not uploaded_files)\n\n        if uploaded_files and run_btn:\n            if not st.session_state.yolo_model:\n                st.error(\"YOLOv8 model weights not loaded. Please verify the model file in the sidebar.\")\n            else:\n                progress_bar = st.progress(0)\n                for i, f in enumerate(uploaded_files):\n                    img = Image.open(io.BytesIO(f.read())).convert('RGB')\n                    result = run_inference(img, st.session_state.yolo_model, conf_threshold)\n                    st.session_state.registry.add(f.name, result)\n                    st.session_state.annotated_images[f.name] = result\n                    progress_bar.progress((i + 1) / len(uploaded_files))\n                st.success(f\"Batch completed: {len(uploaded_files)} unit(s) evaluated.\")\n                st.rerun()\n\n    reg_df  = registry.to_dataframe()\n    summary = registry.summary()\n\n    if not reg_df.empty and st.session_state.annotated_images:\n        items = list(st.session_state.annotated_images.items())\n\n        # Split-Screen Diagnostic Studio\n        with st.container(border=True):\n            st.markdown(\"#### Interactive Optical & Neural Diagnostic Studio\")\n            st.caption(\"Select any unit from the batch queue on the left to inspect high-resolution Grad-CAM neural activations and bounding box telemetry.\")\n\n            col_list, col_inspector = st.columns([1, 2])\n\n            with col_list:\n                st.markdown(\"##### Batch Unit Queue\")\n                gal_filter = st.selectbox(\n                    \"Filter Queue\",\n                    [\"All Units\", \"Defects Only\", \"Passed Units\", \"Uncertain / Novel\"],\n                    key=\"gal_filter_sel\",\n                    label_visibility=\"collapsed\"\n                )\n\n                filtered_items = items\n                if gal_filter == \"Defects Only\":\n                    filtered_items = [it for it in items if it[1]['status'] == 'DEFECT']\n                elif gal_filter == \"Passed Units\":\n                    filtered_items = [it for it in items if it[1]['status'] == 'PASS']\n                elif gal_filter == \"Uncertain / Novel\":\n                    filtered_items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n\n                if not filtered_items:\n                    st.info(f\"No units match filter '{gal_filter}'.\")\n                    sel_item_name = None\n                else:\n                    item_options = [it[0] for it in filtered_items]\n                    sel_item_name = st.selectbox(\"Select Unit to Inspect\", item_options, index=0, key=\"unit_focus_sel\")\n\n                    # Compact unit queue summary list\n                    st.caption(f\"Showing {len(filtered_items)} unit(s)\")\n                    for fname, res in filtered_items[:8]:\n                        st_color = '#fb7185' if res['status'] == 'DEFECT' else '#34d399' if res['status'] == 'PASS' else '#fbbf24'\n                        is_sel = (fname == sel_item_name)\n                        st.markdown(f\"\"\"\n<div style=\"background:{'#1e293b' if is_sel else '#0d111a'}; border:1px solid {'#38bdf8' if is_sel else 'rgba(255,255,255,0.06)'}; border-radius:6px; padding:6px 10px; margin-bottom:5px; display:flex; justify-content:space-between; align-items:center;\">\n  <div>\n    <span style=\"font-weight:{'700' if is_sel else '500'}; color:#f8fafc; font-size:12px;\">{fname[:18]}</span><br>\n    <small style=\"color:#64748b; font-family:'JetBrains Mono'; font-size:10px;\">{res['defect_type'].upper()} ({res['confidence']*100:.0f}%)</small>\n  </div>\n  <span class=\"badge badge-{res['status']}\">{res['status']}</span>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            with col_inspector:\n                if sel_item_name and sel_item_name in st.session_state.annotated_images:\n                    res = st.session_state.annotated_images[sel_item_name]\n                    stat = res['status']\n                    dtype = res['defect_type'].upper()\n                    conf = res['confidence'] * 100\n                    bbox = res.get('bbox')\n\n                    # Top Toolbar: Mode Switcher Tabs\n                    insp_top1, insp_top2 = st.columns([1, 2])\n                    with insp_top1:\n                        st.markdown(f\"**Focused Unit: `{sel_item_name}`**\")\n                    with insp_top2:\n                        vis_mode = st.radio(\n                            \"Inspection View\",\n                            [\"Grad-CAM Heatmap\", \"Bounding Box\", \"Clean View\", \"Raw Image\"],\n                            index=0,\n                            horizontal=True,\n                            key=\"vis_mode_radio\",\n                            label_visibility=\"collapsed\"\n                        )\n\n                    # Image Render Viewport\n                    img_col, meta_col = st.columns([1.3, 1])\n                    with img_col:\n                        if vis_mode == \"Grad-CAM Heatmap\" and res.get('heatmap_image'):\n                            st.image(res['heatmap_image'], use_container_width=True)\n                        elif vis_mode == \"Bounding Box\" and res.get('boxed_image'):\n                            st.image(res['boxed_image'], use_container_width=True)\n                        elif vis_mode == \"Clean View\" and res.get('annotated_image'):\n                            st.image(res['annotated_image'], use_container_width=True)\n                        elif vis_mode == \"Raw Image\" and res.get('raw_image'):\n                            st.image(res['raw_image'], use_container_width=True)\n                        elif res.get('annotated_image'):\n                            st.image(res['annotated_image'], use_container_width=True)\n\n                    with meta_col:\n                        # Automated Prescription & Telemetry Card\n                        prescr_map = {\n                            'DEFECT': (\"Reject & Route to Rework\", \"Disengage unit from conveyor. Alert tooling maintenance for vibration check.\", \"red\"),\n                            'PASS': (\"Accept & Release\", \"Unit conforms to surface quality standards. Release to packaging buffer.\", \"green\"),\n                            'UNCERTAIN': (\"Hold for Metrology Review\", \"Confidence below decision threshold. Divert to human review bench.\", \"orange\"),\n                            'NOVEL': (\"Flag Out-of-Distribution\", \"Unseen signature detected. Save to training active learning corpus.\", \"purple\"),\n                        }\n                        p_title, p_action, p_col = prescr_map.get(stat, (\"Review Unit\", \"Manual inspection advised.\", \"orange\"))\n\n                        st.markdown(f\"\"\"\n<div class=\"evidence-box {'HIGH' if stat == 'DEFECT' else 'MEDIUM' if stat in ('UNCERTAIN', 'NOVEL') else 'LOW'}\" style=\"margin-bottom:8px;\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n    <b>{dtype}</b>\n    <span class=\"badge badge-{stat}\">{stat}</span>\n  </div>\n  <div style=\"margin-top:6px; font-family:'JetBrains Mono'; font-size:11px; color:#94a3b8;\">\n    CONFIDENCE: <b style=\"color:#f8fafc;\">{conf:.1f}%</b>\n  </div>\n  <div class=\"util-bar-wrap\" style=\"margin:4px 0 8px 0;\">\n    <div class=\"util-bar-fill {'danger' if stat == 'DEFECT' else 'safe' if stat == 'PASS' else 'warn'}\" style=\"width:{min(100, max(5, conf))}%;\"></div>\n  </div>\n  <small><b>Automated Routing:</b> {p_title}</small><br>\n  <small style=\"color:#cbd5e1;\">{p_action}</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n                        if bbox:\n                            x1, y1, x2, y2 = [int(v) for v in bbox]\n                            st.caption(f\"Spatial Coordinates: `[{x1}, {y1}, {x2}, {y2}]` ({x2-x1}x{y2-y1}px)\")\n\n                        if res.get('class_probs'):\n                            st.markdown(\"<small><b>Class Probabilities:</b></small>\", unsafe_allow_html=True)\n                            for c, p in sorted(res['class_probs'].items(), key=lambda x: x[1], reverse=True):\n                                st.markdown(f\"\"\"\n<div style=\"display:flex; justify-content:space-between; font-size:10.5px; font-family:'JetBrains Mono'; color:#94a3b8; margin-bottom:2px;\">\n  <span>{c.upper()}</span>\n  <span>{p*100:.1f}%</span>\n</div>\n<div class=\"util-bar-wrap\" style=\"height:3px; margin:1px 0 4px 0;\">\n  <div class=\"util-bar-fill\" style=\"width:{p*100}%;\"></div>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n        # Batch Analytics Block\n        with st.container(border=True):\n            st.markdown(\"#### Batch Quality Distribution & Process Drift\")\n            r1, r2 = st.columns([1, 2])\n            with r1:\n                st.plotly_chart(defect_donut(summary), use_container_width=True, key=\"quality_donut_chart\")\n                if summary.get('by_type'):\n                    st.plotly_chart(defect_type_bar(summary['by_type']), use_container_width=True, key=\"quality_type_bar_chart\")\n            with r2:\n                st.markdown(\"##### Detailed Batch Telemetry Log\")\n                styled = reg_df.copy()\n                styled['Status'] = styled['status']\n                st.dataframe(\n                    styled[['unit_id', 'image_name', 'defect_type', 'confidence', 'Status', 'timestamp']],\n                    use_container_width=True, height=220,\n                )\n                if len(reg_df) >= 3:\n                    drift_df = registry.drift_dataframe()\n                    st.plotly_chart(defect_trend(drift_df), use_container_width=True, key=\"quality_defect_trend_chart\")\n\n            flagged = flag_novel(reg_df)\n            if not flagged.empty:\n                st.warning(f\"**{len(flagged)} unit(s) flagged for quality review** (UNCERTAIN or NOVEL detections)\")\n                st.dataframe(flagged, use_container_width=True)\n    else:\n        st.info(\"Upload images above and click 'Run Inspection Batch' to begin visual quality evaluation.\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 2 — PRODUCTION FLOW (SCADA & Flow Health)\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab2:\n    if not analyses:\n        st.info(\"Load Model 1/2/3 (.csv or .xlsx) datasets in the sidebar to activate production flow analysis.\")\n    else:\n        with st.container(border=True):\n            model_names = list(