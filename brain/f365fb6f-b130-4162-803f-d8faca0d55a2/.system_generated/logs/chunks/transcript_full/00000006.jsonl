ion_state.annotated_images[f.name] = result\n266:                     progress_bar.progress((i + 1) / len(uploaded_files))\n267: \n268:                 st.success(f\"✅ Successfully inspected {len(uploaded_files)} unit(s)!\")\n269: \n270:     # ── Results Section ───────────────────────────────────────────────────────\n271:     st.divider()\n272:     reg_df  = registry.to_dataframe()\n273:     summary = registry.summary()\n274: \n275:     if not reg_df.empty and st.session_state.annotated_images:\n276:         st.markdown(\"### 🖼️ Inspected Units Gallery & Defect Localization Grid\")\n277:         \n278:         # Filter buttons and Visualization Mode\n279:         filter_col1, filter_col2 = st.columns([1, 2])\n280:         with filter_col1:\n281:             gal_filter = st.selectbox(\n282:                 \"Filter View\",\n283:                 [\"All Units\", \"Defects Only (🔴)\", \"Passed Units (✅)\", \"Uncertain / Novel (🟡🟣)\"],\n284:                 key=\"gal_filter_sel\",\n285:             )\n286:         with filter_col2:\n287:             vis_mode = st.radio(\n288:                 \"Display Mode\",\n289:                 [\"🖼️ Clean Industrial View\", \"🔥 Grad-CAM Heatmap\", \"🎯 Bounding Box\", \"📷 Raw Image\"],\n290:                 horizontal=True,\n291:                 key=\"vis_mode_sel\",\n292:             )\n293: \n294:         # Filter items\n295:         items = list(st.session_state.annotated_images.items())\n296:         if gal_filter == \"Defects Only (🔴)\":\n297:             items = [it for it in items if it[1]['status'] == 'DEFECT']\n298:         elif gal_filter == \"Passed Units (✅)\":\n299:             items = [it for it in items if it[1]['status'] == 'PASS']\n300:         elif gal_filter == \"Uncertain / Novel (🟡🟣)\":\n301:             items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n302: \n303:         if not items:\n304:             st.info(f\"No units match filter: '{gal_filter}'\")\n305:         else:\n306:        