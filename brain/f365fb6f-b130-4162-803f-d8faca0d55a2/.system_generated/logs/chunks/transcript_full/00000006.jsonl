rift Analysis\")\n527:         if no_quality or len(registry) < 2:\n528:             st.info(\"Inspect at least 2 units to see drift trends.\")\n529:         else:\n530:             drift_df_raw = registry.drift_dataframe()\n531:             drift        = drift_analysis(drift_df_raw)\n532: \n533:             if drift:\n534:                 dc1, dc2, dc3 = st.columns(3)\n535:                 dc1.metric(\"Trend Direction\", drift['trend'])\n536:                 dc2.metric(\"Slope\", f\"{drift['slope']:+.2f} pp/unit\")\n537:                 dc3.metric(\"Units Needing Review\",\n538:                            drift['novel_count'] + drift['uncertain_count'])\n539: \n540:                 st.plotly_chart(defect_trend(drift['df']), use_container_width=True, key=\"rootcause_defect_trend_chart\")\n541: \n542:         # ── Novel / Uncertain summary ──────────────────────────────────────────\n543:         if not no_quality:\n544:             flagged = flag_novel(registry.to_dataframe())\n545:             if not flagged.empty:\n546:                 st.warning(f\"### 🟣 {len(flagged)} Novel / Uncertain Unit(s) — Human Review Required\")\n547:                 st.markdown(\n548:                     \"These units have confidence scores below the classification threshold. \"\n549:                     \"They may represent **new defect types** not seen during training.\"\n550:                 )\n551:                 st.dataframe(flagged, use_container_width=True)\n552:             else:\n553:                 st.success(\"✅ No novel or uncertain defect patterns detected.\")\n554: \n555: # ═════════════════════════════════════════════════════════════════════════════\n556: # TAB 4 — PROFITABILITY & RECOMMENDATIONS\n557: # ═════════════════════════════════════════════════════════════════════════════\n558: with tab4:\n559:     st.markdown(\"## 💰 Profitability & What-If Simulator\")\n560:     st.markdown(\n561:         \"Convert operational telemetry into financial impact estimates. \"\n562:         \"Use the sliders to simulate process improvement ROI.\"\n563:     )\n564: \n565:     if not analyses:\n566:         st.info(\"Upload production CSV files (sidebar) to unlock financial modelling.\")\n567:     else:\n568:         fin_model = st.selectbox(\n569:             \"Select model for financial analysis\",\n570:             list(analyses.keys()),\n571:             key='fin_model_sel',\n572:         )\n573:         fin_analysis  = analyses.get(fin_model)\n574:         fin_defect_sum = registry.summary() if not registry.to_dataframe().empty else None\n575: \n576:         if fin_analysis is None:\n577:             st.error(\"Could not load analysis for selected model.\")\n578:         else:\n579:             baseline = compute_financials(\n580:                 fin_analysis, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult\n581:             )\n582: \n583:             # ── Baseline KPIs ──────────────────────────────────────────────────\n584:             st.markdown(\"### 📋 Baseline Financial Snapshot\")\n585:             fb1, fb2, fb3, fb4, fb5 = st.columns(5)\n586:             fb1.metric(\"Gross Revenue\",    f\"${baseline['gross_revenue']:,.0f}\")\n587:             fb2.metric(\"Scrap Loss\",       f\"${baseline['scrap_loss']:,.0f}\",    delta_color=\"inverse\")\n588:             fb3.metric(\"Idle Loss\",        f\"${baseline['bottleneck_idle_loss']:,.0f}\", delta_color=\"inverse\")\n589:             fb4.metric(\"Opportunity Loss\", f\"${baseline['opportunity_loss']:,.0f}\", delta_color=\"inverse\")\n590:             fb5.metric(\"Net Margin\",\n591:                        f\"${baseline['net_margin']:,.0f}\",\n592:                        delta=f\"{baseline['margin_pct']:.1f}%\",\n593:                        delta_color=\"normal\" if baseline['net_margin'] > 0 else \"inverse\")\n594: \n595:             wf1, wf2 = st.columns([3, 2])\n596:             with wf1:\n597:                 st.plotly_chart(financial_waterfall(baseline, fin_model), use_container_width=True, key=f\"fin_waterfall_{fin_model}\")\n598: \n599:             with wf2:\n600:                 st.markdown(\"#### Loss Breakdown\")\n601:                 loss_items = {\n602:                     \"Scrap Material Loss\": baseline['scrap_loss'],\n603:                     \"Bottleneck Idle Cost\": baseline['bottleneck_idle_loss'],\n604:                     \"Opportunity Loss\": baseline['opportunity_loss'],\n605:                     \"Rework Cost\": baseline['rework_cost'],\n606:                 }\n607:                 for label, val in loss_items.items():\n608:                     pct = val / baseline['total_loss'] * 100 if baseline['total_loss'] else 0\n609:                     st.markdown(f\"\"\"\n610: <div class=\"metric-card red\">\n611:   <b>{label}</b><br>\n612:   <span style=\"font-size:20px; color:#e74c3c\">${val:,.2f}</span>\n613:   <span style=\"color:#95a5a6\"> ({pct:.0f}%)</span>\n614: </div>\n615: \"\"\", unsafe_allow_html=True)\n616: \n617:             st.divider()\n618: \n619:             # ── What-If Simulator ──────────────────────────────────────────────\n620:             st.markdown(\"### 🎛️ What-If Scenario Simulator\")\n621:             col_s1, col_s2 = st.columns(2)\n622:             with col_s1:\n623:                 util_impr = st.slider(\n624:                     \"Bottleneck Wait Time Reduction (%)\",\n625:                     0, 50, 15, step=5,\n626:                     help=\"Simulates reducing bottleneck idle time via capacity elevation.\",\n627:                 )\n628:             with col_s2:\n629:                 scrap_redn = st.slider(\n630:                     \"Defect / Scrap Rate Reduction (%)\",\n631:                     0, 80, 20, step=5,\n632:                     help=\"Simulates quality improvements reducing defect rate.\",\n633:                 )\n634: \n635:             wi_result = what_if(\n636:                 fin_analysis, fin_defect_sum,\n637:                 scrap_cost, downtime_cost,\n638:                 util_impr, scrap_redn, revenue_mult,\n639:             )\n640:             delta = impact_delta(baseline, wi_result)\n641: \n642:             w1, w2, w3 = st.columns(3)\n643:             w1.metric(\"Projected Net Margin\",\n644:                       f\"${wi_result['net_margin']:,.0f}\",\n645:                       delta=f\"+${delta['delta_margin']:,.0f} vs baseline\",\n646:                       delta_color=\"normal\")\n647:             w2.metric(\"Total Loss Saved\",\n648:                       f\"${delta['delta_loss_saved']:,.0f}\",\n649:                       delta=f\"{delta['margin_improvement_pct']:+.1f}% margin lift\")\n650:             w3.metric(\"Projected Scrap Units\",\n651:                       f\"{wi_result['scrap_units']:.0f}\",\n652:                       delta=f\"{baseline['scrap_units'] - wi_result['scrap_units']:.0f} fewer\",\n653:                       delta_color=\"inverse\")\n654: \n655:             # Compare all models\n656:             if len(analyses) > 1:\n657:                 st.divider()\n658:                 st.markdown(\"#### 📊 Multi-Model Financial Comparison\")\n659:                 all_results = {}\n660:                 for name, an in analyses.items():\n661:                     if an is None:\n662:                         continue\n663:                     b = compute_financials(an, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult)\n664:                     wi = what_if(an, fin_defect_sum, scrap_cost, downtime_cost,\n665:                                  util_impr, scrap_redn, revenue_mult)\n666:                     all_results[name] = {'baseline': b, 'whatif': wi}\n667: \n668:                 st.plotly_chart(margin_comparison_bar(all_results), use_container_width=True, key=\"fin_margin_comp_chart\")\n669: \n670:             st.divider()\n671: \n672:             # ── Recommendations ────────────────────────────────────────────────\n673:             st.markdown(\"### 🎯 Top Recommendations\")\n674: \n675:             # Build recommendation list from evidence + financial impact\n676:             recs = []\n677:             evidence = correlate(fin_analysis, fin_defect_sum)\n678:             for card in evidence[:3]:\n679:                 recs.append({\n680:                     'priority': card['confidence'],\n681:                     'title':    card['cause'],\n682:                     'action':   card['action'],\n683:                     'impact':   f\"Estimated loss reduction via defect/idle reduction\",\n684:                 })\n685: \n686:             # Add throughput-based recommendation\n687:             if fin_analysis.get('throughput_gap', 0) > 10:\n688:                 recs.insert(0, {\n689:                     'priority': 'HIGH',\n690:                     'title':    f\"Elevate {fin_analysis['bottleneck_station']} station capacity\",\n691:                     'action':   (\n692:                         f\"{fin_analysis['bottleneck_station']} is at \"\n693:                         f\"{fin_analysis['bottleneck_util']*100:.0f}% utilisation — the system constraint. \"\n694:                         \"Add capacity here first (overtime, tooling, parallel setup). \"\n695:                         f\"Closing the {fin_analysis['throughput_gap']:.0f}-unit gap could recover \"\n696:                         f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} revenue.\"\n697:                     ),\n698:                     'impact': f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} opportunity recovery\",\n699:                 })\n700: \n701:             priority_icons = {'HIGH': '🔴', 'MEDIUM': '🟡', 'LOW': '⚪'}\n702:             for i, rec in enumerate(recs[:4], 1):\n703:                 p = rec['priority']\n704:                 st.markdown(f\"\"\"\n705: <div class=\"evidence-card {p}\">\n706:   <b>{priority_icons.get(p,'')}&nbsp; #{i} — {rec['title']}</b>\n707:   <span class=\"badge badge-{p}\" style=\"float:right\">{p}</span><br>\n708:   <small>{rec['action']}</small><br>\n709:   <small style=\"color:#2ecc71\">💡 Expected Impact: {rec.get('impact','—')}</small>\n710: </div>\n711: \"\"\", unsafe_allow_html=True)\n712: \n713:             if not recs:\n714:                 st.success(\"✅ No high-priority recommendations at current thresholds.\")\n715: \n716:             # ── Download report ────────────────────────────────────────────────\n717:             st.divider()\n718:             report_lines = [\n719:                 \"# NEURAX 3.0 — Analysis Report\",\n720:                 f\"\\n## Quality Summary\",\n721:                 f\"- Total Inspected: {summary.get('total',0)}\",\n722:                 f\"- Defects: {summary.get('defect',0)} ({summary.get('defect_rate',0):.1f}%)\",\n723:                 f\"- Uncertain: {summary.get('uncertain',0)} | Novel: {summary.get('novel',0)}\",\n724:                 f\"\\n## Production Flow ({fin_model})\",\n725:                 f\"- Demand: {fin_analysis['demand']} | Produced: {fin_analysis['total_parts']}\",\n726:                 f\"- Throughput Efficiency: {fin_analysis['throughput_efficiency']:.1f}%\",\n727:                 f\"- Bottleneck: {fin_analysis['bottleneck_station']} @ {fin_analysis['bottleneck_util']*100:.1f}%\",\n728:                 f\"\\n## Financial Snapshot\",\n729:                 f\"- Gross Revenue: ${baseline['gross_revenue']:,.2f}\",\n730:                 f\"- Total Losses: ${baseline['total_loss']:,.2f}\",\n731:                 f\"- Net Margin: ${baseline['net_margin']:,.2f} ({baseline['margin_pct']:.1f}%)\",\n732:                 f\"\\n## What-If Scenario ({util_impr}% idle reduction, {scrap_redn}% scrap reduction)\",\n733:                 f\"- Projected Margin: ${wi_result['net_margin']:,.2f}\",\n734:                 f\"- Improvement: +${delta['delta_margin']:,.2f} (+{delta['margin_improvement_pct']:.1f}%)\",\n735:                 f\"\\n## Recommendations\",\n736:             ]\n737:             for i, rec in enumerate(recs[:4], 1):\n738:                 report_lines.append(f\"{i}. **[{rec['priority']}]** {rec['title']}: {rec['action']}\")\n739: \n740:             report_text = \"\\n\".join(report_lines)\n741:             st.download_button(\n742:                 \"📄 Download Analysis Report (.md)\",\n743:                 data=report_text,\n744:                 file_name=\"neurax_report.md\",\n745:                 mime=\"text/markdown\",\n746:                 use_container_width=True,\n747:                 type=\"primary\",\n748:             )\n749: \n750: # ─────────────────────────────────────────────────────────────────────────────\n751: # Footer\n752: # ─────────────────────────────────────────────────────────────────────────────\n753: st.divider()\n754: st.markdown(\n755:     \"<center><small>NEURAX 3.0 · NEURAX HACKATHON 3.0 · Domain 2: AI in Industry & Automation</small></center>\",\n756:     unsafe_allow_html=True,\n757: )\n758: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":274,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T15:30:42Z","thinking":"The initial step involves cleaning up the visual elements of the application, replacing all emoji representations with more professional text-based alternatives. This ensures a cleaner and more consistent user interface across the application. Specifically, the application's visual header and status indicators will undergo this transformation to improve clarity.\n\n\nThe application's interface labels and statuses require textual replacements for all emojis to increase professional presentation. System headers and tab names are also to be standardized to ensure uniformity. Specifically, I'm updating the elements on the \"Quality Inspection\" tab and the main system title.\n\nThe \"Production Datasets\", \"Economic Parameters\", and \"Clear Inspection Session\" actions need textual representation. The visual elements within \"Quality Inspection\" should reflect the specified replacements.\n\n\nStatus indicators and tab names will undergo textual replacements to improve clarity and professionalism.  Specifically, the existing icon representations will be translated to their corresponding text equivalents. Certain tab titles and section headers are also being standardized to ensure consistency across the application. Any instances of \"Human Review Required\" will be clearly marked.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nNEURAX 3.0 — Visual Inspection & Defect Root-Cause Assistant\nStreamlit main application\n\"\"\"\nimport io\nimport os\nimport sys\nfrom pathlib import Path\n\nimport pandas as pd\nimport streamlit as st\nfrom PIL import Image\n\n# ── Path setup ────────────────────────────────────────────────────────────────\nROOT = Path(__file__).parent\nsys.path.insert(0, str(ROOT))\n\nfrom modules.defect_detector  import load_model, run_inference\nfrom modules.defect_registry  import DefectRegistry\nfrom modules.production_analyzer import load_csv, analyze, compare_models, estimate_wip\nfrom modules.root_cause       import correlate, drift_analysis, flag_novel\nfrom modules.profitability    import compute_financials, what_if, impact_delta\nfrom utils.chart_helpers      import (\n    defect_donut, defect_type_bar, confidence_histogram, defect_trend,\n    utilization_bar, waiting_time_bar, multi_model_radar,\n    financial_waterfall, margin_comparison_bar,\n)\nfrom utils.constants import DEFECT_CLASSES, STATUS_COLORS\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Page Config\n# ─────────────────────────────────────────────────────────────────────────────\nst.set_page_config(\n    page_title=\"NEURAX 3.0 – Industrial AI\",\n    layout=\"wide\",\n    initial_sidebar_state=\"expanded\",\n)\n\n# ── Custom CSS ────────────────────────────────────────────────────────────────\nst.markdown(\"\"\"\n<style>\n    .main { background-color: #0e1117; }\n    .metric-card {\n        background: linear-gradient(135deg, #1a1f2e, #252d3d);\n        border-radius: 12px; padding: 16px 20px;\n        border-left: 4px solid #3498db;\n        margin-bottom: 8px;\n    }\n    .metric-card.green  { border-left-color: #2ecc71; }\n    .metric-card.red    { border-left-color: #e74c3c; }\n    .metric-card.orange { border-left-color: #f39c12; }\n    .metric-card.purple { border-left-color: #9b59b6; }\n    .evidence-card {\n        background: #1a1f2e; border-radius: 10px;\n        padding: 14px 16px; margin-bottom: 10px;\n        border-left: 5px solid #3498db;\n    }\n    .evidence-card.HIGH   { border-left-color: #e74c3c; }\n    .evidence-card.MEDIUM { border-left-color: #f39c12; }\n    .evidence-card.LOW    { border-left-color: #95a5a6; }\n    .badge {\n        display: inline-block; padding: 2px 8px;\n        border-radius: 20px; font-size: 11px; font-weight: bold;\n    }\n    .badge-DEFECT    { background:#e74c3c; color:white; }\n    .badge-PASS      { background:#2ecc71; color:white; }\n    .badge-UNCERTAIN { background:#f39c12; color:black; }\n    .badge-NOVEL     { background:#9b59b6; color:white; }\n    .badge-HIGH      { background:#e74c3c; color:white; }\n    .badge-MEDIUM    { background:#f39c12; color:black; }\n    .badge-LOW       { background:#95a5a6; color:white; }\n    h1, h2, h3 { color: #ecf0f1; }\n    .stTabs [data-baseweb=\"tab\"] { font-size: 15px; font-weight: 600; }\n</style>\n\"\"\", unsafe_allow_html=True)\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Session State Initialisation\n# ─────────────────────────────────────────────────────────────────────────────\nif 'registry' not in st.session_state:\n    st.session_state.registry = DefectRegistry()\nif 'annotated_images' not in st.session_state:\n    st.session_state.annotated_images = {}  # name -> result dict\nif 'model_data' not in st.session_state:\n    st.session_state.model_data = {}   # name -> DataFrame\nif 'analyses' not in st.session_state:\n    st.session_state.analyses = {}     # name -> analysis dict\nif 'yolo_model' not in st.session_state:\n    st.session_state.yolo_model = None\nif 'model_load_error' not in st.session_state:\n    st.session_state.model_load_error = None\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Sidebar\n# ─────────────────────────────────────────────────────────────────────────────\nwith st.sidebar:\n    st.markdown(\"## NEURAX 3.0\")\n    st.markdown(\"*Visual Inspection & Defect Root-Cause Assistant*\")\n    st.divider()\n\n    # ── Model weights ─────────────────────────────────────────────────────────\n    st.markdown(\"### AI Model\")\n    custom_pt = st.text_input(\n        \"Custom best.pt path (optional)\",\n        placeholder=r\"D:\\acceleration\\best.pt\",\n    )\n    if st.button(\"Load / Reload Model\", use_container_width=True):\n        with st.spinner(\"Loading YOLOv8 weights...\"):\n            mdl, err = load_model(custom_pt or None)\n            st.session_state.yolo_model = mdl\n            st.session_state.model_load_error = err\n        if mdl:\n            st.success(\"Model loaded successfully.\")\n        else:\n            st.error(f\"Error loading model: {err}\")\n\n    # Auto-load on first run\n    if st.session_state.yolo_model is None and st.session_state.model_load_error is None:\n        mdl, err = load_model(custom_pt or None)\n        st.session_state.yolo_model = mdl\n        st.session_state.model_load_error = err\n\n    if st.session_state.yolo_model:\n        st.success(\"YOLOv8 Engine Ready\")\n    elif st.session_state.model_load_error:\n        st.warning(f\"Status: {st.session_state.model_load_error[:80]}...\")\n\n    st.divider()\n\n    # ── Inspection settings ───────────────────────────────────────────────────\n    st.markdown(\"### Inspection Settings\")\n    conf_threshold = st.slider(\n        \"Confidence Threshold\",\n        min_value=0.20, max_value=0.90, value=0.45, step=0.05,\n        help=\"Below this threshold: flagged as UNCERTAIN. Below 0.25: flagged as NOVEL.\",\n    )\n\n    st.divider()\n\n    # ── Production CSVs ───────────────────────────────────────────────────────\n    st.markdown(\"### Production Datasets\")\n\n    def _upload_csv(label, key):\n        f = st.file_uploader(label, type=['csv'], key=key)\n        if f:\n            df, err = load_csv(f)\n            if err:\n                st.error(f\"Parse error: {err}\")\n            else:\n                name = label.split(' ')[0]\n                st.session_state.model_data[name] = df\n                st.session_state.analyses[name] = analyze(df)\n                st.success(f\"Loaded {f.name} ({len(df)} rows)\")\n\n    _upload_csv(\"Model 1 CSV\", \"csv1\")\n    _upload_csv(\"Model 2 CSV\", \"csv2\")\n    _upload_csv(\"Model 3 CSV\", \"csv3\")\n\n    # Auto-load from D:\\acceleration if not already loaded\n    if not st.session_state.model_data:\n        default_paths = {\n            'Model 1': r'D:\\acceleration\\Model 1.csv',\n            'Model 2': r'D:\\acceleration\\Model 2.csv',\n            'Model 3': r'D:\\acceleration\\Model 3.csv',\n        }\n        for name, path in default_paths.items():\n            if os.path.exists(path) and name not in st.session_state.model_data:\n                df, _ = load_csv(path)\n                if df is not None:\n                    st.session_state.model_data[name] = df\n                    st.session_state.analyses[name] = analyze(df)\n\n    if st.session_state.model_data:\n        st.info(f\"Active Models: {', '.join(st.session_state.model_data.keys())}\")\n\n    st.divider()\n\n    # ── Economic Parameters ───────────────────────────────────────────────────\n    st.markdown(\"### Economic Parameters\")\n    scrap_cost = st.slider(\n        \"Scrap Unit Material Cost ($)\",\n        min_value=5.0, max_value=50.0, value=15.0, step=0.5,\n        format=\"$%.2f\",\n    )\n    downtime_cost = st.slider(\n        \"Line Downtime Cost ($/min)\",\n        min_value=1.0, max_value=10.0, value=2.50, step=0.25,\n        format=\"$%.2f\",\n    )\n    revenue_mult = st.slider(\n        \"Revenue Multiplier (x material cost)\",\n        min_value=1.5, max_value=8.0, value=4.0, step=0.5,\n        help=\"Unit Selling Price = Scrap Cost x Multiplier\",\n    )\n\n    st.divider()\n    if st.button(\"Clear Inspection Session\", use_container_width=True):\n        st.session_state.registry.clear()\n        st.session_state.annotated_images.clear()\n        st.success(\"Session cleared.\")\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Header\n# ─────────────────────────────────────────────────────────────────────────────\nst.markdown(\"\"\"\n# NEURAX 3.0 — Industrial Decision-Support System\n**Visual Inspection · Bottleneck Analysis · Root-Cause Correlation · Profitability**\n\"\"\")\n\nsummary    = st.session_state.registry.summary()\nanalyses   = st.session_state.analyses\nregistry   = st.session_state.registry\n\n# ── Top KPI strip ─────────────────────────────────────────────────────────────\nk1, k2, k3, k4, k5 = st.columns(5)\nk1.metric(\"Units Inspected\",  summary.get('total', 0))\nk2.metric(\"Defects Found\",    summary.get('defect', 0),\n          delta=f\"{summary.get('defect_rate', 0):.1f}% defect rate\",\n          delta_color=\"inverse\")\nk3.metric(\"Uncertain / Novel\",\n          f\"{summary.get('uncertain', 0)} / {summary.get('novel', 0)}\")\nk4.metric(\"Models Loaded\",    len(analyses))\nk5.metric(\"Model Status\",\n          \"Ready\" if st.session_state.yolo_model else \"Not Loaded\")\n\nst.divider()\n\n# ─────────────────────────────────────────────────────────────────────────────\n# TABS\n# ─────────────────────────────────────────────────────────────────────────────\ntab1, tab2, tab3, tab4 = st.tabs([\n    \"Quality Inspection\",\n    \"Production Flow\",\n    \"Root Cause Analysis\",\n    \"Profitability & Recommendations\",\n])\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 1 — QUALITY INSPECTION\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab1:\n    st.markdown(\"## Visual Defect Inspection\")\n    st.markdown(\"Upload product images to classify and localise defects using the trained YOLOv8 model.\")\n\n    # ── Upload & Batch Runner ─────────────────────────────────────────────────\n    uploaded_files = st.file_uploader(\n        \"Upload inspection image(s)\",\n        type=['jpg', 'jpeg', 'png', 'bmp', 'tiff'],\n        accept_multiple_files=True,\n        key=\"img_upload\",\n    )\n\n    if uploaded_files:\n        if not st.session_state.yolo_model:\n            st.error(\"YOLOv8 model not loaded. Check sidebar.\")\n        else:\n            if st.button(\"Run Visual Inspection on Batch\", type=\"primary\", use_container_width=True):\n                progress_bar = st.progress(0)\n                for i, f in enumerate(uploaded_files):\n                    img = Image.open(io.BytesIO(f.read())).convert('RGB')\n                    result = run_inference(img, st.session_state.yolo_model, conf_threshold)\n                    st.session_state.registry.add(f.name, result)\n                    st.session_state.annotated_images[f.name] = result\n                    progress_bar.progress((i + 1) / len(uploaded_files))\n\n                st.success(f\"Successfully inspected {len(uploaded_files)} unit(s).\")\n\n    # ── Results Section ───────────────────────────────────────────────────────\n    st.divider()\n    reg_df  = registry.to_dataframe()\n    summary = registry.summary()\n\n    if not reg_df.empty and st.session_state.annotated_images:\n        st.markdown(\"### Inspected Units Gallery & Defect Localization Grid\")\n        \n        # Filter buttons and Visualization Mode\n        filter_col1, filter_col2 = st.columns([1, 2])\n        with filter_col1:\n            gal_filter = st.selectbox(\n                \"Filter View\",\n                [\"All Units\", \"Defects Only\", \"Passed Units\", \"Uncertain / Novel\"],\n                key=\"gal_filter_sel\",\n            )\n        with filter_col2:\n            vis_mode = st.radio(\n                \"Display Mode\",\n                [\"Clean Industrial View\", \"Grad-CAM Heatmap\", \"Bounding Box\", \"Raw Image\"],\n                horizontal=True,\n                key=\"vis_mode_sel\",\n            )\n\n        # Filter items\n        items = list(st.session_state.annotated_images.items())\n        if gal_filter == \"Defects Only\":\n            items = [it for it in items if it[1]['status'] == 'DEFECT']\n        elif gal_filter == \"Passed Units\":\n            items = [it for it in items if it[1]['status'] == 'PASS']\n        elif gal_filter == \"Uncertain / Novel\":\n            items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n\n        if not items:\n            st.info(f\"No units match filter: '{gal_filter}'\")\n        else:\n            # Render in 3-column Grid\n            num_cols = 3\n            for row_idx in range(0, len(items), num_cols):\n                row_items = items[row_idx:row_idx + num_cols]\n                cols = st.columns(num_cols)\n                for col_idx, (fname, res) in enumerate(row_items):\n                    with cols[col_idx]:\n                        stat = res['status']\n                        dtype = res['defect_type'].upper()\n                        conf = res['confidence'] * 100\n                        bbox = res.get('bbox')\n                        \n                        # Card Header\n                        st.markdown(f\"\"\"\n<div style=\"background:#1a1f2e; border-radius:10px; padding:10px; border-top: 4px solid {'#e74c3c' if stat=='DEFECT' else '#2ecc71' if stat=='PASS' else '#f39c12'}; margin-bottom:10px;\">\n    <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n        <span style=\"font-weight:600; font-size:13px; color:#ecf0f1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:180px;\">{fname}</span>\n        <span class=\"badge badge-{stat}\">{stat}</span>\n    </div>\n</div>\n\"\"\", unsafe_allow_html=True)\n                        \n                        # Display chosen overlay image\n                        if vis_mode == \"Grad-CAM Heatmap\" and res.get('heatmap_image'):\n                            st.image(res['heatmap_image'], use_container_width=True)\n                        elif vis_mode == \"Bounding Box\" and res.get('boxed_image'):\n                            st.image(res['boxed_image'], use_container_width=True)\n                        elif vis_mode == \"Raw Image\" and res.get('raw_image'):\n                            st.image(res['raw_image'], use_container_width=True)\n                        elif res.get('annotated_image'):\n                            st.image(res['annotated_image'], use_container_width=True)\n\n                        st.markdown(f\"**Defect:** `{dtype}` | **Conf:** `{conf:.1f}%`\")\n                        if bbox and vis_mode == \"Bounding Box\":\n                            x1, y1, x2, y2 = [int(v) for v in bbox]\n                            st.caption(f\"Box: `[{x1}, {y1}, {x2}, {y2}]` ({x2-x1}x{y2-y1}px)\")\n                        else:\n                            st.caption(f\"Status: **{stat}** (AI Classification)\")\n\n                        # Class probability breakdown\n                        if res.get('class_probs'):\n                            with st.expander(\"Probabilities Breakdown\"):\n                                for c_name, c_prob in sorted(res['class_probs'].items(), key=lambda x: x[1], reverse=True):\n                                    st.progress(min(1.0, float(c_prob)), text=f\"{c_name.capitalize()}: {c_prob*100:.1f}%\")\n\n        st.divider()\n\n        # ── Summary Charts & Logs ─────────────────────────────────────────────\n        st.markdown(\"### Batch Quality Analytics & Inspection Log\")\n        r1, r2 = st.columns([1, 2])\n\n        with r1:\n            st.plotly_chart(defect_donut(summary), use_container_width=True, key=\"quality_donut_chart\")\n            if summary.get('by_type'):\n                st.plotly_chart(defect_type_bar(summary['by_type']), use_container_width=True, key=\"quality_type_bar_chart\")\n\n        with r2:\n            st.markdown(\"#### Detailed Inspection Table\")\n            styled = reg_df.copy()\n            styled['Status'] = styled['status']\n            st.dataframe(\n                styled[['unit_id', 'image_name', 'defect_type', 'confidence', 'Status', 'timestamp']],\n                use_container_width=True, height=260,\n            )\n            if len(reg_df) >= 3:\n                drift_df = registry.drift_dataframe()\n                st.plotly_chart(defect_trend(drift_df), use_container_width=True, key=\"quality_defect_trend_chart\")\n\n        # ── Confidence histogram ───────────────────────────────────────────\n        if len(reg_df[reg_df['status'] != 'PASS']) > 0:\n            st.plotly_chart(confidence_histogram(reg_df), use_container_width=True, key=\"quality_conf_hist_chart\")\n\n        # ── Novel / Uncertain flag table ───────────────────────────────────\n        flagged = flag_novel(reg_df)\n        if not flagged.empty:\n            st.warning(f\"**{len(flagged)} unit(s) flagged for human review** (UNCERTAIN or NOVEL detections)\")\n            st.dataframe(flagged, use_container_width=True)\n    else:\n        st.info(\"Upload images above and click 'Run Visual Inspection on Batch' to populate the inspection grid.\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 2 — PRODUCTION FLOW\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab2:\n    st.markdown(\"## Production Flow Health\")\n    st.markdown(\n        \"Theory of Constraints analysis across Drilling -> Milling -> Assembly stations \"\n        \"using Rockwell Arena simulation data.\"\n    )\n\n    if not analyses:\n        st.info(\"Upload Model 1/2/3 CSV files in the sidebar to begin.\")\n    else:\n        model_names = list(analyses.keys())\n        sel_model   = st.selectbox(\"Select model to inspect\", model_names, index=0)\n        analysis    = analyses.get(sel_model)\n\n        if analysis is None:\n            st.error(f\"Could not parse {sel_model}. Check column names.\")\n        else:\n            # ── Key metrics strip ──────────────────────────────────────────────\n            m1, m2, m3, m4 = st.columns(4)\n            m1.metric(\"Demand\",         f\"{analysis['demand']:.0f} units\")\n            m2.metric(\"Parts Produced\", f\"{analysis['total_parts']:.0f} units\")\n            m3.metric(\"Throughput\",     f\"{analysis['throughput_efficiency']:.1f}%\",\n                      delta=f\"{analysis['throughput_gap']:.0f} units short\",\n                      delta_color=\"inverse\")\n            m4.metric(\"Parts / Hour\",   f\"{analysis['parts_per_hour']:.1f}\")\n\n            st.divider()\n\n            # ── Bottleneck spotlight ───────────────────────────────────────────\n            bn = analysis['bottleneck_station']\n            bu = analysis['bottleneck_util'] * 100\n            bw = analysis['bottleneck_wait']\n\n            if bu > 85:\n                level = \"CRITICAL\"\n            elif bu > 70:\n                level = \"WARNING\"\n            else:\n                level = \"OPTIMAL\"\n\n            st.markdown(f\"\"\"\n<div class=\"metric-card {'red' if level == 'CRITICAL' else 'orange' if level == 'WARNING' else 'green'}\">\n  <h3>Bottleneck: <b>{bn} Station</b>  &nbsp;\n    <span style=\"color:{'#e74c3c' if level=='CRITICAL' else '#f39c12'}\">[{level}]</span>\n  </h3>\n  <p>\n    <b>Utilisation:</b> {bu:.1f}% &nbsp;|&nbsp;\n    <b>Avg. Waiting Time:</b> {bw:.1f} min &nbsp;|&nbsp;\n    <b>Throughput Gap:</b> {analysis['throughput_gap']:.0f} units\n  </p>\n  <p><i>Elevating this station's capacity is the single highest-leverage improvement action (Theory of Constraints).</i></p>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            # ── Station charts ─────────────────────────────────────────────────\n            ch1, ch2 = st.columns(2)\n            with ch1:\n                st.plotly_chart(utilization_bar(analysis['stations'], sel_model),\n                                use_container_width=True, key=f\"flow_util_{sel_model}\")\n            with ch2:\n                st.plotly_chart(waiting_time_bar(analysis['stations'], sel_model),\n                                use_container_width=True, key=f\"flow_wait_{sel_model}\")\n\n            # ── WIP Estimate ───────────────────────────────────────────────────\n            wip = estimate_wip(analysis)\n            if any(v > 0 for v in wip.values()):\n                st.markdown(\"#### Estimated WIP (Little's Law)\")\n                wip_cols = st.columns(len(wip))\n                for col, (station, count) in zip(wip_cols, wip.items()):\n                    col.metric(f\"{station} WIP\", f\"~{count:.0f} parts\")\n\n            st.divider()\n\n            # ── Multi-model comparison table ───────────────────────────────────\n            if len(analyses) > 1:\n                st.markdown(\"#### Model Comparison\")\n                comp_df = compare_models(analyses)\n                st.dataframe(comp_df, use_container_width=True)\n\n                if len(analyses) >= 2:\n                    st.plotly_chart(multi_model_radar(analyses), use_container_width=True, key=\"flow_radar_chart\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 3 — ROOT CAUSE ANALYSIS\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab3:\n    st.markdown(\"## Root-Cause Analysis\")\n    st.markdown(\n        \"Evidence-based correlation between observed defect patterns and \"\n        \"process station conditions.\"\n    )\n\n    no_quality = registry.to_dataframe().empty\n    no_process = not analyses\n\n    if no_quality and no_process:\n        st.info(\"Upload images (Tab 1) and CSV files (sidebar) to unlock root-cause analysis.\")\n    else:\n        rc_model = st.selectbox(\n            \"Select production model for correlation\",\n            list(analyses.keys()) if analyses else ['No model loaded'],\n            key='rc_model_sel',\n        )\n        rc_analysis  = analyses.get(rc_model) if analyses else None\n        rc_defect_sum = registry.summary()\n\n        evidence = correlate(rc_analysis, rc_defect_sum if not no_quality else None)\n\n        if not evidence:\n            st.success(\"No critical correlations detected at current thresholds.\")\n        else:\n            st.markdown(f\"### {len(evidence)} Causal Correlation(s) Identified\")\n            for card in evidence:\n                conf  = card['confidence']\n                obs   = card['defect_observed']\n                cls   = conf\n                html = f\"\"\"\n<div class=\"evidence-card {cls}\">\n  <b>CAUSE: {card['cause']}</b>\n  <span class=\"badge badge-{conf}\" style=\"float:right\">{conf} CONFIDENCE</span><br>\n  <small><b>Evidence:</b> {card['evidence']}</small><br>\n  <small><b>Related Defects:</b> {', '.join(card['related_defects']) if card['related_defects'] else 'General throughput issue'}\n  {'&nbsp; <span class=\"badge badge-DEFECT\">OBSERVED</span>' if obs else ''}</small><br>\n  <hr style=\"margin:8px 0; border-color:#334\">\n  <small><b>Recommended Action:</b> {card['action']}</small>\n</div>\n\"\"\"\n                st.markdown(html, unsafe_allow_html=True)\n\n        st.divider()\n\n        # ── Drift analysis ─────────────────────────────────────────────────────\n        st.markdown(\"### Defect Rate Drift Analysis\")\n        if no_quality or len(registry) < 2:\n            st.info(\"Inspect at least 2 units to see drift trends.\")\n        else:\n            drift_df_raw = registry.drift_dataframe()\n            drift        = drift_analysis(drift_df_raw)\n\n            if drift:\n                dc1, dc2, dc3 = st.columns(3)\n                dc1.metric(\"Trend Direction\", drift['trend'])\n                dc2.metric(\"Slope\", f\"{drift['slope']:+.2f} pp/unit\")\n                dc3.metric(\"Units Needing Review\",\n                           drift['novel_count'] + drift['uncertain_count'])\n\n                st.plotly_chart(defect_trend(drift['df']), use_container_width=True, key=\"rootcause_defect_trend_chart\")\n\n        # ── Novel / Uncertain summary ──────────────────────────────────────────\n        if not no_quality:\n            flagged = flag_novel(registry.to_dataframe())\n            if not flagged.empty:\n                st.warning(f\"### {len(flagged)} Novel / Uncertain Unit(s) — Human Review Required\")\n                st.markdown(\n                    \"These units have confidence scores below the classification threshold. \"\n                    \"They may represent **new defect types** not seen during training.\"\n                )\n                st.dataframe(flagged, use_container_width=True)\n            else:\n                st.success(\"No novel or uncertain defect patterns detected.\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 4 — PROFITABILITY & RECOMMENDATIONS\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab4:\n    st.markdown(\"## Profitability & What-If Simulator\")\n    st.markdown(\n        \"Convert operational telemetry into financial impact estimates. \"\n        \"Use the sliders to simulate process improvement ROI.\"\n    )\n\n    if not analyses:\n        st.info(\"Upload production CSV files (sidebar) to unlock financial modelling.\")\n    else:\n        fin_model = st.selectbox(\n            \"Select model for financial analysis\",\n            list(analyses.keys()),\n            key='fin_model_sel',\n        )\n        fin_analysis  = analyses.get(fin_model)\n        fin_defect_sum = registry.summary() if not registry.to_dataframe().empty else None\n\n        if fin_analysis is None:\n            st.error(\"Could not load analysis for selected model.\")\n        else:\n            baseline = compute_financials(\n                fin_analysis, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult\n            )\n\n            # ── Baseline KPIs ──────────────────────────────────────────────────\n            st.markdown(\"### Baseline Financial Snapshot\")\n            fb1, fb2, fb3, fb4, fb5 = st.columns(5)\n            fb1.metric(\"Gross Revenue\",    f\"${baseline['gross_revenue']:,.0f}\")\n            fb2.metric(\"Scrap Loss\",       f\"${baseline['scrap_loss']:,.0f}\",    delta_color=\"inverse\")\n            fb3.metric(\"Idle Loss\",        f\"${baseline['bottleneck_idle_loss']:,.0f}\", delta_color=\"inverse\")\n            fb4.metric(\"Opportunity Loss\", f\"${baseline['opportunity_loss']:,.0f}\", delta_color=\"inverse\")\n            fb5.metric(\"Net Margin\",\n                       f\"${baseline['net_margin']:,.0f}\",\n                       delta=f\"{baseline['margin_pct']:.1f}%\",\n                       delta_color=\"normal\" if baseline['net_margin'] > 0 else \"inverse\")\n\n            wf1, wf2 = st.columns([3, 2])\n            with wf1:\n                st.plotly_chart(financial_waterfall(baseline, fin_model), use_container_width=True, key=f\"fin_waterfall_{fin_model}\")\n\n            with wf2:\n                st.markdown(\"#### Loss Breakdown\")\n                loss_items = {\n                    \"Scrap Material Loss\": baseline['scrap_loss'],\n                    \"Bottleneck Idle Cost\": baseline['bottleneck_idle_loss'],\n                    \"Opportunity Loss\": baseline['opportunity_loss'],\n                    \"Rework Cost\": baseline['rework_cost'],\n                }\n                for label, val in loss_items.items():\n                    pct = val / baseline['total_loss'] * 100 if baseline['total_loss'] else 0\n                    st.markdown(f\"\"\"\n<div class=\"metric-card red\">\n  <b>{label}</b><br>\n  <span style=\"font-size:20px; color:#e74c3c\">${val:,.2f}</span>\n  <span style=\"color:#95a5a6\"> ({pct:.0f}%)</span>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            st.divider()\n\n            # ── What-If Simulator ──────────────────────────────────────────────\n            st.markdown(\"### What-If Scenario Simulator\")\n            col_s1, col_s2 = st.columns(2)\n            with col_s1:\n                util_impr = st.slider(\n                    \"Bottleneck Wait Time Reduction (%)\",\n                    0, 50, 15, step=5,\n                    help=\"Simulates reducing bottleneck idle time via capacity elevation.\",\n                )\n            with col_s2:\n                scrap_redn = st.slider(\n                    \"Defect / Scrap Rate Reduction (%)\",\n                    0, 80, 20, step=5,\n                    help=\"Simulates quality improvements reducing defect rate.\",\n                )\n\n            wi_result = what_if(\n                fin_analysis, fin_defect_sum,\n                scrap_cost, downtime_cost,\n                util_impr, scrap_redn, revenue_mult,\n            )\n            delta = impact_delta(baseline, wi_result)\n\n            w1, w2, w3 = st.columns(3)\n            w1.metric(\"Projected Net Margin\",\n                      f\"${wi_result['net_margin']:,.0f}\",\n                      delta=f\"+${delta['delta_margin']:,.0f} vs baseline\",\n                      delta_color=\"normal\")\n            w2.metric(\"Total Loss Saved\",\n                      f\"${delta['delta_loss_saved']:,.0f}\",\n                      delta=f\"{delta['margin_improvement_pct']:+.1f}% margin lift\")\n            w3.metric(\"Projected Scrap Units\",\n                      f\"{wi_result['scrap_units']:.0f}\",\n                      delta=f\"{baseline['scrap_units'] - wi_result['scrap_units']:.0f} fewer\",\n                      delta_color=\"inverse\")\n\n            # Compare all models\n            if len(analyses) > 1:\n                st.divider()\n                st.markdown(\"#### Multi-Model Financial Comparison\")\n                all_results = {}\n                for name, an in analyses.items():\n                    if an is None:\n                        continue\n                    b = compute_financials(an, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult)\n                    wi = what_if(an, fin_defect_sum, scrap_cost, downtime_cost,\n                                 util_impr, scrap_redn, revenue_mult)\n                    all_results[name] = {'baseline': b, 'whatif': wi}\n\n                st.plotly_chart(margin_comparison_bar(all_results), use_container_width=True, key=\"fin_margin_comp_chart\")\n\n            st.divider()\n\n            # ── Recommendations ────────────────────────────────────────────────\n            st.markdown(\"### Top Recommendations\")\n\n            # Build recommendation list from evidence + financial impact\n            recs = []\n            evidence = correlate(fin_analysis, fin_defect_sum)\n            for card in evidence[:3]:\n                recs.append({\n                    'priority': card['confidence'],\n                    'title':    card['cause'],\n                    'action':   card['action'],\n                    'impact':   \"Estimated loss reduction via defect/idle reduction\",\n                })\n\n            # Add throughput-based recommendation\n            if fin_analysis.get('throughput_gap', 0) > 10:\n                recs.insert(0, {\n                    'priority': 'HIGH',\n                    'title':    f\"Elevate {fin_analysis['bottleneck_station']} station capacity\",\n                    'action':   (\n                        f\"{fin_analysis['bottleneck_station']} is at \"\n                        f\"{fin_analysis['bottleneck_util']*100:.0f}% utilisation — the system constraint. \"\n                        \"Add capacity here first (overtime, tooling, parallel setup). \"\n                        f\"Closing the {fin_analysis['throughput_gap']:.0f}-unit gap could recover \"\n                        f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} revenue.\"\n                    ),\n                    'impact': f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} opportunity recovery\",\n                })\n\n            priority_labels = {'HIGH': '[HIGH PRIORITY]', 'MEDIUM': '[MEDIUM PRIORITY]', 'LOW': '[LOW PRIORITY]'}\n            for i, rec in enumerate(recs[:4], 1):\n                p = rec['priority']\n                st.markdown(f\"\"\"\n<div class=\"evidence-card {p}\">\n  <b>{priority_labels.get(p,'')}&nbsp; #{i} — {rec['title']}</b>\n  <span class=\"badge badge-{p}\" style=\"float:right\">{p}</span><br>\n  <small>{rec['action']}</small><br>\n  <small style=\"color:#2ecc71\">Expected Impact: {rec.get('impact','—')}</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            if not recs:\n                st.success(\"No high-priority recommendations at current thresholds.\")\n\n            # ── Download report ────────────────────────────────────────────────\n            st.divider()\n            report_lines = [\n                \"# NEURAX 3.0 — Analysis Report\",\n                f\"\\n## Quality Summary\",\n                f\"- Total Inspected: {summary.get('total',0)}\",\n                f\"- Defects: {summary.get('defect',0)} ({summary.get('defect_rate',0):.1f}%)\",\n                f\"- Uncertain: {summary.get('uncertain',0)} | Novel: {summary.get('novel',0)}\",\n                f\"\\n## Production Flow ({fin_model})\",\n                f\"- Demand: {fin_analysis['demand']} | Produced: {fin_analysis['total_parts']}\",\n                f\"- Throughput Efficiency: {fin_analysis['throughput_efficiency']:.1f}%\",\n                f\"- Bottleneck: {fin_analysis['bottleneck_station']} @ {fin_analysis['bottleneck_util']*100:.1f}%\",\n                f\"\\n## Financial Snapshot\",\n                f\"- Gross Revenue: ${baseline['gross_revenue']:,.2f}\",\n                f\"- Total Losses: ${baseline['total_loss']:,.2f}\",\n                f\"- Net Margin: ${baseline['net_margin']:,.2f} ({baseline['margin_pct']:.1f}%)\",\n                f\"\\n## What-If Scenario ({util_impr}% idle reduction, {scrap_redn}% scrap reduction)\",\n                f\"- Projected Margin: ${wi_result['net_margin']:,.2f}\",\n                f\"- Improvement: +${delta['delta_margin']:,.2f} (+{delta['margin_improvement_pct']:.1f}%)\",\n                f\"\\n## Recommendations\",\n            ]\n            for i, rec in enumerate(recs[:4], 1):\n                report_lines.append(f\"{i}. [{rec['priority']}] {rec['title']}: {rec['action']}\")\n\n            report_text = \"\\n\".join(report_lines)\n            st.download_button(\n                \"Download Analysis Report (.md)\",\n                data=report_text,\n                file_name=\"neurax_report.md\",\n                mime=\"text/markdown\",\n                use_container_width=True,\n                type=\"primary\",\n            )\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Footer\n# ─────────────────────────────────────────────────────────────────────────────\nst.divider()\nst.markdown(\n    \"<center><small>NEURAX 3.0 · NEURAX HACKATHON 3.0 · Domain 2: AI in Industry & Automation</small></center>\",\n    unsafe_allow_html=True,\n)\n","Description":"Clean professional app.py completely stripped of all emojis","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\app.py","toolAction":"Removing emojis from app.py","toolSummary":"Remove emojis across UI"}}]}
