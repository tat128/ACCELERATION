\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":372,\"LineContent\":\"        # ── Confidence histogram ───────────────────────────────────────────\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":376,\"LineContent\":\"        # ── Novel / Uncertain flag table ───────────────────────────────────\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":384,\"LineContent\":\"# ═════════════════════════════════════════════════════════════════════════════\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":385,\"LineContent\":\"# TAB 2 — PRODUCTION FLOW\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":386,\"LineContent\":\"# ═════════════════════════════════════════════════════════════════════════════\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app.py\",\"LineNumber\":404,\"LineContent\":\"            # ── Key metrics strip ──────────────────────────────────────────────\"}\n{\"File\":\"C:\\\\Users\\\\win-10\\\\.gemini\\\\antigravity\\\\scratch\\\\neurax_app\\\\app