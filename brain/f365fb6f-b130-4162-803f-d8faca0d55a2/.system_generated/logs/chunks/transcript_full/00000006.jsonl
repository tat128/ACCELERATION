o inspect\", model_names, index=0)\n406:         analysis    = analyses.get(sel_model)\n407: \n408:         if analysis is None:\n409:             st.error(f\"Could not parse {sel_model}. Check column names.\")\n410:         else:\n411:             # ── Key metrics strip ──────────────────────────────────────────────\n412:             m1, m2, m3, m4 = st.columns(4)\n413:             m1.metric(\"Demand\",         f\"{analysis['demand']:.0f} units\")\n414:             m2.metric(\"Parts Produced\", f\"{analysis['total_parts']:.0f} units\")\n415:             m3.metric(\"Throughput\",     f\"{analysis['throughput_efficiency']:.1f}%\",\n416:                       delta=f\"{analysis['throughput_gap']:.0f} units short\",\n417:                       delta_color=\"inverse\")\n418:             m4.metric(\"Parts / Hour\",   f\"{analysis['parts_per_hour']:.1f}\")\n419: \n420:             st.divider()\n421: \n422:             # ── Bottleneck spotlight ───────────────────────────────────────────\n423:             bn = analysis['bottleneck_station']\n424:             bu = analysis['bottleneck_util'] * 100\n425:             bw = analysis['bottleneck_wait']\n426: \n427:             if bu > 85:\n428:                 level, icon = \"CRITICAL\", \"🔴\"\n429:             elif bu > 70:\n430:                 level, icon = \"WARNING\",  \"🟡\"\n431:             else:\n432:                 level, icon = \"OK\",       \"🟢\"\n433: \n434:             st.markdown(f\"\"\"\n435: <div class=\"metric-card {'red' if level == 'CRITICAL' else 'orange' if level == 'WARNING' else 'green'}\">\n436:   <h3>{icon} Bottleneck: <b>{bn} Station</b>  &nbsp;\n437:     <span style=\"color:{'#e74c3c' if level=='CRITICAL' else '#f39c12'}\">{level}</span>\n438:   </h3>\n439:   <p>\n440:     <b>Utilisation:</b> {bu:.1f}% &nbsp;|&nbsp;\n441:     <b>Avg. Waiting Time:</b> {bw:.1f} min &nbsp;|&nbsp;\n442:     <b>Throughput Gap:</b> {analysis['throughput_gap']:.0f} units\n443:   </p>\n444:   <p><i>Elevating this station's capacity is the single highest-leverage improvement action (Theory of Constraints).</i></p>\n445: </div>\n446: \"\"\", unsafe_allow_html=True)\n447: \n448:             # ── Station charts ─────────────────────────────────────────────────\n449:             ch1, ch2 = st.columns(2)\n450:             with ch1:\n451:                 st.plotly_chart(utilization_bar(analysis['stations'], sel_model),\n452:                                 use_container_width=True, key=f\"flow_util_{sel_model}\")\n453:             with ch2:\n454:                 st.plotly_chart(waiting_time_bar(analysis['stations'], sel_model),\n455:                                 use_container_width=True, key=f\"flow_wait_{sel_model}\")\n456: \n457:             # ── WIP Estimate ───────────────────────────────────────────────────\n458:             wip = estimate_wip(analysis)\n459:             if any(v > 0 for v in wip.values()):\n460:                 st.markdown(\"#### 📦 Estimated WIP (Little's Law)\")\n461:                 wip_cols = st.columns(len(wip))\n462:                 for col, (station, count) in zip(wip_cols, wip.items()):\n463:                     col.metric(f\"{station} WIP\", f\"~{count:.0f} parts\")\n464: \n465:             st.divider()\n466: \n467:             # ── Multi-model comparison table ───────────────────────────────────\n468:             if len(analyses) > 1:\n469:                 st.markdown(\"#### 📊 Model Comparison\")\n470:                 comp_df = compare_models(analyses)\n471:                 st.dataframe(comp_df, use_container_width=True)\n472: \n473:                 if len(analyses) >= 2:\n474:                     st.plotly_chart(multi_model_radar(analyses), use_container_width=True, key=\"flow_radar_chart\")\n475: \n476: # ═════════════════════════════════════════════════════════════════════════════\n477: # TAB 3 — ROOT CAUSE ANALYSIS\n478: # ═════════════════════════════════════════════════════════════════════════════\n479: with tab3:\n480:     st.markdown(\"## 🔎 Root-Cause Analysis\")\n481:     st.markdown(\n482:         \"Evidence-based correlation between observed defect patterns and \"\n483:         \"process station conditions.\"\n484:     )\n485: \n486:     no_quality = registry.to_dataframe().empty\n487:     no_process = not analyses\n488: \n489:     if no_quality and no_process:\n490:         st.info(\"Upload images (Tab 1) and CSV files (sidebar) to unlock root-cause analysis.\")\n491:     else:\n492:         rc_model = st.selectbox(\n493:             \"Select production model for correlation\",\n494:             list(analyses.keys()) if analyses else ['No model loaded'],\n495:             key='rc_model_sel',\n496:         )\n497:         rc_analysis  = analyses.get(rc_model) if analyses else None\n498:         rc_defect_sum = registry.summary()\n499: \n500:         evidence = correlate(rc_analysis, rc_defect_sum if not no_quality else None)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
