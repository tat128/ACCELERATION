:                 model = YOLO(path)\n47:                 _model_cache[path] = model\n48:                 return model, None\n49:             except Exception as exc:\n50:                 return None, f\"Failed to load {path}: {exc}\"\n51: \n52:     checked = [p for p in search_paths if p]\n53:     return None, (\n54:         f\"Model weights not found.\\n\"\n55:         f\"Checked:\\n\" + \"\\n\".join(f\"  • {p}\" for p in checked) +\n56:         \"\\n\\nPlace best.pt at D:\\\\acceleration\\\\best.pt or upload below.\"\n57:     )\n58: \n59: \n60: # ── Inference ─────────────────────────────────────────────────────────────────\n61: \n62: def run_inference(\n63:     image_input,\n64:     model=None,\n65:     conf_threshold: float = CONFIDENCE_THRESHOLD,\n66: ) -> dict:\n67:     \"\"\"\n68:     Run YOLOv8 on one image (PIL Image, file path, or uploaded bytes).\n69: \n70:     Returns\n71:     -------\n72:     dict with keys:\n73:         status          PASS | DEFECT | UNCERTAIN | NOVEL | ERROR\n74:         defect_type     primary class name\n75:         confidence      float 0-1\n76:         bbox            [x1,y1,x2,y2] or None (classification mode)\n77:         all_detections  list of raw detection dicts\n78:         annotated_image PIL Image\n79:         error           str (only when status == ERROR)\n80:     \"\"\"\n81:     # ── Load model if not supplied ────────────────────────────────────────────\n82:     if model is None:\n83:         model, err = load_model()\n84:         if model is None:\n85:             return {'status': 'ERROR', 'error': err,\n86:                     'defect_type': 'unknown', 'confidence': 0.0,\n87:                     'bbox': None, 'all_detections': [],\n88:                     'annotated_image': None}\n89: \n90:     # ── Convert input to PIL Image ────────────────────────────────────────────\n91:     if isinstance(image_input, Image.Image):\n92:         img = image_input.convert('RGB')\n93:     else:\n94:         try:\n95:             img = Image.open(image_input).convert('RGB')\n96:         except Exception as exc:\n97:             return {'status': 'ERROR', 'error': str(exc),\n98:                     'defect_type': 'unknown', 'confidence': 0.0,\n99:                     'bbox': None, 'all_detections': [],\n100:                     'annotated_image': None}\n101: \n102:     # ── Run YOLO ──────────────────────────────────────────────────────────────\n103:     try:\n104:         results = model(img, verbose=False)\n105:     except Exception as exc:\n106:         return {'status': 'ERROR', 'error': f'Inference error: {exc}',\n107:                 'defect_type': 'unknown', 'confidence': 0.0,\n108:                 'bbox': None, 'all_detections': [],\n109:                 'annotated_image': annotate_image(img, [], 'ERROR')}\n110: \n111:     result = results[0]\n112:     detections: list[dict] = []\n113: \n114:     # Detection mode (bounding boxes)\n115:     if hasattr(result, 'boxes') and result.boxes is not None and len(result.boxes) > 0:\n116:         for box in result.boxes:\n117:             cls_id  = int(box.cls[0].item())\n118:             conf    = float(box.conf[0].item())\n119:             cls_name = (result.names or {}).get(cls_id, DEFECT_CLASSES[cls_id] if cls_id < len(DEFECT_CLASSES) else 'unknown')\n120:             detections.append({\n121:                 'defect_type': cls_name.lower(),\n122:                 'confidence':  conf,\n123:                 'bbox':        box.xyxy[0].tolist(),\n124:             })\n125: \n126:     # Classification mode (softmax probs)\n127:     elif hasattr(result, 'probs') and result.probs is not None:\n128:         probs    = result.probs.data.cpu().tolist()\n129:         top_cls  = int(result.probs.top1)\n130:         top_conf = float(result.probs.top1conf.item())\n131:         cls_name = (result.names or {}).get(top_cls, DEFECT_CLASSES[top_cls] if top_cls < len(DEFECT_CLASSES) else 'unknown')\n132:         detections.append({\n133:             'defect_type': cls_name.lower(),\n134:             'confidence':  top_conf,\n135:             'bbox':        None,\n136:         })\n137: \n138:     # ── Determine status ──────────────────────────────────────────────────────\n139:     if not detections:\n140:         status        = 'PASS'\n141:         primary_type  = 'normal'\n142:         primary_conf  = 1.0\n143:         primary_bbox  = None\n144:     else:\n145:         # Sort by confidence descending; surface highest-concern defect first\n146:         concern_first = sorted(\n147:             detections,\n148:             key=lambda d: (d['defect_type'] != 'normal', d['confidence']),\n149:             reverse=True,\n150:         )\n151:         top = concern_first[0]\n152:         primary_type = top['defect_type']\n153:         primary_conf = top['confidence']\n154:         primary_bbox = top['bbox']\n155: \n156:         if primary_conf < NOVEL_THRESHOLD:\n157:             status = 'NOVEL'\n158:         elif primary_conf < conf_threshold:\n159:             status = 'UNCERTAIN'\n160:         elif primary_type == 'normal':\n161:             status = 'PASS'\n162:         else:\n163:             status = 'DEFECT'\n164: \n165:     annotated = annotate_image(img.copy(), detections, status)\n166: \n167:     return {\n168:         'status':          status,\n169:         'defect_type':     primary_type,\n170:         'confidence':      primary_conf,\n171:         'bbox':            primary_bbox,\n172:         'all_detections':  detections,\n173:         'annotated_image': annotated,\n174:     }\n175: \n176: \n177: # ── Image Annotation ──────────────────────────────────────────────────────────\n178: \n179: def annotate_image(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n180:     \"\"\"Draw boxes, labels, and a status badge onto the image.\"\"\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
