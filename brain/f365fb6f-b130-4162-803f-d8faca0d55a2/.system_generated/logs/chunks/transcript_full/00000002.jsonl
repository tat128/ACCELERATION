─────────\n        st.markdown(\"### 📈 Defect Rate Drift Analysis\")\n        if no_quality or len(registry) < 2:\n            st.info(\"Inspect at least 2 units to see drift trends.\")\n        else:\n            drift_df_raw = registry.drift_dataframe()\n            drift        = drift_analysis(drift_df_raw)\n\n            if drift:\n                dc1, dc2, dc3 = st.columns(3)\n                dc1.metric(\"Trend Direction\", drift['trend'])\n                dc2.metric(\"Slope\", f\"{drift['slope']:+.2f} pp/unit\")\n                dc3.metric(\"Units Needing Review\",\n                           drift['novel_count'] + drift['uncertain_count'])\n\n                st.plotly_chart(defect_trend(drift['df']), use_container_width=True, key=\"rootcause_defect_trend_chart\")\n\n        # ── Novel / Uncertain summary ──────────────────────────────────────────\n        if not no_quality:\n            flagged = flag_novel(registry.to_dataframe())\n            if not flagged.empty:\n                st.warning(f\"### 🟣 {len(flagged)} Novel / Uncertain Unit(s) — Human Review Required\")\n                st.markdown(\n                    \"These units have confidence scores below the classification threshold. \"\n                    \"They may represent **new defect types** not seen during training.\"\n                )\n                st.dataframe(flagged, use_container_width=True)\n            else:\n                st.success(\"✅ No novel or uncertain defect patterns detected.\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 4 — PROFITABILITY & RECOMMENDATIONS\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab4:\n    st.markdown(\"## 💰 Profitability & What-If Simulator\")\n    st.markdown(\n        \"Convert operational telemetry into financial impact estimates. \"\n        \"Use the sliders to simulate process improvement ROI.\"\n    )\n\n    if not analyses:\n        st.info(\"Upload production CSV files (sidebar) to unlock financial modelling.\")\n    else:\n        fin_model = st.selectbox(\n            \"Select model for financial analysis\",\n            list(analyses.keys()),\n            key='fin_model_sel',\n        )\n        fin_analysis  = analyses.get(fin_model)\n        fin_defect_sum = registry.summary() if not registry.to_dataframe().empty else None\n\n        if fin_analysis is None:\n            st.error(\"Could not load analysis for selected model.\")\n        else:\n            baseline = compute_financials(\n                fin_analysis, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult\n            )\n\n            # ── Baseline KPIs ──────────────────────────────────────────────────\n            st.markdown(\"### 📋 Baseline Financial Snapshot\")\n            fb1, fb2, fb3, fb4, fb5 = st.columns(5)\n            fb1.metric(\"Gross Revenue\",    f\"${baseline['gross_revenue']:,.0f}\")\n            fb2.metric(\"Scrap Loss\",       f\"${baseline['scrap_loss']:,.0f}\",    delta_color=\"inverse\")\n            fb3.metric(\"Idle Loss\",        f\"${baseline['bottleneck_idle_loss']:,.0f}\", delta_color=\"inverse\")\n            fb4.metric(\"Opportunity Loss\", f\"${baseline['opportunity_loss']:,.0f}\", delta_color=\"inverse\")\n            fb5.metric(\"Net Margin\",\n                       f\"${baseline['net_margin']:,.0f}\",\n                       delta=f\"{baseline['margin_pct']:.1f}%\",\n                       delta_color=\"normal\" if baseline['net_margin'] > 0 else \"inverse\")\n\n            wf1, wf2 = st.columns([3, 2])\n            with wf1:\n                st.plotly_chart(financial_waterfall(baseline, fin_model), use_container_width=True, key=f\"fin_waterfall_{fin_model}\")\n\n            with wf2:\n                st.markdown(\"#### Loss Breakdown\")\n                loss_items = {\n                    \"Scrap Material Loss\": baseline['scrap_loss'],\n                    \"Bottleneck Idle Cost\": baseline['bottleneck_idle_loss'],\n                    \"Opportunity Loss\": baseline['opportunity_loss'],\n                    \"Rework Cost\": baseline['rework_cost'],\n                }\n                for label, val in loss_items.items():\n                    pct = val / baseline['total_loss'] * 100 if baseline['total_loss'] else 0\n                    st.markdown(f\"\"\"\n<div class=\"metric-card red\">\n  <b>{label}</b><br>\n  <span style=\"font-size:20px; color:#e74c3c\">${val:,.2f}</span>\n  <span style=\"color:#95a5a6\"> ({pct:.0f}%)</span>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            st.divider()\n\n            # ── What-If Simulator ──────────────────────────────────────────────\n            st.markdown(\"### 🎛️ What-If Scenario Simulator\")\n            col_s1, col_s2 = st.columns(2)\n            with col_s1:\n                util_impr = st.slider(\n                    \"Bottleneck Wait Time Reduction (%)\",\n                    0, 50, 15, step=5,\n                    help=\"Simulates reducing bottleneck idle time via capacity elevation.\",\n                )\n            with col_s2:\n                scrap_redn = st.slider(\n                    \"Defect / Scrap Rate Reduction (%)\",\n                    0, 80, 20, step=5,\n                    help=\"Simulates quality improvements reducing defect rate.\",\n                )\n\n            wi_result = what_if(\n                fin_analysis, fin_defect_sum,\n                scrap_cost, downtime_cost,\n                util_impr, scrap_redn, revenue_mult,\n            )\n            delta = impact_delta(baseline, wi_result)\n\n            w1, w2, w3 = st.columns(3)\n            w1.metric(\"Projected Net Margin\",\n                      f\"${wi_result['net_margin']:,.0f}\",\n                      delta=f\"+${delta['delta_margin']:,.0f} vs baseline\",\n                      delta_color=\"normal\")\n            w2.metric(\"Total Loss Saved\",\n                      f\"${delta['delta_loss_saved']:,.0f}\",\n                