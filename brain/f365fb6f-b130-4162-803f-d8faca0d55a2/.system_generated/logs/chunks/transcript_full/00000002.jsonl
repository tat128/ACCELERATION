{"step_index":89,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T14:27:25Z","content":"Created At: 2026-09-19T19:57:25+05:30\nCompleted At: 2026-09-19T19:57:26+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/app.py`\nTotal Lines: 694\nTotal Bytes: 35846\nShowing lines 300 to 580\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n300:             styled = reg_df.copy()\n301:             styled['Status'] = styled['status'].apply(\n302:                 lambda s: f\"🔴 {s}\" if s == 'DEFECT'\n303:                 else (f\"✅ {s}\" if s == 'PASS'\n304:                 else (f\"🟡 {s}\" if s == 'UNCERTAIN' else f\"🟣 {s}\"))\n305:             )\n306:             st.dataframe(\n307:                 styled[['unit_id', 'image_name', 'defect_type', 'confidence', 'Status', 'timestamp']],\n308:                 use_container_width=True, height=260,\n309:             )\n310:             if len(reg_df) >= 3:\n311:                 drift_df = registry.drift_dataframe()\n312:                 st.plotly_chart(defect_trend(drift_df), use_container_width=True)\n313: \n314:         # ── Confidence histogram ───────────────────────────────────────────\n315:         if len(reg_df[reg_df['status'] != 'PASS']) > 0:\n316:             st.plotly_chart(confidence_histogram(reg_df), use_container_width=True)\n317: \n318:         # ── Novel / Uncertain flag table ───────────────────────────────────\n319:         flagged = flag_novel(reg_df)\n320:         if not flagged.empty:\n321:             st.warning(f\"⚠️ **{len(flagged)} unit(s) flagged for human review** (UNCERTAIN or NOVEL detections)\")\n322:             st.dataframe(flagged, use_container_width=True)\n323:     else:\n324:         st.info(\"Upload images and click **Run Inspection** to begin.\")\n325: \n326: # ═════════════════════════════════════════════════════════════════════════════\n327: # TAB 2 — PRODUCTION FLOW\n328: # ═════════════════════════════════════════════════════════════════════════════\n329: with tab2:\n330:     st.markdown(\"## 🏭 Production Flow Health\")\n331:     st.markdown(\n332:         \"Theory of Constraints analysis across Drilling → Milling → Assembly stations \"\n333:         \"using Rockwell Arena simulation data.\"\n334:     )\n335: \n336:     if not analyses:\n337:         st.info(\"📂 Upload Model 1/2/3 CSV files in the sidebar to begin.\")\n338:     else:\n339:         # Model selector\n340:         model_names = list(analyses.keys())\n341:         sel_model   = st.selectbox(\"Select model to inspect\", model_names, index=0)\n342:         analysis    = analyses.get(sel_model)\n343: \n344:         if analysis is None:\n345:             st.error(f\"Could not parse {sel_model}. Check column names.\")\n346:         else:\n347:             # ── Key metrics strip ──────────────────────────────────────────────\n348:             m1, m2, m3, m4 = st.columns(4)\n349:             m1.metric(\"Demand\",         f\"{analysis['demand']:.0f} units\")\n350:             m2.metric(\"Parts Produced\", f\"{analysis['total_parts']:.0f} units\")\n351:             m3.metric(\"Throughput\",     f\"{analysis['throughput_efficiency']:.1f}%\",\n352:                       delta=f\"{analysis['throughput_gap']:.0f} units short\",\n353:                       delta_color=\"inverse\")\n354:             m4.metric(\"Parts / Hour\",   f\"{analysis['parts_per_hour']:.1f}\")\n355: \n356:             st.divider()\n357: \n358:             # ── Bottleneck spotlight ───────────────────────────────────────────\n359:             bn = analysis['bottleneck_station']\n360:             bu = analysis['bottleneck_util'] * 100\n361:             bw = analysis['bottleneck_wait']\n362: \n363:             if bu > 85:\n364:                 level, icon = \"CRITICAL\", \"🔴\"\n365:             elif bu > 70:\n366:                 level, icon = \"WARNING\",  \"🟡\"\n367:             else:\n368:                 level, icon = \"OK\",       \"🟢\"\n369: \n370:             st.markdown(f\"\"\"\n371: <div class=\"metric-card {'red' if level == 'CRITICAL' else 'orange' if level == 'WARNING' else 'green'}\">\n372:   <h3>{icon} Bottleneck: <b>{bn} Station</b>  &nbsp;\n373:     <span style=\"color:{'#e74c3c' if level=='CRITICAL' else '#f39c12'}\">{level}</span>\n374:   </h3>\n375:   <p>\n376:     <b>Utilisation:</b> {bu:.1f}% &nbsp;|&nbsp;\n377:     <b>Avg. Waiting Time:</b> {bw:.1f} min &nbsp;|&nbsp;\n378:     <b>Throughput Gap:</b> {analysis['throughput_gap']:.0f} units\n379:   </p>\n380:   <p><i>Elevating this station's capacity is the single highest-leverage improvement action (Theory of Constraints).</i></p>\n381: </div>\n382: \"\"\", unsafe_allow_html=True)\n383: \n384:             # ── Station charts ─────────────────────────────────────────────────\n385:             ch1, ch2 = st.columns(2)\n386:             with ch1:\n387:                 st.plotly_chart(utilization_bar(analysis['stations'], sel_model),\n388:                                 use_container_width=True)\n389:             with ch2:\n390:                 st.plotly_chart(waiting_time_bar(analysis['stations'], sel_model),\n391:                                 use_container_width=True)\n392: \n393:             # ── WIP Estimate ───────────────────────────────────────────────────\n394:             wip = estimate_wip(analysis)\n395:             if any(v > 0 for v in wip.values()):\n396:                 st.markdown(\"#### 📦 Estimated WIP (Little's Law)\")\n397:                 wip_cols = st.columns(len(wip))\n398:                 for col, (station, count) in zip(wip_cols, wip.items()):\n399:                     col.metric(f\"{station} WIP\", f\"~{count:.0f} parts\")\n400: \n401:             st.divider()\n402: \n403:             # ── Multi-model comparison table ───────────────────────────────────\n404:             if len(analyses) > 1:\n405:                 st.markdown(\"#### 📊 Model Comparison\")\n406:                 comp_df = compare_models(analyses)\n407:                 st.dataframe(comp_df, use_container_width=True)\n408: \n409:                 if len(analyses) >= 2:\n410:                     st.plotly_chart(multi_model_radar(analyses), use_container_width=True)\n411: \n412: # ═════════════════════════════════════════════════════════════════════════════\n413: # TAB 3 — ROOT CAUSE ANALYSIS\n414: # ═════════════════════════════════════════════════════════════════════════════\n415: with tab3:\n416:     st.markdown(\"## 🔎 Root-Cause Analysis\")\n417:     st.markdown(\n418:         \"Evidence-based correlation between observed defect patterns and \"\n419:         \"process station conditions.\"\n420:     )\n421: \n422:     no_quality = registry.to_dataframe().empty\n423:     no_process = not analyses\n424: \n425:     if no_quality and no_process:\n426:         st.info(\"Upload images (Tab 1) and CSV files (sidebar) to unlock root-cause analysis.\")\n427:     else:\n428:         rc_model = st.selectbox(\n429:             \"Select production model for correlation\",\n430:             list(analyses.keys()) if analyses else ['No model loaded'],\n431:             key='rc_model_sel',\n432:         )\n433:         rc_analysis  = analyses.get(rc_model) if analyses else None\n434:         rc_defect_sum = registry.summary()\n435: \n436:         evidence = correlate(rc_analysis, rc_defect_sum if not no_quality else None)\n437: \n438:         if not evidence:\n439:             st.success(\"✅ No critical correlations detected at current thresholds.\")\n440:         else:\n441:             st.markdown(f\"### ⚡ {len(evidence)} Causal Correlation(s) Identified\")\n442:             for card in evidence:\n443:                 conf  = card['confidence']\n444:                 obs   = card['defect_observed']\n445:                 cls   = conf\n446:                 html = f\"\"\"\n447: <div class=\"evidence-card {cls}\">\n448:   <b>🔗 CAUSE: {card['cause']}</b>\n449:   <span class=\"badge badge-{conf}\" style=\"float:right\">{conf} CONFIDENCE</span><br>\n450:   <small>📏 <b>Evidence:</b> {card['evidence']}</small><br>\n451:   <small>🦠 <b>Related Defects:</b> {', '.join(card['related_defects']) if card['related_defects'] else 'General throughput issue'}\n452:   {'&nbsp; <span class=\"badge badge-DEFECT\">OBSERVED ✓</span>' if obs else ''}</small><br>\n453:   <hr style=\"margin:8px 0; border-color:#334\">\n454:   <small>✅ <b>Recommended Action:</b> {card['action']}</small>\n455: </div>\n456: \"\"\"\n457:                 st.markdown(html, unsafe_allow_html=True)\n458: \n459:         st.divider()\n460: \n461:         # ── Drift analysis ─────────────────────────────────────────────────────\n462:         st.markdown(\"### 📈 Defect Rate Drift Analysis\")\n463:         if no_quality or len(registry) < 2:\n464:             st.info(\"Inspect at least 2 units to see drift trends.\")\n465:         else:\n466:             drift_df_raw = registry.drift_dataframe()\n467:             drift        = drift_analysis(drift_df_raw)\n468: \n469:             if drift:\n470:                 dc1, dc2, dc3 = st.columns(3)\n471:                 dc1.metric(\"Trend Direction\", drift['trend'])\n472:                 dc2.metric(\"Slope\", f\"{drift['slope']:+.2f} pp/unit\")\n473:                 dc3.metric(\"Units Needing Review\",\n474:                            drift['novel_count'] + drift['uncertain_count'])\n475: \n476:                 st.plotly_chart(defect_trend(drift['df']), use_container_width=True)\n477: \n478:         # ── Novel / Uncertain summary ──────────────────────────────────────────\n479:         if not no_quality:\n480:             flagged = flag_novel(registry.to_dataframe())\n481:             if not flagged.empty:\n482:                 st.warning(f\"### 🟣 {len(flagged)} Novel / Uncertain Unit(s) — Human Review Required\")\n483:                 s