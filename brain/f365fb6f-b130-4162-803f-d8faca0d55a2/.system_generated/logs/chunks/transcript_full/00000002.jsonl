{"step_index":112,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T14:39:43Z","thinking":"Defect localization algorithm design begins with image preprocessing: converting the input image, received as a PIL object, into a grayscale numpy array. This preprocessed image will then undergo tailored feature extraction based on the defect type. Initial focus is on `crack` and `scratch` defect types, involving the computation of Difference of Gaussians (DoG), gradient magnitude (using either a Sobel or Scharr filter), Canny edge detection, and morphological closing.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"YOLOv8 inference wrapper with visual defect localization and uncertainty handling.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\nimport cv2\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\n\nfrom utils.constants import (\n    DEFECT_CLASSES,\n    DEFECT_COLORS,\n    STATUS_COLORS,\n    CONFIDENCE_THRESHOLD,\n    NOVEL_THRESHOLD,\n    MODEL_PATHS,\n)\n\ntry:\n    from ultralytics import YOLO\n    _YOLO_AVAILABLE = True\nexcept ImportError:\n    _YOLO_AVAILABLE = False\n\n_model_cache: dict[str, object] = {}\n\n\n# ── Model Loading ─────────────────────────────────────────────────────────────\n\ndef load_model(custom_path: Optional[str] = None) -> tuple[object | None, str | None]:\n    \"\"\"Return (model, error_msg). Model is cached per path.\"\"\"\n    if not _YOLO_AVAILABLE:\n        return None, (\n            \"ultralytics not installed.\\n\"\n            \"Run: pip install ultralytics\"\n        )\n\n    search_paths = ([custom_path] if custom_path else []) + MODEL_PATHS\n    for path in search_paths:\n        if not path:\n            continue\n        if path in _model_cache:\n            return _model_cache[path], None\n        if os.path.exists(path):\n            try:\n                model = YOLO(path)\n                _model_cache[path] = model\n                return model, None\n            except Exception as exc:\n                return None, f\"Failed to load {path}: {exc}\"\n\n    checked = [p for p in search_paths if p]\n    return None, (\n        f\"Model weights not found.\\n\"\n        f\"Checked:\\n\" + \"\\n\".join(f\"  • {p}\" for p in checked) +\n        \"\\n\\nPlace best.pt at D:\\\\acceleration\\\\best.pt or upload below.\"\n    )\n\n\n# ── Computer Vision Defect Localizer ──────────────────────────────────────────\n\ndef localize_defect_saliency(img_pil: Image.Image, defect_type: str) -> list[list[float]]:\n    \"\"\"\n    Intelligently localizes defects (bounding boxes [x1, y1, x2, y2])\n    when using classification models (runs/classify) or when boxes are not natively produced.\n    \"\"\"\n    if defect_type.lower() in ('normal', 'acceptable', 'pass'):\n        return []\n\n    img_rgb = np.array(img_pil.convert('RGB'))\n    h, w, _ = img_rgb.shape\n    gray = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2GRAY)\n    boxes = []\n\n    # 1. Defect-specific feature extraction\n    dtype = defect_type.lower()\n\n    if dtype in ('crack', 'scratch'):\n        # Difference of Gaussians + morphological gradient for linear high-frequency anomalies\n        g1 = cv2.GaussianBlur(gray, (3, 3), 0)\n        g2 = cv2.GaussianBlur(gray, (15, 15), 0)\n        dog = cv2.absdiff(g1, g2)\n        \n        # Edge gradient\n        sobelx = cv2.Sobel(gray, cv2.CV_64F, 1, 0, ksize=3)\n        sobely = cv2.Sobel(gray, cv2.CV_64F, 0, 1, ksize=3)\n        grad = np.sqrt(sobelx**2 + sobely**2)\n        grad = np.uint8(np.clip(grad / (grad.max() + 1e-5) * 255, 0, 255))\n\n        combined = cv2.addWeighted(dog, 0.6, grad, 0.4, 0)\n        _, thresh = cv2.threshold(combined, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n        kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))\n        thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n\n    elif dtype == 'hole':\n        # Dark circular / high-contrast localized regions\n        blur = cv2.GaussianBlur(gray, (7, 7), 0)\n        thresh = cv2.adaptiveThreshold(\n            blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n            cv2.THRESH_BINARY_INV, 21, 6\n        )\n        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n        thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n\n    elif dtype == 'rust':\n        # Color space anomaly (color deviation in HSV / LAB)\n        hsv = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2HSV)\n        # Rust typically spans brownish/orange/red hues with medium to high saturation\n        mask1 = cv2.inRange(hsv, np.array([5, 40, 30]), np.array([30, 255, 240]))\n        mask2 = cv2.inRange(hsv, np.array([160, 40, 30]), np.array([180, 255, 240]))\n        color_mask = cv2.bitwise_or(mask1, mask2)\n        \n        # Saliency in LAB\n        lab = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2LAB)\n        l, a, b = cv2.split(lab)\n        ab_var = cv2.absdiff(a, np.uint8(np.mean(a))) + cv2.absdiff(b, np.uint8(np.mean(b)))\n        _, ab_thresh = cv2.threshold(ab_var, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n        thresh = cv2.bitwise_or(color_mask, ab_thresh)\n        kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))\n        thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n\n    else:\n        # General Spectral Residual / Contrast Saliency\n        saliency = cv2.saliency.StaticSaliencySpectralResidual_create()\n        success, sal_map = saliency.computeSaliency(img_rgb)\n        if success:\n            sal_uint = np.uint8(sal_map * 255)\n            _, thresh = cv2.threshold(sal_uint, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n        else:\n            _, thresh = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)\n\n    # 2. Extract and filter bounding boxes\n    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    candidates = []\n    min_area = (w * h) * 0.001   # at least 0.1% of image\n    max_area = (w * h) * 0.85    # at most 85% of image\n\n    for cnt in contours:\n        area = cv2.contourArea(cnt)\n        if area < min_area or area > max_area:\n            continue\n        x, y, bw, bh = cv2.boundingRect(cnt)\n        \n        # Avoid pure border artifact borders\n        if x <= 2 and y <= 2 and (x + bw) >= (w - 3) and (y + bh) >= (h - 3):\n            continue\n\n        # Add 8px padding\n        pad = 8\n        x1 = max(0, x - pad)\n        y1 = max(0, y - pad)\n        x2 = min(w, x + bw + pad)\n        y2 = min(h, y + bh + pad)\n        candidates.append((area, [float(x1), float(y1), float(x2), float(y2)]))\n\n    # Sort candidates by area descending\n    candidates.sort(key=lambda c: c[0], reverse=True)\n\n    if candidates:\n        # Pick top 1-3 most prominent defect regions\n        boxes = [c[1] for c in candidates[:3]]\n    else:\n        # Fallback: localized central zone if thresholding was too strict\n        margin_x = w * 0.20\n        margin_y = h * 0.20\n        boxes = [[margin_x, margin_y, w - margin_x, h - margin_y]]\n\n    return boxes\n\n\n# ── Inference ─────────────────────────────────────────────────────────────────\n\ndef run_inference(\n    image_input,\n    model=None,\n    conf_threshold: float = CONFIDENCE_THRESHOLD,\n) -> dict:\n    \"\"\"\n    Run YOLOv8 on one image (PIL Image, file path, or uploaded bytes).\n\n    Returns\n    -------\n    dict with keys:\n        status          PASS | DEFECT | UNCERTAIN | NOVEL | ERROR\n        defect_type     primary class name\n        confidence      float 0-1\n        bbox            [x1,y1,x2,y2] or None\n        all_detections  list of raw detection dicts\n        annotated_image PIL Image\n        error           str (only when status == ERROR)\n    \"\"\"\n    # ── Load model if not supplied ────────────────────────────────────────────\n    if model is None:\n        model, err = load_model()\n        if model is None:\n            return {'status': 'ERROR', 'error': err,\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'bbox': None, 'all_detections': [],\n                    'annotated_image': None}\n\n    # ── Convert input to PIL Image ────────────────────────────────────────────\n    if isinstance(image_input, Image.Image):\n        img = image_input.convert('RGB')\n    else:\n        try:\n            img = Image.open(image_input).convert('RGB')\n        except Exception as exc:\n            return {'status': 'ERROR', 'error': str(exc),\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'bbox': None, 'all_detections': [],\n                    'annotated_image': None}\n\n    # ── Run YOLO ──────────────────────────────────────────────────────────────\n    try:\n        results = model(img, verbose=False)\n    except Exception as exc:\n        return {'status': 'ERROR', 'error': f'Inference error: {exc}',\n                'defect_type': 'unknown', 'confidence': 0.0,\n                'bbox': None, 'all_detections': [],\n                'annotated_image': None}\n\n    result = results[0]\n    detections: list[dict] = []\n\n    # Detection mode (bounding boxes from YOLOv8 Detection model)\n    if hasattr(result, 'boxes') and result.boxes is not None and len(result.boxes) > 0:\n        for box in result.boxes:\n            cls_id  = int(box.cls[0].item())\n            conf    = float(box.conf[0].item())\n            cls_name = (result.names or {}).get(cls_id, DEFECT_CLASSES[cls_id] if cls_id < len(DEFECT_CLASSES) else 'unknown')\n            detections.append({\n                'defect_type': cls_name.lower(),\n                'confidence':  conf,\n                'bbox':        box.xyxy[0].tolist(),\n            })\n\n    # Classification mode (softmax probs from YOLOv8 Classification model)\n    elif hasattr(result, 'probs') and result.probs is not None:\n        probs    = result.probs.data.cpu().tolist()\n        top_cls  = int(result.probs.top1)\n        top_conf = float(result.probs.top1conf.item())\n        cls_name = (result.names or {}).get(top_cls, DEFECT_CLASSES[top_cls] if top_cls < len(DEFECT_CLASSES) else 'unknown')\n\n        # Localize defect box via Computer Vision saliency if defective\n        local_boxes = localize_defect_saliency(img, cls_name)\n        \n        if local_boxes:\n            for b in local_boxes:\n                detections.append({\n                    'defect_type': cls_name.lower(),\n                    'confidence':  top_conf,\n                    'bbox':        b,\n                })\n        else:\n            detections.append({\n                'defect_type': cls_name.lower(),\n                'confidence':  top_conf,\n                'bbox':        None,\n            })\n\n    # ── Determine status ──────────────────────────────────────────────────────\n    if not detections:\n        status        = 'PASS'\n        primary_type  = 'normal'\n        primary_conf  = 1.0\n        primary_bbox  = None\n    else:\n        concern_first = sorted(\n            detections,\n            key=lambda d: (d['defect_type'] not in ('normal', 'acceptable', 'pass'), d['confidence']),\n            reverse=True,\n        )\n        top = concern_first[0]\n        primary_type = top['defect_type']\n        primary_conf = top['confidence']\n        primary_bbox = top['bbox']\n\n        if primary_conf < NOVEL_THRESHOLD:\n            status = 'NOVEL'\n        elif primary_conf < conf_threshold:\n            status = 'UNCERTAIN'\n        elif primary_type in ('normal', 'acceptable', 'pass'):\n            status = 'PASS'\n        else:\n            status = 'DEFECT'\n\n    annotated = annotate_image(img.copy(), detections, status)\n\n    return {\n        'status':          status,\n        'defect_type':     primary_type,\n        'confidence':      primary_conf,\n        'bbox':            primary_bbox,\n        'all_detections':  detections,\n        'annotated_image': annotated,\n    }\n\n\n# ── Image Annotation with HUD Bounding Boxes ──────────────────────────────────\n\ndef annotate_image(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n    \"\"\"\n    Draws targeted defect bounding boxes, corner target brackets,\n    and confidence badges directly around the defect location.\n    \"\"\"\n    w, h = img.size\n    \n    # Overlay layer for translucent defect highlights\n    overlay = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n    draw_overlay = ImageDraw.Draw(overlay)\n    draw = ImageDraw.Draw(img)\n\n    for det in detections:\n        bbox = det.get('bbox')\n        dtype = det['defect_type'].lower()\n        if bbox is None or dtype in ('normal', 'acceptable', 'pass'):\n            continue\n\n        x1, y1, x2, y2 = [int(v) for v in bbox]\n        color_hex = DEFECT_COLORS.get(dtype, '#e74c3c')\n        \n        # Convert hex color to RGB tuple\n        c_rgb = tuple(int(color_hex.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))\n        fill_rgba = c_rgb + (55,)  # 22% opacity highlight fill\n\n        # 1. Translucent fill over defect area\n        draw_overlay.rectangle([x1, y1, x2, y2], fill=fill_rgba)\n\n        # 2. Crisp defect bounding box\n        box_thickness = max(2, int(min(w, h) / 200))\n        draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n\n        # 3. Industrial corner brackets for high-precision HUD look\n        corner_len = min(int((x2 - x1) * 0.25), int((y2 - y1) * 0.25), 24)\n        c_thick = box_thickness + 2\n\n        # Top-left corner\n        draw.line([(x1, y1), (x1 + corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y1), (x1, y1 + corner_len)], fill=color_hex, width=c_thick)\n        # Top-right corner\n        draw.line([(x2, y1), (x2 - corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y1), (x2, y1 + corner_len)], fill=color_hex, width=c_thick)\n        # Bottom-left corner\n        draw.line([(x1, y2), (x1 + corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y2), (x1, y2 - corner