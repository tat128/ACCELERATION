='%{x}<br>Utilisation: %{y:.1f}%<extra></extra>',\n131:     ))\n132:     fig.add_hline(y=85, line_dash='dash', line_color=_PALETTE['red'],\n133:                   annotation_text='Bottleneck threshold (85%)')\n134:     fig.add_hline(y=70, line_dash='dot', line_color=_PALETTE['orange'],\n135:                   annotation_text='Warning (70%)')\n136:     fig.update_layout(\n137:         title=f'{model_name} — Station Utilisation',\n138:         yaxis=dict(title='Utilisation (%)', range=[0, 115]),\n139:         xaxis_title='Station',\n140:         height=320,\n141:         **_base_layout(),\n142:     )\n143:     return fig\n144: \n145: \n146: def waiting_time_bar(station_metrics: dict, model_name: str) -> go.Figure:\n147:     stations = list(station_metrics.keys())\n148:     waits = [v['waiting_time'] for v in station_metrics.values()]\n149:     max_wait = max(waits) if waits else 0\n150:     colors = [_PALETTE['red'] if w == max_wait else _PALETTE['blue'] for w in waits]\n151: \n152:     fig = go.Figure(go.Bar(\n153:         x=stations, y=waits,\n154:         marker_color=colors,\n155:         text=[f'{w:.1f} min' for w in waits], textposition='outside',\n156:         hovertemplate='%{x}<br>Wait: %{y:.1f} min<extra></extra>',\n157:     ))\n158:     fig.update_layout(\n159:         title=f'{model_name} — Station Waiting Times',\n160:         yaxis_title='Waiting Time (min)',\n161:         xaxis_title='Station',\n162:         height=300,\n163:         **_base_layout(),\n164:     )\n165:     return fig\n166: \n167: \n168: def multi_model_radar(model_analyses: dict) -> go.Figure:\n169:     \"\"\"Radar chart comparing 3 models across key KPIs.\"\"\"\n170:     categories = ['Throughput %', 'Drill Idle', 'Mill Idle', 'Assembly Idle', 'Overall Idle']\n171:     fig = go.Figure()\n172: \n173:     for model_name, analysis in model_analyses.items():\n174:         if analysis is None:\n175:             continue\n176:         stations = analysis.get('stations', {})\n177:         values = [\n178:             min(analysis.get('throughput_efficiency', 0), 100),\n179:             100 - stations.get('Drilling', {}).get('utilization', 0) * 100,\n180:             100 - stations.get('Milling', {}).get('utilization', 0) * 100,\n181:             100 - stations.get('Assembly', {}).get('utilization', 0) * 100,\n182:             analysis.get('throughput_efficiency', 0),\n183:         ]\n184:         fig.add_trace(go.Scatterpolar(\n185:             r=values + [values[0]],\n186:             theta=categories + [categories[0]],\n187:             fill='toself', name=model_name, opacity=0.6,\n188:         ))\n189: \n190:     fig.update_layout(\n191:         polar=dict(radialaxis=dict(visible=True, range=[0, 110])),\n192:         title='Multi-Model KPI Radar',\n193:         height=380,\n194:         **_base_layout(),\n195:     )\n196:     return fig\n197: \n198: \n199: # ── Financial Charts ──────────────────────────────────────────────────────────\n200: \n201: def financial_waterfall(financials: dict, model_name: str) -> go.Figure:\n202:     labels  = ['Gross Revenue', 'Scrap Loss', 'Idle Loss', 'Opp. Loss', 'Net Margin']\n203:     measure = ['absolute', 'relative', 'relative', 'relative', 'total']\n204:     values  = [\n205:         financials.get('gross_revenue', 0),\n206:         -financials.get('scrap_loss', 0),\n207:         -financials.get('bottleneck_idle_loss', 0),\n208:         -financials.get('opportunity_loss', 0),\n209:         financials.get('net_margin', 0),\n210:     ]\n211: \n212:     fig = go.Figure(go.Waterfall(\n213:         name='', orientation='v',\n214:         measure=measure, x=labels, y=values,\n215:         connector=dict(line=dict(color='rgba(255,255,255,0.3)')),\n216:         decreasing=dict(marker=dict(color=_PALETTE['red'])),\n217:         increasing=dict(marker=dict(color=_PALETTE['green'])),\n218:         totals=dict(marker=dict(color=_PALETTE['blue'])),\n219:         text=[f'${abs(v):,.0f}' for v in values],\n220:         textposition='outside',\n221:     ))\n222:     fig.update_layout(\n223:         title=f'{model_name} — Financial Waterfall (USD)',\n224:         yaxis_title='USD ($)',\n225:         height=360,\n226:         **_base_layout(),\n227:     )\n228:     return fig\n229: \n230: \n231: def margin_comparison_bar(results: dict) -> go.Figure:\n232:     \"\"\"Bar chart comparing net margin across models in baseline vs what-if.\"\"\"\n233:     if not results:\n234:         return go.Figure()\n235: \n236:     models   = list(results.keys())\n237:     baseline = [r['baseline'].get('net_margin', 0) for r in results.values()]\n238:     whatif   = [r['whatif'].get('net_margin', 0) for r in results.values()]\n239: \n240:     fig = go.Figure([\n241:         go.Bar(name='Baseline', x=models, y=baseline, marker_color=_PALETTE['blue'],\n242:                text=[f'${v:,.0f}' for v in baseline], textposition='outside'),\n243:         go.Bar(name='What-If',  x=models, y=whatif,   marker_color=_PALETTE['teal'],\n244:                text=[f'${v:,.0f}' for v in whatif],   textposition='outside'),\n245:     ])\n246:     fig.update_layout(\n247:         barmode='group',\n248:         title='Net Margin — Baseline vs What-If Scenario',\n249:         yaxis_title='Net Margin (USD)',\n250:         height=320,\n251:         **_base_layout(),\n252:     )\n253:     return fig\n254: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
