st.markdown(\"#### AI Model Engine\")\n198:     custom_pt = st.text_input(\n199:         \"Model Weights Path (.pt)\",\n200:         placeholder=r\"D:\\acceleration\\best.pt\",\n201:     )\n202:     if st.button(\"Load / Reload Model\", use_container_width=True):\n203:         with st.spinner(\"Initializing YOLOv8 engine...\"):\n204:             mdl, err = load_model(custom_pt or None)\n205:             st.session_state.yolo_model = mdl\n206:             st.session_state.model_load_error = err\n207:         if mdl:\n208:             st.success(\"Model loaded successfully.\")\n209:         else:\n210:             st.error(f\"Error loading model: {err}\")\n211: \n212:     # Auto-load on initial run\n213:     if st.session_state.yolo_model is None and st.session_state.model_load_error is None:\n214:         mdl, err = load_model(custom_pt or None)\n215:         st.session_state.yolo_model = mdl\n216:         st.session_state.model_load_error = err\n217: \n218:     if st.session_state.yolo_model:\n219:         st.success(\"YOLOv8 Engine Active\")\n220:     elif st.session_state.model_load_error:\n221:         st.warning(f\"Status: {st.session_state.model_load_error[:70]}...\")\n222: \n223:     st.markdown(\"<div class='block-divider'></div>\", unsafe_allow_html=True)\n224: \n225:     # ── Inspection Parameters ─────────────────────────────────────────────────\n226:     st.markdown(\"#### Inspection Thresholds\")\n227:     conf_threshold = st.slider(\n228:         \"Confidence Decision Boundary\",\n229:         min_value=0.20, max_value=0.90, value=0.45, step=0.05,\n230:         help=\"Confidence >= Threshold: Classified. Below Threshold: UNCERTAIN. < 0.25: NOVEL.\",\n231:     )\n232: \n233:     st.markdown(\"<div class='block-divider'></div>\", unsafe_allow_html=True)\n234: \n235:     # ── Production Datasets ───────────────────────────────────────────────────\n236:     st.markdown(\"#### Production Datasets\")\n237: \n238:     def _upload_csv(label, key):\n239:        