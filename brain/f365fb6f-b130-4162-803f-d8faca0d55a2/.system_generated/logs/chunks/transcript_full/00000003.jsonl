_len)], fill=color_hex, width=c_thick)\n        # Bottom-right corner\n        draw.line([(x2, y2), (x2 - corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y2), (x2, y2 - corner_len)], fill=color_hex, width=c_thick)\n\n        # 4. Defect Tag badge directly on top of the bounding box\n        label = f\" {dtype.upper()} · {det['confidence']*100:.1f}% \"\n        dim_text = f\" [{x2-x1}×{y2-y1}px] \"\n        full_label = label + dim_text\n\n        try:\n            font = ImageFont.truetype(\"arialbd.ttf\", max(12, int(min(w, h) / 40)))\n        except Exception:\n            try:\n                font = ImageFont.truetype(\"arial.ttf\", max(12, int(min(w, h) / 40)))\n            except Exception:\n                font = ImageFont.load_default()\n\n        # Measure text\n        bbox_text = draw.textbbox((0, 0), full_label, font=font)\n        text_w = bbox_text[2] - bbox_text[0]\n        text_h = bbox_text[3] - bbox_text[1]\n\n        lbl_y1 = max(0, y1 - text_h - 6)\n        lbl_y2 = lbl_y1 + text_h + 6\n        lbl_x1 = x1\n        lbl_x2 = min(w, x1 + text_w + 8)\n\n        draw.rectangle([lbl_x1, lbl_y1, lbl_x2, lbl_y2], fill=color_hex)\n        draw.text((lbl_x1 + 4, lbl_y1 + 2), full_label, fill='white', font=font)\n\n    # Composite alpha overlay onto main image\n    final_img = Image.alpha_composite(img.convert('RGBA'), overlay).convert('RGB')\n    return final_img\n","Description":"Updated defect_detector.py with intelligent visual defect localization, targeted HUD bounding boxes, corner brackets, and label tags","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\modules\\defect_detector.py","toolAction":"Updating defect detector","toolSummary":"Update defect localization and bounding boxes"}}]}
