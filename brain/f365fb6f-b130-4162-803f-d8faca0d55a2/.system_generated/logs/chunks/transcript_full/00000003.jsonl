 + (55,)  # 22% opacity highlight fill\n329: \n330:         # 1. Translucent fill over defect area\n331:         draw_overlay.rectangle([x1, y1, x2, y2], fill=fill_rgba)\n332: \n333:         # 2. Crisp defect bounding box\n334:         box_thickness = max(2, int(min(w, h) / 200))\n335:         draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n336: \n337:         # 3. Industrial corner brackets for high-precision HUD look\n338:         corner_len = min(int((x2 - x1) * 0.25), int((y2 - y1) * 0.25), 24)\n339:         c_thick = box_thickness + 2\n340: \n341:         # Top-left corner\n342:         draw.line([(x1, y1), (x1 + corner_len, y1)], fill=color_hex, width=c_thick)\n343:         draw.line([(x1, y1), (x1, y1 + corner_len)], fill=color_hex, width=c_thick)\n344:         # Top-right corner\n345:         draw.line([(x2, y1), (x2 - corner_len, y1)], fill=color_hex, width=c_thick)\n346:         draw.line([(x2, y1), (x2, y1 + corner_len)], fill=color_hex, width=c_thick)\n347:         # Bottom-left corner\n348:         draw.line([(x1, y2), (x1 + corner_len, y2)], fill=color_hex, width=c_thick)\n349:         draw.line([(x1, y2), (x1, y2 - corner_len)], fill=color_hex, width=c_thick)\n350:         # Bottom-right corner\n351:         draw.line([(x2, y2), (x2 - corner_len, y2)], fill=color_hex, width=c_thick)\n352:         draw.line([(x2, y2), (x2, y2 - corner_len)], fill=color_hex, width=c_thick)\n353: \n354:         # 4. Defect Tag badge directly on top of the bounding box\n355:         label = f\" {dtype.upper()} · {det['confidence']*100:.1f}% \"\n356:         dim_text = f\" [{x2-x1}×{y2-y1}px] \"\n357:         full_label = label + dim_text\n358: \n359:         try:\n360:             font = ImageFont.truetype(\"arialbd.ttf\", max(12, int(min(w, h) / 40)))\n361:         except Exception:\n362:             try:\n363:                 font = ImageFont.truetype(\"arial.ttf\", max(12, int(min(w, h) / 40)))\n364:             except Exception:\n365:                 font = ImageFont.load_default()\n366: \n367:         # Measure text\n368:         bbox_text = draw.textbbox((0, 0), full_label, font=font)\n369:         text_w = bbox_text[2] - bbox_text[0]\n370:         text_h = bbox_text[3] - bbox_text[1]\n371: \n372:         lbl_y1 = max(0, y1 - text_h - 6)\n373:         lbl_y2 = lbl_y1 + text_h + 6\n374:         lbl_x1 = x1\n375:         lbl_x2 = min(w, x1 + text_w + 8)\n376: \n377:         draw.rectangle([lbl_x1, lbl_y1, lbl_x2, lbl_y2], fill=color_hex)\n378:         draw.text((lbl_x1 + 4, lbl_y1 + 2), full_label, fill='white', font=font)\n379: \n380:     # Composite alpha overlay onto main image\n381:     final_img = Image.alpha_composite(img.convert('RGBA'), overlay).convert('RGB')\n382:     return final_img\n383: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
