:         thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n96: \n97:     elif dtype == 'hole':\n98:         # Dark circular / high-contrast localized regions\n99:         blur = cv2.GaussianBlur(gray, (7, 7), 0)\n100:         thresh = cv2.adaptiveThreshold(\n101:             blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,\n102:             cv2.THRESH_BINARY_INV, 21, 6\n103:         )\n104:         kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n105:         thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n106: \n107:     elif dtype == 'rust':\n108:         # Color space anomaly (color deviation in HSV / LAB)\n109:         hsv = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2HSV)\n110:         # Rust typically spans brownish/orange/red hues with medium to high saturation\n111:         mask1 = cv2.inRange(hsv, np.array([5, 40, 30], dtype=np.uint8), np.array([30, 255, 240], dtype=np.uint8))\n112:         mask2 = cv2.inRange(hsv, np.array([160, 40, 30], dtype=np.uint8), np.array([180, 255, 240], dtype=np.uint8))\n113:         color_mask = cv2.bitwise_or(mask1, mask2)\n114:         \n115:         # Saliency in LAB\n116:         lab = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2LAB)\n117:         _, a, b = cv2.split(lab)\n118:         a_f = a.astype(np.float32)\n119:         b_f = b.astype(np.float32)\n120:         ab_var = np.abs(a_f - float(np.mean(a_f))) + np.abs(b_f - float(np.mean(b_f)))\n121:         ab_uint = np.uint8(np.clip(ab_var / (ab_var.max() + 1e-5) * 255, 0, 255))\n122:         _, ab_thresh = cv2.threshold(ab_uint, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n123:         thresh = cv2.bitwise_or(color_mask, ab_thresh)\n124:         kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (7, 7))\n125:         thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n126: \n127:     else:\n128:         # General Contrast / High-Frequency Saliency\n129:         blur = cv2.GaussianBlur(gray, (9, 9), 0)\n130:         diff = np.abs(gray.astype(np.float32) - blur.astype(np.float32))\n131:         diff_uint = np.uint8(np.clip(diff / (diff.max() + 1e-5) * 255, 0, 255))\n132:         _, thresh = cv2.threshold(diff_uint, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n133:         kernel = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))\n134:         thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, kernel, iterations=2)\n135: \n136:     # 2. Extract and filter bounding boxes\n137:     contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n138:     candidates = []\n139:     min_area = (w * h) * 0.001   # at least 0.1% of image\n140:     max_area = (w * h) * 0.85    # at most 85% of image\n141: \n142:     for cnt in contours:\n143:         area = cv2.contourArea(cnt)\n144:         if area < min_area or area > max_area:\n145:             continue\n146:         x, y, bw, bh = cv2.boundingRect(cnt)\n147:         \n148:         # Avoid pure border artifact borders\n149:         if x <= 2 and y <= 2 and (x + bw) >= (w - 3) and (y + bh) >= (h - 3):\n150:             continue\n151: \n152:         # Add 8px padding\n153:         pad = 8\n154:         x1 = max(0, x - pad)\n155:         y1 = max(0, y - pad)\n156:         x2 = min(w, x + bw + pad)\n157:         y2 = min(h, y + bh + pad)\n158:         candidates.append((area, [float(x1), float(y1), float(x2), float(y2)]))\n159: \n160:     # Sort candidates by area descending\n161:     candidates.sort(key=lambda c: c[0], reverse=True)\n162: \n163:     if candidates:\n164:         # Pick top 1-3 most prominent defect regions\n165:         boxes = [c[1] for c in candidates[:3]]\n166:     else:\n167:         # Fallback: localized central zone if thresholding was too strict\n168:         margin_x = w * 0.20\n169:         margin_y = h * 0.20\n170:         boxes = [[margin_x, margin_y, w - margin_x, h - margin_y]]\n171: \n172:     return boxes\n173: \n174: \n175: # ── Inference ─────────────────────────────────────────────────────────────────\n176: \n177: def run_inference(\n178:     image_input,\n179:     model=None,\n180:     conf_threshold: float = CONFIDENCE_THRESHOLD,\n181: ) -> dict:\n182:     \"\"\"\n183:     Run YOLOv8 on one image (PIL Image, file path, or uploaded bytes).\n184: \n185:     Returns\n186:     -------\n187:     dict with keys:\n188:         status          PASS | DEFECT | UNCERTAIN | NOVEL | ERROR\n189:         defect_type     primary class name\n190:         confidence      float 0-1\n191:         bbox            [x1,y1,x2,y2] or None\n192:         all_detections  list of raw detection dicts\n193:         annotated_image PIL Image\n194:         error           str (only when status == ERROR)\n195:     \"\"\"\n196:     # ── Load model if not supplied ────────────────────────────────────────────\n197:     if model is None:\n198:         model, err = load_model()\n199:         if model is None:\n200:             return {'status': 'ERROR', 'error': err,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":157,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T14:55:21Z","thinking":"Analyzing the scratch defect, the thin linear nature suggests morphological transformations are suitable. Considering both dark scratches on bright surfaces and vice-versa, BlackHat and TopHat transforms appear necessary for comprehensive detection.\n\n\nIsolating scratches involves applying morphological transformations (BlackHat and TopHat) to the grayscale image, effectively removing surface texture and highlighting the linear scratch features.  Bounding box creation will focus on prominent scratch components, merging aligned segments, ensuring the box encompasses the defect while avoiding unnecessary inclusion of the entire image.\n\nRust detection utilizes color deviation from the metal background, employing color space transformations (LAB + HSV) to identify localized patches.  The approach prioritizes finding the primary rust cluster for bounding box creation, constraining maximum box dimensions to prevent full-frame coverage. If high-contrast features are absent, a compact box centered on the maximum anomaly intensity serves as a fallback.\nInspection of multiple or single images will be presented through an interactive and responsive grid layout with a toggle for thumbnail/full-view display.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"YOLOv8 inference wrapper with visual defect localization and uncertainty handling.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\nimport cv2\nimport numpy as np\nfrom PIL import Image, ImageDraw, ImageFont\n\nfrom utils.constants import (\n    DEFECT_CLASSES,\n    DEFECT_COLORS,\n    STATUS_COLORS,\n    CONFIDENCE_THRESHOLD,\n    NOVEL_THRESHOLD,\n    MODEL_PATHS,\n)\n\ntry:\n    from ultralytics import YOLO\n    _YOLO_AVAILABLE = True\nexcept ImportError:\n    _YOLO_AVAILABLE = False\n\n_model_cache: dict[str, object] = {}\n\n\n# ── Model Loading ─────────────────────────────────────────────────────────────\n\ndef load_model(custom_path: Optional[str] = None) -> tuple[object | None, str | None]:\n    \"\"\"Return (model, error_msg). Model is cached per path.\"\"\"\n    if not _YOLO_AVAILABLE:\n        return None, (\n            \"ultralytics not installed.\\n\"\n            \"Run: pip install ultralytics\"\n        )\n\n    search_paths = ([custom_path] if custom_path else []) + MODEL_PATHS\n    for path in search_paths:\n        if not path:\n            continue\n        if path in _model_cache:\n            return _model_cache[path], None\n        if os.path.exists(path):\n            try:\n                model = YOLO(path)\n                _model_cache[path] = model\n                return model, None\n            except Exception as exc:\n                return None, f\"Failed to load {path}: {exc}\"\n\n    checked = [p for p in search_paths if p]\n    return None, (\n        f\"Model weights not found.\\n\"\n        f\"Checked:\\n\" + \"\\n\".join(f\"  • {p}\" for p in checked) +\n        \"\\n\\nPlace best.pt at D:\\\\acceleration\\\\best.pt or upload below.\"\n    )\n\n\n# ── Precise Computer Vision Defect Localizer ──────────────────────────────────\n\ndef localize_defect_saliency(img_pil: Image.Image, defect_type: str) -> list[list[float]]:\n    \"\"\"\n    Localizes targeted defect bounding boxes [x1, y1, x2, y2]\n    tightly around the defect without expanding to the entire image.\n    \"\"\"\n    dtype = defect_type.lower().strip()\n    if dtype in ('normal', 'acceptable', 'pass'):\n        return []\n\n    img_rgb = np.array(img_pil.convert('RGB'))\n    h, w, _ = img_rgb.shape\n    gray = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2GRAY)\n    \n    heatmap = np.zeros((h, w), dtype=np.float32)\n\n    # ── 1. Defect-Specific Feature Filters ────────────────────────────────────\n    if dtype == 'scratch':\n        # Scratches: Thin linear surface grooves (BlackHat + TopHat + Ridge filters)\n        k_small = cv2.getStructuringElement(cv2.MORPH_RECT, (7, 7))\n        blackhat = cv2.morphologyEx(gray, cv2.MORPH_BLACKHAT, k_small)\n        tophat = cv2.morphologyEx(gray, cv2.MORPH_TOPHAT, k_small)\n        ridge = cv2.max(blackhat, tophat)\n        \n        # Directional gradient (Sobel)\n        sx = cv2.Sobel(gray, cv2.CV_32F, 1, 0, ksize=3)\n        sy = cv2.Sobel(gray, cv2.CV_32F, 0, 1, ksize=3)\n        mag = np.sqrt(sx**2 + sy**2)\n        \n        heatmap = (ridge.astype(np.float32) * 0.7) + (mag * 0.3)\n\n    elif dtype == 'rust':\n        # Rust: Oxidation color clusters (HSV brown/orange + LAB color deviation)\n        hsv = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2HSV)\n        mask1 = cv2.inRange(hsv, np.array([5, 30, 20], dtype=np.uint8), np.array([35, 255, 230], dtype=np.uint8))\n        mask2 = cv2.inRange(hsv, np.array([160, 30, 20], dtype=np.uint8), np.array([180, 255, 230], dtype=np.uint8))\n        color_mask = cv2.bitwise_or(mask1, mask2).astype(np.float32)\n\n        lab = cv2.cvtColor(img_rgb, cv2.COLOR_RGB2LAB)\n        _, a, b = cv2.split(lab)\n        a_f, b_f = a.astype(np.float32), b.astype(np.float32)\n        ab_dev = np.abs(a_f - float(np.mean(a_f))) + np.abs(b_f - float(np.mean(b_f)))\n        \n        # Local saturation variance\n        s_chan = hsv[:, :, 1].astype(np.float32)\n        heatmap = (color_mask * 0.5) + (ab_dev * 0.3) + (s_chan * 0.2)\n\n    elif dtype == 'crack':\n        # Cracks: High gradient fractures with high local variance\n        g_blur = cv2.GaussianBlur(gray, (5, 5), 0)\n        sx = cv2.Sobel(g_blur, cv2.CV_32F, 1, 0, ksize=3)\n        sy = cv2.Sobel(g_blur, cv2.CV_32F, 0, 1, ksize=3)\n        grad = np.sqrt(sx**2 + sy**2)\n        \n        dog = np.abs(cv2.GaussianBlur(gray, (3, 3), 0).astype(np.float32) - cv2.GaussianBlur(gray, (15, 15), 0).astype(np.float32))\n        heatmap = (grad * 0.6) + (dog * 0.4)\n\n    elif dtype == 'hole':\n        # Holes: Dark circular / el