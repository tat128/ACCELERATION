{"step_index":1322,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T21:20:03Z","content":"Created At: 2026-09-20T02:50:03+05:30\nCompleted At: 2026-09-20T02:50:03+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/utils/chart_helpers.py`\nTotal Lines: 985\nTotal Bytes: 34939\nShowing lines 460 to 520\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n460:         )\n461:     )\n462:     return fig\n463: \n464: \n465: # ── 3D What-If Optimization Surface ──────────────────────────────────────────\n466: \n467: def margin_surface_3d(\n468:     analysis: dict,\n469:     defect_sum: dict,\n470:     scrap_cost: float,\n471:     downtime_cost: float,\n472:     revenue_mult: float,\n473:     current_util_impr: float = 15.0,\n474:     current_scrap_redn: float = 20.0,\n475: ) -> go.Figure:\n476:     \"\"\"\n477:     Renders an interactive 3D Surface Landscape showing Net Margin ($)\n478:     across variations of Scrap Reduction % and Bottleneck Idle Reduction %.\n479:     Highlights the current slider operating point in real time.\n480:     \"\"\"\n481:     import numpy as np\n482:     from modules.profitability import what_if\n483: \n484:     scrap_vals = np.linspace(0, 60, 20)\n485:     util_vals = np.linspace(0, 50, 20)\n486:     \n487:     Z = np.zeros((len(util_vals), len(scrap_vals)))\n488:     for i, u in enumerate(util_vals):\n489:         for j, s in enumerate(scrap_vals):\n490:             res = what_if(analysis, defect_sum, scrap_cost, downtime_cost, u, s, revenue_mult)\n491:             Z[i, j] = res.get('net_margin', 0)\n492: \n493:     # Calculate active point\n494:     cur_res = what_if(analysis, defect_sum, scrap_cost, downtime_cost, current_util_impr, current_scrap_redn, revenue_mult)\n495:     cur_z = cur_res.get('net_margin', 0)\n496: \n497:     # Executive Classy Colorscale: Deep Obsidian -> Cobalt -> Emerald -> Ice Cyan\n498:     colorscale = [\n499:         [0.0, \"#0b132b\"],\n500:         [0.25, \"#1c2541\"],\n501:         [0.5, \"#0284c7\"],\n502:         [0.75, \"#10b981\"],\n503:         [1.0, \"#38bdf8\"],\n504:     ]\n505: \n506:     fig = go.Figure()\n507: \n508:     # 3D Surface\n509:     fig.add_trace(go.Surface(\n510:         x=scrap_vals,\n511:         y=util_vals,\n512:         z=Z,\n513:         colorscale=colorscale,\n514:         showscale=True,\n515:         colorbar=dict(\n516:             title=dict(text=\"Net Margin ($)\", font=dict(color=\"#cbd5e1\", size=11, family=\"Plus Jakarta Sans\")),\n517:             tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n518:             len=0.7,\n519:             thickness=14,\n520:             outlinewidth=0,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
