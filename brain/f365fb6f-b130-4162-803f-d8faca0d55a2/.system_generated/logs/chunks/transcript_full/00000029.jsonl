{"step_index":1324,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T21:20:06Z","content":"Created At: 2026-09-20T02:50:06+05:30\nCompleted At: 2026-09-20T02:50:07+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/utils/chart_helpers.py`\nTotal Lines: 985\nTotal Bytes: 34939\nShowing lines 520 to 985\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n520:             outlinewidth=0,\n521:         ),\n522:         hovertemplate=\"Scrap Redn: %{x:.1f}%<br>Idle Redn: %{y:.1f}%<br>Margin: $%{z:,.0f}<extra></extra>\",\n523:         contours=dict(\n524:             z=dict(show=True, usecolormap=True, highlightcolor=\"#ffffff\", project_z=True)\n525:         ),\n526:         opacity=0.92,\n527:     ))\n528: \n529:     # Active Operating Point Marker\n530:     fig.add_trace(go.Scatter3d(\n531:         x=[current_scrap_redn],\n532:         y=[current_util_impr],\n533:         z=[cur_z],\n534:         mode=\"markers+text\",\n535:         marker=dict(\n536:             size=8,\n537:             color=\"#f43f5e\",\n538:             symbol=\"diamond\",\n539:             line=dict(color=\"#ffffff\", width=2)\n540:         ),\n541:         text=[f\"  Active Target: ${cur_z:,.0f}\"],\n542:         textposition=\"top center\",\n543:         textfont=dict(color=\"#f8fafc\", size=11, family=\"JetBrains Mono\"),\n544:         name=\"Operating Point\",\n545:         hovertemplate=\"<b>ACTIVE SELECTION</b><br>Scrap Redn: %{x:.1f}%<br>Idle Redn: %{y:.1f}%<br>Margin: $%{z:,.0f}<extra></extra>\"\n546:     ))\n547: \n548:     camera = dict(\n549:         eye=dict(x=1.55, y=-1.55, z=0.95),\n550:         center=dict(x=0, y=0, z=-0.1)\n551:     )\n552: \n553:     fig.update_layout(\n554:         title=dict(\n555:             text=\"3D Profitability Optimization Frontier (What-If Response Surface)\",\n556:             font=dict(size=14, color=\"#f8fafc\", family=\"Plus Jakarta Sans, sans-serif\"),\n557:         ),\n558:         scene=dict(\n559:             xaxis=dict(\n560:                 title=dict(text=\"Scrap Reduction (%)\", font=dict(color=\"#cbd5e1\", size=11)),\n561:                 tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n562:                 backgroundcolor=\"rgba(15, 23, 42, 0.4)\",\n563:                 gridcolor=\"rgba(148, 163, 184, 0.15)\",\n564:                 showbackground=True,\n565:             ),\n566:             yaxis=dict(\n567:                 title=dict(text=\"Bottleneck Idle Red. (%)\", font=dict(color=\"#cbd5e1\", size=11)),\n568:                 tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n569:                 backgroundcolor=\"rgba(15, 23, 42, 0.4)\",\n570:                 gridcolor=\"rgba(148, 163, 184, 0.15)\",\n571:                 showbackground=True,\n572:             ),\n573:             zaxis=dict(\n574:                 title=dict(text=\"Net Margin ($)\", font=dict(color=\"#cbd5e1\", size=11)),\n575:                 tickfont=dict(color=\"#94a3b8\", size=10, family=\"JetBrains Mono\"),\n576:                 backgroundcolor=\"rgba(15, 23, 42, 0.4)\",\n577:                 gridcolor=\"rgba(148, 163, 184, 0.15)\",\n578:                 showbackground=True,\n579:             ),\n580:             camera=camera,\n581:         ),\n582:         paper_bgcolor=_BG,\n583:         font=dict(color=\"#e2e8f0\", family=\"Plus Jakarta Sans, sans-serif\"),\n584:         margin=dict(t=40, b=20, l=20, r=20),\n585:         height=460,\n586:     )\n587:     return fig\n588: \n589: \n590: # ── Animated HTML5 Canvas Production Line Simulator ──────────────────────────\n591: \n592: def render_production_animation(analysis: dict, model_name: str = \"Active Model\") -> str:\n593:     \"\"\"\n594:     Generates a standalone HTML5/CSS/JavaScript canvas component rendering a real-time\n595:     animated conveyor line with moving WIP particle dynamics, queue congestion physics,\n596:     and pulsating constraint/bottleneck nodes.\n597:     \"\"\"\n598:     import json\n599: \n600:     if not analysis or 'stations' not in analysis:\n601:         return \"<div style='color:#94a3b8; padding:20px; text-align:center;'>No simulation data available for animation.</div>\"\n602: \n603:     stations_data = []\n604:     bn_station = analysis.get('bottleneck_station', '')\n605:     \n606:     for s_name, s_info in analysis['stations'].items():\n607:         u_pct = round(s_info.get('utilization', 0) * 100, 1)\n608:         wait_m = round(s_info.get('waiting_time', 0), 2)\n609:         is_bn = (s_name == bn_station)\n610:         stations_data.append({\n611:             'name': s_name,\n612:             'util': u_pct,\n613:             'wait': wait_m,\n614:             'is_bottleneck': is_bn\n615:         })\n616: \n617:     throughput = round(analysis.get('parts_per_hour', 10.0), 1)\n618:     stations_json = json.dumps(stations_data)\n619: \n620:     html_code = f\"\"\"\n621: <!DOCTYPE html>\n622: <html>\n623: <head>\n624: <meta charset=\"utf-8\">\n625: <style>\n626:   * {{ box-sizing: border-box; margin: 0; padding: 0; }}\n627:   body {{\n628:     background: transparent;\n629:     font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;\n630:     color: #f8fafc;\n631:     overflow-x: auto;\n632:     overflow-y: hidden;\n633:     padding: 6px;\n634:   }}\n635:   .sim-container {{\n636:     position: relative;\n637:     width: 100%;\n638:     min-width: 750px;\n639:     background: radial-gradient(circle at 50% 0%, rgba(30, 41, 59, 0.5) 0%, rgba(11, 15, 25, 0.85) 100%);\n640:     border: 1px solid rgba(148, 163, 184, 0.15);\n641:     border-radius: 12px;\n642:     box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);\n643:     padding: 14px 16px 12px 16px;\n644:   }}\n645:   .sim-header {{\n646:     display: flex;\n647:     justify-content: space-between;\n648:     align-items: center;\n649:     margin-bottom: 8px;\n650:   }}\n651:   .sim-title {{\n652:     font-size: 13px;\n653:     font-weight: 700;\n654:     color: #38bdf8;\n655:     letter-spacing: 0.5px;\n656:     display: flex;\n657:     align-items: center;\n658:     gap: 8px;\n659:   }}\n660:   .sim-badge {{\n661:     display: inline-block;\n662:     padding: 2px 8px;\n663:     border-radius: 9999px;\n664:     font-size: 10px;\n665:     font-family: 'JetBrains Mono', monospace;\n666:     font-weight: 600;\n667:     background: rgba(16, 185, 129, 0.15);\n668:     color: #34d399;\n669:     border: 1px solid rgba(16, 185, 129, 0.3);\n670:   }}\n671:   .sim-stats {{\n672:     font-size: 11px;\n673:     font-family: 'JetBrains Mono', monospace;\n674:     color: #94a3b8;\n675:   }}\n676:   #simCanvas {{\n677:     display: block;\n678:     width: 100%;\n679:     height: 190px;\n680:     border-radius: 8px;\n681:     background: rgba(15, 23, 42, 0.65);\n682:     border: 1px solid rgba(148, 163, 184, 0.1);\n683:   }}\n684: </style>\n685: </head>\n686: <body>\n687: <div class=\"sim-container\">\n688:   <div class=\"sim-header\">\n689:     <div class=\"sim-title\">\n690:       <span style=\"display:inline-block; width:8px; height:8px; border-radius:50%; background:#38bdf8; box-shadow:0 0 8px #38bdf8;\"></span>\n691:       REAL-TIME PHYSICAL CONVEYOR TELEMETRY — {model_name.upper()}\n692:     </div>\n693:     <div class=\"sim-stats\">\n694:       LINE RATE: <span style=\"color:#f8fafc; font-weight:700;\">{throughput} parts/hr</span> |\n695:       <span class=\"sim-badge\">PHYSICS SIM ACTIVE</span>\n696:     </div>\n697:   </div>\n698:   <canvas id=\"simCanvas\"></canvas>\n699: </div>\n700: \n701: <script>\n702: (function() {{\n703:   const canvas = document.getElementById('simCanvas');\n704:   const ctx = canvas.getContext('2d');\n705:   const stations = {stations_json};\n706: \n707:   let width, height;\n708:   function resize() {{\n709:     width = canvas.parentElement.clientWidth - 32;\n710:     if (width < 720) width = 720;\n711:     height = 190;\n712:     canvas.width = width * window.devicePixelRatio;\n713:     canvas.height = height * window.devicePixelRatio;\n714:     canvas.style.width = width + 'px';\n715:     canvas.style.height = height + 'px';\n716:     ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n717:   }}\n718:   resize();\n719:   window.addEventListener('resize', resize);\n720: \n721:   // Layout calculations\n722:   const padX = 70;\n723:   const trackY = 95;\n724:   const numStations = stations.length;\n725:   const stepX = (width - 2 * padX) / (numStations + 1);\n726: \n727:   // Station Node Objects\n728:   const nodes = [];\n729:   // Inflow Station (Raw Stock)\n730:   nodes.push({{\n731:     name: 'Raw Stock',\n732:     util: 100,\n733:     isBN: false,\n734:     x: padX,\n735:     y: trackY,\n736:     type: 'inflow'\n737:   }});\n738: \n739:   // Process Stations\n740:   stations.forEach((s, idx) => {{\n741:     nodes.push({{\n742:       name: s.name,\n743:       util: s.util,\n744:       wait: s.wait,\n745:       isBN: s.is_bottleneck,\n746:       x: padX + (idx + 1) * stepX,\n747:       y: trackY,\n748:       type: 'station'\n749:     }});\n750:   }});\n751: \n752:   // Outflow Station (Finished Goods)\n753:   nodes.push({{\n754:     name: 'Shipped',\n755:     util: 100,\n756:     isBN: false,\n757:     x: padX + (numStations + 1) * stepX,\n758:     y: trackY,\n759:     type: 'outflow'\n760:   }});\n761: \n762:   // Particles (WIP units moving on conveyor)\n763:   const particles = [];\n764:   const maxParticles = Math.min(36, Math.max(16, numStations * 4));\n765: \n766:   function createParticle() {{\n767:     return {{\n768:       progress: Math.random(), // 0 to 1 along conveyor\n769:       speed: 0.0012 + Math.random() * 0.0006,\n770:       radius: 3.5,\n771:       hue: Math.random() > 0.15 ? '#38bdf8' : '#34d399'\n772:     }};\n773:   }}\n774: \n775:   for (let i = 0; i < maxParticles; i++) {{\n776:     particles.push(createParticle());\n777:   }}\n778: \n779:   let pulseAngle = 0;\n780: \n781:   function render() {{\n782:     ctx.clearRect(0, 0, width, height);\n783:     pulseAngle += 0.045;\n784: \n785:     // 1. Draw Conveyor Track Base\n786:     const startX = nodes[0].x;\n787:     const endX = nodes[nodes.length - 1].x;\n788: \n789:     // Outer glow for track\n790:     ctx.strokeStyle = 'rgba(56, 189, 248, 0.15)';\n791:     ctx.lineWidth = 10;\n792:     ctx.lineCap = 'round';\n793:     ctx.beginPath();\n794:     ctx.moveTo(startX, trackY);\n795:     ctx.lineTo(endX, trackY);\n796:     ctx.stroke();\n797: \n798:     // Inner conveyor rail\n799:     ctx.strokeStyle = 'rgba(148, 163, 184, 0.35)';\n800:     ctx.lineWidth = 3;\n801:     ctx.beginPath();\n802:     ctx.moveTo(startX, trackY);\n803:     ctx.lineTo(endX, trackY);\n804:     ctx.stroke();\n805: \n806:     // Conveyor tick marks / movement illusion\n807:     const dashOffset = (Date.now() / 35) % 20;\n808:     ctx.strokeStyle = 'rgba(56, 189, 248, 0.5)';\n809:     ctx.lineWidth = 2;\n810:     ctx.setLineDash([4, 6]);\n811:     ctx.lineDashOffset = -dashOffset;\n812:     ctx.beginPath();\n813:     ctx.moveTo(startX, trackY);\n814:     ctx.lineTo(endX, trackY);\n815:     ctx.stroke();\n816:     ctx.setLineDash([]); // Reset dash\n817: \n818:     // 2. Draw & Update Moving WIP Particles\n819:     particles.forEach(p => {{\n820:       p.progress += p.speed;\n821:       if (p.progress > 1) p.progress = 0;\n822: \n823:       // Calculate current X position\n824:       const curX = startX + p.progress * (endX - startX);\n825: \n826:       // Check proximity to bottleneck stations to dynamically slow down (queue up)\n827:       nodes.forEach(n => {{\n828:         if (n.isBN && Math.abs(curX - n.x) < 45 && curX < n.x) {{\n829:           p.speed = 0.0004; // Queue slowdown\n830:         }} else if (Math.abs(curX - n.x) > 50) {{\n831:           p.speed = 0.0012; // Normal conveyor velocity\n832:         }}\n833:       }});\n834: \n835:       // Draw WIP bead\n836:       ctx.beginPath();\n837:       ctx.arc(curX, trackY, p.radius, 0, Math.PI * 2);\n838:       ctx.fillStyle = p.hue;\n839:       ctx.shadowColor = p.hue;\n840:       ctx.shadowBlur = 8;\n841:       ctx.fill();\n842:       ctx.shadowBlur = 0; // Reset\n843:     }});\n844: \n845:     // 3. Draw Station Nodes & Status Badges\n846:     nodes.forEach(n => {{\n847:       const nx = n.x;\n848:       const ny = n.y;\n849: \n850:       if (n.type === 'inflow') {{\n851:         // Inflow terminal\n852:         ctx.fillStyle = 'rgba(30, 41, 59, 0.9)';\n853:         ctx.strokeStyle = '#0284c7';\n854:         ctx.lineWidth = 2;\n855:         ctx.beginPath();\n856:         ctx.roundRect(nx - 36, ny - 32, 72, 64, 8);\n857:         ctx.fill();\n858:         ctx.stroke();\n859: \n860:         ctx.fillStyle = '#94a3b8';\n861:         ctx.font = '9px \"JetBrains Mono\", monospace';\n862:         ctx.textAlign = 'center';\n863:         ctx.fillText('INFLOW', nx, ny - 14);\n864: \n865:         ctx.fillStyle = '#38bdf8';\n866:         ctx.font = 'bold 11px \"Plus Jakarta Sans\", sans-serif';\n867:         ctx.fillText('Raw Stock', nx, ny + 4);\n868: \n869:         ctx.fillStyle = '#64748b';\n870:         ctx.font = '9px \"JetBrains Mono\", monospace';\n871:         ctx.fillText('BUFFER', nx, ny + 18);\n872:       }} else if (n.type === 'outflow') {{\n873:         // Outflow terminal\n874:         ctx.fillStyle = 'rgba(30, 41, 59, 0.9)';\n875:         ctx.strokeStyle = '#10b981';\n876:         ctx.lineWidth = 2;\n877:         ctx.beginPath();\n878:         ctx.roundRect(nx - 36, ny - 32, 72, 64, 8);\n879:         ctx.fill();\n880:         ctx.stroke();\n881: \n882:         ctx.fillStyle = '#94a3b8';\n883:         ctx.font = '9px \"JetBrains Mono\", monospace';\n884:         ctx.textAlign = 'center';\n885:         ctx.fillText('OUTFLOW', nx, ny - 14);\n886: \n887:         ctx.fillStyle = '#34d399';\n888:         ctx.font = 'bold 11px \"Plus Jakarta Sans\", sans-serif';\n889:         ctx.fillText('Shipped', nx, ny + 4);\n890: \n891:         ctx.fillStyle = '#64748b';\n892:         ctx.font = '9px \"JetBrains Mono\", monospace';\n893:         ctx.fillText('OUTPUT', nx, ny + 18);\n894:       }} else {{\n895:         // Production Workstation Node\n896:         const isBN = n.isBN;\n897:         const u = n.util;\n898:         let strokeCol = '#10b981';\n899:         let fillGlow = 'rgba(16, 185, 129, 0.15)';\n900:         let statusText = 'STABLE';\n901:         let statusCol = '#34d399';\n902: \n903:         if (isBN) {{\n904:           strokeCol = '#f43f5e';\n905:           fillGlow = 'rgba(244, 63, 94, 0.35)';\n906:           statusText = 'BOTTLENECK';\n907:           statusCol = '#fb7185';\n908:         }} else if (u > 70) {{\n909:           strokeCol = '#f59e0b';\n910:           fillGlow = 'rgba(245, 158, 11, 0.2)';\n911:           statusText = 'WARNING';\n912:           statusCol = '#fbbf24';\n913:         }}\n914: \n915:         // Pulsing Ring for Bottleneck\n916:         if (isBN) {{\n917:           const pulseR = 44 + Math.sin(pulseAngle) * 6;\n918:           ctx.strokeStyle = 'rgba(244, 63, 94, 0.4)';\n919:           ctx.lineWidth = 2;\n920:           ctx.beginPath();\n921:           ctx.arc(nx, ny, pulseR, 0, Math.PI * 2);\n922:           ctx.stroke();\n923: \n924:           // Radar beacon sweep effect\n925:           ctx.beginPath();\n926:           ctx.arc(nx, ny, pulseR + 4, pulseAngle, pulseAngle + 0.8);\n927:           ctx.strokeStyle = 'rgba(244, 63, 94, 0.85)';\n928:           ctx.lineWidth = 3;\n929:           ctx.stroke();\n930:         }}\n931: \n932:         // Station Card Box\n933:         const cardW = Math.max(78, Math.min(105, stepX - 12));\n934:         const cardH = 74;\n935:         ctx.fillStyle = 'rgba(15, 23, 42, 0.92)';\n936:         ctx.strokeStyle = strokeCol;\n937:         ctx.lineWidth = isBN ? 2.5 : 1.5;\n938: \n939:         ctx.beginPath();\n940:         ctx.roundRect(nx - cardW / 2, ny - cardH / 2, cardW, cardH, 8);\n941:         ctx.fill();\n942:         ctx.stroke();\n943: \n944:         // Station Header / Name\n945:         ctx.fillStyle = '#f8fafc';\n946:         ctx.font = 'bold 11px \"Plus Jakarta Sans\", sans-serif';\n947:         ctx.textAlign = 'center';\n948:         \n949:         let dispName = n.name;\n950:         if (dispName.length > 11) dispName = dispName.substring(0, 10) + '..';\n951:         ctx.fillText(dispName, nx, ny - 18);\n952: \n953:         // Utilization metric\n954:         ctx.fillStyle = statusCol;\n955:         ctx.font = 'bold 14px \"JetBrains Mono\", monospace';\n956:         ctx.fillText(u + '%', nx, ny - 1);\n957: \n958:         // Status Badge Pill\n959:         ctx.fillStyle = fillGlow;\n960:         ctx.strokeStyle = strokeCol;\n961:         ctx.lineWidth = 1;\n962:         ctx.beginPath();\n963:         ctx.roundRect(nx - cardW/2 + 6, ny + 13, cardW - 12, 16, 4);\n964:         ctx.fill();\n965:         ctx.stroke();\n966: \n967:         ctx.fillStyle = statusCol;\n968:         ctx.font = 'bold 8px \"JetBrains Mono\", monospace';\n969:         ctx.fillText(statusText, nx, ny + 24);\n970:       }}\n971:     }});\n972: \n973:     requestAnimationFrame(render);\n974:   }}\n975: \n976:   render();\n977: }})();\n978: </script>\n979: </body>\n980: </html>\n981: \"\"\"\n982:     return html_code\n983: \n984: \n985: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
