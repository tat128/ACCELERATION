           tickfont=dict(color='#94a3b8', size=11),\n41:             title_font=dict(color='#cbd5e1', size=12),\n42:         ),\n43:         **kwargs,\n44:     )\n45: \n46: \n47: # ── Quality Charts ────────────────────────────────────────────────────────────\n48: \n49: def defect_donut(summary: dict) -> go.Figure:\n50:     labels = ['Pass', 'Defect', 'Uncertain', 'Novel']\n51:     values = [\n52:         summary.get('pass', 0),\n53:         summary.get('defect', 0),\n54:         summary.get('uncertain', 0),\n55:         summary.get('novel', 0),\n56:     ]\n57:     colors = [_CYBER['green'], _CYBER['red'], _CYBER['orange'], _CYBER['purple']]\n58: \n59:     fig = go.Figure(go.Pie(\n60:         labels=labels, values=values, hole=0.62,\n61:         marker=dict(colors=colors, line=dict(color='#0b0f19', width=2.5)),\n62:         textinfo='label+percent',\n63:         textfont=dict(size=11, color='#ffffff'),\n64:         hovertemplate='<b>%{label}</b>: %{value} units (%{percent})<extra></extra>',\n65:     ))\n66:     fig.update_layout(\n67:         title=dict(text='Quality Status Distribution', font=dict(size=14, color='#f8fafc')),\n68:         showlegend=True,\n69:         legend=dict(orientation='h', yanchor='bottom', y=-0.22, font=dict(color='#94a3b8')),\n70:         height=320,\n71:         **_base_layout(),\n72:     )\n73:     return fig\n74: \n75: \n76: def defect_type_bar(by_type: dict) -> go.Figure:\n77:     if not by_type:\n78:         return go.Figure()\n79:     df = pd.DataFrame(list(by_type.items()), columns=['Defect', 'Count'])\n80:     color_map = {\n81:         'crack':   _CYBER['red'],\n82:         'hole':    _CYBER['purple'],\n83:         'rust':    _CYBER['orange'],\n84:         'scratch': _CYBER['yellow'],\n85:     }\n86:     colors = [color_map.get(d.lower(), _CYBER['gray']) for d in df['Defect']]\n87:     fig = go.Figure(go.Bar(\n88:         x=df['Defect'], y=df['Count'],\n89:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n90:         text=df['Count'], textposition='outside',\n91:         textfont=dict(color='#ffffff', size=11),\n92:     ))\n93:     fig.update_layout(\n94:         title=dict(text='Defect Class Signature Count', font=dict(size=14, color='#f8fafc')),\n95:         xaxis_title='Defect Signature', yaxis_title='Detected Units',\n96:         height=280,\n97:         **_base_layout(),\n98:     )\n99:     return fig\n100: \n101: \n102: def confidence_histogram(df: pd.DataFrame) -> go.Figure:\n103:     if df.empty:\n104:         return go.Figure()\n105:     fig = px.histogram(\n106:         df[df['status'] != 'PASS'], x='confidence', nbins=20,\n107:         color='status',\n108:         color_discrete_map={'DEFECT': _CYBER['red'], 'UNCERTAIN': _CYBER['orange'], 'NOVEL': _CYBER['purple']},\n109:         title='Neural Confidence Distribution (Flagged Units)',\n110:     )\n111:     fig.update_layout(height=260, **_base_layout())\n112:     return fig\n113: \n114: \n115: def defect_trend(registry_df: pd.DataFrame) -> go.Figure:\n116:     if registry_df.empty:\n117:         return go.Figure()\n118:     fig = go.Figure()\n119:     fig.add_trace(go.Scatter(\n120:         x=registry_df['unit_id'], y=registry_df['rolling_defect_rate'],\n121:         mode='lines+markers', name='Defect Rate',\n122:         line=dict(color=_CYBER['cyan'], width=2.5),\n123:         marker=dict(size=6, color=_CYBER['cyan'], line=dict(color='#ffffff', width=1)),\n124:         fill='tozeroy', fillcolor='rgba(0, 240, 255, 0.12)',\n125:     ))\n126:     fig.add_hline(y=10, line_dash='dash', line_color=_CYBER['orange'],\n127:                   annotation_text='10% Threshold', annotation_position='bottom right',\n128:                   annotation_font=dict(color=_CYBER['orange'], size=10))\n129:     fig.update_layout(\n130:         title=dict(text='Process Drift Telemetry (Rolling 3-Unit Window)', font=dict(size=14, color='#f8fafc')),\n131:         xaxis_title='Inspection Unit #', yaxis_title='Defect Rate (%)',\n132:         height=280,\n133:         **_base_layout(),\n134:     )\n135:     return fig\n136: \n137: \n138: # ── Production Flow Charts ────────────────────────────────────────────────────\n139: \n140: def utilization_bar(station_metrics: dict, model_name: str) -> go.Figure:\n141:     stations = list(station_metrics.keys())\n142:     utils = [v['utilization'] * 100 for v in station_metrics.values()]\n143:     colors = [\n144:         _CYBER['red'] if u > 85 else _CYBER['orange'] if u > 70 else _CYBER['green']\n145:         for u in utils\n146:     ]\n147:     fig = go.Figure(go.Bar(\n148:         x=stations, y=utils,\n149:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n150:         text=[f'{u:.1f}%' for u in utils], textposition='outside',\n151:         textfont=dict(color='#ffffff', size=11),\n152:         hovertemplate='<b>%{x}</b><br>Utilisation: %{y:.1f}%<extra></extra>',\n153:     ))\n154:     fig.add_hline(y=85, line_dash='dash', line_color=_CYBER['red'],\n155:                   annotation_text='Bottleneck Cutoff (85%)',\n156:                   annotation_font=dict(color=_CYBER['red'], size=10))\n157:     fig.add_hline(y=70, line_dash='dot', line_color=_CYBER['orange'],\n158:                   annotation_text='Warning Threshold (70%)',\n159:                   annotation_font=dict(color=_CYBER['orange'], size=10))\n160:     fig.update_layout(\n161:         title=dict(text=f'{model_name} — Station Capacity Utilisation', font=dict(size=14, color='#f8fafc')),\n162:         yaxis=dict(title='Utilisation (%)', range=[0, 115], gridcolor='rgba(0, 240, 255, 0.07)'),\n163:         xaxis_title='Production Station',\n164:         height=320,\n165:         **_base_layout(),\n166:     )\n167:     return fig\n168: \n169: \n170: def waiting_time_bar(station_metrics: dict, model_name: str) -> go.Figure:\n171:     stations = list(station_metrics.keys())\n172:     waits = [v['waiting_time'] for v in station_metrics.values()]\n173:     max_wait = max(waits) if waits else 0\n174:     colors = [_CYBER['red'] if w == max_wait else _CYBER['cyan'] for w in waits]\n175: \n176:     fig = go.Figure(go.Bar(\n177:         x=stations, y=waits,\n178:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n179:         text=[f'{w:.1f}m' for w in waits], textposition='outside',\n180:         textfont=dict(color='#ffffff', size=11),\n181:         hovertemplate='<b>%{x}</b><br>Queue Delay: %{y:.1f} min<extra></extra>',\n182:     ))\n183:     fig.update_layout(\n184:         title=dict(text=f'{model_name} — Queue & Wait Latency', font=dict(size=14, color='#f8fafc')),\n185:         yaxis_title='Queue Delay (minutes)',\n186:         xaxis_title='Production Station',\n187:         height=300,\n188:         **_base_layout(),\n189:     )\n190:     return fig\n191: \n192: \n193: def multi_model_radar(model_analyses: dict) -> go.Figure:\n194:     \"\"\"Radar chart comparing models across key KPIs.\"\"\"\n195:     categories = ['Throughput %', 'Drill Idle', 'Mill Idle', 'Assembly Idle', 'Overall Line Output']\n196:     fig = go.Figure()\n197:     palette_list = [_CYBER['cyan'], _CYBER['green'], _CYBER['purple'], _CYBER['orange']]\n198: \n199:     for i, (model_name, analysis) in enumerate(model_analyses.items()):\n200:         if analysis is None:\n201:             continue\n202:         stations = analysis.get('stations', {})\n203:         values = [\n204:             min(analysis.get('throughput_efficiency', 0), 100),\n205:             100 - stations.get('Drilling', {}).get('utilization', 0) * 100,\n206:             100 - stations.get('Milling', {}).get('utilization', 0) * 100,\n207:             100 - stations.get('Assembly', {}).get('utilization', 0) * 100,\n208:             min(analysis.get('throughput_efficiency', 0), 100),\n209:         ]\n210:         col = palette_list[i % len(palette_list)]\n211:         fig.add_trace(go.Scatterpolar(\n212:             r=values + [values[