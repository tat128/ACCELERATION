0 if baseline['total_loss'] else 0\n                        st.markdown(f\"\"\"\n<div class=\"metric-pane\">\n  <b>{label}</b><br>\n  <span style=\"font-size:18px; font-weight:700; color:#ff3366\">${val:,.2f}</span>\n  <span style=\"color:#94a3b8\"> ({pct:.0f}% of total)</span>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n        # ── Block 2: What-If Simulator ────────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"What-If Scenario Simulation Engine\")\n            st.caption(\"Model projected margin lift from targeted scrap reduction and bottleneck idle mitigation.\")\n\n            col_s1, col_s2 = st.columns(2)\n            with col_s1:\n                util_impr = st.slider(\n                    \"Bottleneck Idle Time Reduction (%)\",\n                    0, 50, 15, step=5,\n                    help=\"Simulates capacity elevation at the bottleneck station.\",\n                )\n            with col_s2:\n                scrap_redn = st.slider(\n                    \"Defect / Scrap Rate Reduction (%)\",\n                    0, 80, 20, step=5,\n                    help=\"Simulates visual inspection quality improvements.\",\n                )\n\n            wi_result = what_if(\n                fin_analysis, fin_defect_sum,\n                scrap_cost, downtime_cost,\n                util_impr, scrap_redn, revenue_mult,\n            )\n            delta = impact_delta(baseline, wi_result)\n\n            w1, w2, w3 = st.columns(3)\n            w1.metric(\"Projected Net Margin\",\n                      f\"${wi_result['net_margin']:,.0f}\",\n                      delta=f\"+${delta['delta_margin']:,.0f} gain\",\n                      delta_color=\"normal\")\n            w2.metric(\"Total Losses Recovered\",\n                      f\"${delta['delta_loss_saved']:,.0f}\",\n                      delta=f\"{delta['margin_improvement_pct']:+.1f}% margin lift\")\n            w3.metric(\"Scrap Reduction\",\n                      f\"{wi_result['scrap_units']:.0f} units\",\n                      delta=f\"{baseline['scrap_units'] - wi_result['scrap_units']:.0f} units saved\",\n                      delta_color=\"inverse\")\n\n        # ── Block 3: Multi-Model Benchmark ────────────────────────────────────\n        if len(analyses) > 1:\n            with st.container(border=True):\n                st.subheader(\"Multi-Model Scenario Profitability\")\n                all_results = {}\n                for name, an in analyses.items():\n                    if an is None:\n                        continue\n                    b = compute_financials(an, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult)\n                    wi = what_if(an, fin_defect_sum, scrap_cost, downtime_cost,\n                                 util_impr, scrap_redn, revenue_mult)\n                    all_results[name] = {'baseline': b, 'whatif': wi}\n\n                st.plotly_chart(margin_comparison_bar(all_results), use_container_width=True, key=\"fin_margin_comp_chart\")\n\n        # ── Block 4: Recommendations & Export ─────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Actionable Engineering Recommendations\")\n            recs = []\n            evidence = correlate(fin_analysis, fin_defect_sum)\n            for card in evidence[:3]:\n                recs.append({\n                    'priority': card['confidence'],\n                    'title':    card['cause'],\n                    'action':   card['action'],\n                    'impact':   \"Direct scrap reduction and buffer stabilization\",\n                })\n\n            if fin_analysis.get('throughput_gap', 0) > 10:\n                recs.insert(0, {\n                    'priority': 'HIGH',\n                    'title':    f\"Elevate {fin_analysis['bottleneck_station']} station capacity\",\n                    'action':   (\n                        f\"{fin_analysis['bottleneck_station']} is operating at \"\n                        f\"{fin_analysis['bottleneck_util']*100:.0f}% capacity utilisation — the primary constraint. \"\n                        \"Add parallel station tooling or schedule shift balancing. \"\n                        f\"Closing the {fin_analysis['throughput_gap']:.0f}-unit gap could recover \"\n                        f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} in unrealized revenue.\"\n                    ),\n                    'impact': f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} revenue recovery\",\n                })\n\n            priority_labels = {'HIGH': '[HIGH PRIORITY]', 'MEDIUM': '[MEDIUM PRIORITY]', 'LOW': '[LOW PRIORITY]'}\n            for i, rec in enumerate(recs[:4], 1):\n                p = rec['priority']\n                st.markdown(f\"\"\"\n<div class=\"evidence-box {p}\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;\">\n    <b>{priority_labels.get(p,'')}&nbsp; #{i} — {rec['title']}</b>\n    <span class=\"badge badge-{p}\">{p}</span>\n  </div>\n  <small>{rec['action']}</small><br>\n  <small style=\"color:#05df9d\"><b>Projected Impact:</b> {rec.get('impact','—')}</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            st.divider()\n\n            report_lines = [\n                \"# Industrial Decision-Support & Quality Intelligence Report\",\n                f\"\\n## Quality Summary\",\n                f\"- Total Units Evaluated: {summary.get('total',0)}\",\n                f\"- Defective Units: {summary.get('defect',0)} ({summary.get('defect_rate',0):.1f}%)\",\n                f\"- Uncertain Classifications: {summary.get('uncertain',0)} | Novel Signatures: {summary.get('novel',0)}\",\n                f\"\\n## Production Flow ({fin_model})\",\n                f\"- Demand Target: {fin_analysis['demand']} | Total Output: {fin_analysis['total_parts']}\",\n                f\"- Throughput Efficiency: {fin_analysis['throughput_efficiency']:.1f}%\",\n                f\"- Bottleneck Station: {fin_analysis['bottleneck_station']} @ {fin_analysis['bottleneck_util']*100:.1f}% utilisation\",\n                f\"\\n## Financial Baseline Snapshot\",\n                f\"- Gross Revenue: ${baseline['gross_revenue']:,.2f}\",\n                f\"- Total Incurred Losses: ${baseline['total_loss']:,.2f}\",\n                f\"- Net Operating Margin: ${baseline['net_margin']:,.2f} ({baseline['margin_pct']:.1f}%)\",\n                f\"\\n## What-If Optimization ({util_impr}% idle reduction, {scrap_redn}% scrap reduction)\",\n                f\"- Projected Operating Margin: ${wi_result['net_margin']:,.2f}\",\n                f\"- Economic Improvement: +${delta['delta_margin']:,.2f} (+{delta['margin_improvement_pct']:.1f}%)\",\n                f\"\\n## Actionable Recommendations\",\n            ]\n            for i, rec in enumerate(recs[:4], 1):\n                report_lines.append(f\"{i}. [{rec['priority']}] {rec['title']}: {rec['action']}\")\n\n            report_text = \"\\n\".join(report_lines)\n            st.download_button(\n                \"Export Comprehensive Executive Report (.md)\",\n                data=report_text,\n                file_name=\"industrial_intelligence_report.md\",\n                mime=\"text/markdown\",\n                use_container_width=True,\n                type=\"primary\",\n            )\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Minimal Clean Futuristic Footer\n# ─────────────────────────────────────────────────────────────────────────────\nst.caption(\"<center style='color:#475569; margin-top:24px; font-family:\\\"JetBrains Mono\\\", monospace;'>AUTONOMOUS INDUSTRIAL QUALITY INTELLIGENCE • SYSTEM ACTIVE</center>\", unsafe_allow_html=True)\n","Description":"Update app.py with futuristic cyber industrial UI design, HUD banner, and glowing telemetry","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antig