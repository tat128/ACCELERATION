─────────────────────────────────────────────────────────────────────────────\n272: with st.sidebar:\n273:     st.markdown(\"### SYSTEM CONTROL\")\n274:     st.caption(\"AI Neural Engine, Telemetry Ingestion & Economic Parameters\")\n275:     st.divider()\n276: \n277:     # AI Model Engine\n278:     with st.container(border=True):\n279:         st.markdown(\"**NEURAL INFERENCE ENGINE**\")\n280:         custom_pt = st.text_input(\n281:             \"Weights File (.pt)\",\n282:             placeholder=r\"D:\\acceleration\\best.pt\",\n283:             label_visibility=\"collapsed\",\n284:         )\n285:         if st.button(\"Initialize Neural Core\", use_container_width=True):\n286:             with st.spinner(\"Compiling YOLOv8 neural pipeline...\"):\n287:                 mdl, err = load_model(custom_pt or None)\n288:                 st.session_state.yolo_model = mdl\n289:                 st.session_state.model_load_error = err\n290:             if mdl:\n291:                 st.success(\"Neural Core Active.\")\n292:             else:\n293:                 st.error(f\"Error: {err}\")\n294: \n295:         # Auto-load on initial run\n296:         if st.session_state.yolo_model is None and st.session_state.model_load_error is None:\n297:             mdl, err = load_model(custom_pt or None)\n298:             st.session_state.yolo_model = mdl\n299:             st.session_state.model_load_error = err\n300: \n301:         if st.session_state.yolo_model:\n302:             st.markdown(\"<small><span class='pulse-dot green'></span> <b>STATUS:</b> ACTIVE (YOLOv8 Core)</small>\", unsafe_allow_html=True)\n303:         elif st.session_state.model_load_error:\n304:             st.caption(f\"Status: {st.session_state.model_load_error[:55]}...\")\n305: \n306:     # Inspection Boundary\n307:     with st.container(border=True):\n308:         st.markdown(\"**DECISION BOUNDARY**\")\n309:         conf_threshold = st.slider(\n310:             \"Confidence Cutoff\",\n311:             min_value=0.20, max_value=0.90, value=0.45, step=0.05,\n312:             help=\"Confidence >= Cutoff: Classified. Below Cutoff: UNCERTAIN. < 0.25: NOVEL.\",\n313:         )\n314: \n315:     # Production Datasets (.CSV, .XLSX, .XLS)\n316:     with st.container(border=True):\n317:         st.markdown(\"**TELEMETRY DATASETS**\")\n318:         st.caption(\"Upload .csv, .xlsx, or .xls Arena simulations\")\n319: \n320:         def _upload_dataset(label, model_key, uploader_key):\n321:             f = st.file_uploader(label, type=['csv', 'xlsx', 'xls'], key=uploader_key)\n322:             if f:\n323:                 df, err = load_dataset(f)\n324:                 if err:\n325:                     st.error(f\"Error reading {f.name}: {err}\")\n326:                 else:\n327:                     st.session_state.model_data[model_key] = df\n328:                     analysis = analyze(df)\n329:                     if analysis:\n330:                         st.session_state.analyses[model_key] = analysis\n331:                         st.success(f\"Loaded {model_key} ({len(df)} rows)\")\n332:                     else:\n333:                         st.warning(f\"Loaded {model_key}, but no station telemetry recognized.\")\n334: \n335:         _upload_dataset(\"Model 1 Telemetry (.csv / .xlsx)\", \"Model 1\", \"upload_m1\")\n336:         _upload_dataset(\"Model 2 Telemetry (.csv / .xlsx)\", \"Model 2\", \"upload_m2\")\n337:         _upload_dataset(\"Model 3 Telemetry (.csv / .xlsx)\", \"Model 3\", \"upload_m3\")\n338: \n339:         # Auto-load if available in project directory\n340:         if not st.session_state.model_data:\n341:             default_path_candidates = {\n342:                 'Model 1': [\n343:                     r'D:\\acceleration\\Model_1.csv', r'D:\\acceleration\\Model 1.csv',\n344:                     r'D:\\acceleration\\Model_1.xlsx', r'D:\\acceleration\\Model 1.xlsx',\n345:                 ],\n346:                 'Model 2': [\n347:                     r'D:\\acceleration\\Model_2.csv', r'D:\\acceleration\\Model 2.csv',\n348:                     r'D:\\acceleration\\Model_2.xlsx', r'D:\\acceleration\\Model 2.xlsx',\n349:                 ],\n350:                 'Model 3': [\n351:                     r'D:\\acceleration\\Model_3.csv', r'D:\\acceleration\\Model 3.csv',\n352:                     r'D:\\acceleration\\Model_3.xlsx', r'D:\\acceleration\\Model 3.xlsx',\n353:                 ],\n354:             }\n355:             for model_name, path_list in default_path_candidates.items():\n356:                 if model_name not in st.session_state.model_data:\n357:                     for p in path_list:\n358:                         if os.path.exists(p):\n359:                             df, err = load_dataset(p)\n360:                             if df is not None:\n361:                                 st.session_state.model_data[model_name] = df\n362:                                 st.session_state.analyses[model_name] = analyze(df)\n363:                                 break\n364: \n365:         if st.session_state.model_data:\n366:             st.caption(f\"Active Models: {', '.join(st.session_state.model_data.keys())}\")\n367: \n368:     # Economic Cost Parameters\n369:     with st.container(border=True):\n370:         st.markdown(\"**ECONOMIC PARAMETERS**\")\n371:         scrap_cost = st.slider(\n372:             \"Scrap Unit Cost ($)\",\n373:             min_value=5.0, max_value=50.0, value=15.0, step=0.5,\n374:             format=\"$%.2f\",\n375:         )\n376:         downtime_cost = st.slider(\n377:             \"Downtime Cost ($/min)\",\n378:             min_value=1.0, max_value=10.0, value=2.50, step=0.25,\n379:             format=\"$%.2f\",\n380:         )\n381:         revenue_mult = st.slider(\n382:             \"Revenue Multiplier\",\n383:             min_value=1.5, max_value=8.0, value=4.0, step=0.5,\n384:             help=\"Unit Selling Price = Scrap Cost x Multiplier\",\n385:         )\n386: \n387:     if st.button(\"Reset Inspection Session\", use_container_width=True):\n388:         st.session_state.registry.clear()\n389:         st.session_state.annotated_images.clear()\n390:         st.success(\"Session reset.\")\n391: \n392: # ─────────────────────────────────────────────────────────────────────────────\n393: # Main Command Header & HUD Telemetry Strip\n394: # ─────────────────────────────────────────────────────────────────────────────\n395: with st.container(border=True):\n396:     h_col1, h_col2 = st.columns([3, 1])\n397:     with h_col1:\n398:         st.title(\"Autonomous Quality & Process Intelligence\")\n399:         st.caption(\"YOLOv8 Neural Vision Engine • Theory of Constraints Bottleneck Diagnostics • Predictive Financial Optimization\")\n400:     with h_col2:\n401:         st.markdown(\"\"\"\n402: <div style=\"text-align:right; margin-top:10px;\">\n403:   <span class=\"badge badge-PASS\"><span class=\"pulse-dot green\"></span>SYSTEM ONLINE</span><br>\n404:   <small style=\"color:#64748b; font-family:'JetBrains Mono';\">LATENCY: 12ms | LEVEL-4 AI</small>\n405: </div>\n406: \"\"\", unsafe_allow_html=True)\n407: \n408:     # Live HUD Telemetry Strip\n409:     st.markdown(\"\"\"\n410: <div class=\"hud-banner\">\n411:   <div><span class=\"pulse-dot\"></span>NEURAL INFERENCE: <span class=\"status-val\">GRAD-CAM ACTIVE</span></div>\n412:   <div>TOC CAPACITY ENGINE: <span class=\"status-val\">MULTI-STAGE ARMORED</span></div>\n413:   <div>SIMULATION PROTOCOL: <span class=\"status-val\">ARENA v16.2 COMPATIBLE</span></div>\n414:   <div>ACCURACY CUTOFF: <span class=\"status-val\">DYNAMIC</span></div>\n415: </div>\n416: \"\"\", unsafe_allow_html=True)\n417: \n418: summary    = st.session_state.registry.summary()\n419: analyses   = st.session_state.analyses\n420: registry   = st.session_state.registry\n421: \n422: # ── Summary KPI Strip ─────────────────────────────────────────────────────────\n423: with st.container(border=True):\n424:     k1, k2, k3, k4, k5 = st.columns(5)\n425:     with k1:\n426:         st.metric(\"Units Inspected\", summary.get('total', 0))\n427:     with k2:\n428:         st.metric(\"Defects Identified\", summary.get('defect', 0),\n429:                   delta=f\"{summary.get('defect_rate', 0):.1f}% defect rate\",\n430:                   delta_color=\"inverse\")\n431:     with k3:\n432:         st.metric(\"Review Required\", f\"{summary.get('uncertain', 0)} / {summary.get('novel', 0)}\")\n433:     with k4:\n434:         st.metric(\"Simulation Models\", len(analyses))\n435:     with k5:\n436:         st.metric(\"Inference Engine\", \"Active\" if st.session_state.yolo_model else \"Inactive\")\n437: \n438: # ─────────────────────────────────────────────────────────────────────────────\n439: # TABS\n440: # ─────────────────────────────────────────────────────────────────────────────\n441: tab1, tab2, tab3, tab4 = st.tabs([\n442:     \"Quality Inspection\",\n443:     \"Production Flow Health\",\n444:     \"Root Cause Analysis\",\n445:     \"Profitability & What-If Simulator\",\n446: ])\n447: \n448: # ═════════════════════════════════════════════════════════════════════════════\n449: # TAB 1 — QUALITY INSPECTION\n450: # ═════════════════════════════════════════════════════════════════════════════\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":710,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T17:47:20Z","thinking":"Refactoring the sidebar aims for a cleaner presentation using tabbed dataset uploaders instead of stacked widgets, accompanied by status indicators for active models. Further improvements involve grouping the AI model engine, decision boundary, and economics components within the sidebar. Consolidating the hero header and KPI commands also appears beneficial for streamlining the interface.\n\n\nA single unified header card is needed to combine the platform title, live status, and KPI metrics. The quality inspection tab will feature a streamlined file uploader, a control bar for gallery adjustments, and a responsive image grid with inline probability meters.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nAutonomous Quality & Process Intelligence Platform\nStreamlit main application with streamlined futuristic industrial UI\n\"\"\"\nimport io\nimport os\nimport sys\nfrom pathlib import Path\n\nimport pandas as pd\nimport streamlit as st\nfrom PIL import Image\n\n# ── Path setup ────────────────────────────────────────────────────────────────\nROOT = Path(__file__).parent\nsys.path.insert(0, str(ROOT))\n\nfrom modules.defect_detector  import load_model, run_inference\nfrom modules.defect_registry  import DefectRegistry\nfrom modules.production_analyzer import load_dataset, load_csv, analyze, compare_models, estimate_wip\nfrom modules.root_cause       import correlate, drift_analysis, flag_novel\nfrom modules.profitability    import compute_financials, what_if, impact_delta\nfrom utils.chart_helpers      import (\n    defect_donut, defect_type_bar, confidence_histogram, defect_trend,\n    utilization_bar, waiting_time_bar, multi_model_radar,\n    financial_waterfall, margin_comparison_bar,\n)\nfrom utils.constants import DEFECT_CLASSES, STATUS_COLORS\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Page Configuration\n# ─────────────────────────────────────────────────────────────────────────────\nst.set_page_config(\n    page_title=\"Industrial Quality & Process AI\",\n    layout=\"wide\",\n    initial_sidebar_state=\"expanded\",\n)\n\n# ── Futuristic Cyber Industrial UI Styling ────────────────────────────────────\nst.markdown(\"\"\"\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap');\n\n    /* Global Canvas */\n    .stApp {\n        background-color: #050711;\n        background-image: \n            radial-gradient(at 0% 0%, rgba(0, 240, 255, 0.08) 0px, transparent 50%),\n            radial-gradient(at 100% 0%, rgba(139, 92, 246, 0.08) 0px, transparent 50%),\n            radial-gradient(at 50% 100%, rgba(16, 185, 129, 0.05) 0px, transparent 50%);\n        font-family: 'Rajdhani', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n        letter-spacing: 0.2px;\n    }\n    \n    /* Typography */\n    h1, h2, h3 {\n        font-family: 'Orbitron', -apple-system, sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.8px !important;\n        color: #f8fafc !important;\n        text-shadow: 0 0 20px rgba(0, 240, 255, 0.15);\n    }\n    h4, h5, h6 {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.5px !important;\n        color: #e2e8f0 !important;\n    }\n\n    /* Sleek Container Cards */\n    [data-testid=\"stVerticalBlockBorderWrapper\"] {\n        background: rgba(11, 17, 33, 0.75) !important;\n        border: 1px solid rgba(0, 240, 255, 0.16) !important;\n        border-radius: 12px !important;\n        backdrop-filter: blur(16px) !important;\n        -webkit-backdrop-filter: blur(16px) !important;\n        box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(0, 240, 255, 0.15) !important;\n        transition: border-color 0.3s ease, box-shadow 0.3s ease;\n    }\n    [data-testid=\"stVerticalBlockBorderWrapper\"]:hover {\n        border-color: rgba(0, 240, 255, 0.32) !important;\n        box-shadow: 0 10px 40px 0 rgba(0, 240, 255, 0.1), inset 0 1px 0 0 rgba(0, 240, 255, 0.25) !important;\n    }\n\n    /* Live Telemetry Pulse Dot */\n    .pulse-dot {\n        display: inline-block;\n        width: 8px;\n        height: 8px;\n        border-radius: 50%;\n        background-color: #00f0ff;\n        box-shadow: 0 0 10px #00f0ff;\n        animation: pulse_glow 2s infinite ease-in-out;\n        margin-right: 6px;\n        vertical-align: middle;\n    }\n    .pulse-dot.green {\n        background-color: #10b981;\n        box-shadow: 0 0 10px #10b981;\n    }\n    @keyframes pulse_glow {\n        0% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 4px currentColor; }\n        50% { transform: scale(1.25); opacity: 1; box-shadow: 0 0 14px currentColor; }\n        100% { transform: scale(0.95); opacity: 0.8; box-shadow: 0 0 4px currentColor; }\n    }\n\n    /* HUD Banner */\n    .hud-banner {\n        display: flex;\n        flex-wrap: wrap;\n        gap: 16px;\n        align-items: center;\n        justify-content: space-between;\n        background: linear-gradient(90deg, rgba(0, 240, 255, 0.08) 0%, rgba(139, 92, 246, 0.04) 100%);\n        border: 1px solid rgba(0, 240, 255, 0.22);\n        border-radius: 8px;\n        padding: 8px 16px;\n        margin: 10px 0;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 11px;\n        color: #94a3b8;\n        letter-spacing: 0.8px;\n    }\n    .hud-banner .status-val {\n        color: #00f0ff;\n        font-weight: 700;\n    }\n\n    /* Badges */\n    .badge {\n        display: inline-block;\n        padding: 3px 10px;\n        border-radius: 4px;\n        font-family: 'JetBrains Mono', monospace;\n        font-size: 11px;\n        font-weight: 700;\n        letter-spacing: 0.8px;\n        text-transform: uppercase;\n        border: 1px solid transparent;\n    }\n    .badge-DEFECT    { background: rgba(239, 68, 68, 0.15); color: #ff3366; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 0 10px rgba(239, 68, 68, 0.2); }\n    .badge-PASS      { background: rgba(16, 185, 129, 0.15); color: #05df9d; border-color: rgba(16, 185, 129, 0.4); box-shadow: 0 0 10px rgba(16, 185, 129, 0.2); }\n    .badge-UNCERTAIN { background: rgba(245, 158, 11, 0.15); color: #ffaa00; border-color: rgba(245, 158, 11, 0.4); box-shadow: 0 0 10px rgba(245, 158, 11, 0.2); }\n    .badge-NOVEL     { background: rgba(139, 92, 246, 0.15); color: #c084fc; border-color: rgba(139, 92, 246, 0.4); box-shadow: 0 0 10px rgba(139, 92, 246, 0.2); }\n    .badge-CRITICAL  { background: rgba(239, 68, 68, 0.15); color: #ff3366; border-color: rgba(239, 68, 68, 0.4); box-shadow: 0 0 10px rgba(239, 68, 68, 0.2); }\n    .badge-WARNING   { background: rgba(245, 158, 11, 0.15); color: #ffaa00; border-color: rgba(245, 158, 11, 0.4); box-shadow: 0 0 10px rgba(245, 158, 11, 0.2); }\n    .badge-OPTIMAL   { background: rgba(16, 185, 129, 0.15); color: #05df9d; border-color: rgba(16, 185, 129, 0.4); box-shadow: 0 0 10px rgba(16, 185, 129, 0.2); }\n    .badge-HIGH      { background: rgba(239, 68, 68, 0.15); color: #ff3366; border-color: rgba(239, 68, 68, 0.4); }\n    .badge-MEDIUM    { background: rgba(245, 158, 11, 0.15); color: #ffaa00; border-color: rgba(245, 158, 11, 0.4); }\n    .badge-LOW       { background: rgba(100, 116, 139, 0.15); color: #94a3b8; border-color: rgba(100, 116, 139, 0.4); }\n\n    /* Evidence Box */\n    .evidence-box {\n        background: rgba(15, 23, 42, 0.85);\n        border: 1px solid rgba(0, 240, 255, 0.18);\n        border-radius: 8px;\n        padding: 14px 16px;\n        margin-bottom: 10px;\n        border-left: 4px solid #00f0ff;\n        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);\n    }\n    .evidence-box.HIGH     { border-left-color: #ff3366; }\n    .evidence-box.CRITICAL { border-left-color: #ff3366; }\n    .evidence-box.MEDIUM   { border-left-color: #ffaa00; }\n    .evidence-box.WARNING  { border-left-color: #ffaa00; }\n    .evidence-box.LOW      { border-left-color: #64748b; }\n    .evidence-box.OPTIMAL  { border-left-color: #05df9d; }\n\n    /* Metric Pane */\n    .metric-pane {\n        background: rgba(13, 20, 38, 0.7);\n        border: 1px solid rgba(0, 240, 255, 0.15);\n        border-radius: 8px;\n        padding: 12px 14px;\n        margin-bottom: 8px;\n        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);\n    }\n\n    /* Tabs Styling */\n    .stTabs [data-baseweb=\"tab-list\"] {\n        gap: 8px;\n        margin-bottom: 14px;\n        background: rgba(11, 17, 33, 0.6);\n        padding: 4px 6px;\n        border-radius: 10px;\n        border: 1px solid rgba(0, 240, 255, 0.12);\n    }\n    .stTabs [data-baseweb=\"tab\"] {\n        font-family: 'Rajdhani', sans-serif;\n        font-size: 15px;\n        font-weight: 700;\n        letter-spacing: 0.5px;\n        padding: 8px 18px;\n        background-color: transparent;\n        border: 1px solid transparent;\n        border-radius: 6px;\n        color: #94a3b8;\n        transition: all 0.2s ease;\n    }\n    .stTabs [data-baseweb=\"tab\"]:hover {\n        color: #00f0ff;\n        background-color: rgba(0, 240, 255, 0.06);\n    }\n    .stTabs [aria-selected=\"true\"] {\n        background: linear-gradient(135deg, rgba(0, 240, 255, 0.15) 0%, rgba(59, 130, 246, 0.15) 100%) !important;\n        color: #00f0ff !important;\n        border-color: rgba(0, 240, 255, 0.4) !important;\n        box-shadow: 0 0 12px rgba(0, 240, 255, 0.15);\n    }\n\n    /* Metrics Values */\n    [data-testid=\"stMetricValue\"] {\n        font-family: 'JetBrains Mono', monospace !important;\n        font-weight: 700 !important;\n        color: #f8fafc !important;\n    }\n    [data-testid=\"stMetricLabel\"] {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-size: 12px !important;\n        font-weight: 600 !important;\n        letter-spacing: 0.6px !important;\n        text-transform: uppercase !important;\n        color: #94a3b8 !important;\n    }\n\n    /* Buttons */\n    .stButton>button {\n        font-family: 'Rajdhani', sans-serif !important;\n        font-weight: 700 !important;\n        letter-spacing: 0.8px !important;\n        text-transform: uppercase !important;\n        border-radius: 6px !important;\n        border: 1px solid rgba(0, 240, 255, 0.3) !important;\n        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;\n        color: #f8fafc !important;\n        transition: all 0.2s ease !important;\n    }\n    .stButton>button:hover {\n        border-color: #00f0ff !important;\n        box-shadow: 0 0 16px rgba(0, 240, 255, 0.35) !important;\n        transform: translateY(-1px);\n    }\n    .stButton>button[kind=\"primary\"] {\n        background: linear-gradient(135deg, #0077b6 0%, #00b4d8 100%) !important;\n        border-color: #00f0ff !important;\n        color: #ffffff !important;\n        box-shadow: 0 0 12px rgba(0, 240, 255, 0.25) !important;\n    }\n    .stButton>button[kind=\"primary\"]:hover {\n        box-shadow: 0 0 22px rgba(0, 240, 255, 0.5) !important;\n    }\n</style>\n\"\"\", unsafe_allow_html=True)\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Session State Initialization\n# ─────────────────────────────────────────────────────────────────────────────\nif 'registry' not in st.session_state:\n    st.session_state.registry = DefectRegistry()\nif 'annotated_images' not in st.session_state:\n    st.session_state.annotated_images = {}\nif 'model_data' not in st.session_state:\n    st.session_state.model_data = {}\nif 'analyses' not in st.session_state:\n    st.session_state.analyses = {}\nif 'yolo_model' not in st.session_state:\n    st.session_state.yolo_model = None\nif 'model_load_error' not in st.session_state:\n    st.session_state.model_load_error = None\n\n# Auto-load weights on launch\nif st.session_state.yolo_model is None and st.session_state.model_load_error is None:\n    mdl, err = load_model()\n    st.session_state.yolo_model = mdl\n    st.session_state.model_load_error = err\n\n# Auto-load default simulation files on launch\nif not st.session_state.model_data:\n    default_path_candidates = {\n        'Model 1': [\n            r'D:\\acceleration\\Model_1.csv', r'D:\\acceleration\\Model 1.csv',\n            r'D:\\acceleration\\Model_1.xlsx', r'D:\\acceleration\\Model 1.xlsx',\n        ],\n        'Model 2': [\n            r'D:\\acceleration\\Model_2.csv', r'D:\\acceleration\\Model 2.csv',\n            r'D:\\acceleration\\Model_2.xlsx', r'D:\\acceleration\\Model 2.xlsx',\n        ],\n        'Model 3': [\n            r'D:\\acceleration\\Model_3.csv', r'D:\\acceleration\\Model 3.csv',\n            r'D:\\acceleration\\Model_3.xlsx', r'D:\\acceleration\\Model 3.xlsx',\n        ],\n    }\n    for model_name, path_list in default_path_candidates.items():\n        if model_name not in st.session_state.model_data:\n            for p in path_list:\n                if os.path.exists(p):\n                    df, err = load_dataset(p)\n                    if df is not None:\n                        st.session_state.model_data[model_name] = df\n                        st.session_state.analyses[model_name] = analyze(df)\n                        break\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Streamlined Sidebar\n# ─────────────────────────────────────────────────────────────────────────────\nwith st.sidebar:\n    st.markdown(\"### SYSTEM CONTROL\")\n    st.caption(\"AI Model, Ingestion & Economic Parameters\")\n    st.divider()\n\n    # AI Model Engine\n    with st.container(border=True):\n        st.markdown(\"**NEURAL INFERENCE ENGINE**\")\n        custom_pt = st.text_input(\n            \"Weights Path (.pt)\",\n            value=r\"D:\\acceleration\\best.pt\",\n            label_visibility=\"collapsed\",\n        )\n        if st.button(\"Reload Model Weights\", use_container_width=True):\n            with st.spinner(\"Initializing YOLOv8...\"):\n                mdl, err = load_model(custom_pt or None)\n                st.session_state.yolo_model = mdl\n                st.session_state.model_load_error = err\n            if mdl:\n                st.success(\"Model Active\")\n            else:\n                st.error(f\"Error: {err}\")\n\n        if st.session_state.yolo_model:\n            st.markdown(\"<small><span class='pulse-dot green'></span> <b>STATUS:</b> ACTIVE (YOLOv8-cls)</small>\", unsafe_allow_html=True)\n        else:\n            st.markdown(\"<small><span class='pulse-dot'></span> <b>STATUS:</b> INACTIVE</small>\", unsafe_allow_html=True)\n\n        conf_threshold = st.slider(\n            \"Confidence Cutoff\",\n            min_value=0.20, max_value=0.90, value=0.45, step=0.05,\n            help=\"Confidence >= Cutoff: Classified. Below: UNCERTAIN. < 0.25: NOVEL.\",\n        )\n\n    # Telemetry Ingestion (Compact Tabbed Interface)\n    with st.container(border=True):\n        st.markdown(\"**TELEMETRY DATASETS**\")\n        st.caption(\"Upload .csv or .xlsx simulation files\")\n        \n        tab_m1, tab_m2, tab_m3 = st.tabs([\"Model 1\", \"Model 2\", \"Model 3\"])\n        \n        def _render_tab_uploader(model_key, tab_obj, uploader_key):\n            with tab_obj:\n                f = st.file_uploader(f\"Upload {model_key}\", type=['csv', 'xlsx', 'xls'], key=uploader_key, label_visibility=\"collapsed\")\n                if f:\n                    df, err = load_dataset(f)\n                    if err:\n                        st.error(f\"Error: {err}\")\n                    else:\n                        st.session_state.model_data[model_key] = df\n                        st.session_state.analyses[model_key] = analyze(df)\n                        st.success(f\"Loaded ({len(df)} rows)\")\n                elif model_key in st.session_state.model_data:\n                    st.caption(f\"Active ({len(st.session_state.model_data[model_key])} rows)\")\n                else:\n                    st.caption(\"No dataset loaded.\")\n\n        _render_tab_uploader(\"Model 1\", tab_m1, \"side_up_m1\")\n        _render_tab_uploader(\"Model 2\", tab_m2, \"side_up_m2\")\n        _render_tab_uploader(\"Model 3\", tab_m3, \"side_up_m3\")\n\n    # Economic Parameters\n    with st.container(border=True):\n        st.markdown(\"**ECONOMIC SENSITIVITY**\")\n        scrap_cost = st.slider(\"Scrap Unit Cost ($)\", 5.0, 50.0, 15.0, 0.5, format=\"$%.2f\")\n        downtime_cost = st.slider(\"Downtime Cost ($/min)\", 1.0, 10.0, 2.50, 0.25, format=\"$%.2f\")\n        revenue_mult = st.slider(\"Revenue Multiplier\", 1.5, 8.0, 4.0, 0.5, help=\"Selling Price = Scrap Cost x Multiplier\")\n\n    if st.button(\"Reset Inspection Session\", use_container_width=True):\n        st.session_state.registry.clear()\n        st.session_state.annotated_images.clear()\n        st.rerun()\n\n# ─────────────────────────────────────────────────────�