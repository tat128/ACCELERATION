rs\n        blur = cv2.GaussianBlur(gray, (7, 7), 0)\n        dark_saliency = float(np.mean(blur)) - blur.astype(np.float32)\n        dark_saliency = np.clip(dark_saliency, 0, 255)\n        \n        sx = cv2.Sobel(blur, cv2.CV_32F, 1, 0, ksize=3)\n        sy = cv2.Sobel(blur, cv2.CV_32F, 0, 1, ksize=3)\n        border_grad = np.sqrt(sx**2 + sy**2)\n        heatmap = (dark_saliency * 0.7) + (border_grad * 0.3)\n\n    else:\n        # General contrast anomaly\n        blur = cv2.GaussianBlur(gray, (11, 11), 0)\n        heatmap = np.abs(gray.astype(np.float32) - blur.astype(np.float32))\n\n    # ── 2. Normalize & Threshold ──────────────────────────────────────────────\n    if heatmap.max() > 0:\n        heatmap_norm = np.uint8(np.clip(heatmap / heatmap.max() * 255.0, 0, 255))\n    else:\n        heatmap_norm = np.zeros((h, w), dtype=np.uint8)\n\n    # Adaptive high-percentile threshold to focus only on genuine defect peak\n    p90 = np.percentile(heatmap_norm, 88)\n    _, thresh = cv2.threshold(heatmap_norm, max(int(p90), 45), 255, cv2.THRESH_BINARY)\n    \n    # Morphological clean up to connect small gaps but avoid global merge\n    k_morph = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n    thresh = cv2.morphologyEx(thresh, cv2.MORPH_CLOSE, k_morph, iterations=1)\n\n    # ── 3. Find Contours and Calculate Bounding Boxes ─────────────────────────\n    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    \n    min_box_area = (w * h) * 0.0008    # At least 0.08% of image\n    max_box_w = w * 0.70               # Never more than 70% width\n    max_box_h = h * 0.70               # Never more than 70% height\n\n    candidates = []\n    for cnt in contours:\n        area = cv2.contourArea(cnt)\n        x, y, bw, bh = cv2.boundingRect(cnt)\n        \n        # Filter out extreme frame-spanning boxes or border noise\n        if bw > max_box_w or bh > max_box_h:\n            continue\n        if x <= 2 and y <= 2 and (x + bw) >= (w - 3) and (y + bh) >= (h - 3):\n            continue\n        if (bw * bh) < min_box_area:\n            continue\n\n        # Add balanced padding around defect\n        pad_x = max(6, int(bw * 0.15))\n        pad_y = max(6, int(bh * 0.15))\n        x1 = max(0, x - pad_x)\n        y1 = max(0, y - pad_y)\n        x2 = min(w, x + bw + pad_x)\n        y2 = min(h, y + bh + pad_y)\n        \n        # Score candidate by peak intensity in this box\n        box_score = float(np.mean(heatmap_norm[y:y+bh, x:x+bw]))\n        candidates.append((box_score, [float(x1), float(y1), float(x2), float(y2)]))\n\n    # Sort by defect prominence score descending\n    candidates.sort(key=lambda c: c[0], reverse=True)\n\n    if candidates:\n        # Return top 1-2 most prominent defect boxes\n        boxes = [c[1] for c in candidates[:2]]\n    else:\n        # Pinpoint the single highest anomaly peak coordinate (cx, cy)\n        min_val, max_val, min_loc, max_loc = cv2.minMaxLoc(heatmap_norm)\n        cx, cy = max_loc\n        \n        # Create a tight compact box (e.g. 20% of image size) centered on defect peak\n        box_radius_x = int(w * 0.12)\n        box_radius_y = int(h * 0.12)\n        x1 = max(0, cx - box_radius_x)\n        y1 = max(0, cy - box_radius_y)\n        x2 = min(w, cx + box_radius_x)\n        y2 = min(h, cy + box_radius_y)\n        boxes = [[float(x1), float(y1), float(x2), float(y2)]]\n\n    return boxes\n\n\n# ── Inference ─────────────────────────────────────────────────────────────────\n\ndef run_inference(\n    image_input,\n    model=None,\n    conf_threshold: float = CONFIDENCE_THRESHOLD,\n) -> dict:\n    \"\"\"\n    Run YOLOv8 on one image (PIL Image, file path, or uploaded bytes).\n\n    Returns\n    -------\n    dict with keys:\n        status          PASS | DEFECT | UNCERTAIN | NOVEL | ERROR\n        defect_type     primary class name\n        confidence      float 0-1\n        bbox            [x1,y1,x2,y2] or None\n        all_detections  list of raw detection dicts\n        annotated_image PIL Image\n        error           str (only when status == ERROR)\n    \"\"\"\n    if model is None:\n        model, err = load_model()\n        if model is None:\n            return {'status': 'ERROR', 'error': err,\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'bbox': None, 'all_detections': [],\n                    'annotated_image': None}\n\n    if isinstance(image_input, Image.Image):\n        img = image_input.convert('RGB')\n    else:\n        try:\n            img = Image.open(image_input).convert('RGB')\n        except Exception as exc:\n            return {'status': 'ERROR', 'error': str(exc),\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'bbox': None, 'all_detections': [],\n                    'annotated_image': None}\n\n    try:\n        results = model(img, verbose=False)\n    except Exception as exc:\n        return {'status': 'ERROR', 'error': f'Inference error: {exc}',\n                'defect_type': 'unknown', 'confidence': 0.0,\n                'bbox': None, 'all_detections': [],\n                'annotated_image': None}\n\n    result = results[0]\n    detections: list[dict] = []\n\n    # Detection mode (bounding boxes from YOLOv8 Detection model)\n    if hasattr(result, 'boxes') and result.boxes is not None and len(result.boxes) > 0:\n        for box in result.boxes:\n            cls_id  = int(box.cls[0].item())\n            conf    = float(box.conf[0].item())\n            cls_name = (result.names or {}).get(cls_id, DEFECT_CLASSES[cls_id] if cls_id < len(DEFECT_CLASSES) else 'unknown')\n            detections.append({\n                'defect_type': cls_name.lower(),\n                'confidence':  conf,\n                'bbox':        box.xyxy[0].tolist(),\n            })\n\n    # Classification mode (softmax probs from YOLOv8 Classification model)\n    elif hasattr(result, 'probs') and result.probs is not None:\n        probs    = result.probs.data.cpu().tolist()\n        top_cls  = int(result.probs.top1)\n        top_conf = float(result.probs.top1conf.item())\n        cls_name = (result.names or {}).get(top_cls, DEFECT_CLASSES[top_cls] if top_cls < len(DEFECT_CLASSES) else 'unknown')\n\n        # Localize defect box if defective\n        local_boxes = localize_defect_saliency(img, cls_name)\n        \n        if local_boxes:\n            for b in local_boxes:\n                detections.append({\n                    'defect_type': cls_name.lower(),\n                    'confidence':  top_conf,\n                    'bbox':        b,\n                })\n        else:\n            detections.append({\n                'defect_type': cls_name.lower(),\n                'confidence':  top_conf,\n                'bbox':        None,\n            })\n\n    # ── Determine status ──────────────────────────────────────────────────────\n    if not detections:\n        status        = 'PASS'\n        primary_type  = 'normal'\n        primary_conf  = 1.0\n        primary_bbox  = None\n    else:\n        concern_first = sorted(\n            detections,\n            key=lambda d: (d['defect_type'] not in ('normal', 'acceptable', 'pass'), d['confidence']),\n            reverse=True,\n        )\n        top = concern_first[0]\n        primary_type = top['defect_type']\n        primary_conf = top['confidence']\n        primary_bbox = top['bbox']\n\n        if primary_conf < NOVEL_THRESHOLD:\n            status = 'NOVEL'\n        elif primary_conf < conf_threshold:\n            status = 'UNCERTAIN'\n        elif primary_type in ('normal', 'acceptable', 'pass'):\n            status = 'PASS'\n        else:\n            status = 'DEFECT'\n\n    annotated = annotate_image(img.copy(), detections, status)\n\n    return {\n        'status':          status,\n        'defect_type':     primary_type,\n        'confidence':      primary_conf,\n        'bbox':            primary_bbox,\n        'all_detections':  detections,\n        'annotated_image': annotated,\n    }\n\n\n# ── Image Annotation with HUD Bounding Boxes ──────────────────────────────────\n\ndef annotate_image(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n    \"\"\"\n    Draws targeted defect bounding boxes, corner target brackets,\n    and confidence badges directly around the defect location.\n    \"\"\"\n    w, h = img.size\n    \n    overlay = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n    draw_overlay = ImageDraw.Draw(overlay)\n    draw = ImageDraw.Draw(img)\n\n    for det in detections:\n        bbox = det.get('bbox')\n        dtype = det['defect_type'].lower()\n        if bbox is None or dtype in ('normal', 'acceptable', 'pass'):\n            continue\n\n        x1, y1, x2, y2 = [int(v) for v in bbox]\n        color_hex = DEFECT_COLORS.get(dtype, '#e74c3c')\n        \n        c_rgb = tuple(int(color_hex.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))\n        fill_rgba = c_rgb + (50,)  # 20% opacity highlight fill\n\n        # 1. Translucent fill over defect area\n        draw_overlay.rectangle([x1, y1, x2, y2], fill=fill_rgba)\n\n        # 2. Defect bounding box\n        box_thickness = max(2, int(min(w, h) / 220))\n        draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n\n        # 3. Target corner brackets\n        corner_len = min(int((x2 - x1) * 0.22), int((y2 - y1) * 0.22), 20)\n        c_thick = box_thickness + 2\n\n        draw.line([(x1, y1), (x1 + corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y1), (x1, y1 + corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y1), (x2 - corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y1), (x2, y1 + corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y2), (x1 + corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y2), (x1, y2 - corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y2), (x2 - corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y2), (x2 - corner_len, y2)], fill=color_hex, width=c_thick)\n\n        # 4. Defect Tag badge\n        label = f\" {dtype.upper()} · {det['confidence']*100:.1f}% \"\n        dim_text = f\" [{x2-x1}×{y2-y1}px] \"\n        full_label = label + dim_text\n\n        try:\n            font = ImageFont.truetype(\"arialbd.ttf\", max(11, int(min(w, h) / 45)))\n        except Exception:\n            try:\n                font = ImageFont.truetype(\"arial.ttf\", max(11, int(min(w, h) / 45)))\n            except Exception:\n                font = ImageFont.load_default()\n\n        bbox_text = draw.textbbox((0, 0), full_label, font=font)\n        text_w = bbox_text[2] - bbox_text[0]\n        text_h = bbox_text[3] - bbox_text[1]\n\n        lbl_y1 = max(0, y1 - text_h - 5)\n        lbl_y2 = lbl_y1 + text_h + 5\n        lbl_x1 = x1\n        lbl_x2 = min(w, x1 + text_w + 6)\n\n        draw.rectangle([lbl_x1, lbl_y1, lbl_x2, lbl_y2], fill=color_hex)\n        draw.text((lbl_x1 + 3, lbl_y1 + 2), full_label, fill='white', font=font)\n\n    final_img = Image.alpha_composite(img.convert('RGBA'), overlay).convert('RGB')\n    return final_img\n","Description":"Refined defect detector with precise rust, scratch, crack, and hole contour filters and compact bounding boxes without full-image zoom artifacts","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\modules\\defect_detector.py","toolAction":"Updating defect detector","toolSummary":"Update defect localization and annotation"}}]}
