ding box:\",\n300:                 img_names,\n301:                 index=len(img_names) - 1,\n302:                 key=\"sel_defect_inspect\",\n303:             )\n304: \n305:             sel_res = st.session_state.annotated_images.get(sel_img_name)\n306:             if sel_res and sel_res.get('annotated_image'):\n307:                 vcol1, vcol2 = st.columns([3, 2])\n308:                 with vcol1:\n309:                     st.image(\n310:                         sel_res['annotated_image'],\n311:                         caption=f\"HUD Defect Box · {sel_img_name}\",\n312:                         use_container_width=True,\n313:                     )\n314:                 with vcol2:\n315:                     st.markdown(\"#### Defect Telemetry\")\n316:                     st_val = sel_res['status']\n317:                     st.markdown(f\"**Classification Status:** <span class='badge badge-{st_val}'>{st_val}</span>\", unsafe_allow_html=True)\n318:                     st.markdown(f\"**Identified Defect Type:** `{sel_res['defect_type'].upper()}`\")\n319:                     st.markdown(f\"**Model Confidence:** `{sel_res['confidence']*100:.2f}%`\")\n320:                     \n321:                     bbox = sel_res.get('bbox')\n322:                     if bbox:\n323:                         x1, y1, x2, y2 = [int(v) for v in bbox]\n324:                         bw, bh = x2 - x1, y2 - y1\n325:                         st.markdown(f\"**Bounding Box:** `[{x1}, {y1}, {x2}, {y2}]`\")\n326:                         st.markdown(f\"**Defect Area:** `{bw} × {bh} px` ({bw*bh:,} pixels)\")\n327:                         st.info(f\"📍 Defect sits at horizontal offset **X: {x1}px**, vertical offset **Y: {y1}px**.\")\n328:                     else:\n329:                         st.success(\"✅ No localized defect bounding box (Acceptable/Normal unit).\")\n330: \n331:             st.divider()\n332: \n333:         r1, r2 = st.columns([1, 2])\n334: \n335:         with r1:\n336:             