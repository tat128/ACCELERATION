{"step_index":218,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T15:17:21Z","thinking":"Grad-CAM successfully computed, directly applying to the YOLOv8 model. This offers AI-driven defect localization by pinpointing the precise regions the neural network identifies, surpassing the limitations of edge filters when dealing with complex surface imperfections like rust. The method generates a thermal heatmap and bounding box indicating the detected defect area.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"YOLOv8 inference wrapper with authentic PyTorch Grad-CAM Neural Activation Localization.\"\"\"\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\nimport cv2\nimport numpy as np\nimport torch\nimport torch.nn.functional as F\nfrom PIL import Image, ImageDraw, ImageFont\n\nfrom utils.constants import (\n    DEFECT_CLASSES,\n    DEFECT_COLORS,\n    STATUS_COLORS,\n    CONFIDENCE_THRESHOLD,\n    NOVEL_THRESHOLD,\n    MODEL_PATHS,\n)\n\ntry:\n    from ultralytics import YOLO\n    _YOLO_AVAILABLE = True\nexcept ImportError:\n    _YOLO_AVAILABLE = False\n\n_model_cache: dict[str, object] = {}\n\n\n# ── Model Loading ─────────────────────────────────────────────────────────────\n\ndef load_model(custom_path: Optional[str] = None) -> tuple[object | None, str | None]:\n    \"\"\"Return (model, error_msg). Model is cached per path.\"\"\"\n    if not _YOLO_AVAILABLE:\n        return None, (\n            \"ultralytics not installed.\\n\"\n            \"Run: pip install ultralytics\"\n        )\n\n    search_paths = ([custom_path] if custom_path else []) + MODEL_PATHS\n    for path in search_paths:\n        if not path:\n            continue\n        if path in _model_cache:\n            return _model_cache[path], None\n        if os.path.exists(path):\n            try:\n                model = YOLO(path)\n                _model_cache[path] = model\n                return model, None\n            except Exception as exc:\n                return None, f\"Failed to load {path}: {exc}\"\n\n    checked = [p for p in search_paths if p]\n    return None, (\n        f\"Model weights not found.\\n\"\n        f\"Checked:\\n\" + \"\\n\".join(f\"  • {p}\" for p in checked) +\n        \"\\n\\nPlace best.pt at D:\\\\acceleration\\\\best.pt or upload below.\"\n    )\n\n\n# ── PyTorch Grad-CAM Neural Activation Engine ─────────────────────────────────\n\ndef compute_gradcam(\n    yolo_model: object,\n    img_pil: Image.Image,\n    target_class_idx: int,\n) -> tuple[np.ndarray | None, list[list[float]]]:\n    \"\"\"\n    Computes exact Grad-CAM activation heatmap from YOLOv8's penultimate feature layer.\n    Returns (cam_heatmap_0_to_1, list_of_bounding_boxes).\n    \"\"\"\n    try:\n        pytorch_model = yolo_model.model\n        pytorch_model.eval()\n        \n        orig_w, orig_h = img_pil.size\n        \n        # Preprocess image to tensor\n        img_resized = img_pil.resize((224, 224)).convert('RGB')\n        img_np = np.array(img_resized, dtype=np.float32) / 255.0\n        tensor = torch.from_numpy(img_np).permute(2, 0, 1).unsqueeze(0)\n        tensor.requires_grad = True\n\n        features_list = []\n        grads_list = []\n\n        def f_hook(module, inp, out):\n            features_list.append(out)\n\n        def b_hook(module, grad_in, grad_out):\n            grads_list.append(grad_out[0])\n\n        # Hook the last C2f feature layer (Layer 8)\n        target_layer = pytorch_model.model[8] if hasattr(pytorch_model, 'model') and len(pytorch_model.model) > 8 else pytorch_model.model[-2]\n        h1 = target_layer.register_forward_hook(f_hook)\n        h2 = target_layer.register_full_backward_hook(b_hook)\n\n        # Forward pass\n        output = pytorch_model(tensor)\n        if isinstance(output, tuple):\n            output = output[0]\n\n        # Backward pass for target defect class\n        pytorch_model.zero_grad()\n        score = output[0, target_class_idx]\n        score.backward()\n\n        h1.remove()\n        h2.remove()\n\n        if not features_list or not grads_list:\n            return None, []\n\n        feature = features_list[-1][0].detach()  # [C, H, W]\n        grad = grads_list[-1][0].detach()        # [C, H, W]\n\n        # Global average pooling of gradients\n        weights = grad.mean(dim=(1, 2), keepdim=True)\n        cam = (weights * feature).sum(dim=0)\n        cam = F.relu(cam).cpu().numpy()\n\n        cam_min, cam_max = cam.min(), cam.max()\n        if cam_max - cam_min > 1e-6:\n            cam = (cam - cam_min) / (cam_max - cam_min)\n        else:\n            cam = np.zeros_like(cam)\n\n        cam_resized = cv2.resize(cam, (orig_w, orig_h), interpolation=cv2.INTER_CUBIC)\n        cam_resized = np.clip(cam_resized, 0.0, 1.0)\n\n        # ── Extract Bounding Boxes from Peak Activation Zone ──────────────────\n        boxes = []\n        # Threshold the top activation region (regions with activation > 45% of peak)\n        thresh_val = max(0.45, np.percentile(cam_resized, 80))\n        _, bin_mask = cv2.threshold(np.uint8(cam_resized * 255), int(thresh_val * 255), 255, cv2.THRESH_BINARY)\n        \n        # Morphological clean up\n        k_morph = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (9, 9))\n        bin_mask = cv2.morphologyEx(bin_mask, cv2.MORPH_CLOSE, k_morph)\n\n        contours, _ = cv2.findContours(bin_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        min_area = (orig_w * orig_h) * 0.002\n\n        for cnt in contours:\n            if cv2.contourArea(cnt) < min_area:\n                continue\n            x, y, bw, bh = cv2.boundingRect(cnt)\n            # Avoid full-screen boundary artifacts\n            if bw > (orig_w * 0.85) and bh > (orig_h * 0.85):\n                continue\n            pad_x = max(8, int(bw * 0.12))\n            pad_y = max(8, int(bh * 0.12))\n            x1 = max(0, x - pad_x)\n            y1 = max(0, y - pad_y)\n            x2 = min(orig_w, x + bw + pad_x)\n            y2 = min(orig_h, y + bh + pad_y)\n            boxes.append([float(x1), float(y1), float(x2), float(y2)])\n\n        if not boxes:\n            # Anchor around the single highest activation peak coordinate\n            min_v, max_v, min_loc, max_loc = cv2.minMaxLoc(cam_resized)\n            cx, cy = max_loc\n            rad_x = int(orig_w * 0.15)\n            rad_y = int(orig_h * 0.15)\n            boxes = [[\n                float(max(0, cx - rad_x)),\n                float(max(0, cy - rad_y)),\n                float(min(orig_w, cx + rad_x)),\n                float(min(orig_h, cy + rad_y)),\n            ]]\n\n        return cam_resized, boxes[:2]\n\n    except Exception:\n        return None, []\n\n\n# ── Inference ─────────────────────────────────────────────────────────────────\n\ndef run_inference(\n    image_input,\n    model=None,\n    conf_threshold: float = CONFIDENCE_THRESHOLD,\n) -> dict:\n    \"\"\"\n    Run YOLOv8 on one image (PIL Image, file path, or uploaded bytes).\n\n    Returns\n    -------\n    dict with keys:\n        status              PASS | DEFECT | UNCERTAIN | NOVEL | ERROR\n        defect_type         primary class name\n        confidence          float 0-1\n        class_probs         dict of class -> prob float\n        bbox                [x1,y1,x2,y2] or None\n        all_detections      list of detection dicts\n        annotated_image     PIL Image with HUD Bounding Box\n        heatmap_image       PIL Image with Grad-CAM Activation Heatmap\n        raw_image           PIL Image original\n        error               str (only when status == ERROR)\n    \"\"\"\n    if model is None:\n        model, err = load_model()\n        if model is None:\n            return {'status': 'ERROR', 'error': err,\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'class_probs': {}, 'bbox': None, 'all_detections': [],\n                    'annotated_image': None, 'heatmap_image': None, 'raw_image': None}\n\n    if isinstance(image_input, Image.Image):\n        img = image_input.convert('RGB')\n    else:\n        try:\n            img = Image.open(image_input).convert('RGB')\n        except Exception as exc:\n            return {'status': 'ERROR', 'error': str(exc),\n                    'defect_type': 'unknown', 'confidence': 0.0,\n                    'class_probs': {}, 'bbox': None, 'all_detections': [],\n                    'annotated_image': None, 'heatmap_image': None, 'raw_image': None}\n\n    try:\n        results = model(img, verbose=False)\n    except Exception as exc:\n        return {'status': 'ERROR', 'error': f'Inference error: {exc}',\n                'defect_type': 'unknown', 'confidence': 0.0,\n                'class_probs': {}, 'bbox': None, 'all_detections': [],\n                'annotated_image': None, 'heatmap_image': None, 'raw_image': img}\n\n    result = results[0]\n    detections: list[dict] = []\n    class_probs: dict[str, float] = {}\n    cam_heatmap: np.ndarray | None = None\n\n    # ── Detection model mode ──────────────────────────────────────────────────\n    if hasattr(result, 'boxes') and result.boxes is not None and len(result.boxes) > 0:\n        for box in result.boxes:\n            cls_id = int(box.cls[0].item())\n            conf = float(box.conf[0].item())\n            cls_name = (result.names or {}).get(cls_id, DEFECT_CLASSES[cls_id] if cls_id < len(DEFECT_CLASSES) else 'unknown')\n            detections.append({\n                'defect_type': cls_name.lower(),\n                'confidence': conf,\n                'bbox': box.xyxy[0].tolist(),\n            })\n\n    # ── Classification model mode with Grad-CAM ──────────────────────────────\n    elif hasattr(result, 'probs') and result.probs is not None:\n        probs_raw = result.probs.data.cpu().numpy()\n        top_cls_idx = int(result.probs.top1)\n        top_conf = float(result.probs.top1conf.item())\n        cls_name = (result.names or {}).get(top_cls_idx, DEFECT_CLASSES[top_cls_idx] if top_cls_idx < len(DEFECT_CLASSES) else 'unknown').lower()\n\n        # Build full probability dictionary\n        for idx, p in enumerate(probs_raw):\n            c_name = (result.names or {}).get(idx, DEFECT_CLASSES[idx] if idx < len(DEFECT_CLASSES) else f'class_{idx}').lower()\n            class_probs[c_name] = round(float(p), 4)\n\n        if cls_name not in ('normal', 'acceptable', 'pass'):\n            # Compute exact Grad-CAM neural activation localization\n            cam_heatmap, local_boxes = compute_gradcam(model, img, top_cls_idx)\n            for b in local_boxes:\n                detections.append({\n                    'defect_type': cls_name,\n                    'confidence': top_conf,\n                    'bbox': b,\n                })\n        else:\n            detections.append({\n                'defect_type': cls_name,\n                'confidence': top_conf,\n                'bbox': None,\n            })\n\n    # ── Determine Status ──────────────────────────────────────────────────────\n    if not detections:\n        status = 'PASS'\n        primary_type = 'normal'\n        primary_conf = 1.0\n        primary_bbox = None\n    else:\n        concern_first = sorted(\n            detections,\n            key=lambda d: (d['defect_type'] not in ('normal', 'acceptable', 'pass'), d['confidence']),\n            reverse=True,\n        )\n        top = concern_first[0]\n        primary_type = top['defect_type']\n        primary_conf = top['confidence']\n        primary_bbox = top['bbox']\n\n        if primary_conf < NOVEL_THRESHOLD:\n            status = 'NOVEL'\n        elif primary_conf < conf_threshold:\n            status = 'UNCERTAIN'\n        elif primary_type in ('normal', 'acceptable', 'pass'):\n            status = 'PASS'\n        else:\n            status = 'DEFECT'\n\n    # Build annotated image with targeted HUD box\n    annotated = annotate_image(img.copy(), detections, status)\n\n    # Build Grad-CAM Heatmap overlay image\n    heatmap_img = generate_heatmap_overlay(img.copy(), cam_heatmap, status, primary_type)\n\n    return {\n        'status': status,\n        'defect_type': primary_type,\n        'confidence': primary_conf,\n        'class_probs': class_probs,\n        'bbox': primary_bbox,\n        'all_detections': detections,\n        'annotated_image': annotated,\n        'heatmap_image': heatmap_img,\n        'raw_image': img,\n    }\n\n\n# ── Grad-CAM Heatmap Visualizer ───────────────────────────────────────────────\n\ndef generate_heatmap_overlay(\n    img: Image.Image,\n    cam: np.ndarray | None,\n    status: str,\n    defect_type: str,\n) -> Image.Image:\n    \"\"\"Creates a smooth thermal activation heatmap overlay on the original image.\"\"\"\n    if cam is None or status == 'PASS':\n        return img\n\n    img_rgb = np.array(img.convert('RGB'))\n    h, w, _ = img_rgb.shape\n\n    # Apply Jet/Turbo colormap to Grad-CAM activation\n    cam_uint = np.uint8(np.clip(cam * 255, 0, 255))\n    heatmap_color = cv2.applyColorMap(cam_uint, cv2.COLORMAP_JET)\n    heatmap_color = cv2.cvtColor(heatmap_color, cv2.COLOR_BGR2RGB)\n\n    # Blend with original image\n    blended = cv2.addWeighted(img_rgb, 0.65, heatmap_color, 0.35, 0)\n    return Image.fromarray(blended)\n\n\n# ── Image Annotation with HUD Bounding Boxes ──────────────────────────────────\n\ndef annotate_image(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n    \"\"\"\n    Draws targeted defect bounding boxes and target corner brackets\n    directly around the neural network's activation region.\n    \"\"\"\n    w, h = img.size\n    \n    overlay = Image.new('RGBA', (w, h), (0, 0, 0, 0))\n    draw_overlay = ImageDraw.Draw(overlay)\n    draw = ImageDraw.Draw(img)\n\n    for det in detections:\n        bbox = det.get('bbox')\n        dtype = det['defect_type'].lower()\n        if bbox is None or dtype in ('normal', 'acceptable', 'pass'):\n            continue\n\n        x1, y1, x2, y2 = [int(v) for v in bbox]\n        color_hex = DEFECT_COLORS.get(dtype, '#e74c3c')\n        \n        c_rgb = tuple(int(color_hex.lstrip('#')[i:i+2], 16) for i in (0, 2, 4))\n        fill_rgba = c_rgb + (45,)  # 18% opacity highlight fill\n\n        # 1. Translucent fill over defect area\n        draw_overlay.rectangle([x1, y1, x2, y2], fill=fill_rgba)\n\n        # 2. Defect bounding box\n        box_thickness = max(2, int(min(w, h) / 220))\n        draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n\n        # 3. Target corner brackets\n        corner_len = min(int((x2 - x1) * 0.22), int((y2 - y1) * 0.22), 20)\n        c_thick = box_thickness + 2\n\n        draw.line([(x1, y1), (x1 + corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y1), (x1, y1 + corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y1), (x2 - corner_len, y1)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y1), (x2, y1 + corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y2), (x1 + corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x1, y2), (x1, y2 - corner_len)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y2), (x2 - corner_len, y2)], fill=color_hex, width=c_thick)\n        draw.line([(x2, y2), (x2, y2 - corner_len)], fill=color_hex, width=c_thick)\n\n        # 4. Defect Tag badge\n        label = f\" {dtype.upper()} · {det['confidence']*100:.1f}% \"\n        dim_text = f\" [{x2-x1}×{y2-y1}px] \"\n        full_label = label + dim_text\n\n        try:\n            font = ImageFont.truetype(\"arialbd.ttf\", max(11, int(min(w, h) / 45)))\n        except Exception:\n            try:\n                font = ImageFont.truetype(\"arial.ttf\", max(11, int(min(w, h) / 45)))\n            except Exception:\n                font = ImageFont.load_default()\n\n        bbox_text = draw.textbbox((0, 0), full_label, font=font)\n        text_w = bbox_text[2] - bbox_text[0]\n        text_h = bbox_text[3] - bbox_text[1]\n\n        lbl_y1 = max(0, y1 - text_h - 5)\n        lbl_y2 = lbl_y1 + text_h + 5\n        lbl_x1 = x1\n        lbl_x2 = min(w, x1 + text_w + 6)\n\n        draw.rectangle([lbl_x1, lbl_y1, lbl_x2, lbl_y2], fill=color_hex)\n        draw.text((lbl_x1 + 3, lbl_y1 + 2), full_label, fill='white', font=font)\n\n    final_img = Image.alpha_composite(img.convert('RGBA'), overlay).convert('RGB')\n    return final_img\n","Description":"Complete rewrite of defect_detector.py with true PyTorch Grad-CAM neural activation localization, thermal heatmaps, and precise AI-derived bounding boxes","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\modules\\defect_detector.py","toolAction":"Updating defect detector with Grad-CAM","toolSummary":"Implement PyTorch GradCAM and Heatmaps"}}]}
