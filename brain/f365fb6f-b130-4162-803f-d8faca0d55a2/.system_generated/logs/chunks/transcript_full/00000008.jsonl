.rectangle([x1, y1, x2, y2], fill=c_rgb + (40,))\n339:         box_thickness = max(2, int(min(w, h) / 200))\n340:         draw.rectangle([x1, y1, x2, y2], outline=color_hex, width=box_thickness)\n341: \n342:         # Tag\n343:         label = f\" {dtype.upper()} {det['confidence']*100:.0f}% \"\n344:         try:\n345:             font = ImageFont.truetype(\"arialbd.ttf\", max(10, int(min(w, h) / 50)))\n346:         except Exception:\n347:             font = ImageFont.load_default()\n348: \n349:         lbl_y1 = max(0, y1 - 18)\n350:         draw.rectangle([x1, lbl_y1, x1 + len(label)*7, y1], fill=color_hex)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
