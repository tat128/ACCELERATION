{"step_index":341,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T16:05:47Z","content":"Created At: 2026-09-19T21:35:47+05:30\nCompleted At: 2026-09-19T21:35:47+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/defect_detector.py`\nTotal Lines: 375\nTotal Bytes: 13992\nShowing lines 50 to 149\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n50:                 model = YOLO(path)\n51:                 _model_cache[path] = model\n52:                 return model, None\n53:             except Exception as exc:\n54:                 return None, f\"Failed to load {path}: {exc}\"\n55: \n56:     checked = [p for p in search_paths if p]\n57:     return None, (\n58:         f\"Model weights not found.\\n\"\n59:         f\"Checked:\\n\" + \"\\n\".join(f\"  • {p}\" for p in checked) +\n60:         \"\\n\\nPlace best.pt at D:\\\\acceleration\\\\best.pt or upload below.\"\n61:     )\n62: \n63: \n64: # ── PyTorch Grad-CAM Neural Activation ─────────────────────────────────────────\n65: \n66: def compute_gradcam(\n67:     yolo_model: object,\n68:     img_pil: Image.Image,\n69:     target_class_idx: int,\n70: ) -> tuple[np.ndarray | None, list[list[float]]]:\n71:     \"\"\"Computes exact Grad-CAM activation heatmap from YOLOv8's penultimate feature layer.\"\"\"\n72:     try:\n73:         pytorch_model = yolo_model.model\n74:         pytorch_model.eval()\n75:         \n76:         orig_w, orig_h = img_pil.size\n77:         \n78:         img_resized = img_pil.resize((224, 224)).convert('RGB')\n79:         img_np = np.array(img_resized, dtype=np.float32) / 255.0\n80:         tensor = torch.from_numpy(img_np).permute(2, 0, 1).unsqueeze(0)\n81:         tensor.requires_grad = True\n82: \n83:         features_list = []\n84:         grads_list = []\n85: \n86:         def f_hook(module, inp, out):\n87:             features_list.append(out)\n88: \n89:         def b_hook(module, grad_in, grad_out):\n90:             grads_list.append(grad_out[0])\n91: \n92:         target_layer = pytorch_model.model[8] if hasattr(pytorch_model, 'model') and len(pytorch_model.model) > 8 else pytorch_model.model[-2]\n93:         h1 = target_layer.register_forward_hook(f_hook)\n94:         h2 = target_layer.register_full_backward_hook(b_hook)\n95: \n96:         output = pytorch_model(tensor)\n97:         if isinstance(output, tuple):\n98:             output = output[0]\n99: \n100:         pytorch_model.zero_grad()\n101:         score = output[0, target_class_idx]\n102:         score.backward()\n103: \n104:         h1.remove()\n105:         h2.remove()\n106: \n107:         if not features_list or not grads_list:\n108:             return None, []\n109: \n110:         feature = features_list[-1][0].detach()\n111:         grad = grads_list[-1][0].detach()\n112: \n113:         weights = grad.mean(dim=(1, 2), keepdim=True)\n114:         cam = (weights * feature).sum(dim=0)\n115:         cam = F.relu(cam).cpu().numpy()\n116: \n117:         cam_min, cam_max = cam.min(), cam.max()\n118:         if cam_max - cam_min > 1e-6:\n119:             cam = (cam - cam_min) / (cam_max - cam_min)\n120:         else:\n121:             cam = np.zeros_like(cam)\n122: \n123:         cam_resized = cv2.resize(cam, (orig_w, orig_h), interpolation=cv2.INTER_CUBIC)\n124:         cam_resized = np.clip(cam_resized, 0.0, 1.0)\n125: \n126:         # Extract bounding box\n127:         thresh_val = max(0.50, np.percentile(cam_resized, 85))\n128:         _, bin_mask = cv2.threshold(np.uint8(cam_resized * 255), int(thresh_val * 255), 255, cv2.THRESH_BINARY)\n129:         contours, _ = cv2.findContours(bin_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n130:         \n131:         boxes = []\n132:         min_area = (orig_w * orig_h) * 0.005\n133:         for cnt in contours:\n134:             if cv2.contourArea(cnt) < min_area:\n135:                 continue\n136:             x, y, bw, bh = cv2.boundingRect(cnt)\n137:             if bw > (orig_w * 0.9) and bh > (orig_h * 0.9):\n138:                 continue\n139:             boxes.append([float(x), float(y), float(x + bw), float(y + bh)])\n140: \n141:         return cam_resized, boxes[:2]\n142:     except Exception:\n143:         return None, []\n144: \n145: \n146: # ── Inference ─────────────────────────────────────────────────────────────────\n147: \n148: def run_inference(\n149:     image_input,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
