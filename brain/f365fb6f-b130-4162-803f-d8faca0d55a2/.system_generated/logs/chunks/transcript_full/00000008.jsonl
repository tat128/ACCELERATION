      \"Upload inspection image(s)\",\n351:         type=['jpg', 'jpeg', 'png', 'bmp', 'tiff'],\n352:         accept_multiple_files=True,\n353:         key=\"img_upload\",\n354:     )\n355: \n356:     if uploaded_files:\n357:         if not st.session_state.yolo_model:\n358:             st.error(\"YOLOv8 model not loaded. Please verify the model file in the sidebar.\")\n359:         else:\n360:             if st.button(\"Run Visual Inspection on Batch\", type=\"primary\", use_container_width=True):\n361:                 progress_bar = st.progress(0)\n362:                 for i, f in enumerate(uploaded_files):\n363:                     img = Image.open(io.BytesIO(f.read())).convert('RGB')\n364:                     result = run_inference(img, st.session_state.yolo_model, conf_threshold)\n365:                     st.session_state.registry.add(f.name, result)\n366:                     st.session_state.annotated_images[f.name] = result\n367:                     progress_bar.progress((i + 1) / len(uploaded_files))\n368: \n369:                 st.success(f\"Batch completed: {len(uploaded_files)} unit(s) evaluated.\")\n370:     \n371:     st.markdown(\"</div>\", unsafe_allow_html=True)\n372: \n373:     # ── Section: Inspection Grid & Visualizer ─────────────────────────────────\n374:     reg_df  = registry.to_dataframe()\n375:     summary = registry.summary()\n376: \n377:     if not reg_df.empty and st.session_state.annotated_images:\n378:         st.markdown(\"\"\"\n379:         <div class=\"section-box\">\n380:             <div class=\"section-title\">Inspection Results Gallery</div>\n381:             <div class=\"section-subtitle\">Unit-by-unit classification telemetry and visual evidence overlays.</div>\n382:         \"\"\", unsafe_allow_html=True)\n383: \n384:         filter_col1, filter_col2 = st.columns([1, 2])\n385:         with filter_col1:\n386:             gal_filter = st.selectbox(\n387:                 \"Filter Results\",\n388:                 [\"All Units\", \"Defects Only\", \"Passed Units\", \"Uncertain / Novel\"],\n389:                 key=\"gal_filter_sel\",\n390:             )\n391:         with filter_col2:\n392:             vis_mode = st.radio(\n393:                 \"Display Mode\",\n394:                 [\"Clean Industrial View\", \"Grad-CAM Heatmap\", \"Bounding Box\", \"Raw Image\"],\n395:                 horizontal=True,\n396:                 key=\"vis_mode_sel\",\n397:             )\n398: \n399:         items = list(st.session_state.annotated_images.items())\n400:         if gal_filter == \"Defects Only\":\n401:             items = [it for it in items if it[1]['status'] == 'DEFECT']\n402:         elif gal_filter == \"Passed Units\":\n403:             items = [it for it in items if it[1]['status'] == 'PASS']\n404:         elif gal_filter == \"Uncertain / Novel\":\n405:             items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n406: \n407:         if not items:\n408:             st.info(f\"No inspected units match the selected filter: '{gal_filter}'\")\n409:         else:\n410:             num_cols = 3\n411:             for row_idx in range(0, len(items), num_cols):\n412:                 row_items = items[row_idx:row_idx + num_cols]\n413:                 cols = st.columns(num_cols)\n414:                 for col_idx, (fname, res) in enumerate(row_items):\n415:                     with cols[col_idx]:\n416:                         stat = res['status']\n417:                         dtype = res['defect_type'].upper()\n418:                         conf = res['confidence'] * 100\n419:                         bbox = res.get('bbox')\n420:                         \n421:                         st.markdown(f\"\"\"\n422: <div class=\"unit-card\" style=\"border-top: 3px solid {'#ef4444' if stat=='DEFECT' else '#10b981' if stat=='PASS' else '#f59e0b'};\">\n423:     <div class=\"unit-card-header\">\n424:         <span style=\"font-weight:600; font-size:13px; color:#f8fafc; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:180px;\">{fname}</span>\n425:         <span class=\"badge badge-{stat}\">{stat}</span>\n426:     </div>\n427: </div>\n428: \"\"\", unsafe_allow_html=True)\n429:                         \n430:                         if vis_mode == \"Grad-CAM Heatmap\" and res.get('heatmap_image'):\n431:                             st.image(res['heatmap_image'], use_container_width=True)\n432:                         elif vis_mode == \"Bounding Box\" and res.get('boxed_image'):\n433:                             st.image(res['boxed_image'], use_container_width=True)\n434:                         elif vis_mode == \"Raw Image\" and res.get('raw_image'):\n435:                             st.image(res['raw_image'], use_container_width=True)\n436:                         elif res.get('annotated_image'):\n437:                             st.image(res['annotated_image'], use_container_width=True)\n438: \n439:                         st.markdown(f\"**Defect Class:** `{dtype}` &nbsp;|&nbsp; **Confidence:** `{conf:.1f}%`\")\n440:                         if bbox and vis_mode == \"Bounding Box\":\n441:                             x1, y1, x2, y2 = [int(v) for v in bbox]\n442:                             st.caption(f\"Coordinates: `[{x1}, {y1}, {x2}, {y2}]` ({x2-x1}x{y2-y1}px)\")\n443:                         else:\n444:                             st.caption(f\"Evaluation: **{stat}** (AI Neural Inference)\")\n445: \n446:                         if res.get('class_probs'):\n447:                             with st.expander(\"Probability Distribution\"):\n448:                                 for c_name, c_prob in sorted(res['class_probs'].items(), key=lambda x: x[1], reverse=True):\n449:                                     st.progress(min(1.0, float(c_prob)), text=f\"{c_name.capitalize()}: {c_prob*100:.1f}%\")\n450: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
{"step_index":322,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-19T15:56:16Z","thinking":"Considering a re-architecture of the application using Streamlit's container blocks to ensure visually distinct and organized sections. The goal is to provide a clean and intuitive user interface with appropriate borders, margins, and padding. Starting with the header section, the title and caption will be placed inside a container for visual containment.\n\n\nFocus is now on structuring the UI with distinct container blocks within the Streamlit application. The design will feature two main tabs: \"Quality Inspection\" and \"Production Flow Health,\" each subdivided into visually separate sections with borders. Each inspection result will be presented in its own encapsulated card. The layout aims to present the information clearly with key metrics and visualizations in an organized manner.\n\n\nThe application structure is now clearly defined with distinct container blocks for each section. This approach ensures each element is visually separate and logically grouped within the respective tabs. Further breakdown within each tab will enhance clarity with specific sub-sections for cross-model comparisons, root cause analysis, and profitability simulations.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"\"\"\"\nVisual Inspection & Defect Root-Cause Assistant\nStreamlit main application\n\"\"\"\nimport io\nimport os\nimport sys\nfrom pathlib import Path\n\nimport pandas as pd\nimport streamlit as st\nfrom PIL import Image\n\n# ── Path setup ────────────────────────────────────────────────────────────────\nROOT = Path(__file__).parent\nsys.path.insert(0, str(ROOT))\n\nfrom modules.defect_detector  import load_model, run_inference\nfrom modules.defect_registry  import DefectRegistry\nfrom modules.production_analyzer import load_csv, analyze, compare_models, estimate_wip\nfrom modules.root_cause       import correlate, drift_analysis, flag_novel\nfrom modules.profitability    import compute_financials, what_if, impact_delta\nfrom utils.chart_helpers      import (\n    defect_donut, defect_type_bar, confidence_histogram, defect_trend,\n    utilization_bar, waiting_time_bar, multi_model_radar,\n    financial_waterfall, margin_comparison_bar,\n)\nfrom utils.constants import DEFECT_CLASSES, STATUS_COLORS\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Page Config\n# ─────────────────────────────────────────────────────────────────────────────\nst.set_page_config(\n    page_title=\"Industrial AI Platform\",\n    layout=\"wide\",\n    initial_sidebar_state=\"expanded\",\n)\n\n# ── Clean Industrial UI Styling ──────────────────────────────────────────────\nst.markdown(\"\"\"\n<style>\n    /* Global Background & Font */\n    .stApp {\n        background-color: #0b0f19;\n        font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    }\n    \n    /* Headers */\n    h1, h2, h3, h4, h5, h6 {\n        color: #f8fafc !important;\n        font-weight: 700 !important;\n        letter-spacing: -0.2px;\n    }\n\n    /* Clean Card Accents */\n    .st-emotion-cache-1r6slb0, .st-emotion-cache-12w0qpk, [data-testid=\"stVerticalBlockBorderWrapper\"] {\n        background-color: #111827;\n        border-color: #1f293d !important;\n        border-radius: 10px !important;\n    }\n\n    /* Badges */\n    .badge {\n        display: inline-block;\n        padding: 3px 10px;\n        border-radius: 6px;\n        font-size: 11px;\n        font-weight: 700;\n        letter-spacing: 0.6px;\n        text-transform: uppercase;\n    }\n    .badge-DEFECT    { background: #ef4444; color: #ffffff; }\n    .badge-PASS      { background: #10b981; color: #ffffff; }\n    .badge-UNCERTAIN { background: #f59e0b; color: #ffffff; }\n    .badge-NOVEL     { background: #8b5cf6; color: #ffffff; }\n    .badge-HIGH      { background: #ef4444; color: #ffffff; }\n    .badge-MEDIUM    { background: #f59e0b; color: #ffffff; }\n    .badge-LOW       { background: #64748b; color: #ffffff; }\n\n    /* Evidence Cards */\n    .evidence-box {\n        background: #151e30;\n        border: 1px solid #23314a;\n        border-radius: 8px;\n        padding: 14px 16px;\n        margin-bottom: 12px;\n        border-left: 4px solid #3b82f6;\n    }\n    .evidence-box.HIGH   { border-left-color: #ef4444; }\n    .evidence-box.MEDIUM { border-left-color: #f59e0b; }\n    .evidence-box.LOW    { border-left-color: #64748b; }\n\n    /* Metric Cards */\n    .metric-pane {\n        background: #141c2c;\n        border: 1px solid #233048;\n        border-radius: 8px;\n        padding: 14px 16px;\n        margin-bottom: 10px;\n    }\n\n    /* Tabs Styling */\n    .stTabs [data-baseweb=\"tab-list\"] {\n        gap: 8px;\n        margin-bottom: 16px;\n    }\n    .stTabs [data-baseweb=\"tab\"] {\n        font-size: 14px;\n        font-weight: 600;\n        padding: 10px 20px;\n        background-color: #111827;\n        border: 1px solid #1f293d;\n        border-radius: 8px;\n        color: #94a3b8;\n    }\n    .stTabs [aria-selected=\"true\"] {\n        background-color: #1e293b !important;\n        color: #ffffff !important;\n        border-color: #3b82f6 !important;\n    }\n</style>\n\"\"\", unsafe_allow_html=True)\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Session State Initialisation\n# ─────────────────────────────────────────────────────────────────────────────\nif 'registry' not in st.session_state:\n    st.session_state.registry = DefectRegistry()\nif 'annotated_images' not in st.session_state:\n    st.session_state.annotated_images = {}\nif 'model_data' not in st.session_state:\n    st.session_state.model_data = {}\nif 'analyses' not in st.session_state:\n    st.session_state.analyses = {}\nif 'yolo_model' not in st.session_state:\n    st.session_state.yolo_model = None\nif 'model_load_error' not in st.session_state:\n    st.session_state.model_load_error = None\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Sidebar\n# ─────────────────────────────────────────────────────────────────────────────\nwith st.sidebar:\n    st.subheader(\"System Control\")\n    st.caption(\"AI Model, Ingestion & Economic Settings\")\n    st.divider()\n\n    # AI Model Engine\n    with st.container(border=True):\n        st.markdown(\"**AI Model Engine**\")\n        custom_pt = st.text_input(\n            \"Weights File (.pt)\",\n            placeholder=r\"D:\\acceleration\\best.pt\",\n            label_visibility=\"collapsed\",\n        )\n        if st.button(\"Load / Reload Model\", use_container_width=True):\n            with st.spinner(\"Initializing YOLOv8 engine...\"):\n                mdl, err = load_model(custom_pt or None)\n                st.session_state.yolo_model = mdl\n                st.session_state.model_load_error = err\n            if mdl:\n                st.success(\"Model ready.\")\n            else:\n                st.error(f\"Error: {err}\")\n\n        # Auto-load on initial run\n        if st.session_state.yolo_model is None and st.session_state.model_load_error is None:\n            mdl, err = load_model(custom_pt or None)\n            st.session_state.yolo_model = mdl\n            st.session_state.model_load_error = err\n\n        if st.session_state.yolo_model:\n            st.caption(\"Status: Model Active (YOLOv8-cls)\")\n        elif st.session_state.model_load_error:\n            st.caption(f\"Status: {st.session_state.model_load_error[:60]}...\")\n\n    # Inspection Boundary\n    with st.container(border=True):\n        st.markdown(\"**Decision Threshold**\")\n        conf_threshold = st.slider(\n            \"Confidence Cutoff\",\n            min_value=0.20, max_value=0.90, value=0.45, step=0.05,\n            help=\"Confidence >= Cutoff: Classified. Below Cutoff: UNCERTAIN. < 0.25: NOVEL.\",\n        )\n\n    # Production CSVs\n    with st.container(border=True):\n        st.markdown(\"**Production Datasets**\")\n\n        def _upload_csv(label, key):\n            f = st.file_uploader(label, type=['csv'], key=key)\n            if f:\n                df, err = load_csv(f)\n                if err:\n                    st.error(f\"Parse error: {err}\")\n                else:\n                    name = label.split(' ')[0]\n                    st.session_state.model_data[name] = df\n                    st.session_state.analyses[name] = analyze(df)\n                    st.success(f\"Loaded {f.name} ({len(df)} rows)\")\n\n        _upload_csv(\"Model 1 CSV\", \"csv1\")\n        _upload_csv(\"Model 2 CSV\", \"csv2\")\n        _upload_csv(\"Model 3 CSV\", \"csv3\")\n\n        # Auto-load if available in project directory\n        if not st.session_state.model_data:\n            default_paths = {\n                'Model 1': r'D:\\acceleration\\Model 1.csv',\n                'Model 2': r'D:\\acceleration\\Model 2.csv',\n                'Model 3': r'D:\\acceleration\\Model 3.csv',\n            }\n            for name, path in default_paths.items():\n                if os.path.exists(path) and name not in st.session_state.model_data:\n                    df, _ = load_csv(path)\n                    if df is not None:\n                        st.session_state.model_data[name] = df\n                        st.session_state.analyses[name] = analyze(df)\n\n        if st.session_state.model_data:\n            st.caption(f\"Active Models: {', '.join(st.session_state.model_data.keys())}\")\n\n    # Economic Cost Parameters\n    with st.container(border=True):\n        st.markdown(\"**Economic Sliders**\")\n        scrap_cost = st.slider(\n            \"Scrap Unit Cost ($)\",\n            min_value=5.0, max_value=50.0, value=15.0, step=0.5,\n            format=\"$%.2f\",\n        )\n        downtime_cost = st.slider(\n            \"Downtime Cost ($/min)\",\n            min_value=1.0, max_value=10.0, value=2.50, step=0.25,\n            format=\"$%.2f\",\n        )\n        revenue_mult = st.slider(\n            \"Revenue Multiplier\",\n            min_value=1.5, max_value=8.0, value=4.0, step=0.5,\n            help=\"Unit Selling Price = Scrap Cost x Multiplier\",\n        )\n\n    if st.button(\"Reset Inspection Session\", use_container_width=True):\n        st.session_state.registry.clear()\n        st.session_state.annotated_images.clear()\n        st.success(\"Session reset.\")\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Main Header\n# ─────────────────────────────────────────────────────────────────────────────\nwith st.container(border=True):\n    st.title(\"Visual Inspection & Defect Root-Cause Assistant\")\n    st.caption(\"Unified Quality Intelligence, Process Bottleneck Diagnostics & Economic Optimization\")\n\nsummary    = st.session_state.registry.summary()\nanalyses   = st.session_state.analyses\nregistry   = st.session_state.registry\n\n# ── Summary KPI Strip ─────────────────────────────────────────────────────────\nwith st.container(border=True):\n    k1, k2, k3, k4, k5 = st.columns(5)\n    with k1:\n        st.metric(\"Units Inspected\", summary.get('total', 0))\n    with k2:\n        st.metric(\"Defects Identified\", summary.get('defect', 0),\n                  delta=f\"{summary.get('defect_rate', 0):.1f}% defect rate\",\n                  delta_color=\"inverse\")\n    with k3:\n        st.metric(\"Review Required\", f\"{summary.get('uncertain', 0)} / {summary.get('novel', 0)}\")\n    with k4:\n        st.metric(\"Simulation Models\", len(analyses))\n    with k5:\n        st.metric(\"Inference Engine\", \"Active\" if st.session_state.yolo_model else \"Inactive\")\n\n# ─────────────────────────────────────────────────────────────────────────────\n# TABS\n# ─────────────────────────────────────────────────────────────────────────────\ntab1, tab2, tab3, tab4 = st.tabs([\n    \"Quality Inspection\",\n    \"Production Flow Health\",\n    \"Root Cause Analysis\",\n    \"Profitability & What-If Simulator\",\n])\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 1 — QUALITY INSPECTION\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab1:\n    # ── Block 1: Ingestion ────────────────────────────────────────────────────\n    with st.container(border=True):\n        st.subheader(\"Batch Inspection Ingestion\")\n        st.caption(\"Upload product surface images for automated YOLOv8 classification and neural Grad-CAM localization.\")\n\n        uploaded_files = st.file_uploader(\n            \"Select product surface images\",\n            type=['jpg', 'jpeg', 'png', 'bmp', 'tiff'],\n            accept_multiple_files=True,\n            key=\"img_upload\",\n            label_visibility=\"collapsed\",\n        )\n\n        if uploaded_files:\n            if not st.session_state.yolo_model:\n                st.error(\"YOLOv8 model not loaded. Please verify the model file in the sidebar.\")\n            else:\n                if st.button(\"Run Visual Inspection on Batch\", type=\"primary\", use_container_width=True):\n                    progress_bar = st.progress(0)\n                    for i, f in enumerate(uploaded_files):\n                        img = Image.open(io.BytesIO(f.read())).convert('RGB')\n                        result = run_inference(img, st.session_state.yolo_model, conf_threshold)\n                        st.session_state.registry.add(f.name, result)\n                        st.session_state.annotated_images[f.name] = result\n                        progress_bar.progress((i + 1) / len(uploaded_files))\n\n                    st.success(f\"Batch completed: {len(uploaded_files)} unit(s) evaluated.\")\n\n    # ── Block 2: Gallery Grid ─────────────────────────────────────────────────\n    reg_df  = registry.to_dataframe()\n    summary = registry.summary()\n\n    if not reg_df.empty and st.session_state.annotated_images:\n        with st.container(border=True):\n            st.subheader(\"Inspection Results Gallery\")\n            st.caption(\"Unit-by-unit classification telemetry and visual evidence overlays.\")\n\n            filter_col1, filter_col2 = st.columns([1, 2])\n            with filter_col1:\n                gal_filter = st.selectbox(\n                    \"Filter Results\",\n                    [\"All Units\", \"Defects Only\", \"Passed Units\", \"Uncertain / Novel\"],\n                    key=\"gal_filter_sel\",\n                )\n            with filter_col2:\n                vis_mode = st.radio(\n                    \"Display Mode\",\n                    [\"Clean Industrial View\", \"Grad-CAM Heatmap\", \"Bounding Box\", \"Raw Image\"],\n                    horizontal=True,\n                    key=\"vis_mode_sel\",\n                )\n\n            items = list(st.session_state.annotated_images.items())\n            if gal_filter == \"Defects Only\":\n                items = [it for it in items if it[1]['status'] == 'DEFECT']\n            elif gal_filter == \"Passed Units\":\n                items = [it for it in items if it[1]['status'] == 'PASS']\n            elif gal_filter == \"Uncertain / Novel\":\n                items = [it for it in items if it[1]['status'] in ('UNCERTAIN', 'NOVEL')]\n\n            if not items:\n                st.info(f\"No inspected units match the selected filter: '{gal_filter}'\")\n            else:\n                num_cols = 3\n                for row_idx in range(0, len(items), num_cols):\n                    row_items = items[row_idx:row_idx + num_cols]\n                    cols = st.columns(num_cols)\n                    for col_idx, (fname, res) in enumerate(row_items):\n                        with cols[col_idx]:\n                            with st.container(border=True):\n                                stat = res['status']\n                                dtype = res['defect_type'].upper()\n                                conf = res['confidence'] * 100\n                                bbox = res.get('bbox')\n\n                                top_l, top_r = st.columns([2, 1])\n                                with top_l:\n                                    st.markdown(f\"**{fname}**\")\n                                with top_r:\n                                    st.markdown(f\"<div style='text-align:right;'><span class='badge badge-{stat}'>{stat}</span></div>\", unsafe_allow_html=True)\n\n                                if vis_mode == \"Grad-CAM Heatmap\" and res.get('heatmap_image'):\n                                    st.image(res['heatmap_image'], use_container_width=True)\n                                elif vis_mode == \"Bounding Box\" and res.get('boxed_image'):\n                                    st.image(res['boxed_image'], use_container_width=True)\n                                elif vis_mode == \"Raw Image\" and res.get('raw_image'):\n                                    st.image(res['raw_image'], use_container_width=True)\n                                elif res.get('annotated_image'):\n                                    st.image(res['annotated_image'], use_container_width=True)\n\n                                st.markdown(f\"**Class:** `{dtype}` &nbsp;|&nbsp; **Confidence:** `{conf:.1f}%`\")\n                                if bbox and vis_mode == \"Bounding Box\":\n                                    x1, y1, x2, y2 = [int(v) for v in bbox]\n                                    st.caption(f\"Target Box: `[{x1}, {y1}, {x2}, {y2}]` ({x2-x1}x{y2-y1}px)\")\n                                else:\n                                    st.caption(f\"Evaluation: **{stat}** (AI Neural Inference)\")\n\n                                if res.get('class_probs'):\n                                    with st.expander(\"Probability Distribution\"):\n                                        for c_name, c_prob in sorted(res['class_probs'].items(), key=lambda x: x[1], reverse=True):\n                                            st.progress(min(1.0, float(c_prob)), text=f\"{c_name.capitalize()}: {c_prob*100:.1f}%\")\n\n        # ── Block 3: Analytics & Log Table ────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Batch Analytics & Telemetry Log\")\n            r1, r2 = st.columns([1, 2])\n            with r1:\n                st.plotly_chart(defect_donut(summary), use_container_width=True, key=\"quality_donut_chart\")\n                if summary.get('by_type'):\n                    st.plotly_chart(defect_type_bar(summary['by_type']), use_container_width=True, key=\"quality_type_bar_chart\")\n\n            with r2:\n                st.markdown(\"##### Detailed Log Table\")\n                styled = reg_df.copy()\n                styled['Status'] = styled['status']\n                st.dataframe(\n                    styled[['unit_id', 'image_name', 'defect_type', 'confidence', 'Status', 'timestamp']],\n                    use_container_width=True, height=270,\n                )\n                if len(reg_df) >= 3:\n                    drift_df = registry.drift_dataframe()\n                    st.plotly_chart(defect_trend(drift_df), use_container_width=True, key=\"quality_defect_trend_chart\")\n\n            if len(reg_df[reg_df['status'] != 'PASS']) > 0:\n                st.plotly_chart(confidence_histogram(reg_df), use_container_width=True, key=\"quality_conf_hist_chart\")\n\n            flagged = flag_novel(reg_df)\n            if not flagged.empty:\n                st.warning(f\"**{len(flagged)} unit(s) flagged for quality review** (UNCERTAIN or NOVEL detections)\")\n                st.dataframe(flagged, use_container_width=True)\n    else:\n        st.info(\"Upload images above and click 'Run Visual Inspection on Batch' to begin analysis.\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 2 — PRODUCTION FLOW\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab2:\n    if not analyses:\n        st.info(\"Load Model 1/2/3 CSV datasets in the sidebar to activate production flow analysis.\")\n    else:\n        # ── Block 1: Production Overview ──────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Production Line Performance & Theory of Constraints\")\n            st.caption(\"Multi-stage capacity utilization, queue times, and Little's Law WIP analysis from Rockwell Arena simulations.\")\n\n            model_names = list(analyses.keys())\n            sel_model   = st.selectbox(\"Select Production Model\", model_names, index=0)\n            analysis    = analyses.get(sel_model)\n\n            if analysis is None:\n                st.error(f\"Unable to parse telemetry for {sel_model}.\")\n            else:\n                m1, m2, m3, m4 = st.columns(4)\n                m1.metric(\"Production Demand\", f\"{analysis['demand']:.0f} units\")\n                m2.metric(\"Parts Produced\",    f\"{analysis['total_parts']:.0f} units\")\n                m3.metric(\"Throughput Rate\",   f\"{analysis['throughput_efficiency']:.1f}%\",\n                          delta=f\"{analysis['throughput_gap']:.0f} units shortage\",\n                          delta_color=\"inverse\")\n                m4.metric(\"Line Speed\",        f\"{analysis['parts_per_hour']:.1f} parts/hr\")\n\n        if analysis is not None:\n            # ── Block 2: Bottleneck Spotlight ─────────────────────────────────\n            with st.container(border=True):\n                st.subheader(\"System Bottleneck Diagnosis\")\n                bn = analysis['bottleneck_station']\n                bu = analysis['bottleneck_util'] * 100\n                bw = analysis['bottleneck_wait']\n\n                if bu > 85:\n                    level = \"CRITICAL\"\n                elif bu > 70:\n                    level = \"WARNING\"\n                else:\n                    level = \"OPTIMAL\"\n\n                st.markdown(f\"\"\"\n<div class=\"evidence-box {'HIGH' if level == 'CRITICAL' else 'MEDIUM' if level == 'WARNING' else 'LOW'}\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n    <b>Primary Constraint Station: {bn}</b>\n    <span class=\"badge badge-{level}\">{level}</span>\n  </div>\n  <div style=\"margin-top:8px;\">\n    <b>Capacity Utilisation:</b> {bu:.1f}% &nbsp;|&nbsp;\n    <b>Average Queue Delay:</b> {bw:.1f} min &nbsp;|&nbsp;\n    <b>Throughput Deficit:</b> {analysis['throughput_gap']:.0f} units\n  </div>\n  <small style=\"color:#94a3b8\">Elevating capacity at this constraint station yields the highest ROI on overall line output.</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            # ── Block 3: Station Telemetry Charts ─────────────────────────────\n            with st.container(border=True):\n                st.subheader(\"Station Capacity & Queue Latency\")\n                ch1, ch2 = st.columns(2)\n                with ch1:\n                    st.plotly_chart(utilization_bar(analysis['stations'], sel_model),\n                                    use_container_width=True, key=f\"flow_util_{sel_model}\")\n                with ch2:\n                    st.plotly_chart(waiting_time_bar(analysis['stations'], sel_model),\n                                    use_container_width=True, key=f\"flow_wait_{sel_model}\")\n\n            # ── Block 4: WIP Estimate ─────────────────────────────────────────\n            wip = estimate_wip(analysis)\n            if any(v > 0 for v in wip.values()):\n                with st.container(border=True):\n                    st.subheader(\"Estimated Work-in-Process (Little's Law)\")\n                    wip_cols = st.columns(len(wip))\n                    for col, (station, count) in zip(wip_cols, wip.items()):\n                        col.metric(f\"{station} WIP Buffer\", f\"~{count:.0f} units\")\n\n            # ── Block 5: Multi-Model Benchmark ────────────────────────────────\n            if len(analyses) > 1:\n                with st.container(border=True):\n                    st.subheader(\"Cross-Model Scenario Benchmark\")\n                    comp_df = compare_models(analyses)\n                    st.dataframe(comp_df, use_container_width=True)\n\n                    if len(analyses) >= 2:\n                        st.plotly_chart(multi_model_radar(analyses), use_container_width=True, key=\"flow_radar_chart\")\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 3 — ROOT CAUSE ANALYSIS\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab3:\n    no_quality = registry.to_dataframe().empty\n    no_process = not analyses\n\n    if no_quality and no_process:\n        st.info(\"Upload inspection images and production datasets to generate causal links.\")\n    else:\n        # ── Block 1: Causal Correlation ───────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Root-Cause Causal Correlation Engine\")\n            st.caption(\"Evidence-based correlation linking process line overloads with physical defect manifestations.\")\n\n            rc_model = st.selectbox(\n                \"Select Baseline Production Model\",\n                list(analyses.keys()) if analyses else ['No model loaded'],\n                key='rc_model_sel',\n            )\n            rc_analysis  = analyses.get(rc_model) if analyses else None\n            rc_defect_sum = registry.summary()\n\n            evidence = correlate(rc_analysis, rc_defect_sum if not no_quality else None)\n\n            if not evidence:\n                st.success(\"No critical process-quality correlations detected under current operating conditions.\")\n            else:\n                st.markdown(f\"**{len(evidence)} Causal Correlation Rule(s) Triggered**\")\n                for card in evidence:\n                    conf  = card['confidence']\n                    obs   = card['defect_observed']\n                    cls   = conf\n                    html = f\"\"\"\n<div class=\"evidence-box {cls}\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;\">\n    <b>PROBABLE CAUSE: {card['cause']}</b>\n    <span class=\"badge badge-{conf}\">{conf} CONFIDENCE</span>\n  </div>\n  <small><b>Telemetry Evidence:</b> {card['evidence']}</small><br>\n  <small><b>Associated Defect Signatures:</b> {', '.join(card['related_defects']) if card['related_defects'] else 'General throughput bottleneck'}\n  {'&nbsp; <span class=\"badge badge-DEFECT\">OBSERVED IN BATCH</span>' if obs else ''}</small><br>\n  <hr style=\"margin:8px 0; border-color:#24324c\">\n  <small><b>Recommended Corrective Action:</b> {card['action']}</small>\n</div>\n\"\"\"\n                    st.markdown(html, unsafe_allow_html=True)\n\n        # ── Block 2: Drift Monitoring ─────────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Batch-to-Batch Defect Drift\")\n            if no_quality or len(registry) < 2:\n                st.info(\"Inspect at least 2 units in Tab 1 to track process drift.\")\n            else:\n                drift_df_raw = registry.drift_dataframe()\n                drift        = drift_analysis(drift_df_raw)\n\n                if drift:\n                    dc1, dc2, dc3 = st.columns(3)\n                    dc1.metric(\"Drift Trajectory\", drift['trend'])\n                    dc2.metric(\"Drift Rate\", f\"{drift['slope']:+.2f} pp/unit\")\n                    dc3.metric(\"Flagged Review Units\", drift['novel_count'] + drift['uncertain_count'])\n\n                    st.plotly_chart(defect_trend(drift['df']), use_container_width=True, key=\"rootcause_defect_trend_chart\")\n\n        # ── Block 3: Out-of-Distribution Registry ─────────────────────────────\n        if not no_quality:\n            flagged = flag_novel(registry.to_dataframe())\n            if not flagged.empty:\n                with st.container(border=True):\n                    st.subheader(\"Out-of-Distribution & Human Review Registry\")\n                    st.warning(f\"**{len(flagged)} Novel / Uncertain Unit(s)** — Flagged for manual engineering review.\")\n                    st.dataframe(flagged, use_container_width=True)\n\n# ═════════════════════════════════════════════════════════════════════════════\n# TAB 4 — PROFITABILITY & RECOMMENDATIONS\n# ═════════════════════════════════════════════════════════════════════════════\nwith tab4:\n    if not analyses:\n        st.info(\"Upload production CSV datasets in the sidebar to activate the financial engine.\")\n    else:\n        # ── Block 1: Baseline Economics ───────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Baseline Economic Impact & Loss Waterfall\")\n            st.caption(\"Financial translation of scrap losses, bottleneck idle time, and opportunity costs.\")\n\n            fin_model = st.selectbox(\n                \"Select Financial Model Target\",\n                list(analyses.keys()),\n                key='fin_model_sel',\n            )\n            fin_analysis  = analyses.get(fin_model)\n            fin_defect_sum = registry.summary() if not registry.to_dataframe().empty else None\n\n            if fin_analysis is None:\n                st.error(\"Unable to load financial model data.\")\n            else:\n                baseline = compute_financials(\n                    fin_analysis, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult\n                )\n\n                fb1, fb2, fb3, fb4, fb5 = st.columns(5)\n                fb1.metric(\"Gross Revenue\",    f\"${baseline['gross_revenue']:,.0f}\")\n                fb2.metric(\"Scrap Loss\",       f\"${baseline['scrap_loss']:,.0f}\", delta_color=\"inverse\")\n                fb3.metric(\"Idle Cost\",        f\"${baseline['bottleneck_idle_loss']:,.0f}\", delta_color=\"inverse\")\n                fb4.metric(\"Opportunity Loss\", f\"${baseline['opportunity_loss']:,.0f}\", delta_color=\"inverse\")\n                fb5.metric(\"Operating Margin\",\n                           f\"${baseline['net_margin']:,.0f}\",\n                           delta=f\"{baseline['margin_pct']:.1f}%\",\n                           delta_color=\"normal\" if baseline['net_margin'] > 0 else \"inverse\")\n\n                wf1, wf2 = st.columns([3, 2])\n                with wf1:\n                    st.plotly_chart(financial_waterfall(baseline, fin_model), use_container_width=True, key=f\"fin_waterfall_{fin_model}\")\n\n                with wf2:\n                    st.markdown(\"##### Direct Loss Breakdown\")\n                    loss_items = {\n                        \"Scrap Material Losses\": baseline['scrap_loss'],\n                        \"Bottleneck Idle Overhead\": baseline['bottleneck_idle_loss'],\n                        \"Market Opportunity Deficit\": baseline['opportunity_loss'],\n                        \"Estimated Rework Cost\": baseline['rework_cost'],\n                    }\n                    for label, val in loss_items.items():\n                        pct = val / baseline['total_loss'] * 100 if baseline['total_loss'] else 0\n                        st.markdown(f\"\"\"\n<div class=\"metric-pane\">\n  <b>{label}</b><br>\n  <span style=\"font-size:18px; font-weight:700; color:#ef4444\">${val:,.2f}</span>\n  <span style=\"color:#94a3b8\"> ({pct:.0f}% of total)</span>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n        # ── Block 2: What-If Simulator ────────────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"What-If Scenario Simulation Engine\")\n            st.caption(\"Model projected margin lift from targeted scrap reduction and bottleneck idle mitigation.\")\n\n            col_s1, col_s2 = st.columns(2)\n            with col_s1:\n                util_impr = st.slider(\n                    \"Bottleneck Idle Time Reduction (%)\",\n                    0, 50, 15, step=5,\n                    help=\"Simulates capacity elevation at the bottleneck station.\",\n                )\n            with col_s2:\n                scrap_redn = st.slider(\n                    \"Defect / Scrap Rate Reduction (%)\",\n                    0, 80, 20, step=5,\n                    help=\"Simulates visual inspection quality improvements.\",\n                )\n\n            wi_result = what_if(\n                fin_analysis, fin_defect_sum,\n                scrap_cost, downtime_cost,\n                util_impr, scrap_redn, revenue_mult,\n            )\n            delta = impact_delta(baseline, wi_result)\n\n            w1, w2, w3 = st.columns(3)\n            w1.metric(\"Projected Net Margin\",\n                      f\"${wi_result['net_margin']:,.0f}\",\n                      delta=f\"+${delta['delta_margin']:,.0f} gain\",\n                      delta_color=\"normal\")\n            w2.metric(\"Total Losses Recovered\",\n                      f\"${delta['delta_loss_saved']:,.0f}\",\n                      delta=f\"{delta['margin_improvement_pct']:+.1f}% margin lift\")\n            w3.metric(\"Scrap Reduction\",\n                      f\"{wi_result['scrap_units']:.0f} units\",\n                      delta=f\"{baseline['scrap_units'] - wi_result['scrap_units']:.0f} units saved\",\n                      delta_color=\"inverse\")\n\n        # ── Block 3: Multi-Model Benchmark ────────────────────────────────────\n        if len(analyses) > 1:\n            with st.container(border=True):\n                st.subheader(\"Multi-Model Scenario Profitability\")\n                all_results = {}\n                for name, an in analyses.items():\n                    if an is None:\n                        continue\n                    b = compute_financials(an, fin_defect_sum, scrap_cost, downtime_cost, revenue_mult)\n                    wi = what_if(an, fin_defect_sum, scrap_cost, downtime_cost,\n                                 util_impr, scrap_redn, revenue_mult)\n                    all_results[name] = {'baseline': b, 'whatif': wi}\n\n                st.plotly_chart(margin_comparison_bar(all_results), use_container_width=True, key=\"fin_margin_comp_chart\")\n\n        # ── Block 4: Recommendations & Export ─────────────────────────────────\n        with st.container(border=True):\n            st.subheader(\"Actionable Engineering Recommendations\")\n            recs = []\n            evidence = correlate(fin_analysis, fin_defect_sum)\n            for card in evidence[:3]:\n                recs.append({\n                    'priority': card['confidence'],\n                    'title':    card['cause'],\n                    'action':   card['action'],\n                    'impact':   \"Direct scrap reduction and buffer stabilization\",\n                })\n\n            if fin_analysis.get('throughput_gap', 0) > 10:\n                recs.insert(0, {\n                    'priority': 'HIGH',\n                    'title':    f\"Elevate {fin_analysis['bottleneck_station']} station capacity\",\n                    'action':   (\n                        f\"{fin_analysis['bottleneck_station']} is operating at \"\n                        f\"{fin_analysis['bottleneck_util']*100:.0f}% capacity utilisation — the primary constraint. \"\n                        \"Add parallel station tooling or schedule shift balancing. \"\n                        f\"Closing the {fin_analysis['throughput_gap']:.0f}-unit gap could recover \"\n                        f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} in unrealized revenue.\"\n                    ),\n                    'impact': f\"~${fin_analysis['throughput_gap'] * scrap_cost * revenue_mult:,.0f} revenue recovery\",\n                })\n\n            priority_labels = {'HIGH': '[HIGH PRIORITY]', 'MEDIUM': '[MEDIUM PRIORITY]', 'LOW': '[LOW PRIORITY]'}\n            for i, rec in enumerate(recs[:4], 1):\n                p = rec['priority']\n                st.markdown(f\"\"\"\n<div class=\"evidence-box {p}\">\n  <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;\">\n    <b>{priority_labels.get(p,'')}&nbsp; #{i} — {rec['title']}</b>\n    <span class=\"badge badge-{p}\">{p}</span>\n  </div>\n  <small>{rec['action']}</small><br>\n  <small style=\"color:#10b981\"><b>Projected Impact:</b> {rec.get('impact','—')}</small>\n</div>\n\"\"\", unsafe_allow_html=True)\n\n            st.divider()\n\n            report_lines = [\n                \"# Industrial Decision-Support & Quality Intelligence Report\",\n                f\"\\n## Quality Summary\",\n                f\"- Total Units Evaluated: {summary.get('total',0)}\",\n                f\"- Defective Units: {summary.get('defect',0)} ({summary.get('defect_rate',0):.1f}%)\",\n                f\"- Uncertain Classifications: {summary.get('uncertain',0)} | Novel Signatures: {summary.get('novel',0)}\",\n                f\"\\n## Production Flow ({fin_model})\",\n                f\"- Demand Target: {fin_analysis['demand']} | Total Output: {fin_analysis['total_parts']}\",\n                f\"- Throughput Efficiency: {fin_analysis['throughput_efficiency']:.1f}%\",\n                f\"- Bottleneck Station: {fin_analysis['bottleneck_station']} @ {fin_analysis['bottleneck_util']*100:.1f}% utilisation\",\n                f\"\\n## Financial Baseline Snapshot\",\n                f\"- Gross Revenue: ${baseline['gross_revenue']:,.2f}\",\n                f\"- Total Incurred Losses: ${baseline['total_loss']:,.2f}\",\n                f\"- Net Operating Margin: ${baseline['net_margin']:,.2f} ({baseline['margin_pct']:.1f}%)\",\n                f\"\\n## What-If Optimization ({util_impr}% idle reduction, {scrap_redn}% scrap reduction)\",\n                f\"- Projected Operating Margin: ${wi_result['net_margin']:,.2f}\",\n                f\"- Economic Improvement: +${delta['delta_margin']:,.2f} (+{delta['margin_improvement_pct']:.1f}%)\",\n                f\"\\n## Actionable Recommendations\",\n            ]\n            for i, rec in enumerate(recs[:4], 1):\n                report_lines.append(f\"{i}. [{rec['priority']}] {rec['title']}: {rec['action']}\")\n\n            report_text = \"\\n\".join(report_lines)\n            st.download_button(\n                \"Export Comprehensive Executive Report (.md)\",\n                data=report_text,\n                file_name=\"industrial_intelligence_report.md\",\n                mime=\"text/markdown\",\n                use_container_width=True,\n                type=\"primary\",\n            )\n\n# ─────────────────────────────────────────────────────────────────────────────\n# Minimal Clean Footer\n# ─────────────────────────────────────────────────────────────────────────────\nst.caption(\"<center style='color:#64748b; margin-top:20px;'>Industrial Quality Intelligence & Decision-Support System</center>\", unsafe_allow_html=True)\n","Description":"Ultra-clean layout using native st.container(border=True) cards, neat block separations, clean typography, and zero neurax title references","Overwrite":true,"TargetFile":"C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\app.py","toolAction":"Refactoring app layout with clean border containers","toolSummary":"Redesign app.py with clean border containers"}}]}
