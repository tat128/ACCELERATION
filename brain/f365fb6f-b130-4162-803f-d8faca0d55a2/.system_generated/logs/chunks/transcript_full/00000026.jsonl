ot by_type:\n86:         return go.Figure()\n87:     df = pd.DataFrame(list(by_type.items()), columns=['Defect', 'Count'])\n88:     color_map = {\n89:         'crack':   _CYBER['red'],\n90:         'hole':    _CYBER['purple'],\n91:         'rust':    _CYBER['orange'],\n92:         'scratch': _CYBER['yellow'],\n93:     }\n94:     colors = [color_map.get(d.lower(), _CYBER['gray']) for d in df['Defect']]\n95:     fig = go.Figure(go.Bar(\n96:         x=df['Defect'], y=df['Count'],\n97:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n98:         text=df['Count'], textposition='outside',\n99:         textfont=dict(color='#ffffff', size=11),\n100:     ))\n101:     fig.update_layout(\n102:         **_base_layout(\n103:             title=dict(text='Defect Class Signature Count', font=dict(size=14, color='#f8fafc')),\n104:             xaxis=dict(title='Defect Signature'),\n105:             yaxis=dict(title='Detected Units'),\n106:             height=280,\n107:         )\n108:     )\n109:     return fig\n110: \n111: \n112: def confidence_histogram(df: pd.DataFrame) -> go.Figure:\n113:     if df.empty:\n114:         return go.Figure()\n115:     fig = px.histogram(\n116:         df[df['status'] != 'PASS'], x='confidence', nbins=20,\n117:         color='status',\n118:         color_discrete_map={'DEFECT': _CYBER['red'], 'UNCERTAIN': _CYBER['orange'], 'NOVEL': _CYBER['purple']},\n119:         title='Neural Confidence Distribution (Flagged Units)',\n120:     )\n121:     fig.update_layout(**_base_layout(height=260))\n122:     return fig\n123: \n124: \n125: def defect_trend(registry_df: pd.DataFrame) -> go.Figure:\n126:     if registry_df.empty:\n127:         return go.Figure()\n128:     fig = go.Figure()\n129:     fig.add_trace(go.Scatter(\n130:         x=registry_df['unit_id'], y=registry_df['rolling_defect_rate'],\n131:         mode='lines+markers', name='Defect Rate',\n132:         line=dict(color=_CYBER['cyan'], width=2.5),\n133:         marker=dict(size=6, color=_CYBER['cyan'], line=dict(color='#ffffff', width=1)),\n134:         fill='tozeroy', fillcolor='rgba(0, 240, 255, 0.12)',\n135:     ))\n136:     fig.add_hline(y=10, line_dash='dash', line_color=_CYBER['orange'],\n137:                   annotation_text='10% Threshold', annotation_position='bottom right',\n138:                   annotation_font=dict(color=_CYBER['orange'], size=10))\n139:     fig.update_layout(\n140:         **_base_layout(\n141:             title=dict(text='Process Drift Telemetry (Rolling 3-Unit Window)', font=dict(size=14, color='#f8fafc')),\n142:             xaxis=dict(title='Inspection Unit #'),\n143:             yaxis=dict(title='Defect Rate (%)'),\n144:             height=280,\n145:         )\n146:     )\n147:     return fig\n148: \n149: \n150: # ── Production Flow Charts ────────────────────────────────────────────────────\n151: \n152: def utilization_bar(station_metrics: dict, model_name: str) -> go.Figure:\n153:     stations = list(station_metrics.keys())\n154:     utils = [v['utilization'] * 100 for v in station_metrics.values()]\n155:     colors = [\n156:         _CYBER['red'] if u > 85 else _CYBER['orange'] if u > 70 else _CYBER['green']\n157:         for u in utils\n158:     ]\n159:     fig = go.Figure(go.Bar(\n160:         x=stations, y=utils,\n161:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n162:         text=[f'{u:.1f}%' for u in utils], textposition='outside',\n163:         textfont=dict(color='#ffffff', size=11),\n164:         hovertemplate='<b>%{x}</b><br>Utilisation: %{y:.1f}%<extra></extra>',\n165:     ))\n166:     fig.add_hline(y=85, line_dash='dash', line_color=_CYBER['red'],\n167:                   annotation_text='Bottleneck Cutoff (85%)',\n168:                   annotation_font=dict(color=_CYBER['red'], size=10))\n169:     fig.add_hline(y=70, line_dash='dot', line_color=_CYBER['orange'],\n170:                   annotation_text='Warning Threshold (70%)',\n171:                   annotation_font=dict(color=_CYBER['orange'], size=10))\n172:     fig.update_layout(\n173:         **_base_layout(\n174:             title=dict(text=f'{model_name} — Station Capacity Utilisation', font=dict(size=14, color='#f8fafc')),\n175:             xaxis=dict(title='Production Station'),\n176:             yaxis=dict(title='Utilisation (%)', range=[0, 115], gridcolor='rgba(0, 240, 255, 0.07)'),\n177:             height=320,\n178:         )\n179:     )\n180:     return fig\n181: \n182: \n183: def waiting_time_bar(station_metrics: dict, model_name: str) -> go.Figure:\n184:     stations = list(station_metrics.keys())\n185:     waits = [v['waiting_time'] for v in station_metrics.values()]\n186:     max_wait = max(waits) if waits else 0\n187:     colors = [_CYBER['red'] if w == max_wait else _CYBER['cyan'] for w in waits]\n188: \n189:     fig = go.Figure(go.Bar(\n190:         x=stations, y=waits,\n191:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n192:         text=[f'{w:.1f}m' for w in waits], textposition='outside',\n193:         textfont=dict(color='#ffffff', size=11),\n194:         hovertemplate='<b>%{x}</b><br>Queue Delay: %{y:.1f} min<extra></extra>',\n195:     ))\n196:     fig.update_layout(\n197:         **_base_layout(\n198:             title=dict(text=f'{model_name} — Queue & Wait Latency', font=dict(size=14, color='#f8fafc')),\n199:             xaxis=dict(title='Production Station'),\n200:             yaxis=dict(title='Queue Delay (minutes)'),\n201:             height=300,\n202:         )\n203:     )\n204:     return fig\n205: \n206: \n207: def multi_model_radar(model_analyses: dict) -> go.Figure:\n208:     \"\"\"Radar chart comparing models across key KPIs.\"\"\"\n209:     categories = ['Throughput %', 'Drill Idle', 'Mill Idle', 'Assembly Idle', 'Overall Line Output']\n210:     fig = go.Figure()\n211:     palette_list = [_CYBER['cyan'], _CYBER['green'], _CYBER['purple'], _CYBER['orange']]\n212: \n213:     for i, (model_name, analysis) in enumerate(model_analyses.items()):\n214:         if analysis is None:\n215:             continue\n216:         stations = analysis.get('stations', {})\n217:         values = [\n218:             min(analysis.get('throughput_efficiency', 0), 100),\n219:             100 - stations.get('Drilling', {}).get('utilization', 0) * 100,\n220:             100 - stations.get('Milling', {}).get('utilization', 0) * 100,\n221:             100 - stations.get('Assembly', {}).get('utilization', 0) * 100,\n222:             min(analysis.get('throughput_efficiency', 0), 100),\n223:         ]\n224:         col = palette_list[i % len(palette_list)]\n225:         fig.add_trace(go.Scatterpolar(\n226:             r=values + [values[0]],\n227:             theta=categories + [categories[0]],\n228:             fill='toself', name=model_name,\n229:             line=dict(color=col, width=2),\n230:             opacity=0.45,\n231:         ))\n232: \n233:     fig.update_layout(\n234:         polar=dict(\n235:             radialaxis=dict(visible=True, range=[0, 110], gridcolor='rgba(0, 240, 255, 0.1)'),\n236:             angularaxis=dict(gridcolor='rgba(0, 240, 255, 0.1)', tickfont=dict(color='#94a3b8', size=10)),\n237:             bgcolor='rgba(13, 19, 36, 0.5)',\n238:         ),\n239:         title=dict(text='Multi-Scenario Tactical Radar Benchmark', font=dict(size=14, color='#f8fafc')),\n240:         paper_bgcolor=_BG,\n241:         plot_bgcolor=_BG,\n242:         font=dict(color='#e2e8f0'),\n243:         height=380,\n244:     )\n245:     return fig\n246: \n247: \n248: # ── Financial Charts ──────────────────────────────────────────────────────────\n249: \n250: def financial_waterfall(financials: dict, model_name: str) -> go.Figure:\n251:     labels  = ['Gross Revenue', 'Scrap Loss', 'Idle Loss', 'Opp. Loss', 'Net Margin']\n252:     measure = ['absolute', 'relative', 'relative', 'relative', 'total']\n253:     values  = [\n254:         financials.get('gross_revenue', 0),\n255:         -financials.get('scrap_loss', 0),\n256:         -financials.get('bottleneck_idle_loss', 0),\n257:         -financials.get('opportunity_loss', 0),\n258:         financials.get('net_margin', 0),\n259:     ]\n260: \n261:     fig = go.Figure(go.Waterfall(\n262:         name='', orientation='v',\n263:         measure=measure, x=labels, y=values,\n264:         connector=dict(line=dict(color='rgba(56, 189, 248, 0.7)', width=2)),\n265:         decreasing=dict(marker=dict(color='#f43f5e', line=dict(color='#fda4af', width=1.5))),\n266:         increasing=dict(marker=dict(color='#10b981', line=dict(color='#6ee7b7', width=1.5))),\n267:         totals=dict(marker=dict(color='#38bdf8', line=dict(color='#bae6fd', width=1.5))),\n268:         text=[f'${abs(v):,.0f}' for v in values],\n269:         textposition='outside',\n270:         textfont=dict(color='#f8fafc', size=12, family='JetBrains Mono, monospace'),\n271:     ))\n272:     fig.update_layout(\n273:         **_base_layout(\n274:             title=dict(text=f'{model_name} — Economic Waterfall Telemetry (USD)', font=dict(size=14, color='#f8fafc')),\n275:             yaxis=dict(title='Financial Impact ($)'),\n276:             height=360,\n277:         )\n278:     )\n279:     return fig\n280: \n281: \n282: def margin_comparison_bar(arg1, arg2=None, model_name: str = \"Active Model\") -> go.Figure:\n283:     \"\"\"\n284:     Renders a high-contrast side-by-side comparison between Baseline and What-If.\n285:     Supports both:\n286:       margin_comparison_bar(baseline_margin, whatif_margin, model_name)\n287:       margin_comparison_bar({'Model 1': {'baseline': ..., 'whatif': ...}})\n288:     \"\"\"\n289:     if isinstance(arg1, dict):\n290:         if not arg1:\n291:             return go.Figure()\n292:         first_key = list(arg1.keys())[0]\n293:         if isinstance(arg1[first_key], dict) and 'baseline' in arg1[first_key]:\n294:             baseline_val = float(arg1[first_key]['baseline'].get('net_margin', 0))\n295:             whatif_val = float(arg1[first_key]['whatif'].get('net_margin', 0))\n296:             model_name = str(first_key)\n297:         else:\n298:             baseline_val = float(arg1.get('baseline', 0))\n299:             whatif_val = float(arg1.get('whatif', 0))\n300:     else:\n301:         baseline_val = float(arg1)\n302:         whatif_val = float(arg2) if arg2 is not None else float(arg1)\n303: \n304:     scenarios = ['Baseline Scenario', 'What-If Optimized']\n305:     margins = [baseline_val, whatif_val]\n306:     colors = ['#6366f1', '#10b981']\n307: \n308:     fig = go.Figure([\n309:         go.Bar(\n310:             x=scenarios,\n311:             y=margins,\n312:             marker=dict(color=colors, line=dict(color=['#a5b4fc', '#6ee7b7'], width=1.5)),\n313:             text=[f'${v:,.0f}' for v in margins],\n314:             textposition='outside',\n315:             textfont=dict(color='#f8fafc', size=13, family='JetBrains Mono, monospace'),\n316:             width=[0.45, 0.45],\n317:         )\n318:     ])\n319:     fig.update_layout(\n320:         **_base_layout(\n321:             title=dict(text=f'Margin Delta: Baseline vs What-If ({model_name})', font=dict(size=13, color='#f8fafc')),\n322:             yaxis=dict(title='Operating Margin ($)'),\n323:             height=260,\n324:         )\n325:     )\n326:     return fig\n327: \n328: \n329: # ── ANN Surrogate & Digital Twin Charts ───────────────────────────────────────\n330: \n331: def ann_prediction_gauge(val: float, title: str, threshold: float = 0.85) -> go.Figure:\n332:     \"\"\"Renders a high-contrast gauge for ANN predicted station load with visible threshold.\"\"\"\n333:     pct = val * 100.0 if val <= 1.0 else val\n334:     thresh_pct = threshold * 100.0 if threshold <= 1.0 else threshold\n335:     bar_color = '#f43f5e' if pct >= thresh_pct else ('#f59e0b' if pct >= thresh_pct * 0.85 else '#38bdf8')\n336: \n337:     fig = go.Figure(go.Indicator(\n338:         mode=\"gauge+number+delta\",\n339:         value=pct,\n340:         number=dict(suffix=\"%\", font=dict(color='#f8fafc', size=26, family='JetBrains Mono, monospace')),\n341:         delta=dict(reference=thresh_pct, increasing=dict(color='#f43f5e'), decreasing=dict(color='#10b981')),\n342:         title=dict(text=f\"<b>{title}</b>\", font=dict(color='#f8fafc', size=13, family='Plus Jakarta Sans, sans-serif')),\n343:         gauge=dict(\n344:             axis=dict(range=[0, 100], tickwidth=1.5, tickcolor=\"#94a3b8\", tickfont=dict(color=\"#cbd5e1\", size=10)),\n345:             bar=dict(color=bar_color, thickness=0.45),\n346:             bgcolor=\"rgba(30, 41, 59, 0.7)\",\n347:             borderwidth=1.5,\n348:             bordercolor=\"rgba(148, 163, 184, 0.3)\",\n349:             steps=[\n350:                 dict(range=[0, thresh_pct * 0.75], color=\"rgba(16, 185, 129, 0.25)\"),\n351:                 dict(range=[thresh_pct * 0.75, thresh_pct], color=\"rgba(245, 158, 11, 0.25)\"),\n352:                 dict(range=[thresh_pct, 100], color=\"rgba(244, 63, 94, 0.35)\"),\n353:             ],\n354:             threshold=dict(\n355:                 line=dict(color='#f43f5e', width=4),\n356:                 thickness=0.85,\n357:                 value=thresh_pct\n358:             )\n359:         )\n360:     ))\n361:     fig.update_layout(\n362:         paper_bgcolor=_BG,\n363:         plot_bgcolor=_BG,\n364:         font=dict(color='#e2e8f0', family='Plus Jakarta Sans, sans-serif'),\n365:         margin=dict(t=35, b=10, l=20, r=20),\n366:         height=200\n367:     )\n368:     return fig\n369: \n370: \n371: def ann_sweep_curve(sweep_x: list, sweep_y: list, output_names: list, current_input: float = None, title: str = \"Neural Metamodel Response Curve\") -> go.Figure:\n372:     \"\"\"Plots multi-output surrogate response curves across parameter sweep with bold threshold.\"\"\"\n373:     fig = go.Figure()\n374:     colors = ['#38bdf8', '#10b981', '#a855f7', '#f59e0b', '#eab308']\n375: \n376:     import numpy as np\n377:     y_arr = np.array(sweep_y)\n378:     if y_arr.ndim == 1:\n379:         y_arr = y_arr.reshape(-1, 1)\n380: \n381:     for i, name in enumerate(output_names):\n382:         col_color = colors[i % len(colors)]\n383:         series_y = y_arr[:, i] * 100.0 if np.max(y_arr[:, i]) <= 1.0 else y_arr[:, i]\n384:         fig.add_trace(go.Scatter(\n385:             x=sweep_x,\n386:             y=series_y,\n387:             mode='lines',\n388:             name=name,\n389:             line=dict(color=col_color, width=3),\n390:             hovertemplate=f\"Input: %{{x:.1f}}<br>{name}: %{{y:.2f}}%<extra></extra>\"\n391:         ))\n392: \n393:     # Bold High-Contrast Threshold line\n394:     fig.add_hline(\n395:         y=85.0, line_dash=\"dash\", line_color=\"#f43f5e\", line_width=2.5,\n396:         annotation_text=\"85% Bottleneck Limit\",\n397:         annotation_font=dict(color=\"#f43f5e\", size=12, family='JetBrains Mono, monospace'),\n398:         annotation_bgcolor=\"rgba(15, 23, 42, 0.85)\",\n399:         annotation_bordercolor=\"#f43f5e\",\n400:         annotation_borderwidth=1,\n401:         annotation_position=\"top right\"\n402:     )\n403: \n404:     if current_input is not None:\n405:         fig.add_vline(\n406:             x=current_input, line_dash=\"dot\", line_color=\"#ffffff\", line_width=2,\n407:             annotation_text=f\"Current Input: {current_input:.1f}\",\n408:             annotation_font=dict(color=\"#38bdf8\", size=11, family='JetBrains Mono, monospace'),\n409:             annotation_bgcolor=\"rgba(15, 23, 42, 0.85)\",\n410:             annotation_bordercolor=\"#38bdf8\",\n411:             annotation_borderwidth=1,\n412:             annotation_position=\"bottom right\"\n413:         )\n414: \n415:     fig.update_layout(\n416:         **_base_layout(\n417:             title=dict(text=title, font=dict(size=14, color='#f8fafc')),\n418:             xaxis=dict(title='Input Parameter Value'),\n419:             yaxis=dict(title='Predicted Output / Utilization (%)'),\n420:             height=340,\n421:             legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n422:         )\n423:     )\n424:     return fig\n425: \n426: \n427: def ann_validation_scatter(y_true: list, y_pred: list, title: str = \"Arena Simulation vs ANN Surrogate\", r2: float = 0.0) -> go.Figure:\n428:     \"\"\"Plots actual Rockwell Arena simulation observations vs ANN surrogate predictions.\"\"\"\n429:     import numpy as np\n430:     fig = go.Figure()\n431: \n432:     # Scatter points\n433:     fig.add_trace(go.Scatter(\n434:         x=y_true,\n435:         y=y_pred,\n436:         mode='markers',\n437:         name='Observations',\n438:         marker=dict(color=_CYBER['cyan'], size=6, opacity=0.75, line=dict(color='#ffffff', width=0.5)),\n439:         hovertemplate=\"Actual: %{x:.4f}<br>Predicted: %{y:.4f}<extra></extra>\"\n440:     ))\n441: \n442:     # Ideal 1:1 diagonal line\n443:     min_val = min(min(y_true), min(y_pred))\n444:     max_val = max(max(y_true), max(y_pred))\n445:     fig.add_trace(go.Scatter(\n446:         x=[min_val, max_val],\n447:         y=[min_val, max_val],\n448:         mode='lines',\n449:         name='Ideal Parity (y=x)',\n450:         line=dict(color=_CYBER['green'], dash='dash', width=2)\n451:     ))\n452: \n453:     fig.update_layout(\n454:         **_base_layout(\n455:             title=dict(text=f\"{title} (R² = {r2:.4f})\", font=dict(size=14, color='#f8fafc')),\n456:             xaxis=dict(title='Rockwell Arena Actual Metric'),\n457:             yaxis=dict(title='ANN Surrogate Metamodel Prediction'),\n458:             height=330,\n459:             legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n460:         )\n461:     )\n462:     return fig\n463: \n464: \nThe above content shows the entire, complete file contents of the requested file.\n"}
