None, str | None]:\n43:     \"\"\"\n44:     Load a model dataset from CSV, XLSX, or XLS seamlessly and efficiently.\n45:     For ultra-large files (e.g. Model 3 with 300MB+), samples rows to ensure\n46:     sub-second latency without browser freezes or memory exhaustion.\n47:     \"\"\"\n48:     try:\n49:         if hasattr(file_or_path, 'read'):\n50:             # Streamlit UploadedFile or file-like buffer\n51:             raw = file_or_path.read()\n52:             fname = getattr(file_or_path, 'name', '').lower()\n53:             \n54:             # Detect by extension or magic header bytes\n55:             if fname.endswith('.xlsx') or raw[:4] == b'PK\\x03\\x04':\n56:                 df = pd.read_excel(io.BytesIO(raw), engine='openpyxl')\n57:             elif fname.endswith('.xls') or raw[:8] == b'\\xd0\\xcf\\x11\\xe0\\xa1\\xb1\\x1a\\xe1':\n58:                 df = pd.read_excel(io.BytesIO(raw), engine='xlrd')\n59:             else:\n60:                 # CSV parsing (if huge, read with limit)\n61:                 if len(raw) > 25 * 1024 * 1024:\n62:                     df = pd.read_csv(io.BytesIO(raw), nrows=max_sample_rows)\n63:                 else:\n64:                     df = pd.read_csv(io.BytesIO(raw))\n65:         else:\n66:             # File path string\n67:             path_str = str(file_or_path)\n68:             lower_path = path_str.lower()\n69:             if lower_path.endswith('.xlsx'):\n70:                 df = pd.read_excel(path_str, engine='openpyxl')\n71:             elif lower_path.endswith('.xls'):\n72:                 df = pd.read_excel(path_str, engine='xlrd')\n73:             else:\n74:                 # If file size is over 20 MB, sample to keep app fast\n75:                 fsize = os.path.getsize(path_str) if os.path.exists(path_str) else 0\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
