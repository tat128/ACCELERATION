date(yaxis)\n42: \n43:     return dict(\n44:         paper_bgcolor=_BG,\n45:         plot_bgcolor=_BG,\n46:         font=dict(color='#e2e8f0', family='-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace'),\n47:         margin=dict(t=45, b=30, l=40, r=20),\n48:         xaxis=default_xaxis,\n49:         yaxis=default_yaxis,\n50:         **kwargs,\n51:     )\n52: \n53: \n54: # ── Quality Charts ────────────────────────────────────────────────────────────\n55: \n56: def defect_donut(summary: dict) -> go.Figure:\n57:     labels = ['Pass', 'Defect', 'Uncertain', 'Novel']\n58:     values = [\n59:         summary.get('pass', 0),\n60:         summary.get('defect', 0),\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
