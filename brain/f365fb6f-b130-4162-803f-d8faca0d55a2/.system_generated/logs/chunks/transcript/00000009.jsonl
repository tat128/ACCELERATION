{"step_index":773,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T18:05:01Z","content":"Created At: 2026-09-19T23:35:01+05:30\nCompleted At: 2026-09-19T23:35:02+05:30\nThe following changes were made by the replace_file_content tool to: C:\\Users\\win-10\\.gemini\\antigravity\\scratch\\neurax_app\\utils\\chart_helpers.py. If relevant, proactively run terminal commands to execute this code for the USER. Don't ask for permission.\n[diff_block_start]\n@@ -304,4 +304,133 @@\n         )\n     )\n     return fig\n+\n+\n+# ── ANN Surrogate & Digital Twin Charts ───────────────────────────────────────\n+\n+def ann_prediction_gauge(val: float, title: str, threshold: float = 0.85) -> go.Figure:\n+    \"\"\"Renders a high-tech cyberpunk gauge for ANN predicted station load.\"\"\"\n+    pct = val * 100.0 if val <= 1.0 else val\n+    thresh_pct = threshold * 100.0 if threshold <= 1.0 else threshold\n+    bar_color = _CYBER['red'] if pct >= thresh_pct else (_CYBER['orange'] if pct >= thresh_pct * 0.85 else _CYBER['cyan'])\n+\n+    fig = go.Figure(go.Indicator(\n+        mode=\"gauge+number+delta\",\n+        value=pct,\n+        number=dict(suffix=\"%\", font=dict(color='#f8fafc', size=24)),\n+        delta=dict(reference=thresh_pct, increasing=dict(color=_CYBER['red']), decreasing=dict(color=_CYBER['green'])),\n+        title=dict(text=title, font=dict(color='#cbd5e1', size=13)),\n+        gauge=dict(\n+            axis=dict(range=[0, 100], tickwidth=1, tickcolor=\"#64748b\", tickfont=dict(color=\"#94a3b8\", size=10)),\n+            bar=dict(color=bar_color, thickness=0.35),\n+            bgcolor=\"rgba(15, 23, 42, 0.6)\",\n+            borderwidth=1,\n+            bordercolor=\"rgba(0, 240, 255, 0.2)\",\n+            steps=[\n+                dict(range=[0, thresh_pct * 0.75], color=\"rgba(5, 223, 157, 0.15)\"),\n+                dict(range=[thresh_pct * 0.75, thresh_pct], color=\"rgba(255, 170, 0, 0.15)\"),\n+                dict(range=[thresh_pct, 100], color=\"rgba(255, 51, 102, 0.25)\"),\n+            ],\n+            threshold=dict(\n+                line=dict(color=_CYBER['red'], width=3),\n+\n<truncated 1883 bytes>\n  )\n+\n+    fig.update_layout(\n+        **_base_layout(\n+            title=dict(text=title, font=dict(size=14, color='#f8fafc')),\n+            xaxis=dict(title='Input Parameter Value'),\n+            yaxis=dict(title='Predicted Output / Utilization (%)'),\n+            height=340,\n+            legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n+        )\n+    )\n+    return fig\n+\n+\n+def ann_validation_scatter(y_true: list, y_pred: list, title: str = \"Arena Simulation vs ANN Surrogate\", r2: float = 0.0) -> go.Figure:\n+    \"\"\"Plots actual Rockwell Arena simulation observations vs ANN surrogate predictions.\"\"\"\n+    import numpy as np\n+    fig = go.Figure()\n+\n+    # Scatter points\n+    fig.add_trace(go.Scatter(\n+        x=y_true,\n+        y=y_pred,\n+        mode='markers',\n+        name='Observations',\n+        marker=dict(color=_CYBER['cyan'], size=6, opacity=0.75, line=dict(color='#ffffff', width=0.5)),\n+        hovertemplate=\"Actual: %{x:.4f}<br>Predicted: %{y:.4f}<extra></extra>\"\n+    ))\n+\n+    # Ideal 1:1 diagonal line\n+    min_val = min(min(y_true), min(y_pred))\n+    max_val = max(max(y_true), max(y_pred))\n+    fig.add_trace(go.Scatter(\n+        x=[min_val, max_val],\n+        y=[min_val, max_val],\n+        mode='lines',\n+        name='Ideal Parity (y=x)',\n+        line=dict(color=_CYBER['green'], dash='dash', width=2)\n+    ))\n+\n+    fig.update_layout(\n+        **_base_layout(\n+            title=dict(text=f\"{title} (R² = {r2:.4f})\", font=dict(size=14, color='#f8fafc')),\n+            xaxis=dict(title='Rockwell Arena Actual Metric'),\n+            yaxis=dict(title='ANN Surrogate Metamodel Prediction'),\n+            height=330,\n+            legend=dict(orientation=\"h\", yanchor=\"bottom\", y=1.02, xanchor=\"right\", x=1)\n+        )\n+    )\n+    return fig\n+\n \n[diff_block_end]\n\nPlease note that the above snippet only shows the MODIFIED lines from the last change. It shows up to 3 lines of unchanged lines before and after the modified lines. The actual file contents may have many more lines not shown.","truncated_fields":["content"]}
