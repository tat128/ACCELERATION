:                 model = YOLO(path)\n47:                 _model_cache[path] = model\n48:                 re\n<truncated 4384 bytes>\ns ──────────────────────────────────────────────────────\n139:     if not detections:\n140:         status        = 'PASS'\n141:         primary_type  = 'normal'\n142:         primary_conf  = 1.0\n143:         primary_bbox  = None\n144:     else:\n145:         # Sort by confidence descending; surface highest-concern defect first\n146:         concern_first = sorted(\n147:             detections,\n148:             key=lambda d: (d['defect_type'] != 'normal', d['confidence']),\n149:             reverse=True,\n150:         )\n151:         top = concern_first[0]\n152:         primary_type = top['defect_type']\n153:         primary_conf = top['confidence']\n154:         primary_bbox = top['bbox']\n155: \n156:         if primary_conf < NOVEL_THRESHOLD:\n157:             status = 'NOVEL'\n158:         elif primary_conf < conf_threshold:\n159:             status = 'UNCERTAIN'\n160:         elif primary_type == 'normal':\n161:             status = 'PASS'\n162:         else:\n163:             status = 'DEFECT'\n164: \n165:     annotated = annotate_image(img.copy(), detections, status)\n166: \n167:     return {\n168:         'status':          status,\n169:         'defect_type':     primary_type,\n170:         'confidence':      primary_conf,\n171:         'bbox':            primary_bbox,\n172:         'all_detections':  detections,\n173:         'annotated_image': annotated,\n174:     }\n175: \n176: \n177: # ── Image Annotation ──────────────────────────────────────────────────────────\n178: \n179: def annotate_image(img: Image.Image, detections: list[dict], status: str) -> Image.Image:\n180:     \"\"\"Draw boxes, labels, and a status badge onto the image.\"\"\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those line