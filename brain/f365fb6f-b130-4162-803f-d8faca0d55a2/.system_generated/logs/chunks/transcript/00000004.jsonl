{"step_index":357,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T16:06:38Z","content":"Created At: 2026-09-19T21:36:38+05:30\nCompleted At: 2026-09-19T21:36:38+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/production_analyzer.py`\nTotal Lines: 168\nTotal Bytes: 6808\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Production-flow analyser.\n3: \n4: Reads Rockwell Arena simulation CSVs (Models 1–3) and applies\n5: Theory of Constraints (TOC) to identify bottleneck stations,\n6: quantify throughput gaps, and compare models.\n7: \"\"\"\n8: from __future__ import annotations\n9: \n10: import io\n11: from typing import Optional\n12: \n13: import numpy as np\n14: import pandas as pd\n15: \n16: from utils.constants import STATION_COLS, DEMAND_COLS, PARTS_COLS, PPH_COLS\n17: \n18: \n19: # ── Helpers ───────────────────────────────────────────────────────────────────\n20: \n21: def _find_col(df: pd.DataFrame, candidates: list[str]) -> Optional[str]:\n22:     \"\"\"Return the first candidate column name that exists in df.\"\"\"\n23:     for c in candidates:\n24:         if c in df.columns:\n25:             return c\n26:     return None\n27: \n28: \n29: def _safe_mean(series) -> float:\n30:     try:\n31:         return float(series.mean())\n32:     except Exception:\n33:         return 0.0\n34: \n35: \n36: # ── Loading ───────────────────────────────────────────────────────────────────\n37: \n38: def load_csv(file_or_path) -> tuple[pd.DataFrame | None, str | None]:\n39:     \"\"\"Load a model CSV and return (DataFrame, error).\"\"\"\n40:     try:\n41:         if hasattr(file_or_path, 'read'):\n42:             # Streamlit Uploaded\n<truncated 762 bytes>\nation, waiting_time}\n61:         bottleneck_station str\n62:         bottleneck_util   float  (0–1)\n63:         bottleneck_wait   float  (minutes)\n64:         demand            float\n65:         total_parts       float\n66:         parts_per_hour    float\n67:         throughput_efficiency float  (%)\n68:         throughput_gap    float\n69:         raw_means         dict  column → mean value\n70:     \"\"\"\n71:     row = df.mean(numeric_only=True).to_dict()\n72: \n73:     # ── Resolve demand / throughput columns ───────────────────────────────────\n74:     demand_col = _find_col(df, DEMAND_COLS)\n75:     parts_col  = _find_col(df, PARTS_COLS)\n76:     pph_col    = _find_col(df, PPH_COLS)\n77: \n78:     demand       = row.get(demand_col,   0.0) if demand_col else 0.0\n79:     total_parts  = row.get(parts_col,    0.0) if parts_col  else 0.0\n80:     parts_per_hr = row.get(pph_col,      0.0) if pph_col    else 0.0\n81: \n82:     # ── Resolve station utilisation / waiting columns ─────────────────────────\n83:     station_metrics: dict[str, dict] = {}\n84: \n85:     for station, col_groups in STATION_COLS.items():\n86:         util_col = _find_col(df, col_groups['util'])\n87:         wait_col = _find_col(df, col_groups['wait'])\n88: \n89:         if util_col is None:\n90:             continue  # station not in this model's CSV\n91: \n92:         raw_util = row.get(util_col, 0.0)\n93:         # Normalise: some CSVs store 0-1, others 0-100\n94:         util = raw_util / 100.0 if raw_util > 1.5 else raw_util\n95:         wait = row.get(wait_col, 0.0) if wait_col else 0.0\n96: \n97:         station_metrics[station] = {\n98:             'utilization':  round(float(util), 4),\n99:             'waiting_time': round(float(wait), 2),\n100:         }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
