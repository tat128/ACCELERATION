m_resized, p_cut)))\n            _, bin_mask = cv2.threshold(np.uint8(cam_resized * 255), int(thresh_val * 255), 255, cv2.THRESH_BINARY)\n            contours, _ = cv2.findContours(bin_mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPRO\n<truncated 508 bytes>\n          by2 = min(orig_h, y + bh + pad)\n                boxes.append([float(bx1), float(by1), float(bx2), float(by2)])\n            if boxes:\n                break\n\n    # Fallback if no box found: high-energy saliency contour\n    if not boxes:\n        img_np = np.array(img_pil.convert('L'))\n        blurred = cv2.GaussianBlur(img_np, (5, 5), 0)\n        grad_x = cv2.Sobel(blurred, cv2.CV_32F, 1, 0, ksize=3)\n        grad_y = cv2.Sobel(blurred, cv2.CV_32F, 0, 1, ksize=3)\n        grad_mag = cv2.magnitude(grad_x, grad_y)\n        grad_norm = cv2.normalize(grad_mag, None, 0, 255, cv2.NORM_MINMAX).astype(np.uint8)\n        _, thresh = cv2.threshold(grad_norm, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)\n        contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n        valid = [c for c in contours if cv2.contourArea(c) > (orig_w*orig_h*0.005)]\n        if valid:\n            best_cnt = max(valid, key=cv2.contourArea)\n            x, y, bw, bh = cv2.boundingRect(best_cnt)\n            if not (bw > orig_w * 0.90 and bh > orig_h * 0.90):\n                boxes.append([float(x), float(y), float(x + bw), float(y + bh)])\n\n    return cam_resized, boxes\n\ntest_files = [\n    ('crack', r'D:\\acceleration\\dataset\\val\\crack\\crack_00011.png', 0),\n    ('hole', r'D:\\acceleration\\dataset\\val\\hole\\hole_00015.png', 1),\n    ('rust', r'D:\\acceleration\\dataset\\val\\rust\\rust_00003.png', 3),\n    ('scratch', r'D:\\acceleration\\dataset\\val\\scratch\\scratch_00023.png', 4),\n]\n\nfor label, p, idx in test_files:\n    img = Image.open(p)\n    cam, boxes = detect_bbox(img, idx, label)\n    print(label, 'boxes:', len(boxes), boxes[:1])\n\"\nTask logs are available at: file:///C:/Users/win-