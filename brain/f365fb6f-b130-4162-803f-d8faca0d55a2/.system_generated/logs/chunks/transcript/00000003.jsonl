{"step_index":263,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T15:30:13Z","content":"Created At: 2026-09-19T21:00:13+05:30\nCompleted At: 2026-09-19T21:00:13+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/root_cause.py`\nTotal Lines: 128\nTotal Bytes: 4513\nShowing lines 1 to 100\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Root-cause correlation engine.\n3: \n4: Matches observed process conditions (from production_analyzer output)\n5: against defect patterns (from defect_registry summary) using a\n6: rule-based evidence framework.\n7: \"\"\"\n8: from __future__ import annotations\n9: \n10: import pandas as pd\n11: \n12: from utils.constants import CORRELATION_RULES\n13: \n14: \n15: # ── Main correlator ───────────────────────────────────────────────────────────\n16: \n17: def correlate(\n18:     analysis: dict | None,\n19:     defect_summary: dict | None,\n20: ) -> list[dict]:\n21:     \"\"\"\n22:     Return a list of evidence cards.\n23: \n24:     Each card:\n25:         cause           str   probable process cause\n26:         evidence        str   which metric triggered the rule\n27:         action          str   recommended corrective action\n28:         confidence      str   HIGH | MEDIUM | LOW\n29:         related_defects list  defect types linked to this cause\n30:         defect_observed bool  were these defects actually seen?\n31:     \"\"\"\n32:     if analysis is None:\n33:         return []\n34: \n35:     # Flatten station data for rule evaluation\n36:     flat_row = dict(analysis.get('raw_means', {}))\n37:     flat_row['Demand']      = analysis.get('demand', 0)\n38:     flat_row['Total parts'] = analysis.get('total_parts', 0)\n39:     for station, data in analysis.get('stations', {}).items():\n40:         flat_row[f'{station} Util']         = data['utilization']\n41:   \n<truncated 449 bytes>\n7:         related = rule['defects']\n58:         observed = bool(set(related) & active_defects) if related else False\n59: \n60:         cards.append({\n61:             'cause':           rule['cause'],\n62:             'evidence':        rule['evidence'],\n63:             'action':          rule['action'],\n64:             'confidence':      rule['confidence'],\n65:             'related_defects': related,\n66:             'defect_observed': observed,\n67:         })\n68: \n69:     # Sort: HIGH first, then observed defects first within tier\n70:     order = {'HIGH': 0, 'MEDIUM': 1, 'LOW': 2}\n71:     cards.sort(key=lambda c: (order.get(c['confidence'], 9), not c['defect_observed']))\n72:     return cards\n73: \n74: \n75: # ── Drift analysis ────────────────────────────────────────────────────────────\n76: \n77: def drift_analysis(registry_df: pd.DataFrame) -> dict | None:\n78:     \"\"\"\n79:     Detect batch-to-batch defect-rate trend.\n80: \n81:     Returns dict with:\n82:         df              enriched DataFrame with rolling_defect_rate\n83:         trend           RISING ⚠️ | IMPROVING ✅ | STABLE\n84:         slope           float  (pp per unit)\n85:         novel_count     int\n86:         uncertain_count int\n87:     \"\"\"\n88:     if registry_df.empty or len(registry_df) < 2:\n89:         return None\n90: \n91:     df = registry_df.copy()\n92: \n93:     # Compute rolling defect rate (already in registry_df if using drift_dataframe())\n94:     if 'rolling_defect_rate' not in df.columns:\n95:         df['is_defect'] = (df['status'] == 'DEFECT').astype(int)\n96:         df['rolling_defect_rate'] = (\n97:             df['is_defect'].rolling(3, min_periods=1).mean() * 100\n98:         )\n99: \n100:     rates = df['rolling_defect_rate'].tolist()\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
