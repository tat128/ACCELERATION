{"step_index":1244,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T21:09:39Z","content":"Created At: 2026-09-20T02:39:39+05:30\nCompleted At: 2026-09-20T02:39:40+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/modules/profitability.py`\nTotal Lines: 142\nTotal Bytes: 5672\nShowing lines 1 to 142\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Profitability & economic modelling module.\n3: \n4: Converts operational telemetry into financial loss estimates and\n5: supports what-if scenario simulation via parameter sliders.\n6: \"\"\"\n7: from __future__ import annotations\n8: \n9: # Assumed unit revenue multiplier (material cost → selling price)\n10: # Adjust via sidebar — this is the default fallback\n11: _DEFAULT_REVENUE_MULTIPLIER = 4.0\n12: \n13: \n14: def compute_financials(\n15:     analysis: dict | None,\n16:     defect_summary: dict | None,\n17:     scrap_cost_per_unit: float = 15.0,\n18:     downtime_cost_per_min: float = 2.50,\n19:     revenue_multiplier: float = _DEFAULT_REVENUE_MULTIPLIER,\n20: ) -> dict:\n21:     \"\"\"\n22:     Compute financial KPIs from operational telemetry.\n23: \n24:     Parameters\n25:     ----------\n26:     analysis              Output of production_analyzer.analyze()\n27:     defect_summary        Output of DefectRegistry.summary()\n28:     scrap_cost_per_unit   Material cost lost per scrapped unit ($)\n29:     downtime_cost_per_min Cost of bottleneck idle time per minute ($)\n30:     revenue_multiplier    Selling price = scrap_cost × multiplier\n31: \n32:     Returns\n33:     -------\n34:     dict with financial KPIs (all in USD)\n35:     \"\"\"\n36:     if analysis is None:\n37:         return _empty_financials()\n38: \n39:     total_parts    = analysis.get('total_parts', 0)\n40:     demand         = analysis.get('demand', 0)\n41:     throughput_gap = analysis.get('throughput_gap', 0)\n42:     bn_wait        = analysis.get('bottleneck_wait', 0)   # avg wait (min) at bottleneck\n<truncated 2740 bytes>\n--\n98:     util_improvement_pct   % reduction in bottleneck waiting time (0-100)\n99:     scrap_reduction_pct    % reduction in defect rate (0-100)\n100:     \"\"\"\n101:     if analysis is None:\n102:         return _empty_financials()\n103: \n104:     # Clone and adjust analysis\n105:     adj_analysis = dict(analysis)\n106:     adj_analysis['bottleneck_wait']     = analysis['bottleneck_wait']     * (1 - util_improvement_pct / 100)\n107:     adj_analysis['throughput_gap']      = analysis['throughput_gap']      * (1 - util_improvement_pct / 100)\n108: \n109:     # Clone and adjust defect summary\n110:     base_rate = (defect_summary or {}).get('defect_rate', 0)\n111:     adj_defect = dict(defect_summary) if defect_summary else {}\n112:     adj_defect['defect_rate'] = base_rate * (1 - scrap_reduction_pct / 100)\n113: \n114:     return compute_financials(\n115:         adj_analysis, adj_defect,\n116:         scrap_cost_per_unit, downtime_cost_per_min,\n117:         revenue_multiplier,\n118:     )\n119: \n120: \n121: def impact_delta(baseline: dict, whatif: dict) -> dict:\n122:     \"\"\"Compute absolute and relative improvement from baseline to what-if.\"\"\"\n123:     delta_margin = whatif['net_margin'] - baseline['net_margin']\n124:     delta_loss   = baseline['total_loss'] - whatif['total_loss']\n125:     return {\n126:         'delta_margin':     round(delta_margin, 2),\n127:         'delta_loss_saved': round(delta_loss, 2),\n128:         'margin_improvement_pct': round(\n129:             delta_margin / abs(baseline['net_margin']) * 100\n130:             if baseline['net_margin'] != 0 else 0, 1\n131:         ),\n132:     }\n133: \n134: \n135: def _empty_financials() -> dict:\n136:     keys = [\n137:         'total_parts', 'good_units', 'scrap_units', 'defect_rate_pct',\n138:         'gross_revenue', 'scrap_loss', 'bottleneck_idle_loss',\n139:         'opportunity_loss', 'rework_cost', 'total_loss', 'net_margin', 'margin_pct',\n140:     ]\n141:     return {k: 0 for k in keys}\n142: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
