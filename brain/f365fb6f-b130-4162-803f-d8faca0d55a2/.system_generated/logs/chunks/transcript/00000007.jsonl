──────────────\n127: \n128: def compare_models(analyses: dict[str, dict | None]) -> pd.DataFrame:\n129:     \"\"\"\n130:     Return a summary DataFrame comparing all loaded models.\n131: \n132:     Columns: Model, Demand, Parts Produced, Parts/Hour, Throughput %,\n133:              Throughput Gap, Bottleneck, Bottleneck Util (%)\n134:     \"\"\"\n135:     rows = []\n136:     for name, a in analyses.items():\n137:         if a is None:\n138:             continue\n139:         bn_station = a['bottleneck_station']\n140:         rows.append({\n141:             'Model':              name,\n142:             'Demand':             a['demand'],\n143:             'Parts Produced':     a['total_parts'],\n144:             'Parts/Hour':         a['parts_per_hour'],\n145:             'Throughput %':       a['throughput_efficiency'],\n146:             'Throughput Gap':     a['throughput_gap'],\n147:             'Bottleneck Station': bn_station,\n148:             'Bottleneck Util %':  round(a['bottleneck_util'] * 100, 1),\n149:             'Bottleneck Wait (min)': a['bottleneck_wait'],\n150:         })\n151:     return pd.DataFrame(rows) if rows else pd.DataFrame()\n152: \n153: \n154: # ── WIP Estimate ──────────────────────────────────────────────────────────────\n155: \n156: def estimate_wip(analysis: dict) -> dict[str, float]:\n157:     \"\"\"\n158:     Rough WIP estimate per station using Little's Law:\n159:         WIP ≈ arrival_rate × waiting_time\n160:     arrival_rate = parts_per_hour / 60  (parts/min)\n161:     \"\"\"\n162:     pph  = analysis.get('parts_per_hour', 0)\n163:     rate = pph / 60.0\n164:     wip  = {}\n165:     for station, data in analysis['stations'].items():\n166:         wip[station] = round(rate * data['waiting_time'], 1)\n167:     return wip\n168: \nThe above content shows the entire, complete file contents of the requested file.\n","truncated_fields":["content"]}
