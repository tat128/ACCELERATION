{"step_index":957,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-19T19:02:13Z","content":"Created At: 2026-09-20T00:32:13+05:30\nCompleted At: 2026-09-20T00:32:14+05:30\nFile Path: `file:///C:/Users/win-10/.gemini/antigravity/scratch/neurax_app/utils/chart_helpers.py`\nTotal Lines: 436\nTotal Bytes: 17481\nShowing lines 1 to 120\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: \"\"\"\n2: Plotly chart factory with futuristic industrial cyber styling.\n3: \"\"\"\n4: import plotly.graph_objects as go\n5: import plotly.express as px\n6: import pandas as pd\n7: \n8: # ── Futuristic Cyber Palette ──────────────────────────────────────────────────\n9: _CYBER = {\n10:     'cyan':    '#00f0ff',\n11:     'green':   '#05df9d',\n12:     'red':     '#ff3366',\n13:     'orange':  '#ffaa00',\n14:     'blue':    '#3b82f6',\n15:     'purple':  '#bf5af2',\n16:     'gray':    '#64748b',\n17:     'dark':    '#111a2e',\n18:     'teal':    '#00e5ff',\n19:     'yellow':  '#ffd600',\n20: }\n21: \n22: _BG = 'rgba(0,0,0,0)'   # transparent background for dark-mode Streamlit\n23: \n24: \n25: def _base_layout(xaxis=None, yaxis=None, **kwargs):\n26:     default_xaxis = dict(\n27:         gridcolor='rgba(0, 240, 255, 0.07)',\n28:         zerolinecolor='rgba(0, 240, 255, 0.18)',\n29:         tickfont=dict(color='#94a3b8', size=11),\n30:         title_font=dict(color='#cbd5e1', size=12),\n31:     )\n32:     default_yaxis = dict(\n33:         gridcolor='rgba(0, 240, 255, 0.07)',\n34:         zerolinecolor='rgba(0, 240, 255, 0.18)',\n35:         tickfont=dict(color='#94a3b8', size=11),\n36:         title_font=dict(color='#cbd5e1', size=12),\n37:     )\n38:     if xaxis is not None:\n39:         default_xaxis.update(xaxis)\n40:     if yaxis is not None:\n41:         default_yaxis.update(yaxis)\n42: \n43:     return dict(\n44:         paper_bgcolor=_BG,\n45:         plot_bgcolor=_BG,\n46:         \n<truncated 1257 bytes>\nayout(\n75:             title=dict(text='Quality Status Distribution', font=dict(size=14, color='#f8fafc')),\n76:             showlegend=True,\n77:             legend=dict(orientation='h', yanchor='bottom', y=-0.22, font=dict(color='#94a3b8')),\n78:             height=320,\n79:         )\n80:     )\n81:     return fig\n82: \n83: \n84: def defect_type_bar(by_type: dict) -> go.Figure:\n85:     if not by_type:\n86:         return go.Figure()\n87:     df = pd.DataFrame(list(by_type.items()), columns=['Defect', 'Count'])\n88:     color_map = {\n89:         'crack':   _CYBER['red'],\n90:         'hole':    _CYBER['purple'],\n91:         'rust':    _CYBER['orange'],\n92:         'scratch': _CYBER['yellow'],\n93:     }\n94:     colors = [color_map.get(d.lower(), _CYBER['gray']) for d in df['Defect']]\n95:     fig = go.Figure(go.Bar(\n96:         x=df['Defect'], y=df['Count'],\n97:         marker=dict(color=colors, line=dict(color='rgba(255,255,255,0.15)', width=1)),\n98:         text=df['Count'], textposition='outside',\n99:         textfont=dict(color='#ffffff', size=11),\n100:     ))\n101:     fig.update_layout(\n102:         **_base_layout(\n103:             title=dict(text='Defect Class Signature Count', font=dict(size=14, color='#f8fafc')),\n104:             xaxis=dict(title='Defect Signature'),\n105:             yaxis=dict(title='Detected Units'),\n106:             height=280,\n107:         )\n108:     )\n109:     return fig\n110: \n111: \n112: def confidence_histogram(df: pd.DataFrame) -> go.Figure:\n113:     if df.empty:\n114:         return go.Figure()\n115:     fig = px.histogram(\n116:         df[df['status'] != 'PASS'], x='confidence', nbins=20,\n117:         color='status',\n118:         color_discrete_map={'DEFECT': _CYBER['red'], 'UNCERTAIN': _CYBER['orange'], 'NOVEL': _CYBER['purple']},\n119:         title='Neural Confidence Distribution (Flagged Units)',\n120:     )\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n","truncated_fields":["content"]}
