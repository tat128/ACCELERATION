# =============================================================================
# Autonomous Quality & Process Intelligence Platform
# Environment Configuration EXAMPLE FILE
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Edit .env with YOUR actual file paths
# 3. Never commit .env to Git (it contains machine-specific paths)
# =============================================================================


# ── Simulation Dataset Paths ──────────────────────────────────────────────────
MODEL_DIR=/path/to/your/simulation/datasets
MODEL_1_PATH=/path/to/Model_1.csv
MODEL_2_PATH=/path/to/Model_2.csv
MODEL_3_PATH=/path/to/Model_3.csv


# ── YOLOv8 Defect Detection Weights ───────────────────────────────────────────
YOLO_WEIGHTS_PATH=/path/to/best.pt


# ── ANN Surrogate Training Data ────────────────────────────────────────────────
MATLAB_MAT_PATH=/path/to/3000Samplesv3.mat


# ── Financial Model Defaults ───────────────────────────────────────────────────
DEFAULT_SCRAP_COST=15.0
DEFAULT_DOWNTIME_COST=2.50
DEFAULT_REVENUE_MULTIPLIER=4.0


# ── Quality Detection Thresholds ───────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.45
NOVEL_THRESHOLD=0.25


# ── Application Settings ───────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
