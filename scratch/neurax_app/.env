# =============================================================================
# Autonomous Quality & Process Intelligence Platform
# Environment Configuration File
# =============================================================================
# Copy this file and rename it .env before running the application.
# All paths use forward slashes or raw Windows paths.
# =============================================================================


# ── Simulation Dataset Paths ──────────────────────────────────────────────────
# CSV/XLSX files exported from Rockwell Arena simulation runs.
# The app auto-loads these on startup if they exist.

MODEL_DIR=D:/acceleration
MODEL_1_PATH=D:/acceleration/Model_1.csv
MODEL_2_PATH=D:/acceleration/Model_2.csv
MODEL_3_PATH=D:/acceleration/Model_3.csv


# ── YOLOv8 Defect Detection Weights ───────────────────────────────────────────
# Path to the trained YOLOv8 .pt weights file.

YOLO_WEIGHTS_PATH=D:/acceleration/best.pt


# ── ANN Surrogate Training Data ────────────────────────────────────────────────
# MATLAB .mat workspace containing 3,000 Arena simulation training samples.

MATLAB_MAT_PATH=C:/Users/win-10/Downloads/3000Samplesv3.mat


# ── Financial Model Defaults ───────────────────────────────────────────────────
# These values pre-fill the Economic Intelligence sliders.
# Judges / users can override them in the UI at runtime.

DEFAULT_SCRAP_COST=15.0
DEFAULT_DOWNTIME_COST=2.50
DEFAULT_REVENUE_MULTIPLIER=4.0


# ── Quality Detection Thresholds ───────────────────────────────────────────────
# CONFIDENCE_THRESHOLD : below this -> UNCERTAIN flag
# NOVEL_THRESHOLD      : below this -> NOVEL flag (human review required)

CONFIDENCE_THRESHOLD=0.45
NOVEL_THRESHOLD=0.25


# ── Application Settings ───────────────────────────────────────────────────────
# DEBUG=true enables verbose console logging (set false for demo)

APP_ENV=production
DEBUG=false
